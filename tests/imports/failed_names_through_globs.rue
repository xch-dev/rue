import X;

// Two glob imports that bring in error items with the same name would each have filled it, so a
// failure of either import explains what finds the name. `a`'s `X::Y` finds the error item that
// `k` brings in, which is in a cycle with `k`'s own re-export, but `l`'s failure explains the name
// too, so only `l`'s failure is reported.
mod k {
    export super::a::Y::X;
}

mod l {
    export missing::X;
}

mod a {
    import super::k::*;
    import super::l::*;

    export X::Y;
}

// A named import of the name shadows the glob imports, so its own failure isn't explained by
// theirs, and is reported. It would fail even if `k` had an `X`.
mod s {
    import super::k::*;

    export X;
}

mod b {
    import super::*;
    import X::d::X;
}

fn main() -> Int {
    s::X
}
