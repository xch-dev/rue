import h;
import nope::h;
import nope::u;

fn u() -> Int {
    1
}

// An import through `super` that finds a name in some namespaces passes on its block in the
// others, and an import without a path of a blocked name isn't reported again
mod inner {
    import super::u;

    export fn f() -> Int {
        u() + u::g()
    }
}

fn main() -> Int {
    h() + inner::f()
}
