import h;
import nope::h;
import nope::u;

fn u() -> Int {
    1
}

// An import through `super` that finds a name in some namespaces brings in the error items of the
// others. `import h;` of the name that `import nope::h;` fails to bring in isn't reported again
// either.
mod inner {
    import super::u;

    export fn f() -> Int {
        u() + u::g()
    }
}

fn main() -> Int {
    h() + inner::f()
}
