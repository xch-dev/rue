// `crate` can only start a path, and a path can't end in it. The root has no parent, so `super`
// can't follow it, and `crate` doesn't reach the prelude
mod a {
    export const X: Int = 1;

    import super::crate::X;
    import crate;
    import crate::{crate};
}

fn main() -> Int {
    let _ = crate;
    let _ = crate::super::X;
    let _ = a::crate::X;
    let _: crate::Int = 1;
    crate::a::X
}
