import A::B;
import B::A;
import C::C;
import D::E;
import E::I;
import F::G;
import G::H;
import H::F;
import c::X::X;
import d::W::W;
import nope::D;
import nope::V;
import p::q::V::V;

mod c {
    import super::X;
}

mod p {
    import super::*;

    mod q {
        import super::V;
    }
}

mod d {
    import super::*;
}

// A named import with a path is still reported when the module it names failed to import the name
// privately, like a path to it in code is
mod a {
    import super::b::Y;
    import super::b::Z;

    export fn f() -> Int {
        Y + Z
    }
}

mod b {
    import super::a::Y;
    import nope::Z;

    export fn g() -> Int {
        Y + Z
    }
}

// An import that fails at a name that another failed import binds isn't reported again, unless
// that import only failed because of it, which happens in a cycle. The uses aren't reported again.
fn main() -> Int {
    A + B + C + D + E + F + G + H + I + V + W + X + a::f() + b::g()
}
