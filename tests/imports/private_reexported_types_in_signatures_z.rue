// A private type re-exported through `z::m` is reported once, even though the signatures that use
// it are resolved before every import is: the imports are resolved before the signatures too, and
// the reported re-export exports the type then. That's whichever module is resolved first, which
// depends on module names (see private_reexported_types_in_signatures_a and
// private_reexported_types_in_signatures_z).
mod z {
    type X = Int;

    export mod m {
        export super::X;
    }
}

mod a {
    import super::z::m::X;

    export fn f(x: X) -> super::z::m::X {
        x
    }
}

fn main() -> Int {
    let x: z::m::X = 1;
    a::f(x)
}
