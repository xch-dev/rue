import both::VALUE;

mod alpha {
    export const VALUE: Int = 1;
    export const SHARED: Int = 3;
    export type Number = Int;
}

mod beta {
    export const VALUE: Int = 2;
    export super::alpha::SHARED;
    export type Number = String;
}

mod both {
    export super::alpha::*;
    export super::beta::*;
}

mod chained {
    export super::both::*;
}

mod user {
    import super::alpha::*;
    import super::beta::*;

    export fn ambiguous(value: Number) -> Int {
        VALUE + value
    }

    export fn same_item() -> Int {
        SHARED
    }
}

mod shadowed {
    import super::alpha::*;
    import super::beta::*;

    const VALUE: Int = 4;

    export fn local() -> Int {
        VALUE
    }
}

fn main() -> Int {
    user::ambiguous(1)
        + user::same_item()
        + shadowed::local()
        + both::VALUE
        + chained::VALUE
        + VALUE
}
