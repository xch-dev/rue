// In a program compiled from a single file, `project` names the file, so it reaches the file's
// items (private ones too, since every module is in it) from any inline module
const SECRET: Int = 40;

mod a {
    mod b {
        export fn get() -> Int {
            project::SECRET + project::a::helper()
        }
    }

    export fn helper() -> Int {
        1
    }

    export fn call() -> Int {
        b::get()
    }
}

// Named and glob imports through `project`
mod c {
    import project::SECRET;
    import project::a::*;

    export fn run() -> Int {
        call() + SECRET
    }
}

// `export project::...` re-exports a public item of the root, like `export super::...`
mod d {
    export project::SHARED;
}

export const SHARED: Int = SECRET;

// Types through `project`, and `project` from the top level of the file itself
type Alias = project::Num;
type Num = Int;

fn main() -> Int {
    let x: Alias = project::c::run();
    x + d::SHARED
}
