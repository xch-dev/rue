mod a {
    export const V: Int = 1;
}

mod z {
    export mod m {
        export const W: Int = 20;
    }
}

const V: Int = 7;

mod m {
    export const W: Int = 30;
}

mod inner {
    import super::a::V;
    import super::z::m;

    export mod deeper {
        import super::V;
        import super::m::W;

        export fn value() -> Int {
            V
        }

        export fn path() -> Int {
            W
        }
    }
}

mod globbed {
    import super::a::*;

    export mod deeper {
        import super::V;

        export fn value() -> Int {
            V
        }
    }
}

test fn parent_imports_use_the_parent_named_import() -> Int {
    inner::deeper::value() + V
}

test fn parent_import_paths_use_the_parent_named_import() -> Int {
    inner::deeper::path() + m::W
}

test fn parent_imports_use_the_parent_glob_import() -> Int {
    globbed::deeper::value() + V
}
