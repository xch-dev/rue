mod a {
    export const V: Int = 1;
    export type T = Int;
}

const V: Int = 7;

type T = Bytes;

mod y {
    export const W: Int = 7;
}

mod z {
    export mod y {
        export const W: Int = 1;
    }
}

mod inner {
    import deeper::*;

    export mod deeper {
        export super::super::a::V;
        export super::super::a::T;
    }

    // `super` is `inner`, so these are what `inner` has, which it gets from `deeper`
    export mod user {
        import super::V;
        import super::T;

        export fn f(value: T) -> T {
            value
        }

        export fn g() -> Int {
            V
        }
    }
}

mod globs {
    // `super::y` is the top-level `y`, even though `z::*` brings in a module named `y` too
    import super::z::*;
    import super::y::*;

    export fn f() -> Int {
        W
    }
}

test fn parent_imports_use_what_the_parent_imports() -> Int {
    inner::user::g() + inner::user::f(10) + V
}

test fn parent_paths_use_the_parent_module() -> Int {
    globs::f() + y::W
}
