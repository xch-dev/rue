// In a program compiled from a single file, `crate` names the file, so it reaches the file's items
// (private ones too, since every module is in it) from any inline module
const SECRET: Int = 40;

mod a {
    mod b {
        export fn get() -> Int {
            crate::SECRET + crate::a::helper()
        }
    }

    export fn helper() -> Int {
        1
    }

    export fn call() -> Int {
        b::get()
    }
}

// Named and glob imports through `crate`
mod c {
    import crate::SECRET;
    import crate::a::*;

    export fn run() -> Int {
        call() + SECRET
    }
}

// `export crate::...` re-exports a public item of the root, like `export super::...`
mod d {
    export crate::SHARED;
}

export const SHARED: Int = SECRET;

// Types through `crate`, and `crate` from the top level of the file itself
type Alias = crate::Num;
type Num = Int;

fn main() -> Int {
    let x: Alias = crate::c::run();
    x + d::SHARED
}
