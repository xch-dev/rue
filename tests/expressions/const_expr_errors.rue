test fn parameter(value: Int) -> Int {
    const { value + 1 }
}

test fn outer_binding() -> Int {
    let value = 1;
    const { value + 1 }
}

test fn raises() -> Int {
    const {
        raise 42;
    }
}

test fn destructured_runtime_value(value: Int) -> Int {
    const {
        let (a, b) = (value, 4);
        a + b
    }
}

test fn outer_destructured_binding() -> Int {
    let (a, b) = (3, 4);
    const { a + b }
}
