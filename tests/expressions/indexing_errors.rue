// The unions in these tests overlap on purpose, to test how the compiler handles them
#![allow(redundant_union_member)]

struct Wrapper {
    value: Bytes,
}

fn lists(list: List<Bytes>, pair: (Bytes, Int), wrapper: Wrapper, either: Bytes | List<Int>) {
    let _ = list[0];
    let _ = list[1..];
    let _ = pair[0];
    let _ = wrapper[0];
    let _ = either[0];
    let _ = [1, 2, 3][0];
}

fn atoms(int: Int, bool: Bool, public_key: PublicKey, signature: Signature, atom: Atom, any: Any) {
    let _ = int[0];
    let _ = bool[0];
    let _ = public_key[0];
    let _ = signature[..48];
    let _ = atom[0];
    let _ = any[0];
}

fn generic<T>(value: T) -> Bytes {
    value[0]
}

fn bounds(bytes: Bytes, list: List<Int>) {
    let _ = bytes[bytes];
    let _ = bytes["a"..list];
    let _ = bytes[..bytes];
    let _ = bytes[nil];
    let _ = bytes[true..];
}

fn results(bytes: Bytes) -> Int {
    let _: Bytes32 = bytes[..32];
    let _: PublicKey = bytes[0];
    bytes[0]
}

fn unbounded(bytes: Bytes) -> Bytes {
    bytes[..]
}

fn undeclared(bytes: Bytes) -> Bytes {
    missing[0] + bytes[missing] + bytes[missing..other]
}

const LOOP: Int = LOOP;
const FIRST: Int = SECOND + 1;
const SECOND: Int = FIRST + 1;

fn recursive_constants(bytes: Bytes) -> Bytes {
    bytes[LOOP] + bytes[FIRST] + bytes[SECOND - 1] + bytes[LOOP..FIRST]
}

type First = String;
type Last = String;

// Part of a string is a string, and part of anything else is bytes
fn strings(
    string: String,
    literal: "hello" | "world",
    optional: String | nil,
    bytes: Bytes,
    first: First,
    name: First | Last,
    twice: String | String,
) {
    let _: Int = first[0];
    let _: Int = name[1..];
    let _: Int = twice[0];
    let _: Int = string[0];
    let _: Int = string[1..];
    let _: Int = literal[..2];
    let _: Int = "hello"[1];
    let _: Int = optional[0];
    let _: Int = bytes[0];
    let _: Int = (string + string)[0];
}
