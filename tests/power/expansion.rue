// CLVM has no power operator, so a power is compiled to the multiplications that the product of
// that many copies of the base is, and the exponent is evaluated at compile time

// The same as `x * x`
test fn square(x: Int) -> Int {
    x ** 2
}

test fn square_by_hand(x: Int) -> Int {
    x * x
}

test fn cube(x: Int) -> Int {
    x ** 3
}

test fn cube_by_hand(x: Int) -> Int {
    x * x * x
}

test fn eighth_power(x: Int) -> Int {
    x ** 8
}

test fn eighth_power_by_hand(x: Int) -> Int {
    x * x * x * x * x * x * x * x
}

// A power of constants is folded
test fn constant_power() -> Int {
    10 ** 18
}

test fn constant_power_by_hand() -> Int {
    10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10 * 10
}

// So is a power of a base that's made of constants, which is repeated rather than bound
const BASE: Int = 3;

test fn constant_bases() -> Int {
    (-2)
            ** 3
        + (2 ** 3)
            ** 2
        + (1 + 2)
            ** 2
        + const { BASE + 1 }
            ** 2
        + (5 as Int)
            ** 2
        + (2 ** 16)
                ** 16
            % 7
}

// A power of constants is the number it evaluates to, so a power of one is too
test fn power_of_constant_power() -> Int {
    (2 ** 6) ** 100 % 1000 + (10 ** 6) ** 100 % 7 + (1 + 2 ** 3) ** 2
}

// A base that's a negative number is a power of that number too
test fn negative_constant_base() -> Int {
    const { -3 } ** 3 + const { -3 } ** 2 + (0xFF as Int) ** 3 + (-(2 ** 40)) ** 40 % 7
}

// A base that's too large to repeat that many times is bound even if it's made of constants, so
// that its copies don't multiply
test fn large_constant_base() -> Int {
    ((1 + 1) ** 40) ** 40 % 7 + (1 + 1 + 0) ** 256 % 1000
}

// So is the power of a power that's too long to be the operand of a product with `LIMITS`
test fn long_constant_power_base() -> Int {
    ((2 ** 40) ** 40) ** 40 % 1000
}

test fn largest_exponent_of_largest_exponent() -> Int {
    ((1 ** 256) ** 256) ** 256
}

// A constant that's referenced more than once is read from the environment, so a power of one
// isn't folded, like the product by hand. It is with an `inline const`, or in a const expression.
test fn constant_item_base() -> Int {
    BASE ** 4
}

test fn constant_item_base_by_hand() -> Int {
    BASE * BASE * BASE * BASE
}

inline const INLINE_BASE: Int = 3;

test fn inline_constant_item_base() -> Int {
    INLINE_BASE ** 4
}

test fn constant_item_base_in_const() -> Int {
    const { BASE ** 4 }
}

// A base that isn't a reference or made of constants is bound, so that it's only evaluated once
test fn bound_base(x: Int) -> Int {
    (x + 1) ** 3
}

test fn bound_base_by_hand(x: Int) -> Int {
    let base = x + 1;
    base * base * base
}

fn increment(x: Int) -> Int {
    x + 1
}

test fn call_base(x: Int) -> Int {
    increment(x) ** 2
}

// The first power is the same as the base, and the zeroth power is one
test fn first_power(x: Int) -> Int {
    x ** 1
}

test fn zeroth_power(x: Int) -> Int {
    x ** 0
}

// The base is still evaluated for its effect with an exponent of zero, like the value of a
// binding that's never referenced, so this fails for a divisor of zero
test fn zeroth_power_of_failing_base(x: Int) -> Int {
    (10 / x) ** 0
}

test fn zeroth_power_of_valid_base(x: Int) -> Int {
    (10 / x) ** 0
}

// A reference is repeated rather than bound, but what it refers to is still evaluated for its
// effect with an exponent of zero
test fn zeroth_power_of_failing_reference(x: Int) -> Int {
    inline let quotient = 10 / x;
    quotient ** 0
}

test fn zeroth_power_of_valid_reference(x: Int) -> Int {
    inline let quotient = 10 / x;
    quotient ** 0
}

// A field is read from the environment each time, like a reference
struct Point {
    x: Int,
    y: Int,
}

test fn field_base(point: Point) -> Int {
    point.x ** 2 + point.y ** 3
}

test fn field_base_by_hand(point: Point) -> Int {
    point.x * point.x + point.y * point.y * point.y
}

// So is a cast of one, while the length of a value is computed, so it's bound
test fn cast_base(bytes: Bytes) -> Int {
    (bytes as Int) ** 3
}

test fn length_base(bytes: Bytes) -> Int {
    bytes.length ** 3
}

test fn zeroth_power_of_field(point: Point) -> Int {
    point.y ** 0
}

// A power of a constant is known not to be zero, so dividing by it can't fail, and a division
// that isn't used is removed like it is for the number itself
test fn unused_division_by_power(x: Int) -> Int {
    let _quotient = x / 10 ** 3;
    let _remainder = x % 2 ** 1;
    let _first = x / const { 5 } ** 2;
    let _zeroth = x / 0 ** 0;
    x
}

// The same goes for a shift, which fails for an amount that's too large
test fn unused_shift_by_power(x: Int) -> Int {
    let _shifted = x << 2 ** 3;
    x
}

test fn failing_shift_by_power(x: Int) -> Int {
    let _shifted = x << 2 ** 70;
    x
}

// A power of zero is zero, so this division is kept, and fails
test fn division_by_zero_power(x: Int) -> Int {
    let _quotient = x / 0 ** 2;
    x
}

// A `-` before the base applies to the power
test fn negated_power(x: Int) -> Int {
    -x ** 2
}

test fn power_of_negation(x: Int) -> Int {
    (-x) ** 2
}

// The exponent can be any expression that's known at compile time
const EXPONENT: Int = 2;

fn double(value: Int) -> Int {
    value * 2
}

test fn constant_exponent(x: Int) -> Int {
    x ** EXPONENT
}

test fn computed_exponent(x: Int) -> Int {
    x ** (EXPONENT + 1)
}

test fn function_exponent(x: Int) -> Int {
    x ** double(EXPONENT)
}

// A power in a function that an exponent or a constant calls is expanded before the call is
// evaluated, wherever the function is declared
fn squared(value: Int) -> Int {
    value ** 2
}

const SQUARE: Int = squared(3);

test fn power_in_called_function(x: Int) -> Int {
    x ** squared(2) + SQUARE + x ** square_of_successor(1)
}

fn square_of_successor(value: Int) -> Int {
    (value + 1) ** 2
}

test fn power_exponent(x: Int) -> Int {
    x ** 2 ** EXPONENT
}

test fn const_block_exponent(x: Int) -> Int {
    x ** const { EXPONENT - 2 }
}

// Powers nest like the products they're compiled to
test fn power_of_power(x: Int) -> Int {
    (x ** 2) ** 3
}

test fn sum_of_powers(x: Int, y: Int) -> Int {
    x ** 2 + 2 * x * y + y ** 2
}

// A power can be used in a constant and in a const expression
const DECIMALS: Int = 10 ** 3;

test fn power_in_constant(x: Int) -> Int {
    x * DECIMALS + const { 2 ** 64 }
}

// The largest exponent is 256
test fn largest_exponent() -> Int {
    2 ** 256 - 1
}

test fn largest_exponent_of_parameter(x: Int) -> Int {
    x ** 256
}

// An inline binding is substituted for each copy of the base, as it is in a product
test fn inline_base(x: Int) -> Int {
    inline let base = x + 1;
    base ** 2
}

// A power in a lambda, a generic function and a branch
fn apply<T>(value: T, function: fn(value: T) -> T) -> T {
    function(value)
}

test fn power_in_lambda(x: Int) -> Int {
    apply(x, fn(value) => value ** 2)
}

test fn power_in_branch(x: Int, flag: Bool) -> Int {
    if flag {
        x ** 2
    } else {
        x ** 3
    }
}

// A power of constants is a constant index, so the byte after it is found when compiling too
const INDEX: Int = 2;

test fn power_index(bytes: Bytes) -> Bytes {
    bytes[INDEX ** 2] + bytes[2 ** 1..2 ** 2]
}

test fn power_of_index(bytes: Bytes) -> Int {
    (bytes[0] as Int) ** 2
}

// An unused power of a value that can't fail is removed
test fn unused_power(x: Int) -> Int {
    let _unused = (x + 1) ** 2;
    x
}

// A power is the right operand of `||` the way its product is: it can't fail without
// `operand_limits`, so it's evaluated whether or not the left operand decides the result
fn any_large_square(items: List<Int>) -> Bool {
    if items is nil {
        return false;
    }

    items.first > 100 || items.first ** 2 > 100 || any_large_square(items.rest)
}

fn any_large_square_by_hand(items: List<Int>) -> Bool {
    if items is nil {
        return false;
    }

    items.first > 100 || items.first * items.first > 100 || any_large_square_by_hand(items.rest)
}

test fn eager_square(items: List<Int>) -> Bool {
    any_large_square(items)
}

test fn eager_square_by_hand(items: List<Int>) -> Bool {
    any_large_square_by_hand(items)
}

// A small function with a power in it is inlined into its calls the way its product is
fn small_square(x: Int) -> Int {
    x ** 2
}

fn small_square_by_hand(x: Int) -> Int {
    x * x
}

test fn inlined_square(a: Int, b: Int) -> Int {
    small_square(a) + small_square(b)
}

test fn inlined_square_by_hand(a: Int, b: Int) -> Int {
    small_square_by_hand(a) + small_square_by_hand(b)
}

// A power is as large as its product when a function is measured for inlining. A body this large
// isn't measured, so neither function is inlined, though inlining it would fold these calls.
fn large_power(x: Int) -> Int {
    x ** 20
}

fn large_power_by_hand(x: Int) -> Int {
    x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

test fn shared_large_power() -> Int {
    large_power(2) + large_power(3)
}

test fn shared_large_power_by_hand() -> Int {
    large_power_by_hand(2) + large_power_by_hand(3)
}
