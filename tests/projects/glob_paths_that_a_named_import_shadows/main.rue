// `import b::a` brings in `a.rue`'s inner module `a`, which shadows the sibling `a.rue` for the
// path of `import a::*`. The two imports wait for each other, but `a::*`'s path isn't forced while
// the named import of `a` is in the same cycle: only `b::a`'s path is forced, which finds the
// sibling `b.rue`, and then `a::*`'s path finds the inner module `a` that it brings in. So `V` is
// 100, from the inner module. `second.rue` does the same with the names in the other order.

import a::*;
import b::a;

fn main() -> Int {
    V
}
