const SECRET: Int = 1;

// Re-exporting a private item would make it public, so it's reported, as in Rust
export mod a {
    export super::SECRET;
}

// Sibling files are public, so they can be re-exported, by name or with a glob import, which
// doesn't re-export the private items of the file
export mod files {
    export super::helpers;
    export super::*;

    export fn secret() -> Int {
        SECRET
    }
}
