import p::z::n;

// Before the re-export is reported, `import p::z::n` finds only private items, so it fails, which
// hides the sibling file `n.rue`. The re-export is reported before any failure is final, and then
// the import brings in the public function `n`, so `d`'s import of `n` through `super` reaches
// `n.rue`.
mod p {
    export mod z {
        export super::n;

        mod n {}
    }

    fn n() -> Int {
        5
    }
}

mod d {
    import super::n;

    export fn f() -> Int {
        n() + n::Q
    }
}

fn main() -> Int {
    n() + d::f() + n::Q
}
