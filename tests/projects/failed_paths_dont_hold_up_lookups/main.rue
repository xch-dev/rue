export b::*;
import nope::u;

// The lookup of `u` doesn't wait for `import nope::u` to bring it in, so it isn't forced past it to
// the sibling file once nothing else can be resolved
mod a {
    import super::u;

    export fn f() -> Int {
        u::greet()
    }
}

mod b {}

fn main() -> Int {
    a::f()
}
