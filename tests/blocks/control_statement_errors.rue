// An arm of a `match` statement can't be a value, since it isn't used
fn value_arm(value: Int | nil) -> Int {
    match value {
        nil => 1,
        Int => {}
    }

    2
}

// A branch of a statement can't end in a value either
fn value_branch(flag: Bool) -> Int {
    if flag {
        1
    } else {
        debug flag;
    }

    2
}

// A statement in an expression block can't return from the function, since the block's value is
// what it would return
fn return_in_expression_block(value: Int | nil) -> Int {
    let result = {
        match value {
            nil => {
                return 1;
            }
            _ => {}
        }

        2
    };
    result + 1
}

// A branch of a function body's value that falls through doesn't have a value
fn missing_value(flag: Bool) -> Int {
    if flag {
        return 1;
    } else {
        debug flag;
    }
}

// A `match` statement still has to handle every value
fn not_exhaustive(value: Int | nil | (Int, Int)) -> Int {
    match value {
        nil => {
            return 0;
        }
        Int => {}
    }

    1
}

// When several branches fall through, the rest of the block sees every value they do
fn not_narrowed(value: Int | nil, flag: Bool) -> Int {
    match value {
        nil => {
            debug flag;
        }
        Int => {}
    }

    value + 1
}

// An `if` statement whose block falls through doesn't narrow what comes after it
fn if_not_narrowed(value: Int | nil) -> Int {
    if value is nil {
        debug value;
    }

    value + 1
}

// The arms of an `inline match` statement are all evaluated, so it doesn't narrow either
fn inline_not_narrowed(value: Int | nil) -> Int {
    inline match value {
        nil => {
            return 0;
        }
        Int => {}
    }

    value + 1
}

test fn errors() -> Int {
    value_arm(nil)
        + value_branch(true)
        + return_in_expression_block(nil)
        + missing_value(true)
        + not_exhaustive(nil)
        + not_narrowed(nil, true)
        + if_not_narrowed(nil)
        + inline_not_narrowed(nil)
}
