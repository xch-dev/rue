struct Circle {
    kind = 1,
    radius: Int,
}

struct Square {
    kind = 2,
    side: Int,
}

struct Point {
    _kind = 3,
}

type Shape = Circle | Square | Point;

fn checked(value: Int) -> Int {
    assert value < 100;
    value
}

// Every arm ends in `return` or `raise`, so the match ends the function
fn every_arm_exits(shape: Shape) -> Int {
    match shape {
        Circle => {
            return shape.radius;
        }
        Square => {
            return shape.side * 2;
        }
        Point => {
            raise "point";
        }
    }
}

test fn every_arm_exits_circle() -> Int {
    every_arm_exits(Circle { radius: 5 })
}

test fn every_arm_exits_point() -> Int {
    every_arm_exits(Point {})
}

// Every branch ends in `return` or `raise`, so the chain ends the function
fn every_branch_exits(value: Int) -> Int {
    if value > 10 {
        return 1;
    } else if value > 5 {
        raise "between";
    } else {
        return 2;
    }
}

test fn every_branch_exits_results() -> List<Int> {
    [every_branch_exits(20), every_branch_exits(1)]
}

test fn every_branch_exits_raises() -> Int {
    every_branch_exits(7)
}

// Only one arm continues with the rest of the function
fn one_arm_continues(shape: Shape) -> Int {
    match shape {
        Circle => {
            return shape.radius;
        }
        Square => {
            raise "square";
        }
        Point => {}
    }

    100
}

test fn one_arm_continues_results() -> List<Int> {
    [one_arm_continues(Circle { radius: 5 }), one_arm_continues(Point {})]
}

// Several arms continue with the rest of the function, which is only generated once
fn several_arms_continue(shape: Shape, value: Int) -> Int {
    match shape {
        Circle => {
            return shape.radius;
        }
        Square => {
            assert value > 0;
        }
        Point => {
            assert value > 1;
        }
    }

    value * value + 1000
}

test fn several_arms_continue_results() -> List<Int> {
    [
        several_arms_continue(Circle { radius: 5 }, 0),
        several_arms_continue(Square { side: 1 }, 1),
        several_arms_continue(Point {}, 2),
    ]
}

test fn several_arms_continue_fails() -> Int {
    several_arms_continue(Point {}, 1)
}

// No branch returns, so the statement is evaluated before the rest of the function
fn no_branch_returns(value: Int) -> Int {
    if value > 5 {
        assert value < 10;
    } else if value > 2 {
        debug value;
    } else {
        assert value != 0;
    }

    value + 1
}

test fn no_branch_returns_results() -> List<Int> {
    [no_branch_returns(7), no_branch_returns(3), no_branch_returns(1)]
}

test fn no_branch_returns_fails() -> Int {
    no_branch_returns(0)
}

// An `if` statement without an `else` can fall through too
fn if_falls_through(value: Int) -> Int {
    if value > 5 {
        assert value < 10;
    }

    value
}

test fn if_falls_through_results() -> List<Int> {
    [if_falls_through(7), if_falls_through(20 - 19)]
}

test fn if_falls_through_fails() -> Int {
    if_falls_through(12)
}

// Statements nest, and each one continues with the rest of the block it's in
fn nested(shape: Shape, value: Int) -> Int {
    match shape {
        Circle => {
            if value > 5 {
                return shape.radius;
            } else if value > 2 {
                assert value != 3;
            } else {
                assert value != 0;
            }

            assert value != 4;
        }
        _ => {
            match value {
                0 => {
                    return 0;
                }
                _ => {}
            }
        }
    }

    value + 10
}

test fn nested_results() -> List<Int> {
    [
        nested(Circle { radius: 5 }, 6),
        nested(Circle { radius: 5 }, 5),
        nested(Circle { radius: 5 }, 1),
        nested(Point {}, 0),
        nested(Point {}, 7),
    ]
}

test fn nested_fails() -> Int {
    nested(Circle { radius: 5 }, 4)
}

// Statements after one another
fn sequence(shape: Shape, value: Int) -> Int {
    match shape {
        Circle => {
            return 1;
        }
        Square => {
            assert value > 0;
        }
        Point => {}
    }

    if value > 5 {
        return 2;
    } else if value > 3 {
        assert value != 4;
    } else {
        debug value;
    }

    value
}

test fn sequence_results() -> List<Int> {
    [
        sequence(Circle { radius: 1 }, 0),
        sequence(Square { side: 1 }, 7),
        sequence(Point {}, 5),
        sequence(Point {}, 0),
    ]
}

// A binding that can fail is still checked when a branch returns before it's used
fn checks_before_returning(value: Int, early: Bool) -> Int {
    let checked = checked(value);

    if early {
        return 0;
    } else if value > 5 {
        assert value > 6;
    } else {
        debug value;
    }

    checked
}

test fn checks_before_returning_fails() -> Int {
    checks_before_returning(500, true)
}

// The branches of a function body's value can return from the function
fn returns_from_value(value: Int) -> Int {
    if value > 5 {
        return 1;
    } else {
        2
    }
}

fn returns_from_match_value(value: Int | nil) -> Int {
    match value {
        nil => {
            return 0;
        }
        Int => value + 1,
    }
}

fn returns_from_block_value(value: Int) -> Int {
    {
        if value > 5 {
            return 1;
        }

        2
    }
}

test fn returns_from_values() -> List<Int> {
    [
        returns_from_value(7),
        returns_from_value(1),
        returns_from_match_value(nil),
        returns_from_match_value(4),
        returns_from_block_value(7),
        returns_from_block_value(1),
    ]
}

// A statement with `;` after it is an expression statement, whose branches are values
fn expression_statement(value: Int) -> Int {
    if value > 5 {
        value
    } else {
        0
    };
    value
}

test fn expression_statement_result() -> Int {
    expression_statement(7)
}

// A statement in an expression block falls through to the rest of the block
fn in_expression_block(value: Int) -> Int {
    let result = {
        match value {
            0 => {
                assert value == 0;
            }
            _ => {}
        }

        value + 1
    };
    result * 2
}

test fn in_expression_block_result() -> Int {
    in_expression_block(1)
}

// The arms of a statement can be `if` and `match` without a block around them
fn arms_without_blocks(value: Int | nil, flag: Bool) -> Int {
    match value {
        nil => if flag {
            return 0;
        } else {
            raise "no value";
        }
        Int => match value {
            3 => {
                return 1;
            }
            _ => {}
        }
    }

    value + 2
}

test fn arms_without_blocks_results() -> List<Int> {
    [arms_without_blocks(nil, true), arms_without_blocks(3, false), arms_without_blocks(5, false)]
}

test fn arms_without_blocks_raises() -> Int {
    arms_without_blocks(nil, false)
}

// The rest of the block only sees the values of the branches that fall through to it
fn narrows_after(value: Int | nil, pair: (Int, Int) | Int) -> Int {
    match value {
        nil => {
            return 0;
        }
        _ => {}
    }

    if pair is Int {
        return value + pair;
    } else if pair.first > 10 {
        raise "too large";
    } else {
        debug pair;
    }

    value + pair.first + pair.rest
}

test fn narrows_after_results() -> List<Int> {
    [narrows_after(nil, 1), narrows_after(1, 2), narrows_after(1, (2, 3))]
}

// The last arm handles every value that's left, which the rest of the block sees by its members
fn narrows_to_last_arm(shape: Shape) -> Int {
    match shape {
        Point => {
            return 0;
        }
        Circle => {
            raise "a circle has no sides";
        }
        Square => {
            assert shape.side > 0;
        }
    }

    shape.side * 4
}

test fn narrows_to_last_arm_results() -> List<Int> {
    [narrows_to_last_arm(Point {}), narrows_to_last_arm(Square { side: 3 })]
}

// An `inline match` statement evaluates every arm
fn inline_statement(value: Int) -> Int {
    inline match value {
        0 => {
            debug value;
        }
        _ => {}
    }

    value
}

test fn inline_statement_result() -> Int {
    inline_statement(1)
}

// A function without a value, inlined into a branch that returns, returns nil rather than
// continuing with the rest of the block it's called from
inline fn check_positive(value: Int) {
    assert value > 0;
}

fn returns_inlined_nil(flag: Bool, value: Int) -> Int | nil {
    if flag {
        return check_positive(value);
    } else {
        debug value;
    }

    value + 100
}

fn returns_inlined_nil_shared(flag: Bool, value: Int) -> Int | nil {
    if flag {
        return check_positive(value);
    } else if value > 5 {
        debug value;
    } else {
        assert value != 0;
    }

    value + 100
}

test fn returns_inlined_nil_results() -> List<Int | nil> {
    [
        returns_inlined_nil(true, 1),
        returns_inlined_nil(false, 1),
        returns_inlined_nil_shared(true, 1),
        returns_inlined_nil_shared(false, 1),
    ]
}

// A function without a value that ends with a statement, inlined into a branch that falls
// through
inline fn log_sign(value: Int) {
    if value > 0 {
        debug "positive";
    }
}

fn calls_statement_function(flag: Bool, value: Int) -> Int {
    if flag {
        return 1;
    } else {
        log_sign(value);
    }

    value
}

test fn calls_statement_function_results() -> List<Int> {
    [calls_statement_function(true, 5), calls_statement_function(false, 5)]
}

// A function without a return type can end with a statement
fn check_value(value: Int) {
    if value > 5 {
        assert value < 10;
    } else {
        assert value != 0;
    }
}

test fn ends_with_statement() {
    check_value(7);
    check_value(1);
}

test fn ends_with_statement_fails() {
    check_value(12);
}

// A function without a return type can still end with an `if` or `match` whose branches are its
// value
fn delegates(value: Int) {
    if value > 1 {
        check_value(value)
    } else {
        check_value(value + 5)
    }
}

fn delegates_match(value: Int) {
    match value {
        0 => nil,
        _ => check_value(value),
    }
}

test fn delegates_results() {
    delegates(7);
    delegates(1);
    delegates_match(0);
    delegates_match(7);
}

test fn delegates_fails() {
    delegates(12);
}

// So can a function without a return type that ends with an `else if`
fn ends_with_else_if(value: Int) {
    if value > 10 {
        return;
    } else if value > 5 {
        assert value != 6;
    }
}

test fn ends_with_else_if_results() {
    ends_with_else_if(20);
    ends_with_else_if(7);
    ends_with_else_if(1);
}

test fn ends_with_else_if_fails() {
    ends_with_else_if(6);
}

// An `else if` statement can leave out the `else`, even with several of them
fn three_levels(value: Int) -> Int {
    if value > 10 {
        return 1;
    } else if value > 5 {
        assert value != 6;
    } else if value > 2 {
        assert value != 3;
    }

    value
}

test fn three_levels_results() -> List<Int> {
    [three_levels(20), three_levels(7), three_levels(4), three_levels(1)]
}

// An `else if` statement can leave out the `else`
fn else_if_without_else(value: Int) -> Int {
    if value > 10 {
        return 1;
    } else if value > 5 {
        assert value != 6;
    }

    value
}

test fn else_if_without_else_results() -> List<Int> {
    [else_if_without_else(20), else_if_without_else(7), else_if_without_else(2)]
}

test fn else_if_without_else_fails() -> Int {
    else_if_without_else(6)
}

// A return inside an `if` statement in a branch can still return from the function
fn returns_from_nested_if(value: Int | nil, flag: Bool) -> Int {
    match value {
        nil => {
            if flag {
                return 1;
            }
        }
        Int => {}
    }

    2
}

fn returns_from_nested_if_shared(value: Int | nil, flag: Bool) -> Int {
    match value {
        nil => {
            if flag {
                return 1;
            }
        }
        Int => {
            assert value != 3;
        }
    }

    2
}

test fn returns_from_nested_if_results() -> List<Int> {
    [
        returns_from_nested_if(nil, true),
        returns_from_nested_if(nil, false),
        returns_from_nested_if(5, true),
        returns_from_nested_if_shared(nil, true),
        returns_from_nested_if_shared(nil, false),
        returns_from_nested_if_shared(5, true),
    ]
}

// A binding that can fail is still put where it's used if no branch can return
fn substitutes_without_returns(value: Int) -> Int {
    let checked = checked(value);

    if value > 5 {
        assert value > 6;
    } else {
        debug value;
    }

    checked
}

test fn substitutes_without_returns_result() -> Int {
    substitutes_without_returns(7)
}

// Statements in an inline function, called from a branch of another statement
inline fn classify(value: Int) -> Int {
    if value > 10 {
        return 3;
    } else if value > 5 {
        assert value != 6;
    } else {
        debug value;
    }

    value * 2
}

fn calls_inline_statements(shape: Shape, value: Int) -> Int {
    match shape {
        Point => {
            return classify(value);
        }
        _ => {}
    }

    classify(value + 1)
}

test fn calls_inline_statements_results() -> List<Int> {
    [
        calls_inline_statements(Point {}, 20),
        calls_inline_statements(Point {}, 7),
        calls_inline_statements(Circle { radius: 1 }, 1),
    ]
}

// Statements in a lambda
fn lambda_statements(value: Int, other: Int) -> Int {
    let run = fn(value: Int, other: Int): Int => {
        match value {
            0 => {
                return 7;
            }
            1 => {
                assert other > 0;
            }
            _ => {
                debug other;
            }
        }

        value * other
    };
    run(value, other)
}

test fn lambda_statements_results() -> List<Int> {
    [lambda_statements(0, 5), lambda_statements(1, 5), lambda_statements(3, 5)]
}

// An `inline if` statement evaluates both of its branches
fn inline_if_statement(value: Int) -> Int {
    inline if value > 5 {
        debug value;
    } else {
        debug 0;
    }

    value
}

test fn inline_if_statement_result() -> Int {
    inline_if_statement(7)
}

// A branch with bindings of its own before it runs the shared rest of the block
fn bindings_before_shared_rest(shape: Shape, value: Int) -> Int {
    match shape {
        Circle => {
            return shape.radius;
        }
        Square => {
            let doubled = value * 2;
            assert doubled + doubled > 4;
        }
        Point => {
            assert value > 1;
        }
    }

    value + 1
}

test fn bindings_before_shared_rest_results() -> List<Int> {
    [
        bindings_before_shared_rest(Circle { radius: 9 }, 0),
        bindings_before_shared_rest(Square { side: 1 }, 2),
        bindings_before_shared_rest(Point {}, 2),
    ]
}

// The rest of the block sees what the branch that falls through does, whichever branch that is
fn narrows_to_then(value: (Int, Int) | nil) -> Int {
    if value is (Int, Int) {
        debug value;
    } else {
        return 0;
    }

    value.first + 1
}

fn narrows_through_else_if(value: (Int, Int) | nil | Bytes32) -> Int {
    if value is nil {
        return 0;
    } else if value is Bytes32 {
        raise "bytes";
    } else {
        debug value;
    }

    value.first + 1
}

fn narrows_to_earlier_arm(value: (Int, Int) | nil) -> Int {
    match value {
        (Int, Int) => {}
        nil => {
            return 0;
        }
    }

    value.first + 1
}

test fn narrows_to_branch_results() -> List<Int> {
    [
        narrows_to_then((1, 2)),
        narrows_to_then(nil),
        narrows_through_else_if((3, 4)),
        narrows_through_else_if(nil),
        narrows_to_earlier_arm((5, 6)),
        narrows_to_earlier_arm(nil),
    ]
}

// A `match` statement on an enum narrows the rest of the block to the variants that fall through
enum Payment {
    Free,
    Card { amount: Int },
    Refund { amount: Int },
}

fn charge(payment: Payment) -> Int {
    match payment {
        Payment::Free => {
            return 0;
        }
        Payment::Refund => {
            raise "refunds aren't charged";
        }
        Payment::Card => {
            assert payment.amount > 0;
        }
    }

    payment.amount
}

test fn charge_results() -> List<Int> {
    [charge(Payment::Free), charge(Payment::Card { amount: 5 })]
}

test fn charge_refund() -> Int {
    charge(Payment::Refund { amount: 5 })
}

// A branch whose only exit is a statement whose branches all exit exits too, so the rest of the
// block only sees the values of the other branch
fn exits_through_statement(value: Int | nil, flag: Bool) -> Int {
    if value is nil {
        if flag {
            return 0;
        } else {
            raise "no value";
        }
    }

    value + 1
}

fn exits_through_statement_shared(value: Int | nil, flag: Bool) -> Int {
    match value {
        nil => {
            if flag {
                return 0;
            } else {
                raise "no value";
            }
        }
        Int => {
            assert value != 3;
        }
    }

    value + 1
}

test fn exits_through_statement_results() -> List<Int> {
    [
        exits_through_statement(nil, true),
        exits_through_statement(4, true),
        exits_through_statement_shared(nil, true),
        exits_through_statement_shared(4, true),
    ]
}

// A statement whose branches all exit doesn't have a value, even with more statements after it
fn exits_before_more_statements(flag: Bool) -> Int {
    let value: Int = {
        if flag {
            raise "flag";
        } else {
            raise "no flag";
        }

        debug flag;
    };
    value
}

test fn exits_before_more_statements_raises() -> Int {
    exits_before_more_statements(true)
}
