test fn guard_function(value: nil | fn() -> Int) -> Bool {
    value is fn() -> Int
}

test fn guard_any(value: Any) -> Bool {
    value is List<Int>
}

test fn guard_list(value: List<Bytes>) -> Bool {
    value is List<Bytes32>
}

type Tree = nil | (Tree, Tree);

test fn guard_tree(value: Any) -> Bool {
    value is Tree
}
