// The unions in these tests overlap on purpose, to test how the compiler handles them
#![allow(redundant_union_member)]

// Each level nests the previous type twice, which doubles the size of the check
type T0 = Int;
type T1 = (T0, T0);
type T2 = (T1, T1);
type T3 = (T2, T2);
type T4 = (T3, T3);
type T5 = (T4, T4);
type T6 = (T5, T5);
type T7 = (T6, T6);
type T8 = (T7, T7);
type T9 = (T8, T8);
type T10 = (T9, T9);
type T11 = (T10, T10);
type T12 = (T11, T11);
type T13 = (T12, T12);

fn too_large(value: Any) -> Bool {
    value is T12
}

// Every level past the limit is too large as well
fn larger(value: Any) -> Bool {
    value is T13
}

// The value could still be guarded, so these aren't incompatible
fn unguarded_assign(value: Any) -> T12 {
    value
}

fn unguarded_cast(value: Any) -> T12 {
    value as T12
}

// A check that's too large isn't needed if another pair matches every pair
fn any_pair(value: Any) -> Bool {
    value is (Any, Any) | T13
}

// But it is needed alongside a pair that's small enough, whichever half is too large
fn first_too_large(value: Any) -> Bool {
    value is (T12, Int) | (Int, Int)
}

fn rest_too_large(value: Any) -> Bool {
    value is (Int, T12) | (Int, Int)
}

// Or if the rest of the pair can never match
fn never_matches(value: (Any, Bytes32)) -> Bool {
    value is (T12, nil)
}

fn incompatible_assign(value: (Any, Bytes32)) -> (T12, nil) {
    value
}

fn main(pair: (Any, Bytes32)) -> (Bool, ((T12, T12), (T12, nil))) {
    (
        too_large(nil)
            && larger(nil)
            && any_pair(nil)
            && first_too_large(nil)
            && rest_too_large(nil)
            && never_matches(pair),
        ((unguarded_assign(nil), unguarded_cast(nil)), incompatible_assign(pair)),
    )
}
