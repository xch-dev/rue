    | L<260>;

fn too_large(value: Any) -> Bool {
    value is Big
}

// The value could still be guarded, so these aren't incompatible
fn unguarded_assign(value: Any) -> Big {
    value
}

fn unguarded_cast(value: Any) -> Big {
    value as Big
}

// A check that's too large isn't needed if another pair matches every pair
fn any_pair(value: Any) -> Bool {
    value is (Any, Any) | (Big, Big)
}

// But it is needed alongside a pair that's small enough, whichever half is too large
fn first_too_large(value: Any) -> Bool {
    value is (Big, Int) | (Int, Int)
}

fn rest_too_large(value: Any) -> Bool {
    value is (Int, Big) | (Int, Int)
}

// Or if the rest of the pair can never match
fn never_matches(value: (Any, Bytes32)) -> Bool {
    value is (Big, nil)
}

fn incompatible_assign(value: (Any, Bytes32)) -> (Big, nil) {
    value
}

fn main(pair: (Any, Bytes32)) -> (Bool, ((Big, Big), (Big, nil))) {
    (
        too_large(nil)
            && any_pair(nil)
            && first_too_large(nil)
            && rest_too_large(nil)
            && never_matches(pair),
        ((unguarded_assign(nil), unguarded_cast(nil)), incompatible_assign(pair)),
    )
}
