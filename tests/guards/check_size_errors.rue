// Each level nests the previous type twice, which doubles the size of the check
type T0 = Int;
type T1 = (T0, T0);
type T2 = (T1, T1);
type T3 = (T2, T2);
type T4 = (T3, T3);
type T5 = (T4, T4);
type T6 = (T5, T5);
type T7 = (T6, T6);
type T8 = (T7, T7);
type T9 = (T8, T8);
type T10 = (T9, T9);
type T11 = (T10, T10);
type T12 = (T11, T11);
type T24 = (T12, T12);

fn too_large(value: Any) -> Bool {
    value is T12
}

// The check is too large long before the nesting is too deep
fn much_too_large(value: Any) -> Bool {
    value is T24
}

// The value could still be guarded, so this isn't an incompatible assignment
fn unguarded(value: Any) -> T12 {
    value
}

fn main() -> (Bool, T12) {
    (too_large(nil) && much_too_large(nil), unguarded(nil))
}
