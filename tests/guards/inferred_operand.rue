// Guards whose value gets its type from elsewhere still check it at runtime, including the
// explicit type argument that the error in `inferred_operand_errors.rue` asks for

fn pick<T>(first: T, second: T) -> T {
    if first is Int {
        return second;
    }
    first
}

test fn explicit_unchecked_cast() {
    let value: Any = (1, 2);
    assert !(unchecked_cast::<Any>(value) is Bytes32);
    assert unchecked_cast::<Any>(value) is (Int, Int);
}

test fn generic_inferred_from_arguments() {
    let pair: Any = (1, 2);
    let number: Any = 5;
    assert !(pick(pair, number) is Bytes32);
    assert pick(number, pair) is (Int, Int);
}

test fn list_literal() {
    let pair: Any = (1, 2);
    let number: Any = 5;
    assert !([pair] is List<Int>);
    assert [number] is List<Int>;
}
