struct A {
    kind: 1,
}

struct B {
    kind: 2,
}

// When both parts differ, the pair is split in two, and the pairs that are left aren't all `(B, B)`
test fn both_parts_differ(value: (A | B, A | B)) -> (B, B) {
    if value is (A, A) {
        return (B { kind: 2 }, B { kind: 2 });
    }

    value
}
