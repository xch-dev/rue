// Each level nests the previous type twice, which would double the size of the check at each level
// if its parts weren't shared
type T0 = Int;
type T1 = (T0, T0);
type T2 = (T1, T1);
type T3 = (T2, T2);
type T4 = (T3, T3);
type T5 = (T4, T4);
type T6 = (T5, T5);
type T7 = (T6, T6);
type T8 = (T7, T7);
type T9 = (T8, T8);
type T10 = (T9, T9);
type T11 = (T10, T10);
type T12 = (T11, T11);
type T13 = (T12, T12);
type T14 = (T13, T13);
type T15 = (T14, T14);
type T16 = (T15, T15);
type T17 = (T16, T16);
type T18 = (T17, T17);

// The checks of `T2` and `T3` are helpers, which are generated once and called for each use
test fn valid(value: Any) -> Bool {
    value is T4
}

test fn pair_in_place_of_int(value: Any) -> Bool {
    value is T4
}

test fn int_in_place_of_pair(value: Any) -> Bool {
    value is T4
}

test fn not_a_pair(value: Any) -> Bool {
    value is T4
}

// The check stays small however many levels there are
test fn deep(value: Any) -> Bool {
    value is T18
}

// The value is only passed to the check once, so it's evaluated once
test fn computed_value(value: Any) -> Bool {
    (value, value) is (T3, T3)
}

// A bound value is passed to the check once as well, so it doesn't need to be kept
test fn bound_value(value: Any) -> Bool {
    let pair = (value, value);
    pair is (T3, T3)
}

inline fn is_t4(value: Any) -> Bool {
    value is T4
}

// A guard in an inlined function is lowered where it's called
test fn inlined_function(value: Any) -> Bool {
    is_t4(value) && !is_t4(nil)
}

test fn match_arm(value: Any) -> Int {
    match value {
        T4 => 4,
        T3 => 3,
        _ => 0,
    }
}

// The value is narrowed by a shared check like any other
test fn narrowed(value: Any) -> Int {
    if value is T4 {
        value.first.first.first.first + value.rest.rest.rest.rest
    } else {
        0
    }
}
