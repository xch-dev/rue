test fn condition_type_guards() {
    let puzzle_hash = sha256("puzzle_hash");
    let coin_id = sha256("coin_id");
    let id = sha256("id");

    assert Remark {} as Condition is Remark;
    assert Remark { rest: 42 } as Condition is Remark;
    assert AggSigParent { message: nil, public_key: INFINITY_G1 } as Condition is AggSigParent;
    assert AggSigPuzzle { message: nil, public_key: INFINITY_G1 } as Condition is AggSigPuzzle;
    assert AggSigAmount { message: nil, public_key: INFINITY_G1 } as Condition is AggSigAmount;
    assert AggSigPuzzleAmount {
        message: nil,
        public_key: INFINITY_G1,
    } as Condition is AggSigPuzzleAmount;
    assert AggSigParentAmount {
        message: nil,
        public_key: INFINITY_G1,
    } as Condition is AggSigParentAmount;
    assert AggSigParentPuzzle {
        message: nil,
        public_key: INFINITY_G1,
    } as Condition is AggSigParentPuzzle;
    assert AggSigUnsafe { message: nil, public_key: INFINITY_G1 } as Condition is AggSigUnsafe;
    assert AggSigMe { message: nil, public_key: INFINITY_G1 } as Condition is AggSigMe;
    assert CreateCoin { puzzle_hash: puzzle_hash, amount: 42 } as Condition is CreateCoin;
    assert ReserveFee { amount: 42 } as Condition is ReserveFee;
    assert CreateCoinAnnouncement { message: nil } as Condition is CreateCoinAnnouncement;
    assert AssertCoinAnnouncement { id: id } as Condition is AssertCoinAnnouncement;
    assert CreatePuzzleAnnouncement { message: nil } as Condition is CreatePuzzleAnnouncement;
    assert AssertPuzzleAnnouncement { id: id } as Condition is AssertPuzzleAnnouncement;
    assert AssertConcurrentSpend { coin_id: coin_id } as Condition is AssertConcurrentSpend;
    assert AssertConcurrentPuzzle {
        puzzle_hash: puzzle_hash,
    } as Condition is AssertConcurrentPuzzle;
    assert SendMessage { mode: 42, message: nil, receiver: [42] } as Condition is SendMessage;
    assert ReceiveMessage { mode: 42, message: nil, sender: [42] } as Condition is ReceiveMessage;
    assert AssertMyCoinId { coin_id: coin_id } as Condition is AssertMyCoinId;
    assert AssertMyParentId { parent_id: id } as Condition is AssertMyParentId;
    assert AssertMyPuzzleHash { puzzle_hash: puzzle_hash } as Condition is AssertMyPuzzleHash;
    assert AssertMyAmount { amount: 42 } as Condition is AssertMyAmount;
    assert AssertMyBirthSeconds { seconds: 42 } as Condition is AssertMyBirthSeconds;
    assert AssertMyBirthHeight { height: 42 } as Condition is AssertMyBirthHeight;
    assert AssertEphemeral {} as Condition is AssertEphemeral;
    assert AssertSecondsRelative { seconds: 42 } as Condition is AssertSecondsRelative;
    assert AssertSecondsAbsolute { seconds: 42 } as Condition is AssertSecondsAbsolute;
    assert AssertHeightRelative { height: 42 } as Condition is AssertHeightRelative;
    assert AssertHeightAbsolute { height: 42 } as Condition is AssertHeightAbsolute;
    assert AssertBeforeSecondsRelative { seconds: 42 } as Condition is AssertBeforeSecondsRelative;
    assert AssertBeforeSecondsAbsolute { seconds: 42 } as Condition is AssertBeforeSecondsAbsolute;
    assert AssertBeforeHeightRelative { height: 42 } as Condition is AssertBeforeHeightRelative;
    assert AssertBeforeHeightAbsolute { height: 42 } as Condition is AssertBeforeHeightAbsolute;
    assert Softfork { cost: 42, args: [] } as Condition is Softfork;
}

// A condition is a list that starts with its opcode
fn opcode(condition: Condition) -> Int {
    let (opcode, _) = condition as (Int, Any);
    opcode
}

test fn condition_opcodes() {
    let id = sha256("id");

    assert opcode(Remark {}) == REMARK;
    assert opcode(AggSigParent { public_key: INFINITY_G1, message: nil }) == AGG_SIG_PARENT;
    assert opcode(AggSigPuzzle { public_key: INFINITY_G1, message: nil }) == AGG_SIG_PUZZLE;
    assert opcode(AggSigAmount { public_key: INFINITY_G1, message: nil }) == AGG_SIG_AMOUNT;
    assert opcode(AggSigPuzzleAmount {
        public_key: INFINITY_G1,
        message: nil,
    }) == AGG_SIG_PUZZLE_AMOUNT;
    assert opcode(AggSigParentAmount {
        public_key: INFINITY_G1,
        message: nil,
    }) == AGG_SIG_PARENT_AMOUNT;
    assert opcode(AggSigParentPuzzle {
        public_key: INFINITY_G1,
        message: nil,
    }) == AGG_SIG_PARENT_PUZZLE;
    assert opcode(AggSigUnsafe { public_key: INFINITY_G1, message: nil }) == AGG_SIG_UNSAFE;
    assert opcode(AggSigMe { public_key: INFINITY_G1, message: nil }) == AGG_SIG_ME;
    assert opcode(CreateCoin { puzzle_hash: id, amount: 42 }) == CREATE_COIN;
    assert opcode(ReserveFee { amount: 42 }) == RESERVE_FEE;
    assert opcode(CreateCoinAnnouncement { message: nil }) == CREATE_COIN_ANNOUNCEMENT;
    assert opcode(AssertCoinAnnouncement { id }) == ASSERT_COIN_ANNOUNCEMENT;
    assert opcode(CreatePuzzleAnnouncement { message: nil }) == CREATE_PUZZLE_ANNOUNCEMENT;
    assert opcode(AssertPuzzleAnnouncement { id }) == ASSERT_PUZZLE_ANNOUNCEMENT;
    assert opcode(AssertConcurrentSpend { coin_id: id }) == ASSERT_CONCURRENT_SPEND;
    assert opcode(AssertConcurrentPuzzle { puzzle_hash: id }) == ASSERT_CONCURRENT_PUZZLE;
    assert opcode(SendMessage { mode: 42, message: nil, receiver: [] }) == SEND_MESSAGE;
    assert opcode(ReceiveMessage { mode: 42, message: nil, sender: [] }) == RECEIVE_MESSAGE;
    assert opcode(AssertMyCoinId { coin_id: id }) == ASSERT_MY_COIN_ID;
    assert opcode(AssertMyParentId { parent_id: id }) == ASSERT_MY_PARENT_ID;
    assert opcode(AssertMyPuzzleHash { puzzle_hash: id }) == ASSERT_MY_PUZZLE_HASH;
    assert opcode(AssertMyAmount { amount: 42 }) == ASSERT_MY_AMOUNT;
    assert opcode(AssertMyBirthSeconds { seconds: 42 }) == ASSERT_MY_BIRTH_SECONDS;
    assert opcode(AssertMyBirthHeight { height: 42 }) == ASSERT_MY_BIRTH_HEIGHT;
    assert opcode(AssertEphemeral {}) == ASSERT_EPHEMERAL;
    assert opcode(AssertSecondsRelative { seconds: 42 }) == ASSERT_SECONDS_RELATIVE;
    assert opcode(AssertSecondsAbsolute { seconds: 42 }) == ASSERT_SECONDS_ABSOLUTE;
    assert opcode(AssertHeightRelative { height: 42 }) == ASSERT_HEIGHT_RELATIVE;
    assert opcode(AssertHeightAbsolute { height: 42 }) == ASSERT_HEIGHT_ABSOLUTE;
    assert opcode(AssertBeforeSecondsRelative { seconds: 42 }) == ASSERT_BEFORE_SECONDS_RELATIVE;
    assert opcode(AssertBeforeSecondsAbsolute { seconds: 42 }) == ASSERT_BEFORE_SECONDS_ABSOLUTE;
    assert opcode(AssertBeforeHeightRelative { height: 42 }) == ASSERT_BEFORE_HEIGHT_RELATIVE;
    assert opcode(AssertBeforeHeightAbsolute { height: 42 }) == ASSERT_BEFORE_HEIGHT_ABSOLUTE;
    assert opcode(Softfork { cost: 42, args: [] }) == SOFTFORK;
}

// The conditions are the variants of the `Condition` enum, so they can be named through it and
// matched on
fn spent_amount(conditions: List<Condition>) -> Int {
    if conditions is nil {
        return 0;
    }

    let (condition, rest) = conditions;

    let amount = match condition {
        Condition::CreateCoin => condition.amount,
        ReserveFee => condition.amount,
        _ => 0,
    };

    amount + spent_amount(rest)
}

test fn condition_enum() {
    let puzzle_hash = sha256("puzzle_hash");

    let conditions: List<Condition> = [
        Condition::CreateCoin { puzzle_hash, amount: 3 },
        CreateCoin { puzzle_hash, amount: 4, memos: Memos { value: [puzzle_hash] } },
        Condition::ReserveFee { amount: 1 },
        Condition::AssertEphemeral {},
        Remark {},
    ];

    assert spent_amount(conditions) == 8;

    // The layout is the same as the list of the opcode and the fields
    assert tree_hash(Condition::AssertEphemeral {}) == tree_hash([ASSERT_EPHEMERAL]);
    assert tree_hash(CreateCoin { puzzle_hash, amount: 3 }) == tree_hash([
        CREATE_COIN,
        puzzle_hash,
        3,
    ]);
}

test fn hashing() {
    assert tree_hash("hello") == 0xcceeb7a985ecc3dabcb4c8f666cd637f16f008e3c963db6aa6f83a7b288c54ef;
    assert tree_hash("hello") == tree_hash_atom("hello");
    assert tree_hash_atom("hello") == sha256(1 as Bytes + "hello");
}

test fn currying() {
    let hash = curry_tree_hash(tree_hash("xyz"), [tree_hash("a"), tree_hash("b"), tree_hash("c")]);
    assert hash == 0x932daac5826a521478ec3dc75c49f889278bc56bf6afa45cdfa3aadffe2e76ed;
}

test fn recursion() {
    check_each([
        nil,
        "Hello, world!",
        (100, 200),
        [1, 2, 3],
        fn(a: Int, b: Int) => a + b,
        check_each,
    ]);
}

fn check_each(list: List<Any>) {
    if list is nil {
        return;
    }

    let (value, rest) = list;

    assert deep_equal(value, value);
    assert tree_hash(value) == tree_hash(value);

    check_each(rest);
}
