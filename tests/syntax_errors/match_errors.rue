fn missing_arrow(value: Int | nil) -> Int {
    match value {
        nil 0,
        _ => 1,
    }
}

fn missing_comma(value: Int | nil) -> Int {
    match value {
        nil => 0
        _ => 1,
    }
}

// Only an arm that ends with a brace can leave out its comma
fn missing_comma_same_line(value: Int | nil) -> Int {
    match value { nil => 0 _ => 1 }
}

// An arm whose value is a block ends at its closing brace, like a block statement, so it can't be
// continued with a field access or an operator
fn continued_block_arm(value: Int | nil) -> Int {
    match value {
        nil => { (1, 2) }.first,
        Int => if value > 0 { 1 } else { 2 } + 3,
    }
}

fn missing_body(value: Int | nil) -> Int {
    match value {
        nil =>,
        _ => 1,
    }
}

fn missing_pattern(value: Int | nil) -> Int {
    match value {
        => 0,
        _ => 1,
    }
}

fn missing_brace(value: Int | nil) -> Int {
    match value
}

fn missing_value() -> Int {
    match {
        _ => 1,
    }
}

struct A {
    kind = 1,
}

struct B {
    kind = 2,
}

// An unclosed delimiter in an arm hides the arms after it, so nothing is said about them
fn unclosed_arm(value: A | B) -> Int {
    match value {
        A => foo(1,
        B => 2,
    }
}

fn main() -> Int {
    missing_arrow(nil) + missing_comma(nil) + missing_body(nil) + missing_pattern(nil)
        + missing_brace(nil) + missing_value()
        + unclosed_arm(A {})
        + missing_comma_same_line(nil)
        + continued_block_arm(nil)
}
