// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

fn missing_arrow(value: Int | nil) -> Int {
    match value {
        nil 0,
        _ => 1,
    }
}

fn missing_comma(value: Int | nil) -> Int {
    match value {
        nil => 0
        _ => 1,
    }
}

// Only an arm that ends with a brace can leave out its comma
fn missing_comma_same_line(value: Int | nil) -> Int {
    match value { nil => 0 _ => 1 }
}

// An arm whose value is a block ends at its closing brace, like a block statement, so it can't be
// continued with a field access or an operator
fn continued_block_arm(value: Int | nil) -> Int {
    match value {
        nil => { (1, 2) }.first,
        Int => if value > 0 { 1 } else { 2 } + 3,
    }
}

fn missing_body(value: Int | nil) -> Int {
    match value {
        nil =>,
        _ => 1,
    }
}

fn missing_pattern(value: Int | nil) -> Int {
    match value {
        => 0,
        _ => 1,
    }
}

fn missing_brace(value: Int | nil) -> Int {
    match value
}

fn missing_value() -> Int {
    match {
        _ => 1,
    }
}

struct A {
    kind = 1,
}

struct B {
    kind = 2,
}

// An unclosed delimiter in an arm hides the arms after it, so nothing is said about them
fn unclosed_arm(value: A | B) -> Int {
    match value {
        A => foo(1,
        B => 2,
    }
}

fn main() -> Int {
    missing_arrow(nil) + missing_comma(nil) + missing_body(nil) + missing_pattern(nil)
        + missing_brace(nil) + missing_value()
        + unclosed_arm(A {})
        + missing_comma_same_line(nil)
        + continued_block_arm(nil)
}

struct Pair {
    first: Int,
    rest: Int,
}

// An arm's binding comes before the `=>`, and only names or destructures the value, so it can't
// be a literal or a type. A name, a pair or a list comes after `as`, which takes one binding.
export fn binding_errors(value: Pair | (Int, Int) | nil) -> Int {
    match value {
        Pair whole => whole.first,
        (Int, Int) as (0, rest) => rest,
        nil => 0,
    }
}

export fn binding_after_arrow(value: Pair | nil) -> Int {
    match value {
        Pair => { first, rest } first + rest,
        nil => 0,
    }
}

// A brace that doesn't start a binding is a block whose `=>` is missing
export fn missing_arrow_before_block(value: Pair | nil) -> Int {
    match value {
        Pair { 1 }
        nil => 0,
    }
}

export fn typed_binding(value: Pair | nil) -> Int {
    match value {
        Pair { first: List<Int>, rest: 2 } => first,
        nil => 0,
    }
}

// Without `as`, a pair or a list after the type isn't a binding, and `as` needs a binding after it
export fn missing_as(value: (Int, Int) | List<Int>) -> Int {
    match value {
        (Int, Int) (first, rest) => first + rest,
        nil as => 0,
        _ [first] => first,
    }
}

// An arm that's missing its `=>` and value doesn't take the type of the next arm for its binding,
// and neither does a block on the next line
export fn missing_arrow_and_value(value: Pair | (Int, Int) | nil) -> Int {
    match value {
        Pair
        nil => 0,
        _ => 1,
    }
}

export fn struct_binding_on_the_next_line(value: Pair | nil) -> Int {
    match value {
        Pair
        { first, rest } => first + rest,
        nil => 0,
    }
}

// A condition comes before the `=>`, so a block right after it is a missing `=>`, and so is the
// block of an `if` that was meant to be the arm's value
export fn condition_without_arrow(value: Int | nil) -> Int {
    match value {
        Int if value > 1 { 1 }
        _ => 0,
    }
}

export fn if_value_without_arrow(value: Int | nil) -> Int {
    match value {
        Int if value > 1 { 1 } else { 2 }
        _ => 0,
    }
}

export fn missing_condition(value: Int | nil) -> Int {
    match value {
        Int if => 1,
        _ => 0,
    }
}

// A struct initializer in a condition needs parentheses, like in the condition of an `if`
export fn struct_initializer_condition(value: Pair | nil) -> Int {
    match value {
        Pair if value == Pair { first: 1, rest: 2 } => 1,
        _ => 0,
    }
}

export fn unclosed_binding(value: Pair | nil) -> Int {
    match value {
        Pair { first, rest => first + rest,
        nil => 0,
    }
}
