// Headers of `for` expressions that aren't finished

fn main(xs: List<Int>, ys: List<Int>) -> Int {
    // A `,` after a list is followed by another one
    let a = for x in xs, { x };
    let a2 = for x in xs, {
        let doubled = x * 2;
        doubled
    };

    // The body can be followed by a name, which isn't the `in` after a struct binding
    let a3 = for x in xs, { x + 1 }
    length(a3);

    // A `,` after the item is followed by a name for what's left of the list
    let b = for x, in xs { x };

    // Only one name can follow the item
    let c = for x, rest, more in xs { x };

    // The lists are separated by `,`
    let d = for x in xs y in ys { x + y };

    // Each list has an item
    let e = for x in xs, in ys { x };

    length(a) + length(b) + length(c) + length(d) + length(e) + length(a2)
}
