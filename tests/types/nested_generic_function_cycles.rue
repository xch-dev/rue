// Generic functions nest their generics inside of recursive types here, so comparing these took
// exponential time until #362's step 13b.3 (#344), and gave up as too complex. They're compared in
// fixpoint mode now, which finishes. `Q1` is assignable to `Q2`, since they're both `N0`, so the
// guard is unnecessary. That wasn't found until #362's step 13g, since the union members that
// matched a value weren't monotone in their results (#360), so comparing had no least fixed point,
// and iterating kept a failure from an early round. Now a failed pair of bounds only rules out
// the union members it was collected under
type N0 = Bytes
    | (((1, Bytes32), N0 | N1<2, Bytes32>))
    | (((N1<Bytes32, Bytes>, N1<1, nil>), N2 | N1<Bytes32, Bytes>));

type N1<A, B> = fn(
    p0: N1<A, B> | (Bytes32 | A) | B,
    p1: fn<U10, U11>(p0: fn<U20>(p0: U20, p1: N0) -> 1, p1: (Bytes, Bytes32), p2: U11) -> U10,
    p2: N2,
) -> B;

type N2 = (
    (fn<U30, U31>(p0: N1<Bytes, 2>, p1: U30, p2: N1<1, U30>) -> U30)
        | (N2 | N1<nil, Bytes> | N0)
        | N1<Bytes, 1>,
    (Bytes32, N2),
);

type Q1 = N0;
type Q2 = N0;

fn main(x: Q1, y: N2) -> Int {
    // Assigning, which compares the types
    let _z: N0 = y;

    // Checking at runtime, which compares the types to work out what needs to be checked
    if x is Q2 {
        1
    } else {
        0
    }
}
