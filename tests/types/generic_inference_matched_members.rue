struct Box<T> {
    value: T,
}

fn first<T>(value: T | (T, Int) | nil) -> T {
    unchecked_cast(value)
}

fn increment(value: Int) -> Int {
    value + 1
}

// The function matches the `T` member, so what comparing its runtime structure with `(T, Int)`
// gives `T` is left out (#364)
test fn function_matches_the_generic_member() -> Int {
    let function = first(increment);
    function(1)
}

fn unbox<T>(value: Box<T> | (T, T)) -> T {
    unchecked_cast(value)
}

// `Box<5>` matches `Box<T>`, and only casts to `(T, T)` as the pair `(5 . nil)`, so the `nil` that
// member gives `T` is left out, and the expected type keeps `T` as `5` (#364)
test fn struct_matches_its_own_member() -> Int {
    let value: Box<5> = Box::<5> { value: 5 };
    let result: 5 = unbox(value);
    result
}

fn either<A>(value: A) -> (A, Int) | (Int, A) {
    (value, 1)
}

// `(A, Int)` matches `(T, Int)`, so the bound `A ≤ Int` from `(Int, T)`, which doesn't match, isn't
// checked against `T ≤ A` (#360)
test fn generic_function_with_a_union_return_is_assignable_to_itself() -> Int {
    let function: fn<T>(value: T) -> (T, Int) | (Int, T) = either;
    function(1).first
}

fn unwrap<A>(value: A | nil) -> A {
    unchecked_cast(value)
}

// `nil` is held by the `nil` member without bounding `A`, so the bound `A ≥ nil` from the `A`
// member isn't checked against the return type's `A ≤ Int` (#360)
test fn generic_function_with_a_union_parameter_is_assignable() -> Int {
    let function: fn(a: Int | nil) -> Int = unwrap;
    function(1)
}

fn ident<A>(x: A) -> (A, Int) {
    (x, 1)
}

fn pick<U>(f: fn(x: Int) -> (Int, Int) | (U, Bytes)) -> fn(x: Int) -> (Int, Int) | (U, Bytes) {
    f
}

// Guard: `U`'s only candidate, `Int`, comes from the `(U, Bytes)` member, which doesn't match, so
// it's kept, since a generic whose candidates all come from members that didn't match keeps them
test fn candidate_only_from_a_member_that_doesnt_match() -> Int {
    let function = pick(ident);
    function(5).first
}

fn apply<U>(f: fn(a: Int | nil) -> U) -> U {
    f(1)
}

// The same when it's passed: `U` is inferred from `A`'s instantiation and the bounds checked for
// it, which leave out `A ≥ nil`, so it's `Int` rather than `Int | nil`
test fn generic_function_with_a_union_parameter_is_inferred_through() -> Int {
    let value: Int = apply(unwrap);
    value + 1
}

type Same = fn<U>(u: U) -> U;
type Other = fn<V>(v: V) -> V;

fn take_after<T>(_a: Same, b: T | Same) -> T {
    unchecked_cast(b)
}

fn take_before<T>(b: T | Same, _a: Same) -> T {
    unchecked_cast(b)
}

// Whether the `Same` member collects bounds doesn't depend on whether comparing `Other` with it was
// reused from the memo, so both orders are assignable
test fn member_bounds_dont_depend_on_the_memo() -> Int {
    let _after: fn(a: Other, b: Other) -> Int = take_after;
    let _before: fn(b: Other, a: Other) -> Int = take_before;
    1
}

type Recursive = fn<A>(x: A) -> (A, Recursive);
type Rest = (Int, Again) | (Bytes, nil);
type Again = fn(x: Int) -> Rest;

// Comparing `(A, Recursive)` with `Rest` gives `A ≤ Int` from the member that matches, and
// `A ≤ Bytes` from the one that doesn't. The inner `Recursive` revisits that comparison with its
// own `A`, which gets both bounds from its summary, but the one from the member that didn't match
// doesn't decide whether it holds there either (#362's step 13b.1)
test fn bounds_from_unmatched_members_dont_decide_revisits() -> Int {
    let function: Recursive = unchecked_cast(nil);
    let _inline: fn(x: Int) -> Rest = function;
    1
}

type Nested = (Nested, nil);
type Either<U> = U | (Either<U>, nil);

fn either_of<U>(value: Either<U>) -> U {
    unchecked_cast(value)
}

// Comparing `(Nested, nil)` with `Either<U>` holds the pair with the pair member, by revisiting the
// same comparison. The only bound the revisit puts on `U` is one that didn't match, so the pair
// member holds the value whatever `U` is, the `U` member's `U ≥ Nested` isn't needed, and `U` is
// `Int` (#362's step 13b.1)
test fn unmatched_bounds_from_revisits_dont_bound() -> Int {
    let _f: fn(value: Nested) -> Int = either_of;
    1
}

fn pick_nested<A>(value: (A | Bytes32, nil) | (Int, A)) -> A {
    unchecked_cast(value)
}

// Both members hold `(Int, nil)`: the first with `A ≥ Int`, through the union nested in it, and
// the second with `A ≥ nil`. With `A ≤ Int` from the return type, the second member's bounds
// don't hold, which only rules it out: the first still holds, so `A` is `Int` (#362's step 13g).
// Every member that matched used to have to hold, which rejected this
test fn nested_member_bounds() -> Int {
    let _f: fn(value: (Int, nil)) -> Int = pick_nested;
    1
}

fn make<T>() -> fn(x: T) -> T {
    unchecked_cast(nil)
}

type Increment = fn(x: Int) -> Int;
type Discard = fn(x: Int) -> nil;

// `make`'s function matches both members of the union with `T` as `Int`, and `Discard`'s
// `T ≤ nil` conflicts with `T ≥ Int`, which only rules `Discard` out, so `Increment` holds (#362's
// step 13g). This used to be rejected, though `fn() -> Increment` alone is accepted
test fn either_function_member() -> Int {
    let _either: fn() -> Increment | Discard = make;
    1
}

type PairsToInt = fn(x: (Int, Int)) -> Int | (Int, Int);
type PairsToNil = fn(x: (Int, Int)) -> nil;

// The same with a union in the first member's return type, which `T` can be either member of
test fn either_function_member_with_a_union() -> Int {
    let _either: fn() -> PairsToInt | PairsToNil = make;
    1
}

fn duplicate<T>(value: T) -> (T, T) {
    (value, value)
}

// `T ≥ Int` from the parameter, and both members of the return type's union match `(T, T)`: the
// first with `T ≤ Int` and the second with `T ≤ Bytes32`. Only the second member's bounds conflict,
// which rules it out, and the first holds with `T` as `Int` (#362's step 13g)
test fn duplicate_into_either_pair() -> Int {
    let function: fn(value: Int) -> (Int, Int) | (Bytes32, Bytes32) = duplicate;
    let _pair = function(1);
    1
}

type Pairs = fn<U>(x: U) -> (U, U);
type GivenPairs<B> = fn(g: Pairs) -> B;
type PairsOfInts = fn<T>(g: fn(x: Int) -> T) -> (T, T);

fn call_given<B>(f: GivenPairs<B> | nil) -> B {
    unchecked_cast(f)
}

// `PairsOfInts` matches the first member of `GivenPairs<B> | nil`, under which `B ≥ (T', T')` and
// `T' ≥ (U', U')`. `T'` gets `T' ≤ (Int, Int)` when the bounds are checked, and checking it again
// fails `(U', U') ≤ (Int, Int)` while `U'` is rigid, which only rules out that member. It's still
// checked again with `U'` open, as a pair that fails outside of a union is, so `U'` is `Int` and
// the member holds (#362's step 13g)
test fn instances_reopened_under_a_union_member() -> Int {
    let _call: fn(f: PairsOfInts) -> ((Int, Int), (Int, Int)) = call_given;
    1
}

fn first_of<T>(value: T | (T, T)) -> T {
    unchecked_cast(value)
}

// Both members of `T | (T, T)` match `(5, 5)`, but the `(T, T)` member's `T ≥ 5` is implied by the
// `T ≥ 5` that `5` gives, so the `T` member's `T ≥ (5, 5)` isn't needed, and `T` is `5` (#362's
// step 13h). Both members' candidates used to be kept, which made `T` `Int | (5, 5)`
test fn both_members_match() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = first_of(value);
    result + 0
}

fn as_function<T>(value: T | (T, T)) -> fn(x: T) -> nil {
    unchecked_cast(value)
}

// What `T` is without leaving out any member's candidates, `Int | (5, 5)`, makes the result a
// `fn(x: (5, 5)) -> nil`, so it's what the call is solved with. Leaving out `T ≥ (5, 5)` would
// make `T` `5`, and the result couldn't take a `(5, 5)`
test fn returns_function_of_both() -> Int {
    let value: 5 | (5, 5) = 5;
    let _call: fn(x: (5, 5)) -> nil = as_function(value);
    1
}

fn apply_to_member<T>(value: T | (T, T), f: fn(x: T) -> Int) -> Int {
    f(unchecked_cast(value))
}

// The call has no expected type to narrow `T` for, so the lambda's `x` keeps the `(5, 5)` that
// the `T` member gives, and checking it for a pair isn't redundant
test fn lambda_takes_both() -> Int {
    let value: 5 | (5, 5) = (5, 5);
    apply_to_member(
        value,
        fn(x) => if x is (Int, Int) {
            x.first
        } else {
            x
        },
    )
}

fn first_of_three<T>(value: T | (T, T) | (T, (T, T))) -> T {
    unchecked_cast(value)
}

fn first_of_three_reversed<T>(value: (T, (T, T)) | (T, T) | T) -> T {
    unchecked_cast(value)
}

// Each union is decided from the candidates no union leaves out, here the `T ≥ 5` that `5` gives,
// so the order of the members doesn't matter. `(5, (5, 5))` matches all three members, and only
// `(T, (T, T))`'s are all implied. When the unions were decided one after another, the first
// order made `T` `Int | (5, 5)`
test fn three_members_match() -> Int {
    let value: 5 | (5, 5) | (5, (5, 5)) = 5;
    let result: 5 = first_of_three(value);
    result + 0
}

test fn three_members_match_reversed() -> Int {
    let value: 5 | (5, 5) | (5, (5, 5)) = 5;
    let result: 5 = first_of_three_reversed(value);
    result + 0
}

// `T ≥ 5` is implied by the wider `T ≥ Int` from outside of the union, so the `T` member's
// `T ≥ (5, 5)` is left out and `T` is `Int`
test fn lower_candidate_implied_by_a_wider_one() -> Int {
    let value: Int | (5, 5) = 5;
    let result: Int = first_of(value);
    result + 0
}

fn held_first<T>(value: T | (T, T | Int)) -> T {
    unchecked_cast(value)
}

// The `(T, T | Int)` member's second `5` is held by `Int`, which doesn't constrain `T`, so the
// member is still implied and the `T` member's `T ≥ (5, 5)` is left out
test fn held_candidates_count_as_implied() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = held_first(value);
    result + 0
}

fn nested_first<T>(value: (T | nil, nil) | ((T, T), nil)) -> T {
    unchecked_cast(value)
}

// The `T ≥ (5, 5)` that's left out is collected under a union nested in the member left out
test fn nested_union_in_a_left_out_member() -> Int {
    let value: (5, nil) | ((5, 5), nil) = (5, nil);
    let result: 5 = nested_first(value);
    result + 0
}

fn first_of_both<T>(a: T | (T, T), b: T | (T, T)) -> T {
    unchecked_cast(a)
}

// Neither union's candidates count as holding anyway for the other, so each is decided from the
// `T ≥ 5`s that the two `5`s give. When they counted, each union's `T` member was implied by the
// other's, and `T` was `Int | (5, 5)`
test fn same_union_twice() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = first_of_both(value, value);
    result + 0
}

fn as_curried<T>(value: T | (T, T)) -> fn() -> fn(x: T) -> nil {
    unchecked_cast(value)
}

// The same as `returns_function_of_both`, through a function that the result returns
test fn returns_curried_function_of_both() -> Int {
    let value: 5 | (5, 5) = 5;
    let _call: fn() -> fn(x: (5, 5)) -> nil = as_curried(value);
    1
}

fn takes_into<U>(value: U) -> fn(y: U) -> nil {
    unchecked_cast(value)
}

fn apply_into<U>(value: U, f: fn(y: U) -> Int) -> Int {
    f(value)
}

// Without an expected type, `T` is what it always was, `Int | (5, 5)`, so the guard on the result
// can be a pair. A `T` of `5` would make it redundant, which is an error
test fn guard_on_the_result() -> Int {
    let value: 5 | (5, 5) = 5;
    let result = first_of(value);
    if result is (Int, Int) {
        return result.first;
    }
    1
}

// The same for a result that flows into a function type's parameter later
test fn result_flows_into_a_parameter() -> Int {
    let value: 5 | (5, 5) = 5;
    let result = first_of(value);
    let call = takes_into(result);
    let _call: fn(y: (5, 5)) -> nil = call;
    1
}

// A call in an argument of another call takes that call's generic as its expected type, which
// gives `T` no bound, so it's what it always was, and `U` takes the `(5, 5)` the outer expected
// type needs
test fn nested_call_into_a_parameter() -> Int {
    let value: 5 | (5, 5) = 5;
    let _call: fn(y: (5, 5)) -> nil = takes_into(first_of(value));
    1
}

// The same through a lambda's parameter, whose guard isn't redundant
test fn nested_call_into_a_lambda() -> Int {
    let value: 5 | (5, 5) = (5, 5);
    apply_into(
        first_of(value),
        fn(y) => if y is (Int, Int) {
            y.first
        } else {
            y
        },
    )
}

fn keep_both<U>(a: U, b: U) -> U {
    unchecked_cast((a, b))
}

// `first_of(value)` is an argument whose parameter type is the enclosing call's `U`, which the `5`
// before it has inferred as `5` so far. That's only a hint, which `U` can still widen past, so
// `T` isn't narrowed for it and stays `Int | (5, 5)`, and the guard on the result can be a pair.
// Narrowing for the hint would make `T` and `U` `5`, and the guard redundant, which is an error
test fn hint_from_an_enclosing_call() -> Int {
    let value: 5 | (5, 5) = 5;
    let result = keep_both(5, first_of(value));
    if result is (Int, Int) {
        return result.first;
    }
    1
}

fn first_and_paired<T>(value: T | (T, T)) -> (T, (T, nil)) {
    unchecked_cast(value)
}

// Only the expected type's `T ≤ 5` from the first element, outside of any union member, has to
// hold, which `Int | (5, 5)` breaks and `5` satisfies, so `T` is narrowed to `5`, and the second
// element is held by the `(5, nil)` member. The `T ≤ 4` from the `(4, nil)` member is only one
// alternative, so it doesn't keep `T` from being narrowed
test fn narrowed_for_a_bound_outside_of_a_union() -> Int {
    let value: 5 | (5, 5) = 5;
    let _result: (5, (4, nil) | (5, nil)) = first_and_paired(value);
    1
}

fn apply_after<U>(_start: U, value: U, f: fn(y: U) -> Int) -> Int {
    f(value)
}

fn apply_thunk<U>(_start: U, value: fn() -> U, f: fn(y: U) -> Int) -> Int {
    f(value())
}

fn apply_pair<U>(_start: U, value: (U, Int), f: fn(y: U) -> Int) -> Int {
    f(value.first)
}

// `first_of(value)` has to be assignable to `U`, which is `Int` so far, but it's checked against
// what `U` is finally inferred as, which its own value widens. So `T` isn't narrowed for it, `U`
// is `Int | (5, 5)`, and the lambda's guard isn't redundant
test fn provisional_expected_type() -> Int {
    let value: 5 | (5, 5) = (5, 5);
    apply_after(
        5,
        first_of(value),
        fn(y) => if y is (Int, Int) {
            y.first
        } else {
            y
        },
    )
}

// The same through a lambda's body
test fn provisional_expected_type_of_a_lambda_body() -> Int {
    let value: 5 | (5, 5) = (5, 5);
    apply_thunk(
        5,
        fn() => first_of(value),
        fn(y) => if y is (Int, Int) {
            y.first
        } else {
            y
        },
    )
}

// The same through a pair's element
test fn provisional_expected_type_of_a_pair_element() -> Int {
    let value: 5 | (5, 5) = (5, 5);
    apply_pair(
        5,
        (first_of(value), 1),
        fn(y) => if y is (Int, Int) {
            y.first
        } else {
            y
        },
    )
}

fn keep_first<U>(a: U, _b: U) -> U {
    a
}

fn thunk_after<U>(_start: U, value: fn() -> U) -> U {
    value()
}

fn only_five(value: 5) -> 5 {
    value
}

// A `let` annotation is a type of its own, which the value is checked against as it is, so a call
// in it is narrowed for it even in a lambda body whose expected type is provisional
test fn let_annotation_in_a_provisional_lambda_body() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: Int = thunk_after(
        5,
        fn() => {
            let inner: 5 = first_of(value);
            inner + 0
        },
    );
    result + 0
}

// The same for a lambda's return type
test fn return_type_of_a_lambda_with_a_provisional_type() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: Int = thunk_after(5, fn(): 5 => first_of(value));
    result + 0
}

// The same for the argument of a parameter that doesn't reference its call's generics, though that
// call is in an argument whose expected type is provisional
test fn argument_of_a_concrete_parameter_in_a_provisional_argument() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: Int = keep_first(5, only_five(first_of(value)));
    result + 0
}

struct Five {
    value: 5,
}

// The same for a struct's field, which its value is checked against as it is
test fn field_in_a_provisional_argument() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: Five = keep_both(Five { value: 5 }, Five { value: first_of(value) });
    result.value + 0
}

fn identity<T>(value: T) -> T {
    value
}

// `identity`'s `T ≤ 5`, from the `let` annotation, is outside of any union member, so `T` is at
// most `5` however `identity` is solved, and its argument has to be a `5`. That's what
// `first_of(value)` is required to be, though its expected type is provisional, so it's narrowed
// for it when `Int | (5, 5)` isn't one, and `T` is `5`
test fn nested_call_narrowed_for_a_requirement() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = identity(first_of(value));
    result + 0
}

// The same through two calls
test fn nested_call_narrowed_through_two_calls() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = identity(identity(first_of(value)));
    result + 0
}

// The same for an argument after another one: `keep_both`'s `U ≤ 5` makes `first_of(value)`
// required to be a `5`, whatever the `5` before it infers `U` as so far
test fn nested_call_narrowed_after_another_argument() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = keep_both(5, first_of(value));
    result + 0
}

fn wrap<T>(value: T | (T, T)) -> (T, nil) {
    unchecked_cast(value)
}

// `(Int | (5, 5), nil)` isn't a `(5, nil) | Bytes`, so the call doesn't solve and `T` is
// narrowed. `(5, nil)` is, so that's what it's solved with, though `T ≤ 5` is only under the
// expected type's `(5, nil)` member
test fn narrowed_for_a_member_of_the_expected_type() -> Int {
    let value: 5 | (5, 5) = 5;
    let _result: (5, nil) | Bytes = wrap(value);
    1
}
