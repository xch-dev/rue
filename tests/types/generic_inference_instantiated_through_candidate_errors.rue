fn both<B, C>(f: fn(x: Int) -> (B, C)) -> (B, C) {
    f(1)
}

// The generic function's `T` is instantiated once for all of `B` and `C`'s bounds, along with its
// own `T ≥ Int`, so it can't be `Int` for `B` and `Bytes32` for `C` (#363)
fn instantiated_once() -> Int {
    let _instantiated: fn(a: fn<T>(x: T) -> (T, T)) -> (Int, Bytes32) = both;
    1
}

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn call_with_int<B>(function: fn(x: Int) -> B) -> B {
    function(1)
}

fn pairs_of<T>(x: T) -> (T, T) {
    (x, x)
}

// `pairs_of`'s `T` is `Int`, from its parameter, so it can't give `Bytes32` as well
fn not_both() -> Int {
    let result: (Int, Bytes32) = map(call_with_int, pairs_of);
    result.first
}

type Pairs = fn<T>(x: (T, T)) -> (T, T);
type FromPairs = fn(f: Pairs) -> (Int, Int);
type Deferred = fn<Y>(y: Y) -> fn<B>(f: fn(x: Y) -> B) -> B;

fn deferred<Y>(y: Y) -> fn<B>(f: fn(x: Y) -> B) -> B {
    unchecked_cast(y)
}

// `Pairs`' `T` is `Int` for the first element, from `FromPairs`' return type, so the second
// element's `T ≥ (Int, Int)` conflicts, even though its comparison is reused from the first's
fn bound_kept_when_reused() -> Int {
    let deferred_pair: (Deferred, Deferred) = (deferred, deferred);
    let _pair: (
        fn(y: (Int, Int)) -> FromPairs,
        fn(y: ((Int, Int), (Int, Int))) -> FromPairs,
    ) = deferred_pair;
    1
}

type Duplicate = fn<U>(x: U) -> (U, U);
type CallsBack = fn<T>(callback: fn(x: Int) -> T) -> (T, T);

fn call_duplicate<B>(function: fn(callback: Duplicate) -> B) -> B {
    function(unchecked_cast(nil))
}

// `Duplicate`'s `U` is at least `Int`, from `CallsBack`' callback, so it can't also be `Bytes32`,
// although it's instantiated two levels in
fn not_both_two_levels_in() -> Int {
    let _instantiated: fn(function: CallsBack) -> ((Int, Bytes32), (Int, Bytes32)) = call_duplicate;
    1
}

type Identity = fn<V>(v: V) -> V;
type GivesPair = fn<U>(h: fn(v: U) -> (Int, Int), k: U) -> Int;
type TakesInt = fn<T>(g: fn(h: T, k: Int) -> Int, b: T) -> Int;

fn call_back<B>(f: fn(g: GivesPair, b: B) -> Int, w: B) -> Int {
    f(unchecked_cast(nil), w)
}

// `Identity`'s `V` would have to be both at least `Int` and at most `(Int, Int)`: it's made while
// `TakesInt`' `T` is checked again, and stays rigid while `GivesPair`' `U` is checked after it
fn not_instantiated_after_its_check() -> Int {
    let _instantiated: fn(f: TakesInt, w: Identity) -> Int = call_back;
    1
}
