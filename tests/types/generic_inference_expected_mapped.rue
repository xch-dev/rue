fn identity<U>(value: U) -> U {
    value
}

fn either<T>(first: T, second: T) -> T {
    first
}

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn cycle<A, B>(forward: fn(a: A) -> B, _backward: fn(b: B) -> A, value: A) -> B {
    forward(value)
}

// `T` is mapped from the first `5`, and the type expected of the call keeps it `5` for the nested
// call, rather than `5` widened to `Int` (#353)
test fn nested_call_after_a_mapped_generic() -> Int {
    let value: 5 = either(5, either(5, 5));
    value
}

// `A` is only mapped to `B` in the cycle, and the expected type reaches it through `B` (#336)
test fn nested_call_into_a_cycle() -> Int {
    let direct: 5 = cycle(identity, identity, 5);
    let nested: 5 = cycle(identity, identity, map(identity, 5));
    direct + nested
}

fn apply<A>(value: A, function: fn(a: A) -> Int) -> A {
    let _ = function(value);
    value
}

fn only_five(value: 5) -> Int {
    value
}

// Nothing can add to `A` once `5` is compiled, and the lambda's return type doesn't reference it,
// so its parameter takes the expected bound: `x: 5`
test fn lambda_parameter_takes_the_expected_bound() -> Int {
    let value: 5 = apply(5, fn(x) => only_five(x));
    value
}

fn three<T>(first: T, function: fn(x: T) -> Int, last: T) -> T {
    let _ = function(first);
    last
}

// Guard: the lambda waits for the `6` after it, so its parameter is `5 | 6`, which the call's
// `fn(x: 5 | 6)` can take, rather than `5`
test fn lambda_before_a_later_value_keeps_it_wide() -> Int {
    let value: 5 | 6 = three(5, fn(x) => 1, 6);
    value
}

// Guard: a lambda inside another argument never takes the expected bounds, since that argument
// isn't ordered as a lambda
test fn lambda_inside_another_argument_keeps_it_wide() -> Int {
    let block: 5 | 6 = three(5, { fn(x) => 1 }, 6);
    block + lambda_in_branches_keeps_it_wide(true)
}

fn lambda_in_branches_keeps_it_wide(condition: Bool) -> Int {
    let value: 5 | 6 = three(
        5,
        if condition {
            fn(x) => 1
        } else {
            fn(x) => 2
        },
        6,
    );
    value
}

fn three_in_a_pair<T>(first: T, pair: (T, fn(x: T) -> Int), last: T) -> T {
    let _ = pair.rest(pair.first);
    last
}

// Guard: the same for a lambda in a pair
test fn lambda_in_a_pair_keeps_it_wide() -> Int {
    let value: 5 | 6 = three_in_a_pair(5, (5, fn(x) => 1), 6);
    value
}

fn generic_last<T>(first: T, function: fn(x: T) -> Int, last: fn(y: Int) -> T) -> T {
    let _ = function(first);
    last(1)
}

// Guard: a generic lambda doesn't hold up the others, but it still adds `6` to `T`, so the first
// lambda's parameter keeps what the arguments infer
test fn lambda_before_a_generic_lambda_keeps_it_wide() -> Int {
    let value: 5 | 6 = generic_last(5, fn(x) => 1, fn<V>(_y: V) => 6);
    value
}

fn same<T>(function: fn(a: T) -> T, produce: fn() -> T) -> T {
    function(produce())
}

// Guard: the first lambda's return type references `T`, so it can still add to it, and its
// parameter keeps what the arguments infer, `Int`. With the expected bound, `x2` would be `7`, and
// the `5` it returns would make `T` `7 | 5`, which `fn(x2: 7)` can't take
test fn lambda_that_adds_to_its_parameter_type_keeps_it_wide() -> 5 | 7 {
    same(fn(x2) => 5, fn() => 7)
}

fn map_reversed<A, B>(value: A, function: fn(a: A) -> B) -> B {
    function(value)
}

// A call with a lambda only in its own arguments takes the expected bounds as a call without one
// does, since its lambda is compiled against its own generics. So `T` is `7` for it, rather than
// `7` widened to `Int`, and its `B` stays `7`, as with `map_reversed::<5, 7>`
test fn nested_call_with_a_lambda_takes_the_expected_bound() -> Int {
    let value: 7 = either(7, map_reversed(5, fn(x) => 7));
    let deeper: 7 = either(7, either(map_reversed(5, fn(x) => 7), 7));
    value + deeper
}
