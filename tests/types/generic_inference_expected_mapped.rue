fn identity<U>(value: U) -> U {
    value
}

fn either<T>(first: T, second: T) -> T {
    first
}

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn cycle<A, B>(forward: fn(a: A) -> B, _backward: fn(b: B) -> A, value: A) -> B {
    forward(value)
}

// `T` is mapped from the first `5`, and the type expected of the call keeps it `5` for the nested
// call, rather than `5` widened to `Int` (#353)
test fn nested_call_after_a_mapped_generic() -> Int {
    let value: 5 = either(5, either(5, 5));
    value
}

// `A` is only mapped to `B` in the cycle, and the expected type reaches it through `B` (#336)
test fn nested_call_into_a_cycle() -> Int {
    let direct: 5 = cycle(identity, identity, 5);
    let nested: 5 = cycle(identity, identity, map(identity, 5));
    direct + nested
}

fn apply<A>(value: A, function: fn(a: A) -> Int) -> A {
    let _ = function(value);
    value
}

fn only_five(value: 5) -> Int {
    value
}

// Nothing can add to `A` once `5` is compiled, and the lambda's return type doesn't reference it,
// so its parameter takes the expected bound: `x: 5`
test fn lambda_parameter_takes_the_expected_bound() -> Int {
    let value: 5 = apply(5, fn(x) => only_five(x));
    value
}

fn three<T>(first: T, function: fn(x: T) -> Int, last: T) -> T {
    let _ = function(first);
    last
}

// Guard: the lambda waits for the `6` after it, so its parameter is `5 | 6`, which the call's
// `fn(x: 5 | 6)` can take, rather than `5`
test fn lambda_before_a_later_value_keeps_it_wide() -> Int {
    let value: 5 | 6 = three(5, fn(x) => 1, 6);
    value
}

// Guard: a lambda inside another argument never takes the expected bounds, since that argument
// isn't ordered as a lambda
test fn lambda_inside_another_argument_keeps_it_wide() -> Int {
    let block: 5 | 6 = three(5, { fn(x) => 1 }, 6);
    block + lambda_in_branches_keeps_it_wide(true)
}

fn lambda_in_branches_keeps_it_wide(condition: Bool) -> Int {
    let value: 5 | 6 = three(
        5,
        if condition {
            fn(x) => 1
        } else {
            fn(x) => 2
        },
        6,
    );
    value
}

fn three_in_a_pair<T>(first: T, pair: (T, fn(x: T) -> Int), last: T) -> T {
    let _ = pair.rest(pair.first);
    last
}

// Guard: the same for a lambda in a pair
test fn lambda_in_a_pair_keeps_it_wide() -> Int {
    let value: 5 | 6 = three_in_a_pair(5, (5, fn(x) => 1), 6);
    value
}

fn generic_last<T>(first: T, function: fn(x: T) -> Int, last: fn(y: Int) -> T) -> T {
    let _ = function(first);
    last(1)
}

// Guard: a generic lambda doesn't hold up the others, but it still adds `6` to `T`, so the first
// lambda's parameter keeps what the arguments infer
test fn lambda_before_a_generic_lambda_keeps_it_wide() -> Int {
    let value: 5 | 6 = generic_last(5, fn(x) => 1, fn<V>(_y: V) => 6);
    value
}

fn same<T>(function: fn(a: T) -> T, produce: fn() -> T) -> T {
    function(produce())
}

// Guard: the first lambda's return type references `T`, so it can still add to it, and its
// parameter keeps what the arguments infer, `Int`. With the expected bound, `x2` would be `7`, and
// the `5` it returns would make `T` `7 | 5`, which `fn(x2: 7)` can't take
test fn lambda_that_adds_to_its_parameter_type_keeps_it_wide() -> 5 | 7 {
    same(fn(x2) => 5, fn() => 7)
}

fn map_reversed<A, B>(value: A, function: fn(a: A) -> B) -> B {
    function(value)
}

// A call with a lambda only in its own arguments takes the expected bounds as a call without one
// does, since its lambda is compiled against its own generics. So `T` is `7` for it, rather than
// `7` widened to `Int`, and its `B` stays `7`, as with `map_reversed::<5, 7>`
test fn nested_call_with_a_lambda_takes_the_expected_bound() -> Int {
    let value: 7 = either(7, map_reversed(5, fn(x) => 7));
    let deeper: 7 = either(7, either(map_reversed(5, fn(x) => 7), 7));
    value + deeper
}

fn pass<U>(value: U) -> U {
    value
}

// Guard: a call can pass its lambda through, so it only takes the expected bounds once nothing
// later can add to them. Here `6` can, so the lambda keeps what the arguments infer, as a lambda
// directly in the argument does. With `T` as `5`, it would be `fn(x: 5) -> 1`, which isn't a
// `fn(x: 5 | 6) -> Int`
test fn lambda_through_a_nested_call_before_a_later_value_keeps_it_wide() -> Int {
    let value: 5 | 6 = three(5, pass(fn(x) => 1), 6);
    let deeper: 5 | 6 = three(5, pass(pass(fn(x) => 1)), 6);
    let block: 5 | 6 = three(5, { pass(fn(x) => 1) }, 6);
    value + deeper + block
}

fn constant<T>(value: T) -> fn() -> T {
    fn() => value
}

// A call with arguments and no lambda takes the expected type's own bound, `7 | 8`, rather than
// the `7` the first argument narrows `T` to, since its own argument then adds `8`, as with
// `either::<7 | 8>`
test fn nested_call_takes_the_expected_types_own_bound() -> Int {
    let value: 7 | 8 = either(7, identity(8));
    let deeper: 7 | 8 = either(7, identity(identity(8)));
    let both: 7 | 8 = either(identity(7), identity(8));
    let function: fn() -> 7 | 8 = either(constant(7), constant(8));
    value + deeper + both + function()
}

fn later<T>(value: T, other: T, function: fn(x: T) -> Int) -> T {
    let _ = function(value);
    other
}

fn make<T>() -> T {
    unchecked_cast(5)
}

fn tail<T>(first: T, function: fn(x: T) -> Int) -> T {
    let _ = function(first);
    first
}

// Guards: a call's generic that only its expected type constrains keeps the narrower `5`, whether
// the call has no arguments, has one without any inside it, has arguments that don't constrain it
// (`nothing(1)`, `default_or(nil)`, `head([])`) or only bounds it from above (`sink(…)`), and so
// does a lambda that a call passes through. A block isn't widened at all, only a call is. Either
// way, `x` is `5`, as on main, which the unnecessary guards show
test fn narrower_mapping_kept_without_arguments_or_with_a_lambda() -> Int {
    let made: 5 | 6 = later(
        5,
        make(),
        fn(x) => if x is 5 {
            1
        } else {
            2
        },
    );
    let passed: 5 | 6 = tail(
        5,
        pass(
            fn(x) => if x is 5 {
                1
            } else {
                2
            },
        ),
    );
    let inside: 5 | 6 = later(
        5,
        identity(make()),
        fn(x) => if x is 5 {
            1
        } else {
            2
        },
    );
    let unbound: 5 | 6 = later(5, nothing(1), fn(x) => only_five(x));
    let held: 5 | 6 = later(5, default_or(nil), fn(x) => only_five(x));
    let empty: 5 | 6 = later(
        5,
        head([]),
        fn(x) => if x is 5 {
            1
        } else {
            2
        },
    );
    let block: 5 | 6 = later(
        5,
        { head([]) },
        fn(x) => if x is 5 {
            1
        } else {
            2
        },
    );
    let sunk: 5 | 6 = later(5, sink(takes_five_or_six), only_five);
    made + passed + inside + unbound + held + empty + block + sunk
}

type Tree<T> = nil | (T, (Tree<T>, Tree<T>));

fn twice<A>(function: fn(a: A) -> A) -> fn(a: A) -> A {
    fn(a: A) => function(function(a))
}

fn grow<A>(build: fn(a: fn(a: A) -> A) -> Tree<A>, step: fn(a: A) -> A, depth: Int) -> A | nil {
    if depth > 0 {
        // Guard: the renamed `A` is fixed by `build`, which holds it in a parameter type too, so
        // `twice(identity)` keeps `A` rather than the return type's `A | nil`, which `build` isn't
        // (infer-fuzz generator 2, seed 875)
        return grow(build, twice(identity), depth - 1);
    }

    let _tree = build(step);
    nil
}

test fn generic_bounded_from_above_keeps_its_mapping() -> Int {
    let result = grow(fn(_step: fn(a: Int) -> Int) => nil, fn(a: Int) => a, 1);
    if result is nil {
        0
    } else {
        result
    }
}

fn nothing<A>(value: Int) -> A {
    unchecked_cast(value)
}

fn default_or<A>(value: A | nil) -> A {
    unchecked_cast(value)
}

fn head<T>(list: List<T>) -> T {
    unchecked_cast(list)
}

fn pair<A, B>(first: A, rest: B) -> (A, B) {
    (first, rest)
}

fn wrap<A>(value: A) -> (A, Int) {
    (value, 1)
}

fn listy<A>(value: A) -> List<A> {
    [value]
}

// Guards: a widened call's generic whose own arguments fit the narrower type keeps it, so
// `pair(5, 5)` is a `(5, 5)` here, not a `(5 | Int, 5 | Int)` under the expected type's own
// `(Int, Int)`, and `x.first` is `5`, as on main. Only a generic whose arguments don't fit it, such
// as `id(8)`'s where `T` is narrowed to `7`, takes the wider bound
test fn widened_call_keeps_what_fits_the_narrower_type() -> Int {
    let paired: (Int, Int) = later((5, 5), pair(5, 5), fn(x) => only_five(x.first));
    let wrapped: (Int, Int) = later((5, 5), wrap(5), fn(x) => only_five(x.first));
    let _listed: List<Int> = later(
        [5],
        listy(5),
        fn(x) => if x is List<5> {
            1
        } else {
            2
        },
    );
    paired.first + wrapped.first
}

test fn widened_pair_takes_a_value_the_narrower_type_doesnt_hold() -> Int {
    let value: (5 | 6, Int) = later((5, 1), pair(6, 2), fn(_x) => 1);
    value.first
}

fn sink<T>(_function: fn(x: T) -> Int) -> T {
    unchecked_cast(5)
}

fn takes_five_or_six(value: 5 | 6) -> Int {
    value
}
