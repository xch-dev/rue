fn first<T>(value: T | (T, T)) -> T {
    unchecked_cast(value)
}

// Both members match `(5, 5)`, so both of their candidates are kept, and `T` is `Int | (5, 5)`.
// Picking one would mean backtracking (#362, §5, question 2)
fn both_members_match() -> Int {
    let value: 5 | (5, 5) = 5;
    let result: 5 = first(value);
    result
}

type Recursive = fn<A>(x: A) -> (A, Recursive);
type Rest = (Int, Revisited | Other);
type Inline = fn(x: Int) -> Rest;
type Revisited = fn(x: Int) -> Rest;
type Other = fn(x: Bytes) -> Rest;

// Whether the target is written as the alias that's revisited doesn't change the result. Both
// are accepted since #362's step 13b.1, which instantiates each occurrence of a generic function
// on its own: the `Recursive` that `function` returns is assignable to `Revisited` whatever the
// outer `A` is. They were rejected before, when revisiting the return type merged the inner `A`,
// with its `A ≥ Bytes` from `Other`, into the outer one
fn assign_through_the_revisited_alias(function: Recursive) -> Int {
    let _revisited: Revisited = function;
    let _inline: Inline = function;
    1
}

fn make_both<T>() -> (fn(x: T) -> nil, fn(x: nil) -> T) {
    unchecked_cast(nil)
}

type TakesInt = fn(x: Int) -> nil;
type TakesBytes32 = fn(x: Bytes32) -> nil;
type Increment = fn(x: Int) -> Int;
type Discard = fn(x: Int) -> nil;
type GivesIncrement = fn(x: nil) -> Increment;
type GivesDiscard = fn(x: nil) -> Discard;

// The first union gives `T ≥ Int` or `T ≥ Bytes32`, and the second `T ≤ Increment` or
// `T ≤ Discard`, and every one of the four pairs fails, so no pick of a member of each holds.
// A pair across two unions only rules out picking both of its members (#362's step 13g), and
// here each member conflicts with every member of the other union
fn members_of_two_unions_conflict() -> Int {
    let _both: fn() -> (TakesInt | TakesBytes32, GivesIncrement | GivesDiscard) = make_both;
    1
}

type OrInt<X> = X | Int;
type OrNil<X> = X | nil;

fn alike_members<U>(_x: (U | OrInt<U>, OrNil<U> | U) | Bytes) -> U {
    unchecked_cast(nil)
}

// The parameter's unions have members that are alike (`U` twice), which a summary of a comparison
// leaves out of the union, so that what fails under the other still rules it out (#362's step 13g).
// This is rejected, as it is without the duplicate members: a summary that kept the left out
// member as one with nothing under it accepted it
fn alike_members_stay_ruled_out() -> Int {
    let _f = alike_members as fn<B>(x: B) -> fn(x: nil) -> (Bytes, nil);
    1
}
