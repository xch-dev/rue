fn map<T, U>(list: List<T>, function: fn(item: T) -> U) -> List<U> {
    if list is nil {
        return nil;
    }
    [function(list.first), ...map(list.rest, function)]
}

fn fold<T, A>(list: List<T>, initial: A, function: fn(accumulator: A, item: T) -> A) -> A {
    if list is nil {
        return initial;
    }
    fold(list.rest, function(initial, list.first), function)
}

fn apply<T, U>(function: fn(value: T) -> U, value: T) -> U {
    function(value)
}

fn empty<T>() -> List<T> {
    nil
}

fn default<T>() -> T {
    unchecked_cast(nil)
}

fn both<T, U>(first: T) -> (T, List<U>) {
    (first, nil)
}

fn takes(function: fn(value: Int) -> Int) -> Int {
    function(1)
}

fn takes_two(function: fn(first: Int, second: Int) -> Int) -> Int {
    function(1, 2)
}

fn takes_rest(function: fn(first: Int, ...rest: List<Int>) -> Int) -> Int {
    function(1, ...nil)
}

fn takes_either(_function: (fn(value: Int) -> Int) | (fn(first: Int, second: Int) -> Int)) -> Int {
    1
}

fn make<T>(_count: Int) -> List<T> {
    nil
}

fn call<T>(_function: fn(value: T) -> Int) -> Int {
    1
}

fn same<T>(first: T, second: T, check: fn(value: T) -> Int) -> T {
    if check(first) == 0 {
        first
    } else {
        second
    }
}

fn self_feeding<T>(pair: (Int, fn(value: T) -> T), value: T) -> T {
    pair.rest(value)
}

fn takes_none(function: fn() -> Int) -> Int {
    function()
}

fn in_pair<T>(_pair: (Int, fn(value: T) -> Int)) -> Int {
    1
}

fn each<T>(_list: List<fn(value: T) -> T>, value: T) -> T {
    value
}

fn with_number<T>(_pair: (fn(value: T) -> T, Int)) -> Int {
    1
}

fn two<T, U>(first: List<T>, _second: fn(value: U) -> Int) -> List<T> {
    first
}

struct First {
    value: Int,
}

struct Second {
    value: Int,
}

struct Thing {
    value: Int,
}

// An error in the body of a lambda is the only error: `U` isn't inferred because of it
fn error_in_a_lambda_body() -> nil {
    let field = map([1, 2, 3], fn(x) => x.first);
    let undeclared = map([1, 2, 3], fn(x) => x + missing);
    nil
}

// A lambda with the wrong number of parameters is reported as that, once
fn lambda_parameter_count() -> nil {
    let extra = map([1, 2, 3], fn(x, y) => x);
    let extra_two = map([1, 2, 3], fn(x, y, z) => x);
    let extra_typed = map([1, 2, 3], fn(x: Int, y: Int) => x);
    let none = map([1, 2, 3], fn() => 1);
    let not_generic = takes(fn(x, y) => x);
    let not_generic_none = takes(fn() => 1);
    let annotated: fn(value: Int) -> Int = fn(x, y) => x;

    // Outside of a call, a lambda whose parameters all have types, or that has too few, is shown
    // against the type that's expected of it
    let annotated_typed: fn(value: Int) -> Int = fn(x: Int, y: Int) => x;
    let annotated_none: fn(value: Int) -> Int = fn() => 1;

    // A lambda in the body of another is reported for itself, and so is the one it's in
    let nested = takes_two(fn(x) => takes(fn(p, q) => p));
    let nested_typed = takes_two(fn(x: Int, y: Int, z: Int) => takes(fn(p, q) => p));
    let nested_none = map([1, 2, 3], fn() => takes(fn(x, y) => x));

    // And one that's part of an argument, where it's the only error
    let pair = self_feeding((1, fn(x, y) => x), 5);
    let pair_generic = in_pair((1, fn(x, y) => 1));
    let list = each([fn(x) => x, fn(x, y) => x], 5);

    // With too few, it's the argument as a whole that isn't what's expected
    let pair_none = self_feeding((1, fn() => 1), 5);
    let pair_generic_none = in_pair((1, fn() => 1));
    nil
}

// A function type that takes the rest of its arguments, or more than one function type, has no
// one number of parameters to expect, so these are reported as they were
fn no_parameter_count() -> nil {
    let rest_expected = takes_rest(fn(x, y, z) => x);
    let rest_passed = takes(fn(...a) => 1);
    let rest_passed_none = takes_none(fn(...a) => 1);
    let rest_passed_extra = takes(fn(x, ...y) => x);
    let rest_passed_typed = takes(fn(a: Int, ...b: Int) => 1);
    let rest_passed_few = takes_two(fn(...a: Int) => 1);
    let rest_passed_many = takes_two(fn(a: Int, b: Int, ...c: Int) => 1);
    let either_extra = takes_either(fn(a, b, c) => a);
    let either_none = takes_either(fn() => 1);
    nil
}

// A lambda that has the parameters it's expected to isn't reported for them
fn lambda_with_another_error() -> nil {
    let returns = takes(fn(x) => "text");
    let parameter = takes(fn(x: Bytes) => 1);
    nil
}

// The wrong number of arguments is the only error
fn argument_count() -> nil {
    let missing = map([1, 2, 3]);
    let extra = map([1, 2, 3], fn(x) => x, 5);
    nil
}

// An argument of the wrong type is shown against the parameter as it's declared, where a generic
// isn't inferred because of it
fn argument_type() -> nil {
    let list = map(5, fn(x) => x);
    let function = apply(5, 5);

    // It's the only error where the body of a lambda uses a parameter that it left without a
    // type, and so is one in an argument that the parameter's type would have come from
    let used = map(5, fn(x) => x + 1);
    let used_bool = map(5, fn(x) => x * 2 > 5);
    let undeclared = map(missing, fn(x) => x + 1);
    let undeclared_value = apply(fn(x) => x + 1, missing);

    // As is the error for a value that's passed, which is before the call
    let value = missing;
    let bound = map(value, fn(x) => x + 1);
    let bound_value = apply(fn(x) => x.first, value);
    nil
}

// The call that a generic can't be inferred for is the only one that's reported, not the calls
// that it's an argument of, or the uses of its value
fn uninferred_generic(condition: Bool) -> Int {
    let list = empty();
    let number: Int = list;
    let first = if list is nil {
        0
    } else {
        list.first + 1
    };
    let nested = map(empty(), fn(x) => x);
    let value = default();
    let other = if condition {
        both(1)
    } else {
        both(2)
    };
    number
        + first
        + value
        + other.first
        + if nested is nil {
            0
        } else {
            1
        }
}

// It's still reported where nothing else is wrong
fn only_uninferred_generic() -> nil {
    let list = empty();
    let pair = both(1);
    let mapped = map(empty::<Int>(), fn(x) => default());
    nil
}

// And where what's wrong couldn't have inferred it, since it's only in the return type, or in
// the type of another parameter
fn unrelated_generic() -> nil {
    let list = make("text");
    let pair = both(missing);
    let other_argument = two([missing], fn(x) => 1);

    // The wrong number of arguments isn't why a generic that no parameter has isn't inferred
    let none = make();
    let extra = make(1, 2);
    let one_of_two = both();

    // An argument that a type couldn't be compiled for isn't why either, once it's reported
    let unresolved = empty();
    let function = apply(unresolved, 5);
    nil
}

// A call in a lambda that's passed to the same function has the same generics, which aren't the
// ones of the call that it's in
fn nested_calls_of_one_function() -> nil {
    let argument = map([[1]], fn(list) => map(5, fn(x) => x));
    let function = map([[1]], fn(list) => map(list, 5));
    let inner_generic = map(map(nil, fn(x) => x), fn(y) => y);
    let inner_parameter = call(fn(x) => call(fn(y) => y + 1));
    let inner_call = call(fn(x) => call(fn(y) => 1));
    let outer_parameter = call(fn(x) => call(fn(y) => x + 1));

    // An error of a call that's done with it isn't left out by the call that it's in, which is
    // missing an argument
    let inner_error = self_feeding((1, fn(a) => self_feeding((1, fn(x) => x + 1), a)));
    let declared = self_feeding((1, fn(list) => self_feeding(7, list)), 5);
    nil
}

// A string in a type is shown as it is, whatever it says
fn string_type() -> Int {
    let list = empty();
    let text: Int = "{unresolved}";
    text
}

// A generic that's inferred as a union of what every argument gave it is named in a note. The
// accumulator is typed, since one that isn't takes the union (see
// `generic_inference_self_feeding_lambdas.rue`)
fn inferred_union(any: Any) -> nil {
    let text = fold([1, 2], 0, fn(accumulator: Int, item) => "text");
    let mixed = fold([1, 2], true, fn(accumulator: Bool, item) => item);

    // But not one that's shown as a single type, or that's any value
    let bool = same(true, false, fn(x: true) => 1);
    let anything = same(any, 1, fn(x: Int) => 1);
    nil
}

// An error in a lambda's body about a parameter whose type wasn't inferred says so, since it shows
// the generic of the function that's called
fn uninferred_parameter<T>(outer: T, thing: Thing, either: First | Second) -> nil {
    let compound = self_feeding((1, fn(x) => (x, 1).first + 1), 5);

    // The call says that the generic can't be inferred as well, which is why the body is rejected
    let argument = call(fn(x) => x + 1);
    let field = call(fn(x) => x.first);
    let list = map(nil, fn(x) => x + 1);

    // But not an error about another type, including a generic with the same name
    let unrelated = self_feeding(
        (
            1,
            fn(x) => {
                let y: Bytes = 1;
                x
            },
        ),
        5,
    );
    let same_name = self_feeding(
        (
            1,
            fn(x) => {
                let y: Int = outer;
                x
            },
        ),
        5,
    );

    // Or one about a parameter that has a type
    let typed = self_feeding((1, fn(x: Int) => x.first), 5);

    // An argument with the generic in its type isn't why the generic isn't inferred
    let leaked = with_number((fn(x) => x, "text"));

    // Or an error after a lint that names the generic, about a generic with the same name
    let lint = self_feeding(
        (
            1,
            fn(x) => {
                let pair = (either, x);
                let number = match pair {
                    (First, Any) => 1,
                    (Second, Any) => 2,
                };
                let other: Int = outer;
                x
            },
        ),
        5,
    );

    // Or about a type whose name has the generic's in it
    let longer_name = self_feeding(
        (
            1,
            fn(x) => {
                let wrong: Int = thing;
                x
            },
        ),
        5,
    );

    // A parameter that's destructured is one that an error is about, too
    let destructured = self_feeding((1, fn((a, b)) => (a, b)), 5);
    let destructured_argument = call(fn((a, b)) => 1);
    nil
}

fn recursive_walk<T, U>(list: List<T>, f: fn(x: T) -> U, depth: Int) -> List<U> {
    if depth > 0 {
        // The inner lambda's parameter isn't inferred, so `U` isn't either, and the call's type
        // doesn't show the caller's `U` that stands for it, which `List<Int>` would be rejected for
        let inner = recursive_walk([(fn(y) => y + 1, 1)], fn(p) => p.first(p.rest), depth - 1);
        let _k: List<Int> = inner;

        // Where `f` is passed on, `U` is inferred as the caller's `U` from it, which the error in
        // another argument doesn't change, so `List<Int>` is still rejected
        let passed_on = recursive_walk(list, f, missing);
        let _j: List<Int> = passed_on;

        // An argument that couldn't be compiled before the call is why `U` isn't inferred, too
        let unknown = missing;
        let unresolved_argument = recursive_walk(list, unknown, depth - 1);
        let _l: List<Int> = unresolved_argument;

        // So are the missing arguments, where nothing else gives `U` a type
        let missing_arguments = recursive_walk(list);
        let _m: List<Int> = missing_arguments;

        // Where `T` is inferred as the caller's `U`, which the lambda's parameter is too, `U` is
        // still only a stand-in for what the lambda would have returned
        let caller_list: List<U> = recursive_walk(list, f, depth - 1);
        let from_caller = recursive_walk(caller_list, fn(y) => y.bogus, depth - 1);
        let _n: List<Int> = from_caller;
    }

    if list is nil {
        nil
    } else {
        [f(list.first), ...recursive_walk(list.rest, f, depth)]
    }
}

fn recursive_empty<T>(depth: Int) -> List<T> {
    if depth > 0 {
        // `T` is only in the return type, so the error in the argument isn't why it isn't
        // inferred, and the caller's `T` that stands for it is still rejected for `List<Int>`
        let empty = recursive_empty(missing);
        let _e: List<Int> = empty;
    }

    nil
}

fn recursive_element_lambdas<T, U>(
    list: List<fn(x: T) -> U>,
    items: List<T>,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        // `U` is inferred as the callee's `T`, which only stands in as the caller's `T` because
        // the missing argument didn't give it a type, so what the call returns doesn't show that
        let returned = recursive_element_lambdas([fn(x) => x], missing, depth - 1);
        let _r: List<Int> = returned;
    }

    recursive_element_lambdas(list, items, depth)
}

fn recursive_untyped_parameters<T, U>(f: fn(x: U) -> T, g: fn(y: U) -> Int, depth: Int) -> (T, U) {
    if depth > 0 {
        // A known gap: here the lambdas' parameters are compiled as the caller's `U` that stands
        // for the callee's while the arguments are, so the call infers it as that, and what it
        // returns still shows it after the error
        let stood_in = recursive_untyped_parameters(fn(x) => [x], fn(y) => missing, depth - 1);
        let _s: (Int, Int) = stood_in;
    }

    recursive_untyped_parameters(f, g, depth)
}
