// The guards on what a lambda in a pair or list of a recursive call gets (see
// `generic_inference_recursive_element_bounds.rue`). Each one keeps the type it had before, which
// the diagnostics show

fn make<X>() -> X {
    unchecked_cast(1)
}

// A call with no arguments keeps the caller's `T`, so the call's `T` is `Int | T`, as before
fn call_without_arguments<T>(pair: (T, T), depth: Int) -> T {
    if depth > 0 {
        let result = call_without_arguments((1, make()), depth - 1);
        let _show: nil = result;
        return pair.first;
    }

    pair.first
}

// So does a call in a lambda's body, where the caller's `T` is only the lambda's return type
fn lambda_return_type<T>(pair: (T, fn() -> T), depth: Int) -> T {
    if depth > 0 {
        let result = lambda_return_type((1, fn() => make()), depth - 1);
        let _show: nil = result;
        return pair.first;
    }

    pair.first
}

// A typed parameter keeps the caller's `T` in the lambda's expected return type, so `make()` is
// `Int | T`, as before
fn typed_parameter<T>(pair: (T, fn(value: T) -> T), depth: Int) -> T {
    if depth > 0 {
        let result = typed_parameter((1, fn(_value: T | Int) => make()), depth - 1);
        let _show: nil = result;
        return pair.first;
    }

    pair.first
}

// A parameter type that's a union with the caller's `T` keeps it, since the lambda could compile
// with it before
fn union_parameter<T>(pair: (T, fn(value: T | Int) -> Int), depth: Int) -> Int {
    if depth > 0 {
        return union_parameter(
            (
                1,
                fn(x) => {
                    let _show: nil = x;
                    0
                },
            ),
            depth - 1,
        );
    }

    pair.rest(pair.first)
}

type Callback<X> = fn(value: X) -> Int;

// With a union of function types expected, the parameter is `T | Int`, which keeps the caller's `T`
fn union_of_functions<T>(pair: (T, Callback<T> | Callback<Int>), depth: Int) -> Int {
    if depth > 0 {
        return union_of_functions(
            (
                1,
                fn(x) => {
                    let _show: nil = x;
                    0
                },
            ),
            depth - 1,
        );
    }

    0
}

fn wrap<F>(function: fn(value: F) -> Int) -> fn(value: F) -> Int {
    function
}

// A lambda inside a call in the pair isn't the element itself, so it keeps the caller's `T`
fn lambda_in_a_call<T>(pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        return lambda_in_a_call(
            (
                1,
                wrap(
                    fn(x) => {
                        let _show: nil = x;
                        0
                    },
                ),
            ),
            depth - 1,
        );
    }

    pair.rest(pair.first)
}

// The caller's `T` that another generic of the callee is inferred as is the caller's own, so the
// lambda gets `T` there
fn other_generic<T, U>(value: U, pair: (T, fn(value: U) -> Int), depth: Int) -> Int {
    if depth > 0 {
        let caller: T = unchecked_cast(1);
        return other_generic(
            caller,
            (
                1,
                fn(x) => {
                    let _show: nil = x;
                    0
                },
            ),
            depth - 1,
        );
    }

    pair.rest(value)
}

// The same when the type expected of the call gives it: the caller's `T` can't be told apart
// from the restored one, so the lambda still gets `T`
fn expected_generic<T, U>(pair: (T, fn(value: T) -> U), depth: Int) -> U {
    if depth > 0 {
        let result: T = expected_generic((1, fn(x) => x), depth - 1);
        return unchecked_cast(result);
    }

    pair.rest(pair.first)
}

// The lambda's `x` is the caller's `T`, which its body passes to `caller`, a value from outside of it
// that takes the caller's `T`, so it isn't checked as what the call's renamed `T` is inferred as:
// that would be unsound, since `1` isn't a `T`
fn passes_on_to_the_caller<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        let caller = pair.first;
        return passes_on_to_the_caller((fn(x) => caller(x), 1), depth - 1);
    }

    pair.first(pair.rest)
}

fn apply<A>(function: fn(value: A) -> Int, value: A) -> Int {
    function(value)
}

// The same where the value from outside is referenced in a binding or a nested lambda in the body
fn captured_in_a_binding<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        return captured_in_a_binding(
            (
                fn(x) => {
                    let caller = pair.first;
                    caller(x)
                },
                1,
            ),
            depth - 1,
        );
    }

    pair.first(pair.rest)
}

fn captured_in_a_nested_lambda<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        return captured_in_a_nested_lambda(
            (fn(x) => apply(fn(y) => pair.first(y), x), 1),
            depth - 1,
        );
    }

    pair.first(pair.rest)
}

fn ident<V>(value: V) -> V {
    value
}

// The lambda's body names the caller's `T` itself, so it makes values of `T` that don't come from
// `x` as far as its type says: it returns `T`, which `U` would be inferred as, while `x` is checked
// as `Int`. That would be unsound, since `1` isn't a `T`, so `x` isn't checked as `Int`
fn names_the_callers_generic<T, U>(pair: (fn(value: T) -> U, T), depth: Int) -> (U, T) {
    if depth > 0 {
        let annotated = names_the_callers_generic(
            (
                fn(x) => {
                    let y: T = x;
                    y
                },
                1,
            ),
            depth - 1,
        );
        let cast = names_the_callers_generic((fn(x) => x as T, 1), depth - 1);
        let explicit = names_the_callers_generic((fn(x) => ident::<T>(x), 1), depth - 1);
        let _unused = (annotated, (cast, explicit));
        return (pair.first(pair.rest), pair.rest);
    }

    (pair.first(pair.rest), pair.rest)
}

// Each lambda counts on its own: `fn(x) => x` captures nothing, but `fn(y) => caller(y)` captures
// `caller`, which takes the caller's `T`, so `y` isn't checked as `Int` because `x` is
fn one_of_two_lambdas_captures<T>(
    pair: ((fn(value: T) -> Int, fn(value: T) -> Int), T),
    depth: Int,
) -> Int {
    if depth > 0 {
        let caller = pair.first.first;
        return one_of_two_lambdas_captures(((fn(x) => x, fn(y) => caller(y)), 1), depth - 1);
    }

    pair.first.rest(pair.rest)
}

fn second_of<A, B>(_first: A, second: B) -> B {
    second
}

// By design: `x7`'s type takes the caller's own `U` from the pair's `(5, u)`, while `y7` stands for
// the renamed one. The body references both, and a call that sees through them returns a `U` that
// could come from either, so telling which would mean tracking it through the call: in the
// lambda's whole type, `U` is the caller's own. The result is that `U` rather than the `Int` that
// `7` gives the renamed one, so the binding is rejected. It's sound, and the program is rejected
// without the fix as well, where the call itself is. A body that only references one of them is
// typed exactly (see `own_and_standing_in_parameters` in `generic_inference_recursive_element_bounds.rue`)
fn own_and_standing_in_seen_through<T, U, V>(p: (T, fn(a: T, b: U) -> V), u0: U, depth: Int) -> V {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let inner = own_and_standing_in_seen_through(
            ((5, u), fn(x7, y7) => second_of(x7, y7)),
            7,
            depth - 1,
        );
        let _inner: Int = inner;
        return p.rest(p.first, u0);
    }

    p.rest(p.first, u0)
}

// Guard: an untyped lambda that's the first element of a pair isn't refined, so its body has the
// caller's `T` that `x7` stands for, which `+` doesn't take, even where the call's inference counts it
// as the renamed `T` (see `first_element_lambdas_count_as_the_renamed_generics`)
fn first_element_lambda_body<T, U>(p: List<(fn(a: T) -> U, Int)>, value: T, depth: Int) -> U {
    if depth > 0 {
        let _listed = first_element_lambda_body(
            [(fn(x6: Int) => x6, 1), (fn(x7) => x7 + 1, 1)],
            5,
            depth - 1,
        );
        return unchecked_cast::<U>(nil);
    }

    if p is ((fn(a: T) -> U, Int), List<(fn(a: T) -> U, Int)>) {
        p.first.first(value)
    } else {
        unchecked_cast::<U>(nil)
    }
}

// Guard: with both lambdas' parameters counting as the renamed generics, each of those would be a
// candidate for the other, so the argument's candidates are what they are with the caller's
// generics they stand for, and only the argument is reported, as without that
fn renamed_generics_naming_each_other<T, U>(
    p: List<((fn(a: T) -> U, Int), (fn(b: U) -> T, Int))>,
    depth: Int,
) -> U {
    if depth > 0 {
        let r = renamed_generics_naming_each_other([((fn(a) => a, 1), (fn(b) => b, 1))], depth - 1);
        let _r: T = r;
        return unchecked_cast::<U>(nil);
    }

    unchecked_cast::<U>(nil)
}
