fn apply<A>(value: A, function: fn(a: A) -> Int) -> A {
    let _ = function(value);
    value
}

// Breaking: `x` is `5` now, as it is with `apply::<5>`, so a guard for `6` can't match. It compiled
// before, with `x: Int`
fn guard_that_cant_match_the_expected_bound() -> Int {
    let value: 5 = apply(
        5,
        fn(x) => if x is 6 {
            1
        } else {
            2
        },
    );
    value
}

fn identity<U>(value: U) -> U {
    value
}

fn cycle<A, B>(value: A, back: fn(b: B) -> A, function: fn(a: A) -> B) -> A {
    let _ = back(function(value));
    value
}

// `x` is the union of `5` and the expected bound `5 | 6` passed through `B`, which is shown once
// each, as `5 | 6`, not as `5 | 5 | 6`
fn guard_against_a_union_with_a_repeated_literal() -> Int {
    let value: 5 | 6 = cycle(
        5,
        identity,
        fn(x) => if x is 7 {
            6
        } else {
            5
        },
    );
    value
}

fn either<T>(_first: T, second: T) -> T {
    second
}

// Only a call is compiled against the expected type's own bound, so the call in a block gets the
// `7` that the first argument narrows `T` to, and `8` doesn't fit it
fn call_in_a_block_isnt_widened() -> Int {
    let value: 7 | 8 = either(7, { identity(8) });
    value
}

fn nothing<A>(value: Int) -> A {
    unchecked_cast(value)
}

// The narrower type of a widened call isn't passed on to a builtin's arguments, so `nothing`'s `A`
// is still only inferable from what `sha256` expects of it, which is nothing
fn narrower_type_doesnt_reach_a_builtins_arguments() -> Bytes32 {
    let value: Bytes32 = either(sha256("a"), sha256(nothing(1)));
    value
}
