// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

// Candidates that are unions with the generic they bound as a member, which inference used as they
// were, leaving the callee's generic in the call's type (#362, 13k4 and 13k5). A lower one is split
// into its members, since `T ≥ X | T` is `T ≥ X`, and an upper one says nothing, since `T ≤ X | T`
// always holds (see `generic_inference_bounds_naming_the_generic_errors.rue`).
//
// A generic lambda passed next to an untyped lambda gives the lower ones, where the generics they
// link are inferred through each other (infer-fuzz generator 1, seed 2807, and generator 3, seed
// 5981)

fn cycle<A, B>(forward: fn(a: A) -> B, backward: fn(a: B) -> A, value: A) -> B {
    forward(backward(forward(value)))
}

fn cycle_pair<A, B>(forward: (fn(a: A) -> B, Int), backward: fn(a: B) -> A, value: A) -> B {
    forward.first(backward(forward.first(value)))
}

fn cycle_list<A, B>(forward: List<fn(a: A) -> B>, backward: fn(a: B) -> A, value: A) -> B {
    if forward is nil {
        return unchecked_cast::<B>(nil);
    }

    forward.first(backward(forward.first(value)))
}

fn cycle_late<A, B>(backward: fn(a: B) -> A, forward: (fn(a: A) -> B, Int), value: A) -> B {
    forward.first(backward(forward.first(value)))
}

fn pass<A>(value: A) -> A {
    value
}

fn head_or<T>(list: List<T>, default: T) -> T {
    let _ = list;
    default
}

fn same<T>(function: fn(a: T) -> T, produce: fn() -> T) -> T {
    function(produce())
}

fn same_again<T>(function: fn(a: T) -> T, produce: fn() -> T, depth: Int) -> T {
    if depth > 0 {
        let inner = same_again(
            head_or(
                [fn<V>(value: V) => value],
                fn(x) => head_or(unchecked_cast::<List<5>>(nil), x),
            ),
            fn() => 5,
            depth - 1,
        );
        let check: Int = inner;
        let _ = check;
        return function(produce());
    }

    function(produce())
}

// The generic lambda is compiled before the call that gives `A` its type, so `A` was only bounded
// by `B`, which nothing gave a type yet, and `x` was `Int | B`, so `B ≥ Int | B` through the
// lambda's return type, which `B` was inferred as
test fn generic_lambda_beside_an_untyped_lambda() -> Int {
    let value = cycle(fn(x) => x, fn<V>(value: V) => value, pass(5));
    let check: Int = value;
    check + 0
}

// The same with the untyped lambda as an element of a pair or list, before or after the generic
// lambda, and calling a generic function
test fn generic_lambda_beside_an_untyped_element_lambda() -> (Int, (Int, (Int, Int))) {
    let pair = cycle_pair((fn(x) => x, 1), fn<V>(value: V) => value, pass(5));
    let list = cycle_list([fn(x) => x], fn<V>(value: V) => value, pass(5));
    let late = cycle_late(fn<V>(value: V) => value, (fn(x) => x, 1), pass(5));
    let call = cycle_pair((fn(x) => pass(x), 1), fn<V>(value: V) => value, pass(5));
    let checks: (Int, (Int, (Int, Int))) = (pair, (list, (late, call)));
    (checks.first, checks.rest)
}

// The same call compiled before the fix: with the generic arguments written out, with a value that
// isn't a call, which is compiled first, and with the lambda's parameter typed
test fn generic_lambda_beside_an_untyped_lambda_that_compiled() -> (Int, (Int, Int)) {
    let explicit = cycle::<5, 5>(fn(x) => x, fn<V>(value: V) => value, pass(5));
    let literal = cycle(fn(x) => x, fn<V>(value: V) => value, 5);
    let typed = cycle(fn(x: Int) => x, fn<V>(value: V) => value, pass(5));
    let checks: (Int, (Int, Int)) = (explicit, (literal, typed));
    (checks.first, checks.rest)
}

// `head_or` makes the untyped lambda generic over `V` from the generic lambda next to it, and
// passing `fn<V>(x: V) -> Int | V` for `fn(a: T) -> T` gave `T ≥ Int | T`, which `T` was inferred as
test fn generic_lambda_through_a_call_beside_an_untyped_lambda() -> Int {
    let value = same(
        head_or([fn<V>(value: V) => value], fn(x) => head_or(unchecked_cast::<List<5>>(nil), x)),
        fn() => 5,
    );
    let check: Int = value;
    check + 0
}

test fn generic_lambda_through_a_call_beside_an_untyped_lambda_that_compiled() -> (Int, Int) {
    let explicit = same::<Int>(
        head_or::<fn(a: Int) -> Int>(
            [fn<V>(value: V) => value],
            fn(x) => head_or(unchecked_cast::<List<5>>(nil), x),
        ),
        fn() => 5,
    );
    let typed = same(
        head_or(
            [fn<V>(value: V) => value],
            fn(x: Int) => head_or(unchecked_cast::<List<5>>(nil), x),
        ),
        fn() => 5,
    );
    let checks: (Int, Int) = (explicit, typed);
    (checks.first, checks.rest)
}

// The same in a recursive call, as the fuzzer found it
test fn generic_lambda_beside_an_untyped_lambda_in_a_recursive_call() -> Int {
    same_again(fn(x: Int) => x, fn() => 1, 1)
}

fn g0<A>(_a: fn(a: Maybe<A>) -> Int, value: A) -> fn(a: A) -> A {
    let _ = value;
    fn(a: A) => a
}

type Maybe<T> = T | nil;

type IntOr<T> = Int | T;

fn optional<V>(value: V) -> Maybe<V> {
    value
}

fn int_or<V>(value: V) -> IntOr<V> {
    value
}

fn g4<A>(function: fn(a: Maybe<A>) -> Maybe<A>) -> fn(a: A) -> Maybe<A> {
    fn(a: A) => function(a)
}

// A union behind an alias is split too, as a named generic function that returns one gives:
// `fn<V>(value: V) -> Maybe<V>` for `fn(a: B) -> A` gave `B ≥ Maybe<B> | Int` through the lambda
test fn generic_function_returning_an_alias_beside_an_untyped_lambda() -> (Int | nil, Int) {
    let maybe = cycle(fn(x) => x, optional, pass(5));
    let int = cycle(fn(x) => x, int_or, pass(5));
    let checks: (Int | nil, Int) = (maybe, int);
    (checks.first, checks.rest)
}

// `x` is compiled as `Maybe<A>`, and returning it gives `A ≥ A | nil`, which only says `A ≥ nil`,
// so `A` is inferred as `nil`, as it is when `nil` is passed for a `Maybe<A>`. The difference from
// `g0(fn(x) => 9)` in the errors file, which is rejected, is that something flows out of the lambda
// here, and nothing does there
test fn untyped_parameter_of_a_union_with_the_generic_returned() -> nil {
    let function = g4(fn(x) => x);
    let check: fn(a: nil) -> nil = function;
    check(nil)
}

fn g5<A>(function: fn(a: Maybe<A>) -> A) -> A {
    function(nil)
}

// Guard: where the lambda gives `A` a lower bound, `A ≤ A | nil` is kept, as on main, where it keeps
// `6` from being widened to `Int`, which can't be shown to satisfy it. It's only left out where
// nothing else gives `A` a type (see the errors file)
test fn literal_from_a_lambda_with_a_union_parameter_with_the_generic() -> 6 {
    let value = g5(fn(x) => 6);
    let check: 6 = value;
    check
}

// An untyped lambda parameter compiled as `Maybe<A>` gives `A ≤ A | nil`, which says nothing, so
// `A` is inferred from the other arguments, or written out (infer-fuzz generator 3, seed 6717)
test fn untyped_parameter_of_a_union_with_the_generic() -> (Int, Int) {
    let inferred = g0(fn(x) => 9, 5);
    let explicit = g0::<Int>(fn(x) => 9, 5);
    let checks: (fn(a: Int) -> Int, fn(a: Int) -> Int) = (inferred, explicit);
    (checks.first(1), checks.rest(2))
}
