test fn shared_pairs() -> Bool {
    let value: T32 | nil = nil;
    pairs(value) is T32
}

test fn shared_unions() -> Bool {
    let value: F32 = nil;
    unions(value) is nil
}

fn pairs(value: T32 | nil) -> T32 | nil {
    value
}

fn unions(value: F32) -> F32 {
    value
}
