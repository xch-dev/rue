// The unions in these tests overlap on purpose, to test how the compiler handles them
#![allow(redundant_union_member, indistinguishable_union_member)]

// An untyped lambda parameter's type is inferred along with the call's generics while the lambda's
// body has been compiled with the type the other arguments gave it, so a bound that only reaches it
// through the lambda's own return type still narrows it (#362, step 13c)

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

test fn issue_case() -> Int {
    // `B ≤ 5` reaches `x` through the lambda's return type, so `A` isn't widened to `Int` (#335)
    let result: 5 = map(fn(x) => x, 5);
    result + 1
}

test fn through_a_pair() -> Int {
    let result: (5, 5) = map(fn(x) => (x, x), 5);
    result.first + result.rest
}

test fn without_an_expected_type() -> Int {
    // Nothing bounds the return type, so `x` is `Int` as before
    let result = map(fn(x) => x, 5);
    result + 1
}

test fn body_compiled_with_the_wider_type() -> Int {
    // The body is compiled with `x: Int`, so the comparison with `6` is still allowed, and only the
    // lambda's type is narrowed to `fn(x: 5) -> 5`
    let result: 5 = map(
        fn(x) => if x == 6 {
            5
        } else {
            x
        },
        5,
    );
    result + 1
}

fn run<A, B>(function: fn(a: A) -> B, check: fn(b: B) -> Int, value: A) -> Int {
    check(function(value))
}

fn five_only(value: 5) -> Int {
    value
}

test fn bounded_by_another_argument() -> Int {
    // `five_only` gives `B ≤ 5`, which reaches `x` the same way
    run(fn(x) => x, five_only, 5)
}

test fn guarded_value_unchanged() -> Bool {
    // A guard's type is only a hint, so the call is solved as before and the guard still checks
    map(fn(x) => x, 5) is 5
}

test fn lint_sees_the_parameter_type() -> Int {
    // The parameter is compiled as a reference to `Int`, which lints see as `Int`, so the binding's
    // annotation is still redundant and the lint suggests returning the value directly
    let result = map(
        fn(x) => {
            let y: Int = x;
            y
        },
        5,
    );
    result
}

fn five_only_value(value: 5) -> Int {
    value
}

test fn argument_of_a_call_without_generics() -> Int {
    // `five_only_value`'s parameter doesn't reference generics, so the type it expects of the
    // argument is final
    five_only_value(map(fn(x) => x, 5))
}

test fn annotated_let_in_a_lambda_body() -> Int {
    // The annotation is a type of its own, even inside a lambda that's an argument of a call whose
    // generics are still being inferred
    map(
        fn(y) => {
            let result: 5 = map(fn(x) => x, 5);
            result + y
        },
        1,
    )
}

test fn annotated_lambda_return_type() -> Int {
    // So is a lambda's annotated return type
    map(fn(_y): 5 => map(fn(x) => x, 5), 1)
}

fn generic_member<T>(_value: T) -> (5, Int) | T {
    // The caller's `T` can't hold the pair as another pair, so the element's expected `5` counts
    (map(fn(x) => x, 5), 1)
}

test fn pair_expected_with_a_generic_member() -> Int {
    let result = generic_member(nil);

    if result is (5, Int) {
        result.first
    } else {
        0
    }
}

fn pair_map<A, B>(function: fn(pair: (A, Int)) -> B, value: A) -> B {
    function((value, 1))
}

test fn compound_parameter() -> Int {
    // `p` is `(A, Int)`, and `B ≤ (5, Int)` reaches the `A` in it, so `A` isn't widened
    let result: (5, Int) = pair_map(fn(p) => p, 5);
    result.first
}

test fn element_of_a_compound_parameter() -> Int {
    // `p.first` keeps the reference to `A`, so `B ≤ 5` reaches it too
    let result: 5 = pair_map(fn(p) => p.first, 5);
    result + 1
}

fn list_map<A, B>(function: fn(list: List<A>) -> B, value: A) -> B {
    function([value])
}

test fn list_parameter() -> Int {
    let result: List<5> = list_map(fn(list) => list, 5);

    if result is (5, List<5>) {
        result.first
    } else {
        0
    }
}

fn two<A, B>(function: fn(a: A, b: A) -> B, value: A) -> B {
    function(value, value)
}

test fn generic_in_two_parameters() -> Int {
    // Both parameters are `A`, which is one reference in both of them
    let result: (5, 5) = two(fn(a, b) => (a, b), 5);
    result.first + result.rest
}

fn two_pairs<A, B>(function: fn(x: (A, Int), y: (A, Int)) -> B, value: A) -> B {
    function((value, 1), (value, 2))
}

test fn generic_in_the_second_parameter() -> Int {
    let result: 5 = two_pairs(fn(_p, q) => q.first, 5);
    result + 1
}

fn rest_map<A, B>(function: fn(pair: (Int, A)) -> B, value: A) -> B {
    function((1, value))
}

test fn rest_of_a_compound_parameter() -> Int {
    // `p.rest` keeps the reference to `A` too
    let result: 5 = rest_map(fn(p) => p.rest, 5);
    result + 1
}

fn mixed_map<A, B, C>(function: fn(pair: (A, B), callback: fn(x: B) -> Int) -> C, a: A, b: B) -> C {
    function((a, b), fn(_x) => 0)
}

test fn excluded_generic_next_to_a_wrapped_one() -> Int {
    // `B` is a parameter of `callback` too, so it isn't wrapped, but `p.rest` is still what `B` is
    // inferred as, `Int`, next to the reference to `A` in `p`
    let result: (5, Int) = mixed_map(fn(p, callback) => (p.first, p.rest + callback(p.rest)), 5, 6);
    result.first + result.rest
}

fn wrap<T>(value: T) -> (T, Int) {
    (value, 1)
}

test fn argument_of_a_call_with_a_final_expected_type() -> Int {
    // `wrap`'s `(5, Int)` is a type of its own, and no other argument can add to its `T`, so the
    // `5` its argument is expected to be is what `T` has to be, and `map` is solved for it, as
    // `wrap::<5>(map::<5, 5>(...))` is
    let result: (5, Int) = wrap(map(fn(x) => x, 5));
    result.first
}

fn wrap_after<T>(value: T, _last: T) -> (T, Int) {
    (value, 1)
}

test fn argument_before_another_one_with_the_generic() -> Int {
    // The `6` after it adds to `T` too, but `T` is still at most `5 | 6`, so `map` is solved for
    // what fits that, as `wrap_after::<5 | 6>(map::<5, 5>(...), 6)` is
    let result: (5 | 6, Int) = wrap_after(map(fn(x) => x, 5), 6);
    result.first
}

test fn argument_of_a_guarded_call() -> Bool {
    // The guard's type is only a hint, so `map` is solved as before and the guard still checks
    wrap(map(fn(x) => x, 5)) is (5, Int)
}

fn chain<A, B, C>(first: fn(a: A) -> B, second: fn(a: B) -> C, value: A) -> C {
    second(first(value))
}

fn feed<A, B>(_first: fn(a: A) -> B, _second: fn(a: B) -> Int) -> fn(a: A) -> Int {
    fn(_x) => 1
}

fn compose<A, B>(function: fn(a: A) -> B) -> fn(a: A) -> B {
    function
}

test fn argument_whose_generic_takes_values() -> Int {
    // `compose`'s `A` is where its argument takes values, so what it's inferred as so far is only a
    // hint for `feed`'s: solving `feed` for it would give `fn(value: 5) -> Int`, which isn't the
    // `fn(a: Int) -> Int` that `compose` ends up needing, and this compiles as before
    chain::<Int | nil, 5, Int>(compose(fn(_x) => 5), compose(feed(fn(x) => x, five_only)), nil)
}

fn nested_map<A, B>(function: fn(p: ((A, Int), Int)) -> B, value: A) -> B {
    function(((value, 1), 2))
}

fn nested_rest_map<A, B>(function: fn(p: ((Int, A), Int)) -> B, value: A) -> B {
    function(((1, value), 2))
}

test fn compound_element_of_a_compound_parameter() -> Int {
    // `p.first` keeps the reference to `A` inside it, wherever it is, and so does `p.first.first`
    let pair: (5, Int) = nested_map(fn(p) => p.first, 5);
    let rest: (Int, 5) = nested_rest_map(fn(p) => p.first, 5);
    let element: 5 = nested_map(fn(p) => p.first.first, 5);
    pair.first + rest.rest + element
}

struct Wrapper<T> {
    value: T,
    other: Int,
}

struct Last<T> {
    other: Int,
    value: T,
}

fn struct_map<A, B>(function: fn(wrapper: Wrapper<A>) -> B, value: A) -> B {
    function(Wrapper::<A> { value, other: 1 })
}

fn last_map<A, B>(function: fn(last: Last<A>) -> B, value: A) -> B {
    function(Last::<A> { other: 1, value })
}

fn pair_struct_map<A, B>(function: fn(wrapper: Wrapper<(A, Int)>) -> B, value: A) -> B {
    function(Wrapper::<(A, Int)> { value: (value, 1), other: 2 })
}

test fn field_of_a_struct_parameter() -> Int {
    // A struct's fields keep the reference to `A` too, wherever they are in it
    let first: 5 = struct_map(fn(wrapper) => wrapper.value, 5);
    let last: 5 = last_map(fn(last) => last.value, 5);
    let pair: (5, Int) = pair_struct_map(fn(wrapper) => wrapper.value, 5);
    first + last + pair.first
}

fn wrapped_map<A, B>(function: fn(p: (Wrapper<A>, Int)) -> B, value: A) -> B {
    function((Wrapper::<A> { value, other: 1 }, 2))
}

fn optional_map<A, B>(function: fn(p: ((A, Int) | nil, Int)) -> B, value: A) -> B {
    function(((value, 1), 2))
}

test fn reference_in_a_struct_or_union_element() -> Int {
    // An element keeps the reference to `A` inside a struct or a union in it too
    let wrapper: Wrapper<5> = wrapped_map(fn(p) => p.first, 5);
    let optional: (5, Int) | nil = optional_map(fn(p) => p.first, 5);

    if optional is (5, Int) {
        wrapper.value + optional.first
    } else {
        wrapper.value
    }
}

fn apply_to<T>(pair: (fn(value: T) -> T, T)) -> T {
    pair.first(pair.rest)
}

test fn nested_call_to_the_same_function() -> Any {
    // The inner call shares the outer call's `T`, but the inner lambda's body has no values of `T`
    // other than `y`, so it works for any `T`, and is checked as `fn(y: Int) -> Int`, as with
    // `apply_to::<Int>`
    apply_to((fn(_x) => apply_to((fn(y) => y, 1)), "hi"))
}

fn call_back<T>(
    pair: (fn(value: T, callback: fn(v: T) -> Int) -> Int, (T, fn(v: T) -> Int)),
) -> Int {
    pair.first(pair.rest.first, pair.rest.rest)
}

fn five_only_callback(value: 5) -> Int {
    value
}

test fn callback_of_an_enclosing_call_left_alone() -> Int {
    // The same when the outer lambda's `callback` isn't used in the inner lambda
    call_back((
        fn(_x, _callback) => call_back((fn(y, _other) => y, (7, fn(_z) => 0))),
        (5, five_only_callback),
    ))
}

test fn union_expected_type() -> 5 | Bytes {
    // `B ≤ 5 | Bytes` reaches `x` through the lambda's return type, as `B ≤ 5` does in
    // `issue_case`, though neither of `x`'s upper bounds, `Int` and `5 | Bytes`, is assignable to the
    // other. `x` takes `A`'s value too, so `A` isn't widened to `Int`, as `map::<5, 5>` isn't
    map(fn(x) => x, 5)
}

test fn optional_expected_type() -> 5 | nil {
    // Likewise with `nil`, the shape most of the fuzzer's newly inferred programs take
    map(fn(x) => x, 5)
}

test fn returned_binding() -> Int {
    // `x` is resolved from the `5` that flows into it, so `result` holds the value's own `5`, as
    // with `let result: 5 = 5;`, and `needless_let_return` doesn't offer to return it directly
    let result: 5 = map(fn(x) => x, 5);
    result
}

type Pairish<T> = (T, Int);

fn alias_map<A, B>(function: fn(p: Pairish<A>) -> B, value: A) -> B {
    function((value, 1))
}

fn list_map_first<A, B>(function: fn(list: List<A>) -> B, value: A) -> B {
    function([value])
}

test fn element_through_an_alias() -> Int {
    // An alias keeps the references to `A` in what it stands for, so `p.first` still has one, and
    // so does `list.first` in a `List<A>`, once `list` is narrowed past `nil`
    let pair: 5 = alias_map(fn(p) => p.first, 5);
    let list: 5 = list_map_first(
        fn(list) => if list is nil {
            5
        } else {
            list.first
        },
        5,
    );
    pair + list
}

struct Optional<T> {
    value: T,
    other: Int | nil,
}

fn optional_struct_map<A, B>(function: fn(w: Optional<A> | nil) -> B, value: A) -> B {
    function(Optional::<A> { value, other: 1 })
}

fn narrowed_struct_map<A, B>(function: fn(w: Optional<A>) -> B, value: A) -> B {
    function(Optional::<A> { value, other: 1 })
}

test fn field_of_a_narrowed_struct() -> Int {
    // Narrowing keeps the references to `A`: past `nil`, after narrowing another field too, and in
    // the union of the copies that narrowing a field makes, in a pair or not
    let past_nil: 5 = optional_struct_map(
        fn(w) => if w is nil {
            5
        } else {
            w.value
        },
        5,
    );
    let other_field: 5 = optional_struct_map(
        fn(w) => if w is nil {
            5
        } else if w.other is nil {
            w.value
        } else {
            5
        },
        5,
    );
    let first_copies: 5 = narrowed_struct_map(
        fn(w) => {
            let either = if w.other is nil {
                (w, 0)
            } else {
                (w, 1)
            };
            either.first.value
        },
        5,
    );
    let rest_copies: 5 = narrowed_struct_map(
        fn(w) => {
            let either = if w.other is nil {
                (0, w)
            } else {
                (1, w)
            };
            either.rest.value
        },
        5,
    );
    past_nil + other_field + first_copies + rest_copies
}

fn list_map_two<A, B>(function: fn(list: List<A>) -> B, value: A) -> B {
    function([value, value])
}

test fn rest_of_a_narrowed_list() -> Int {
    // The rest of a `List<A>` is the same `List<A>`, where the alias refers to itself, so narrowing
    // it past `nil` keeps the reference too
    let result: 5 = list_map_two(
        fn(list) => if list is nil {
            5
        } else {
            let tail = list.rest;
            if tail is nil {
                5
            } else {
                tail.first
            }
        },
        5,
    );
    result
}

type TwoPairs<T> = (T, Int) | (T, Bytes);

fn nested_union_map<A, B>(function: fn(p: TwoPairs<A> | (A, nil)) -> B, value: A) -> B {
    function((value, 1))
}

test fn element_of_a_union_with_an_alias_in_it() -> Int {
    // The pairs of a union with an alias of a union in it are all of its members
    let result: 5 = nested_union_map(fn(p) => p.first, 5);
    result
}

test fn narrowed_part_of_a_binding_in_a_lambda() -> Int {
    // Narrowing a part of `p` keeps the rest of it as it was, with the reference to `A` in `x`, so
    // `B ≤ (5, 1) | nil` still reaches it
    let narrowed: (5, 1) | nil = map(
        fn(x) => {
            let p = (x, 1);
            if p.rest is 1 {
                p
            } else {
                nil
            }
        },
        5,
    );

    if narrowed is (5, 1) {
        narrowed.first
    } else {
        0
    }
}
