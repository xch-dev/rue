}

fn caller_value_not_final<T>(p: (fn(a: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        let t = unchecked_cast::<T>(nil);
        let r: Any = same(caller_value_not_final((fn(_x) => 1, (t, 1)), depth - 1));
        return unchecked_cast::<Int>(r);
    }

    p.first(p.rest)
}

// More held lambdas (see `HeldLambda`), from the last review round:
// - guard, kept as before by design: a pair's first element whose body is compiled with the
//   caller's generic where it is, since it only passes its parameter on, is compiled there, so
//   the call's `V` is a type that holds anything, which a guard for a pair on it overlaps, and
//   which `nil` is assignable to where the call's type takes one. Compiled against what the call
//   is solved with, `V` would be `Int`, and both would be rejected
// - guards, each compiled as before: a held lambda before one that reads what it returns, where
//   the call is solved again for the second; a lambda in a typed lambda's body, which isn't held,
//   so it's compiled in its scope; a body with a call in it whose expected type isn't a fallback;
//   a lambda that's the rest of its pair, in a list, which is recorded once, with its pair, so
//   that `x3.first` is widened to `Int`, which `7` is assignable to; and a pair's rest before a
//   lambda, `(1, 2)` in `(5, (1, 2))`, which is only recorded with its pair, so that
//   `same(x.first)` is widened to `Int` too
fn passes_its_parameter_on<U, V>(p: (fn(a: U) -> (V, Int), U), depth: Int) -> V {
    if depth > 0 {
        let r = passes_its_parameter_on((fn(x) => x, (1, 2)), depth - 1);
        if r is (Any, Any) {
            return unchecked_cast::<V>(r.first);
        }
        return unchecked_cast::<V>(nil);
    }

    p.first(p.rest).first
}

fn passes_its_parameter_on_takes_any<U, V>(p: (fn(a: U) -> (V, Int), U), depth: Int) -> fn(
    c: V,
) -> Int {
    if depth > 0 {
        let r = passes_its_parameter_on_takes_any((fn(x) => x, (1, 2)), depth - 1);
        let n = r(nil);
        return fn(_c) => n;
    }

    fn(_c) => 1
}

type Itself<T> = T;

fn passes_on_through_an_alias<U, V>(p: (fn(a: Itself<U>) -> V, U), depth: Int) -> V {
