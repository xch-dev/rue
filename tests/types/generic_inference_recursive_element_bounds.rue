// Two values of the same type give the lambda's parameter that type, and a function in it can be
// called: in a later argument, in a list, with a narrower value after the lambda, and with a
// function that takes more after it
fn same_type_twice<U, V>(p: (U, fn(a: U) -> V), q: U, depth: Int) -> V {
    if depth > 0 {
        let g: fn(a: Int) -> Int = fn(a) => a + 1;
