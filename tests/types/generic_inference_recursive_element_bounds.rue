fn takes<A>() -> fn(a: A) -> Int {
    fn(_a: A) => 1
}

// A lambda in a pair expected to be a bare generic, `T`, which a function and a call without
// arguments give a type
fn stands_for_a_generic<T, U>(e: T, p: (Int, T), q: fn(a: T) -> Int, u: U, depth: Int) -> Int {
    if depth > 0 {
        let g: fn(a: Int) -> Int = fn(a: Int) => a;
