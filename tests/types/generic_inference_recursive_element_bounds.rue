        let value: 5 | (5, 5) = (5, 5);
        let r: Int = provisional_in_a_lambdas_body(
            5,
            (1, fn(_x) => first_of_either(value)),
            fn(y) => if y is (Int, Int) {
                y.first + 100
            } else {
                y
            },
            depth - 1,
        );
        return r;
    }

    g(p.rest(1))
}

