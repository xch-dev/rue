// A lambda that waits is compiled after the waiting lambdas that return what it reads, as in a
// call that isn't recursive: `y` is what `fn(x) => x + 1` returns of the `5` after the pair
fn two_steps_in_a_recursive_call<T, U>(
    pair: (fn(x: T) -> U, fn(y: U) -> Int),
    value: T,
    depth: Int,
) -> Int {
    if depth > 0 {
        return two_steps_in_a_recursive_call((fn(x) => x + 1, fn(y) => y * 2), 5, depth - 1);
    }

