}

fn rest_before_the_lambda<U, V>(p: ((Int, U), fn(a: U) -> V), depth: Int) -> fn(a: V) -> Int {
    if depth > 0 {
        let r = rest_before_the_lambda(((5, (1, 2)), fn(x) => same(x.first)), depth - 1);
        let _n: Int = r(7);
        return unchecked_cast::<fn(a: V) -> Int>(nil);
    }

