fn first_of_either<T>(value: T | (T, T)) -> T {
    unchecked_cast(value)
}

// A call in a lambda's body is compiled against a return type that later arguments can still add
// to, so `first_of_either(value)` isn't solved for the `5` that the first argument gives `S`
fn provisional_in_a_lambdas_body<S, W>(
    _s: S,
    p: (W, fn(a: Int) -> S),
    g: fn(y: S) -> Int,
    depth: Int,
) -> Int {
