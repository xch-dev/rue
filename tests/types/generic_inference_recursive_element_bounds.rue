// From the pass after the last review round:
// - guard: a held lambda with a call in its body is compiled with its argument's expected type
//   still provisional, as it is where it is, so that `first_of(value)` isn't narrowed to the
//   call's `Int`, and `y` is `5 | (5, 5)`, which the guard on it holds for
// - guard, kept as before by design: a held lambda that's refined where it is, with a bare `u`
//   among the elements before it, has one of the caller's generics that stand for renamed ones
//   as its parameter's type, or a member of it, so the parameter takes whatever the renamed
//   generic is solved as, and the call is accepted whatever comes after it. It's compiled as it
//   would have been there: the call is `(1, 2) | U | 1`, with the later argument's `1`, where the
//   same lambda with its parameter's type written gives `(1, 2) | U | Int`, and `r` takes
//   `(1, 3)` with `(u, 3)` before the lambda. Compiling it against what the call is solved with
//   would give the written lambda's type, and reject both
fn first_of_either<T>(value: T | (T, T)) -> T {
    unchecked_cast(value)
}

fn provisional_in_a_held_body<S, W>(
    _s: S,
    p: (W, fn(a: Int) -> S),
    g: fn(y: S) -> Int,
    depth: Int,
) -> Int {
    if depth > 0 {
        let value: 5 | (5, 5) = (5, 5);
        let r: Int = provisional_in_a_held_body(
            5,
            (1, fn(_x) => first_of_either(value)),
            fn(y) => if y is (Int, Int) {
                y.first + 100
            } else {
                y
            },
            depth - 1,
        );
        return r;
    }

    g(p.rest(1))
}

test fn held_lambda_body_with_a_provisional_expected_type() -> Int {
    provisional_in_a_held_body(5, (1, fn(_x) => 5), fn(y) => y, 1)
}

fn sees_through_to_the_generic<U, V>(p: ((U, U), fn(a: U) -> V), q: U, depth: Int) -> V {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let r = sees_through_to_the_generic((((1, 2), u), fn(x) => x), 1, depth - 1);
        let _r: (1, 2) | U | 1 = r;
        let typed = sees_through_to_the_generic(
            (((1, 2), u), fn(x: (1, 2) | U | Int) => x),
            1,
            depth - 1,
        );
        let _typed: (1, 2) | U | Int = typed;
        return unchecked_cast::<V>(nil);
    }

    p.rest(q)
}

fn sees_through_in_a_pair<U, V>(p: ((U, U), fn(a: U) -> V), q: U, depth: Int) -> fn(c: V) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let n: Int = depth;
        let r = sees_through_in_a_pair((((u, 3), u), fn(x) => x), n, depth - 1);
        let k = r((1, 3));
        return fn(_c) => k;
    }

    let _unused = (p, q);
    fn(_c) => 0
}

// - guard: a held lambda that's a list's item, compiled as it would have been where it is, is
//   recorded against the type it was refined to there (the call in the first one's body has
//   them compiled there), `fn(a: 5 | 7) -> S`, and not against
//   `fn(a: W) -> S`, which would keep the later `5` from widening `W` for the lambda after it, so
//   that `x` is `5 | 7 | Int`, which `9` is assignable to
fn list_item_recorded_as_refined<S, W>(
    p: (W, (fn(a: W) -> S, (W, (fn(b: W) -> S, nil)))),
    g: fn(c: Int) -> Int,
    depth: Int,
) -> fn(a: S) -> Int {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let r = list_item_recorded_as_refined(
            [v, fn(_x) => same(nil), 5, fn(x) => x],
            fn(c) => c,
            depth - 1,
        );
        return fn(_a) => r(9);
    }

    fn(_a) => g(1)
}

// - guards, each compiled as before:
//   - held lambdas compiled as they would have been where they are see the elements recorded in
//     the order they come in, so that `T` takes the first of its upper bounds, `Bytes | nil`
//     from what `fn(_x1) => h` returns, and not `Int | nil` from the typed lambda after it, for
//     `x3`
//   - a later argument that's compiled against a generic a held lambda takes as a parameter, as
//     `make_any()` is for `T`, has the lambda's parameter type as its upper bound, `5 | 7`, with
//     the lambda as a second element, where the first one's generic has nothing else to give it
//     a type, and in a pair before a later value
fn recorded_in_order<U, T>(
    p: (fn(a: U) -> fn(b: T) -> Int, (fn(a: T) -> Int, (fn(a: T) -> Int, (T, nil)))),
    h: fn(b: Bytes | nil) -> Int,
    u: U,
    depth: Int,
) -> Int {
    if depth > 0 {
        return recorded_in_order(
            [
                fn(_x1) => h,
                fn(_x2: Int | nil) => 1,
                fn(x3) => {
                    let _y: Bytes | nil = x3;
                    1
                },
                nil,
            ],
            h,
            u,
            depth - 1,
        );
    }

    0
}

fn bounds_a_later_argument<T, U>(e: T, p: (U, (fn(a: T) -> Int, T)), q: T, depth: Int) -> T {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let r = bounds_a_later_argument(v, (nil, (fn(x) => x + 1, 5)), make_any(), depth - 1);
        let _s: 5 | 7 = r;
    }

    make_any()
}

fn bounds_a_later_argument_after_another<T, X>(
    p: (fn(a: X) -> Int, ((T, fn(a: T) -> Int), T)),
    q: T,
    depth: Int,
) -> T {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let r = bounds_a_later_argument_after_another(
            (fn(_w) => 1, ((v, fn(x) => x + 1), 5)),
            make_any(),
            depth - 1,
        );
        let _s: 5 | 7 = r;
    }

    make_any()
}

fn bounds_a_later_argument_in_a_pair<T>(p: ((T, fn(a: T) -> Int), T), q: T, depth: Int) -> T {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let r = bounds_a_later_argument_in_a_pair(((v, fn(x) => x + 1), 5), make_any(), depth - 1);
        let _s: 5 | 7 = r;
    }

    make_any()
}

// - guards, each compiled as before:
//   - a later argument with a call in a `match` is compiled against the generic a held lambda
//     takes as well, as `bounds_a_later_argument` is
//   - an element recorded inside another element, as `(u, 5)` is in the block, where the caller's
//     generics don't stand for renamed ones, adds nothing for the held lambdas compiled as they
//     would have been where they are either, so `y` is `Int` and not `Int | U`
fn bounds_a_later_match<T, U>(e: T, p: (U, (fn(a: T) -> Int, T)), q: T, depth: Int) -> T {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let m: 1 | 2 = 1;
        let r = bounds_a_later_match(
            v,
            (nil, (fn(x) => x + 1, 5)),
            match m {
                1 => make_any(),
                2 => make_any(),
            },
            depth - 1,
        );
        let _s: 5 | 7 = r;
    }

    make_any()
}

fn recorded_inside_an_element<U>(p: (U, (Int, (fn(b: U) -> Int, nil))), u: U, depth: Int) -> Int {
    if depth > 0 {
        return recorded_inside_an_element(
            [
                5,
                {
                    let _z = [(u, 5)] as ((U, Bytes), nil);
                    7
                },
                fn(y) => same(y) + 1,
            ],
            5,
            depth - 1,
        );
    }

    p.rest.rest.first(u)
}

// - guard: a lambda that stands for a generic itself, as `fn(x) => nil` does for `T`, which `g`
//   gave a function type, isn't held past an argument that's compiled against that generic, so
//   that `takes()` is compiled against both functions, as before
fn takes<A>() -> fn(a: A) -> Int {
    fn(_a: A) => 1
}

fn stands_for_a_generic<T, U>(e: T, p: (Int, T), q: fn(a: T) -> Int, u: U, depth: Int) -> Int {
    if depth > 0 {
        let g: fn(a: Int) -> Int = fn(a: Int) => a;
        return stands_for_a_generic(g, (1, fn(x) => nil), takes(), u, depth - 1);
    }

    q(e) + q(p.rest)
}

// - guards, each compiled as before: held lambdas whose parameters would take what the call is
//   solved with as the elements before them give it are compiled as they would have been where
//   they are, so that what comes after one doesn't make its parameter a union of the same type
//   again, or of a narrower one:
//   - the function in `x.first` can be called, and the `1` in it is widened to `Int`, which `5` is
//     assignable to, with the same value again after the lambda
//   - `x.rest` is widened to `Int` with a narrower pair after it, and `x.first` can be called
//     with a function that takes more after it
//   - two of the same value before the lambda keep `x.first` a `1`, as before
//   - a pair with a held lambda in it counts as any type for that, so that `x` is either pair
fn same_type_twice<U, V>(p: (U, fn(a: U) -> V), q: U, depth: Int) -> V {
    if depth > 0 {
        let g: fn(a: Int) -> Int = fn(a) => a + 1;
        let r = same_type_twice(((g, 1), fn(x) => x.first), (g, 1), depth - 1);
        return unchecked_cast::<V>(r(1));
    }

    p.rest(q)
}

fn same_type_twice_in_a_list<U, V>(p: (U, (fn(a: U) -> V, (U, nil))), depth: Int) -> fn(
    c: V,
) -> Int {
    if depth > 0 {
        let r = same_type_twice_in_a_list([(1, 2), fn(x) => x.first, (1, 2)], depth - 1);
        let n = r(5);
        return fn(_c) => n;
    }

    fn(_c) => 0
}

fn narrower_after_the_lambda<U, V>(p: (U, (fn(a: U) -> V, (U, nil))), depth: Int) -> fn(
    c: V,
) -> Int {
    if depth > 0 {
        let n: Int = depth;
        let r = narrower_after_the_lambda([(n, 1), fn(x) => x.rest, (2, 1)], depth - 1);
        let k = r(5);
        return fn(_c) => k;
    }

    fn(_c) => 0
}

fn function_that_takes_more_after<U, V>(p: (U, fn(a: U) -> V), q: U, depth: Int) -> V {
    if depth > 0 {
        let g: fn(a: Int) -> Int = fn(a) => a + 1;
        let g1: fn(a: 1) -> Int = fn(_a) => 2;
        let r = function_that_takes_more_after(((g1, 1), fn(x) => x.first), (g, 1), depth - 1);
        let _k: Int = r(1);
    }

    unchecked_cast(nil)
}

fn same_type_twice_before<U, V>(p: (U, (U, (fn(a: U) -> V, nil))), depth: Int) -> V {
    if depth > 0 {
        let r = same_type_twice_before([(1, 2), (1, 2), fn(x) => x.first], depth - 1);
        let _k: 1 = r;
    }

    unchecked_cast(nil)
}

fn held_lambdas_in_both<T, U, V>(
    p: (((T, fn(a: Int) -> Any) | U, (T, fn(a: Int) -> Any) | U), fn(a: U) -> V),
    depth: Int,
) -> V {
    if depth > 0 {
        let _r = held_lambdas_in_both(
            (((1, fn(z) => (z, z)), (1, fn(y) => y)), fn(x) => x.rest),
            depth - 1,
        );
    }

    unchecked_cast(nil)
}

// - guards, each compiled as before, since that's decided for each held lambda, with the held
//   lambdas before it in place:
//   - `y` is what `fn(x) => (x, 1)` returns, `(Int, 1)`, which the later `(n, 1)` adds nothing
//     to, so `y.rest` is widened to `Int`
//   - `x` is `((Int, Int), 1)` beside a lambda that's compiled against what the call is solved
//     with, since a later argument adds to what it takes
fn earlier_lambda_returns_it<U, V>(p: (fn(a: Int) -> U, fn(a: U) -> V), q: U, depth: Int) -> fn(
    c: V,
) -> Int {
    if depth > 0 {
        let n: Int = depth;
        let r = earlier_lambda_returns_it((fn(x) => (x, 1), fn(y) => y.rest), (n, 1), depth - 1);
        let k = r(5);
        return fn(_c) => k + 40;
    }

    let _unused = (p, q);
    fn(_c) => 2
}

fn beside_one_that_takes_more<U, V, W, X>(
    p: ((W, fn(a: W) -> V), ((U, U), fn(a: U) -> X)),
    q: W,
    q2: U,
    depth: Int,
) -> fn(c: V) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let pr: (Int, Int) = (8, 9);
        let r = beside_one_that_takes_more(
            (((pr, 1), fn(x) => x.rest), (((1, 2), u), fn(_y) => 5)),
            ((1, 2), 1),
            1,
            depth - 1,
        );
        let k = r(5);
        return fn(_c) => k + 40;
    }

    fn(_c) => 2
}

// - guard, compiled as before: a pair's first element whose parameter is shadowed where its body
//   uses an operator, as `x` is by the field of `Shadow`, whatever kind of binding shadows it,
//   only passes its parameter on, so it's compiled with the caller's generic where it is
struct Shadow {
    x: Int,
}

fn shadowed_by_a_field<U, V>(p: (fn(a: U) -> (V, Int), U), depth: Int) -> V {
    if depth > 0 {
        let r = shadowed_by_a_field(
            (
                fn(x) => {
                    let y = x;
                    let { x } = Shadow { x: 1 };
                    let _z = x + 1;
                    y
                },
                (1, 2),
            ),
            depth - 1,
        );
        if r is (Any, Any) {
            return unchecked_cast::<V>(r.first);
        }
        return unchecked_cast::<V>(nil);
    }

    p.first(p.rest).first
}

// - a pair's first element whose body has its parameter as a prefix operator's operand can't be
//   compiled with the caller's generic either, so it's compiled against what the call is solved
//   with, where the call was rejected
fn negated_first_element<T, U>(p: (fn(a: T) -> U, T), depth: Int) -> U {
    if depth > 0 {
        let r = negated_first_element((fn(x) => -x, 1), depth - 1);
        let _n: Int = r;
    }

    p.first(p.rest)
}

// - a pair's first element in a later argument is compiled against what the call is solved with,
//   with the rest of its pair recorded while it's held, so that `v` is the caller's own there and
//   `x` is `(V, 1)`, where the call was rejected
fn rest_recorded_while_held<T, U, V, W>(
    functions: List<fn(a: List<U>, b: T) -> List<U>>,
    value: T,
    p: (fn(a: V) -> W, V),
    depth: Int,
) -> W {
    if depth > 0 {
        let v = unchecked_cast::<V>(nil);
        let guarded = rest_recorded_while_held(
            [
                fn(x: List<(5, U)>, _x1: List<(6, U)>) => x,
                fn(y, y1) => {
                    let _guard = y1 is nil;
                    same(y)
                },
            ],
            nil,
            (fn(x) => x.rest, (v, 1)),
            depth - 1,
        );
        let _r: Int = guarded;
        return unchecked_cast::<W>(nil);
    }

    unchecked_cast::<W>(nil)
}
