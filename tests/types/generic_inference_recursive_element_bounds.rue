}

// A lambda that waits is typed once nothing still to be compiled can add to what it reads, and
// what it reads follows what a lambda compiled where it is returns to what that one reads: `_y`
// reads `U`, which `fn(x) => x` returns of `T`, so it waits for the `"ab"` that adds to `T`,
// whether it's beside that lambda or in an argument after it
fn beside_one_that_passes_a_later_argument_on<T, U>(
    p: (fn(x: T) -> U, fn(y: U) -> Int),
    r: T,
    q: T,
    depth: Int,
) -> (Int, Int) {
    if depth > 0 {
        return beside_one_that_passes_a_later_argument_on(
            (fn(x) => x, fn(_y) => 7),
            (1, 2),
            "ab",
            depth - 1,
        );
    }

    (p.rest(p.first(q)), p.rest(p.first(r)))
}

test fn lambda_beside_one_that_passes_a_later_argument_on() -> (Int, Int) {
    beside_one_that_passes_a_later_argument_on((fn(x: Int) => x, fn(_y: Int) => 3), 1, 2, 1)
}

fn after_one_that_passes_a_later_argument_on<T, U>(
    p0: (fn(x: T) -> U, Int),
    r: T,
    p1: (fn(y: U) -> Int, Int),
    q: T,
    depth: Int,
) -> (Int, Int) {
    if depth > 0 {
        return after_one_that_passes_a_later_argument_on(
            (fn(x) => x, 0),
            (1, 2),
            (fn(_y) => 7, 0),
            "ab",
            depth - 1,
        );
    }

    (p1.first(p0.first(q)), p1.first(p0.first(r)))
}

test fn lambda_after_one_that_passes_a_later_argument_on() -> (Int, Int) {
    after_one_that_passes_a_later_argument_on((fn(x: Int) => x, 0), 1, (fn(_y: Int) => 3, 0), 2, 1)
}

// A lambda whose body has a guard on its parameter doesn't wait for a generic that nothing has
// given a type: it's compiled where it is, with the caller's generic standing for the callee's,
// which the guard overlaps, as it's compiled with the generic in a call that isn't recursive.
// Typed as the pair's `[1, 2]` gives `U`, the guard for `nil` couldn't hold
fn guard_in_the_body<U>(p: (fn(a: U) -> Int, U), depth: Int) -> Int {
    if depth > 0 {
        return guard_in_the_body(
            (
                fn(x) => if x is nil {
                    5
                } else {
                    6
                },
                [1, 2],
            ),
            depth - 1,
        );
    }

    p.first(p.rest)
}

test fn lambda_with_a_guard_in_its_body() -> Int {
    guard_in_the_body((fn(a: Int) => a, 1), 1)
}

// The lambda in the pair is compiled where it is, since the lambda after it reads what it
// returns, and that one waits for what it returns of the list before it
fn rest_of_a_pair_in_a_list<U, V>(
    p0: [(List<V>, fn(a: List<V>) -> U), fn(a: U) -> V],
    depth: Int,
) -> fn(a: V) -> Int {
    if depth > 0 {
        let r = rest_of_a_pair_in_a_list(
            [([[5]], fn(x1) => (1, x1)), fn(x3) => x3.first],
            depth - 1,
        );
        let _n: Int = r(7);
        return unchecked_cast::<fn(a: V) -> Int>(nil);
    }

    unchecked_cast::<fn(a: V) -> Int>(nil)
}

// The declared changes' rejected calls (see the errors file) compile with the parameter's type
// written, in a recursive call and in a call that isn't
fn bounds_a_later_argument_typed<T, U>(e: T, p: (U, (fn(a: T) -> Int, T)), q: T, depth: Int) -> T {
    if depth > 0 {
        let v: 5 | 7 = 5;
        let r = bounds_a_later_argument_typed(
            v,
            (nil, (fn(x: 5 | 7) => x + 1, 5)),
            make_any(),
            depth - 1,
        );
        let _s: 5 | 7 = r;
    }

    make_any()
}

fn later_argument_adds<T, U>(e: T, p: (U, (fn(a: T) -> Int, T)), q: T) -> T {
    q
}

fn later_argument_adds_typed() -> Int {
    let v: 5 | 7 = 5;
    let r = later_argument_adds(v, (nil, (fn(x: 5 | 7) => x + 1, 5)), make_any());
    let _s: 5 | 7 = r;
    0
}

fn later_argument_widens_typed<T, U>(p0: (T, (U, fn(x: T) -> U)), p1: T, depth: Int) -> Int {
    if depth > 0 {
        let _r = later_argument_widens_typed((7, (5, fn(x: Int | String) => x)), "ab", depth - 1);
    }

    0
}

fn later_argument_widens_callee<T, U>(p0: (T, (U, fn(x: T) -> U)), p1: T) -> Int {
    0
}

fn later_argument_widens_ordinary_typed() -> Int {
    later_argument_widens_callee((7, (5, fn(x: Int | String) => x)), "ab")
}

fn later_element_widens_typed<V, W>(p: [V, fn(a: V) -> W, W, V], depth: Int) -> Int {
    if depth > 0 {
        let _r = later_element_widens_typed(
            [7, fn(x: Int | (Int, Int)) => x, 1, (1, 2)],
            depth - 1,
        );
    }

    0
}

fn widens_under_a_hint_typed<T, U>(p: (T, fn(x: T) -> U), q: T, depth: Int) -> (U, U) {
    if depth > 0 {
        let _r = ident(widens_under_a_hint_typed(
            (5, fn(x: Int | (Int, Int)) => (x, x)),
            (1, 2),
            depth - 1,
        ));
    }

    (p.rest(q), p.rest(p.first))
}

// In a recursive call, what a lambda whose parameters all have types returns doesn't give its
// generic a type where the elements after it are, so a lambda after it that applies an operator
// to that generic waits for the rest of the argument, and is typed with what the first returns
fn after_a_typed_lambda_that_gives_it<T, U>(
    functions: (fn(a: T) -> U, (fn(a: U) -> T, T)),
    depth: Int,
) -> T {
    if depth > 0 {
        let _r = after_a_typed_lambda_that_gives_it(
            (fn(x: Int) => 8, (fn(y) => y - 1, depth)),
            depth - 1,
        );
    }

    functions.rest.first(functions.first(functions.rest.rest))
}

test fn operator_lambda_after_a_typed_lambda() -> Int {
    after_a_typed_lambda_that_gives_it((fn(x: Int) => x + 1, (fn(y: Int) => y * 2, 3)), 1)
}
