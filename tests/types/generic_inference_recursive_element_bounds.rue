// In a recursive call, the argument's expected type has the callee's generics that aren't inferred
// yet restored to the caller's generics they were renamed from. A lambda in a pair or list in the
// argument still gets what the elements before it infer for the callee's generic, as in any other
// call (#350)

fn recursive<T>(pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // The lambda gets `Int`, which the `1` before it infers, not the caller's `T`
        return recursive((1, fn(x) => x), depth - 1);
    }

    pair.rest(pair.first)
}

test fn lambda_after_a_value_in_a_recursive_call() -> Int {
    recursive((2, fn(x) => x), 1)
}

fn recursive_list<T>(items: (T, (fn(value: T) -> Int, nil)), depth: Int) -> Int {
    if depth > 0 {
        return recursive_list([1, fn(x) => x + 1], depth - 1);
    }

    items.rest.first(items.first)
}

test fn lambda_item_after_a_value_in_a_recursive_call() -> Int {
    recursive_list([2, fn(x) => x], 1)
}

fn recursive_unused<T>(pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        return recursive_unused((1, fn(_x) => 0), depth - 1);
    }

    pair.rest(pair.first)
}

test fn lambda_that_ignores_its_parameter_in_a_recursive_call() -> Int {
    recursive_unused((2, fn(x) => x), 1)
}

fn recursive_nil<T>(pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // `x` is `nil`, which the element before it infers
        return recursive_nil(
            (
                nil,
                fn(x) => {
                    let _nil: nil = x;
                    0
                },
            ),
            depth - 1,
        );
    }

    pair.rest(pair.first)
}

test fn lambda_after_nil_in_a_recursive_call() -> Int {
    recursive_nil((2, fn(x) => x), 1)
}

fn recursive_typed<T>(pair: (T, fn(first: Int, second: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // The untyped parameter comes after a typed one
        return recursive_typed((1, fn(first: Int, second) => first + second), depth - 1);
    }

    pair.rest(0, pair.first)
}

test fn lambda_with_a_typed_parameter_in_a_recursive_call() -> Int {
    recursive_typed((2, fn(_first: Int, second) => second), 1)
}

fn recursive_nested<T>(pair: (T, (Int, fn(value: T) -> Int)), depth: Int) -> Int {
    if depth > 0 {
        return recursive_nested((1, (2, fn(x) => x + 1)), depth - 1);
    }

    pair.rest.rest(pair.first)
}

test fn lambda_in_a_nested_pair_in_a_recursive_call() -> Int {
    recursive_nested((2, (3, fn(x) => x)), 1)
}

type Same<T> = T;

fn recursive_alias<T>(pair: (T, fn(value: Same<T>) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // Through an alias around the parameter type
        return recursive_alias((1, fn(x) => x), depth - 1);
    }

    pair.rest(pair.first)
}

test fn lambda_with_an_aliased_parameter_type_in_a_recursive_call() -> Int {
    recursive_alias((2, fn(x) => x), 1)
}

fn recursive_value<T>(pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // Guard: the element before the lambda is the caller's `T`, so the lambda gets `T`, as
        // before
        return recursive_value((pair.first, fn(x) => pair.rest(x)), depth - 1);
    }

    pair.rest(pair.first)
}

test fn guard_lambda_after_the_callers_generic() -> Int {
    recursive_value((2, fn(x) => x), 1)
}

fn recursive_argument<T>(value: T, pair: (T, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // Guard: an argument before the pair infers the callee's `T`, so it isn't restored, as before
        return recursive_argument(5, (1, fn(x) => x), depth - 1);
    }

    pair.rest(value)
}

test fn guard_generic_inferred_by_an_earlier_argument() -> Int {
    recursive_argument(2, (3, fn(x) => x), 1)
}

fn recursive_upper<T>(pair: (fn(value: T) -> Int, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // Guard: the first lambda can be assigned to `fn(value: T) -> Int`, so it doesn't stop the
        // callee's `T` from being the caller's, and the second lambda still gets `T`, as before
        return recursive_upper(
            (
                fn(_value: T | Int) => 1,
                fn(value) => {
                    let _same: T = value;
                    1
                },
            ),
            depth - 1,
        );
    }

    0
}

test fn guard_lambda_after_an_upper_bound_the_callers_generic_satisfies() -> Int {
    recursive_upper((fn(value: Int) => value, fn(value: Int) => value), 1)
}

fn recursive_local<T>(first: Int, function: fn(value: T) -> Int, depth: Int) -> Int {
    if depth > 0 {
        // Guard: only a pair or list argument is refined, so in a pair in a lambda argument's body,
        // the `T` written in the annotation is the caller's own. The `1` before the inner lambda
        // doesn't make it `Int`, as before
        return recursive_local(
            1,
            fn(_value) => {
                let _local: (T | Int, fn(value: T) -> Int) = (
                    1,
                    fn(value) => {
                        let _same: T = value;
                        1
                    },
                );
                1
            },
            depth - 1,
        );
    }

    first
}

test fn guard_pair_in_a_lambda_argument_in_a_recursive_call() -> Int {
    recursive_local(1, fn(value: Int) => value, 1)
}

fn recursive_block<T>(pair: (T, Int), depth: Int) -> Int {
    if depth > 0 {
        // Guard: a pair in a block that's an element isn't refined either, so the `1` before the
        // block doesn't make the inner lambda's `T` `Int`, as before
        return recursive_block(
            (
                1,
                {
                    let _local: (Int, fn(value: T) -> Int) = (
                        1,
                        fn(value) => {
                            let _same: T = value;
                            1
                        },
                    );
                    1
                },
            ),
            depth - 1,
        );
    }

    pair.rest
}

test fn guard_pair_in_a_block_in_a_recursive_call() -> Int {
    recursive_block((1, 2), 1)
}

fn recursive_union_member<T>(pair: (T | Int, fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        // Guard: `1` can be assigned to `T | Int`, as the `Int` member, so it doesn't stop the
        // callee's `T` from being the caller's, and the lambda still gets `T`, as before
        return recursive_union_member(
            (
                1,
                fn(value) => {
                    let _same: T = value;
                    0
                },
            ),
            depth - 1,
        );
    }

    0
}

test fn guard_value_assignable_to_a_union_with_the_callers_generic() -> Int {
    recursive_union_member((1, fn(value) => value), 1)
}

fn recursive_union_list<T>(items: (T | nil, (fn(value: T) -> Int, nil)), depth: Int) -> Int {
    if depth > 0 {
        // Guard: the same in a list, with `nil`
        return recursive_union_list(
            [
                nil,
                fn(value) => {
                    let _same: T = value;
                    0
                },
            ],
            depth - 1,
        );
    }

    0
}

test fn guard_list_item_assignable_to_a_union_with_the_callers_generic() -> Int {
    recursive_union_list([nil, fn(_value) => 0], 1)
}

fn recursive_union_of_pairs<T>(
    pair: (T, fn(value: T) -> Int) | (Int, fn(value: T) -> Int),
    depth: Int,
) -> Int {
    if depth > 0 {
        // Guard: the same with a union of pairs expected, whose first elements make `T | Int`
        return recursive_union_of_pairs(
            (
                1,
                fn(value) => {
                    let _same: T = value;
                    0
                },
            ),
            depth - 1,
        );
    }

    0
}

test fn guard_union_of_pairs_with_the_callers_generic() -> Int {
    recursive_union_of_pairs((1, fn(value) => value), 1)
}

fn recursive_other_part<T, U>(value: U, pair: ((U, T), fn(value: T) -> Int), depth: Int) -> Int {
    if depth > 0 {
        let same: Same<T> = pair.first.rest;

        // Guard: `("x", same)` can't be assigned to `(Int, T)` while it's compiled, since the `1`
        // before it maps `U`, but `Same<T>` is assignable to `T`, so the lambda still gets `T`,
        // as before
        return recursive_other_part(
            1,
            (
                ("x", same),
                fn(value) => {
                    let _same: T = value;
                    0
                },
            ),
            depth - 1,
        );
    }

    0
}

test fn guard_element_that_fails_for_another_generic() -> Int {
    recursive_other_part(1, ((1, 2), fn(value) => value), 1)
}

// The lambda before its value is compiled with the caller's `T`, but its body has no other values
// of `T`, so it works for any `T`, and is checked as what the call's renamed `T` is inferred as,
// `Int`, as with `lambda_before_its_value::<Int>`
fn lambda_before_its_value<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        return lambda_before_its_value((fn(x) => x, 1), depth - 1);
    }

    pair.first(pair.rest)
}

test fn lambda_before_its_value_in_a_recursive_call() -> Int {
    lambda_before_its_value((fn(x) => x, 1), 1)
}

// Values from outside of the lambda without `T` in their types don't stop it, and neither does a
// reference to the function itself, whose `T` the reference renames
fn lambda_with_other_captures<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        return lambda_with_other_captures(
            (
                fn(x) => if depth > 1 {
                    x
                } else {
                    lambda_with_other_captures((fn(y) => y, 2), 0)
                },
                1,
            ),
            depth - 1,
        );
    }

    pair.first(pair.rest)
}

test fn lambda_with_other_captures_in_a_recursive_call() -> Int {
    lambda_with_other_captures((fn(x) => x, 1), 1)
}

// The lambda's own bindings aren't values from outside of it, even with `T` in their types
fn lambda_with_its_own_binding<T>(pair: (fn(value: T) -> Int, T), depth: Int) -> Int {
    if depth > 0 {
        return lambda_with_its_own_binding(
            (
                fn(x) => {
                    let y = (x, 1);
                    y.first
                },
                1,
            ),
            depth - 1,
        );
    }

    pair.first(pair.rest)
}

test fn lambda_with_its_own_binding_in_a_recursive_call() -> Int {
    lambda_with_its_own_binding((fn(x) => x, 1), 1)
}

// A generic the lambda returns is inferred as what it's checked as, so `U` is `5`, as with
// `lambda_returning_its_value::<5, 5>`
fn lambda_returning_its_value<T, U>(pair: (fn(value: T) -> U, T), depth: Int) -> U {
    if depth > 0 {
        let narrowed: 5 = lambda_returning_its_value((fn(x) => x, 5), depth - 1);
        return unchecked_cast(narrowed);
    }

    pair.first(pair.rest)
}

test fn lambda_returning_its_value_in_a_recursive_call() -> Int {
    lambda_returning_its_value((fn(x) => x, 1), 1)
}

// When the call is solved again for the type expected of it, so that `y` is `5`, the lambda before
// its value is still checked as what the call's renamed `T` is inferred as, as with
// `next_to_another_lambda::<Int, 5, 5>`
fn next_to_another_lambda<T, A, B>(
    pair: (fn(value: T) -> Int, T),
    function: fn(a: A) -> B,
    value: A,
    depth: Int,
) -> B {
    if depth > 0 {
        let narrowed: 5 = next_to_another_lambda((fn(x) => x, 1), fn(y) => y, 5, depth - 1);
        return unchecked_cast(narrowed);
    }

    let _result = pair.first(pair.rest);
    function(value)
}

test fn lambda_before_its_value_next_to_another_lambda() -> Int {
    next_to_another_lambda((fn(x) => x, 1), fn(y) => y, 5, 1)
}

// Two lambdas before their value that capture nothing are both checked as `fn(value: Int) -> Int`
fn two_lambdas_before_their_value<T>(
    pair: ((fn(value: T) -> Int, fn(value: T) -> Int), T),
    depth: Int,
) -> Int {
    if depth > 0 {
        return two_lambdas_before_their_value(((fn(x) => x, fn(y) => y), 1), depth - 1);
    }

    pair.first.rest(pair.rest)
}

test fn two_lambdas_before_their_value_in_a_recursive_call() -> Int {
    two_lambdas_before_their_value(((fn(x) => x, fn(y) => y), 1), 1)
}

fn same<Q>(value: Q) -> Q {
    value
}

// A typed lambda before an untyped one names the caller's own `U`, which `T` is inferred with, so
// from then on `U` is the caller's in the list, not the callee's renamed `U` it stood for. `x7`
// gets `(5, U)` with the caller's `U`, and so does the result, rather than a copy of it that
// prints the same and nothing binds (infer-fuzz generator 3, seed 3641)
fn typed_before_untyped<T, U>(functions: List<fn(a: T) -> U>, value: T, depth: Int) -> List<U> {
    if depth > 0 {
        let through_a_call = typed_before_untyped(
            [fn(x6: (5, U)) => x6, fn(x7) => same(x7)],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _through_a_call: List<(5, U)> = through_a_call;

        let returned = typed_before_untyped(
            [fn(x6: (5, U)) => x6, fn(x7) => x7],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _returned: List<(5, U)> = returned;

        let several = typed_before_untyped(
            [fn(x6: (5, U)) => x6, fn(x7) => x7, fn(x8) => same(x8)],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _several: List<(5, U)> = several;

        // Guard: with the untyped lambda first, `U` still stands for the renamed one there
        let untyped_first = typed_before_untyped(
            [fn(x7) => same(x7), fn(x6: (5, U)) => x6],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _untyped_first: List<(5, U)> = untyped_first;
        return nil;
    }

    if functions is (fn(a: T) -> U, List<fn(a: T) -> U>) {
        [functions.first(value)]
    } else {
        nil
    }
}

test fn typed_lambda_names_the_callers_generic_before_an_untyped_one() -> (List<Int>, List<Int>) {
    (
        typed_before_untyped([fn(x: Int) => x + 1], 6, 0),
        typed_before_untyped([fn(x: Int) => x], 6, 1),
    )
}

// The same in a pair, and in nested lists
fn typed_before_untyped_in_a_pair<T, U>(
    functions: (fn(a: T) -> U, fn(a: T) -> U),
    value: T,
    depth: Int,
) -> U {
    if depth > 0 {
        let returned = typed_before_untyped_in_a_pair(
            (fn(x6: (5, U)) => x6, fn(x7) => x7),
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _returned: (5, U) = returned;

        let through_a_call = typed_before_untyped_in_a_pair(
            (fn(x6: (5, U)) => x6, fn(x7) => same(x7)),
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _through_a_call: (5, U) = through_a_call;
        return functions.first(value);
    }

    functions.rest(value)
}

fn typed_before_untyped_in_nested_lists<T, U>(
    functions: List<List<fn(a: T) -> U>>,
    value: T,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let apart = typed_before_untyped_in_nested_lists(
            [[fn(x6: (5, U)) => x6], [fn(x7) => x7]],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _apart: List<(5, U)> = apart;

        let together = typed_before_untyped_in_nested_lists(
            [[fn(x6: (5, U)) => x6, fn(x7) => x7]],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _together: List<(5, U)> = together;
        return nil;
    }

    nil
}

// The same with the caller's `T`, which the typed lambda names, and the value has
fn typed_names_the_callers_parameter_generic<T, U>(
    functions: List<fn(a: T) -> U>,
    value: T,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let names_t = typed_names_the_callers_parameter_generic(
            [fn(x6: (5, T)) => x6, fn(x7) => x7],
            (5, value),
            depth - 1,
        );
        let _names_t: List<(5, T)> = names_t;
        return nil;
    }

    nil
}

test fn typed_lambda_names_the_callers_generic_in_other_arguments() -> (
    Int,
    (List<Int>, List<Int>),
) {
    (
        typed_before_untyped_in_a_pair((fn(x: Int) => x, fn(x: Int) => x + 2), 6, 1),
        (
            typed_before_untyped_in_nested_lists([[fn(x: Int) => x]], 6, 1),
            typed_names_the_callers_parameter_generic([fn(x: Int) => x], 6, 1),
        ),
    )
}

// Guard: untyped lambdas compiled with the caller's generic standing for the renamed one infer
// the renamed one, not the caller's, for the lambdas after them, so they still stand for it there
fn untyped_lambdas_only<T, U>(functions: List<fn(a: T) -> U>, value: T, depth: Int) -> List<U> {
    if depth > 0 {
        let same_type = untyped_lambdas_only([fn(x1) => x1, fn(x2) => x2], 7, depth - 1);
        let _same_type: List<Int> = same_type;

        let different = untyped_lambdas_only([fn(x) => x, fn(x) => (5, x)], 7, depth - 1);
        let _different: List<Int | (5, Int)> = different;
        return nil;
    }

    if functions is (fn(a: T) -> U, List<fn(a: T) -> U>) {
        [functions.first(value)]
    } else {
        nil
    }
}

fn untyped_lambdas_in_a_pair<T, U>(
    pair: (fn(a: T) -> U, fn(a: T) -> U),
    value: T,
    depth: Int,
) -> U {
    if depth > 0 {
        let inner = untyped_lambdas_in_a_pair((fn(x) => x, fn(y) => y), 7, depth - 1);
        let _inner: Int = inner;
        return pair.rest(value);
    }

    pair.first(value)
}

// Guard: a typed lambda that names the caller's `T` only makes it the caller's own in the lambdas
// whose types take it from there, so the later lambdas still get `T` for the renamed `U`
fn typed_first_then_untyped<T, U>(functions: List<fn(a: U) -> T>, depth: Int) -> List<T> {
    if depth > 0 {
        let t = unchecked_cast::<T>(nil);
        let u = unchecked_cast::<U>(nil);
        let inner = typed_first_then_untyped([fn(_x: T) => u, fn(_x) => t, fn(_x) => t], depth - 1);
        let _inner: List<U | T> = inner;
        return nil;
    }

    nil
}

test fn untyped_lambdas_keep_standing_for_the_renamed_generics() -> (List<Int>, (Int, List<Int>)) {
    (
        untyped_lambdas_only([fn(x: Int) => x + 1], 6, 1),
        (
            untyped_lambdas_in_a_pair((fn(x: Int) => x + 1, fn(x: Int) => x), 6, 1),
            typed_first_then_untyped([fn(x: Int) => x], 1),
        ),
    )
}

// Guard: the `(5, u)` after the lambda has the caller's `U` as itself, but the lambda's expected
// type doesn't take it from what the elements before it infer, so `x` still stands for the
// renamed `U` there
fn values_around_a_lambda<T, U>(p: (T, (T, (fn(a: U) -> T, (U, nil)))), depth: Int) -> (T, U) {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let r = values_around_a_lambda([u, 1, fn(x) => (5, x), (5, u)], depth - 1);
        let _r: (U | Int | (5, (5, U)), (5, U)) = r;
        return unchecked_cast::<(T, U)>(nil);
    }

    unchecked_cast::<(T, U)>(nil)
}

test fn values_keep_the_renamed_generics_around_a_lambda() -> (Int, Int) {
    values_around_a_lambda((1, (2, (fn(x: Int) => x, (3, nil)))), 1)
}

// A typed lambda that names the caller's `U` before a pair whose first element is an untyped lambda.
// That element isn't refined, so its body has the caller's `U` that `x7` stands for, but the call's
// inference counts `x7` as the renamed one, so the result is exactly the caller's own `(5, U)`
// (#362, 13k6)
fn typed_before_a_pair_of_untyped<T, U>(
    p: (fn(a: T) -> U, (fn(a: T) -> U, fn(a: T) -> U)),
    value: T,
    depth: Int,
) -> U {
    if depth > 0 {
        let r = typed_before_a_pair_of_untyped(
            (fn(x6: (5, U)) => x6, (fn(x7) => x7, fn(x8) => x8)),
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _r: (5, U) = r;
        return p.first(value);
    }

    p.first(value)
}

fn typed_in_a_list_of_pairs<T, U>(
    functions: List<(fn(a: T) -> U, fn(a: T) -> U)>,
    value: T,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let r = typed_in_a_list_of_pairs(
            [(fn(x6: (5, U)) => x6, fn(x0) => x0), (fn(x7) => x7, fn(x8) => x8)],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _r: List<(5, U)> = r;
        return nil;
    }

    nil
}

test fn typed_lambda_names_the_callers_generic_before_pairs() -> (Int, List<Int>) {
    (
        typed_before_a_pair_of_untyped(
            (fn(x: Int) => x + 3, (fn(x: Int) => x, fn(x: Int) => x)),
            1,
            1,
        ),
        typed_in_a_list_of_pairs([(fn(x: Int) => x, fn(x: Int) => x)], 1, 1),
    )
}

// A lambda whose first parameter has the caller's own `U` and whose second stands for the renamed
// one: a call in its body that sees through the first one returns the caller's `U`, and one that
// only sees through the second returns the renamed one, which `7` makes `Int` (infer-fuzz generator
// 3 review, reduced)
fn own_and_standing_in_parameters<T, U, V>(
    p: (fn(a: T) -> T, fn(a: T, b: U) -> V),
    u0: U,
    depth: Int,
) -> V {
    if depth > 0 {
        let first = own_and_standing_in_parameters(
            (fn(x6: (5, U)) => x6, fn(x7, _y7) => same(x7)),
            7,
            depth - 1,
        );
        let _first: (5, U) = first;
        let second = own_and_standing_in_parameters(
            (fn(x6: (5, U)) => x6, fn(_x7, y7) => same(y7)),
            7,
            depth - 1,
        );
        let _second: Int = second;
        return p.rest(p.first(unchecked_cast::<T>(nil)), u0);
    }

    p.rest(p.first(unchecked_cast::<T>(nil)), u0)
}

test fn own_and_standing_in_parameters_of_one_lambda() -> Int {
    own_and_standing_in_parameters((fn(x: Int) => x, fn(x: Int, y: Int) => x + y), 1, 1)
}

// Guard: `x` stands for the renamed `U`, which `fn(x) => x` returns as the renamed `T`, so what the
// renamed `T` is inferred as for `y` is the renamed `U` there, not the caller's own `U`, and `5`
// makes both of them `Int` (infer-fuzz generator 3, seed 1667, and review)
fn swapped_generics<T, U>(p: (fn(a: U) -> T, fn(b: T) -> T), v: U, depth: Int) -> List<(T, U)> {
    if depth > 0 {
        let inner = swapped_generics((fn(x) => x, fn(y) => y), 5, depth - 1);
        let _inner: List<(Int, Int)> = inner;

        // The same through a call that sees through `x`
        let through_a_call = swapped_generics((fn(x) => same(x), fn(y) => y), 5, depth - 1);
        let _through_a_call: List<(Int, Int)> = through_a_call;
        return nil;
    }

    [(p.rest(p.first(v)), v)]
}

fn swapped_generics_twice<T, U>(
    p: (fn(a: U) -> T, fn(b: T, c: U) -> T),
    v: U,
    depth: Int,
) -> List<(T, U)> {
    if depth > 0 {
        let inner = swapped_generics_twice((fn(x) => x, fn(y, _z) => y), 5, depth - 1);
        let _inner: List<(Int, Int)> = inner;
        return nil;
    }

    [(p.rest(p.first(v), v), v)]
}

test fn stand_ins_returned_as_another_renamed_generic() -> (List<(Int, Int)>, List<(Int, Int)>) {
    (
        swapped_generics((fn(x: Int) => x + 1, fn(y: Int) => y * 2), 3, 1),
        swapped_generics_twice((fn(x: Int) => x + 1, fn(y: Int, z: Int) => y + z), 3, 1),
    )
}

// Guard: `y1`'s type takes the caller's own `U` from `x1`'s annotation, but the body only
// references `y`, which stands for the renamed `U`, so `identity(y)` returns that (infer-fuzz
// generator 3 review, reduced)
fn unreferenced_parameter_with_its_own_generic<T, U>(
    functions: List<fn(a: List<U>, b: T) -> List<U>>,
    value: T,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let inner = unreferenced_parameter_with_its_own_generic(
            [fn(x: List<(5, U)>, _x1: List<(6, U)>) => x, fn(y, _y1) => same(y)],
            nil,
            depth - 1,
        );
        let _inner: List<(5, U)> = inner;

        // A body that uses `_y1` without returning it, such as in a guard, or that destructures
        // it, references it too, so `U` is the caller's own in the lambda's whole type. That doesn't
        // solve the call, so it's solved as if nothing were the caller's own, as without the fix
        let guarded = unreferenced_parameter_with_its_own_generic(
            [
                fn(x: List<(5, U)>, _x1: List<(6, U)>) => x,
                fn(y, y1) => {
                    let _guard = y1 is nil;
                    same(y)
                },
            ],
            nil,
            depth - 1,
        );
        let _guarded: List<(5, U)> = guarded;
        let destructured = unreferenced_parameter_with_its_own_generic(
            [fn(x: List<(5, U)>, _x1: List<(6, U)>) => x, fn(y, [..._rest]) => same(y)],
            nil,
            depth - 1,
        );
        let _destructured: List<(5, U)> = destructured;
        return nil;
    }

    if functions is (fn(a: List<U>, b: T) -> List<U>, List<fn(a: List<U>, b: T) -> List<U>>) {
        functions.first(nil, value)
    } else {
        nil
    }
}

test fn only_referenced_parameters_count_for_the_lambda() -> List<Int> {
    unreferenced_parameter_with_its_own_generic([fn(x: List<Int>, _y: Int) => x], 1, 1)
}

// The same with the caller's own `U` in the second parameter's type, and the first one standing
// for the renamed `U`
fn own_in_the_second_parameter<T, U, V>(
    p: (fn(a: T) -> T, fn(a: U, b: T) -> V),
    u0: U,
    depth: Int,
) -> V {
    if depth > 0 {
        let own = own_in_the_second_parameter(
            (fn(x6: (5, U)) => x6, fn(_x7, y7) => same(y7)),
            7,
            depth - 1,
        );
        let _own: (5, U) = own;
        let standing_in = own_in_the_second_parameter(
            (fn(x6: (5, U)) => x6, fn(x7, _y7) => same(x7)),
            7,
            depth - 1,
        );
        let _standing_in: Int = standing_in;
        return p.rest(u0, p.first(unchecked_cast::<T>(nil)));
    }

    p.rest(u0, p.first(unchecked_cast::<T>(nil)))
}

// The same with another generic, `W`, standing for its renamed one in the second parameter, whether
// the call that sees through them takes one of them or both
fn own_and_another_standing_in<T, U, W, V>(
    p: (fn(a: T) -> T, fn(a: T, b: W) -> V),
    u0: U,
    w0: W,
    depth: Int,
) -> V {
    if depth > 0 {
        let apart = own_and_another_standing_in(
            (fn(x6: (5, U)) => x6, fn(x7, y7) => (x7, same(y7))),
            8,
            7,
            depth - 1,
        );
        let _apart: ((5, U), Int) = apart;
        let together = own_and_another_standing_in(
            (fn(x6: (5, U)) => x6, fn(x7, y7) => same((x7, y7))),
            8,
            7,
            depth - 1,
        );
        let _together: ((5, U), Int) = together;

        // A body that names the caller's own `U` there still sees through `y7`, whose `W` stands
        // for the renamed one
        let named = own_and_another_standing_in(
            (fn(x6: (5, U)) => x6, fn(x7, y7) => (same::<(5, U)>(x7), same(y7))),
            8,
            7,
            depth - 1,
        );
        let _named: ((5, U), Int) = named;
        let annotated = own_and_another_standing_in(
            (
                fn(x6: (5, U)) => x6,
                fn(x7, y7) => {
                    let _k: (5, U) = x7;
                    same(y7)
                },
            ),
            8,
            7,
            depth - 1,
        );
        let _annotated: Int = annotated;
        return p.rest(p.first(unchecked_cast::<T>(nil)), w0);
    }

    p.rest(p.first(unchecked_cast::<T>(nil)), w0)
}

// The same with a spread parameter, which isn't wrapped, so each of the others counts the own
// generics of all of them
fn own_with_a_spread<T, U>(
    functions: List<fn(a: T, ...b: List<T>) -> U>,
    value: T,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let through_a_call = own_with_a_spread(
            [fn(x6: (5, U), ..._r6: List<(5, U)>) => x6, fn(x7, ..._r7) => same(x7)],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _through_a_call: List<(5, U)> = through_a_call;
        let returned = own_with_a_spread(
            [fn(x6: (5, U), ..._r6: List<(5, U)>) => x6, fn(x7, ..._r7) => x7],
            (5, unchecked_cast::<U>(nil)),
            depth - 1,
        );
        let _returned: List<(5, U)> = returned;
        return nil;
    }

    nil
}

test fn own_generics_in_other_parameters() -> (Int, (Int, List<Int>)) {
    (
        own_in_the_second_parameter((fn(x: Int) => x, fn(x: Int, y: Int) => x + y), 1, 1),
        (
            own_and_another_standing_in((fn(x: Int) => x, fn(x: Int, y: Int) => x + y), 1, 2, 1),
            own_with_a_spread([fn(x: Int, ..._r: List<Int>) => x], 6, 1),
        ),
    )
}

// Only the renamed generics that the elements before it give a type count. `T` in the first
// lambda's `(V, V)` stands for the renamed one, which nothing gives a type, so `y30_1` still stands
// for it, and the caller's own `T` in `(5, T)` is only `y79_2`'s (infer-fuzz generator 3 review,
// reduced)
fn only_inferred_renamed_generics<T, U, V>(
    functions: List<fn(a1: T, a2: U) -> U>,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let returned = only_inferred_renamed_generics(
            [
                fn(_x38_1: (V, V), x1_2: (5, T)) => x1_2,
                fn(_x55_1: (V, V), x7_2) => x7_2,
                fn(_y30_1, y79_2) => y79_2,
            ],
            depth - 1,
        );
        let _returned: List<(5, T)> = returned;
        let through_a_call = only_inferred_renamed_generics(
            [
                fn(_x38_1: (V, V), x1_2: (5, T)) => x1_2,
                fn(_x55_1: (V, V), x7_2) => same(x7_2),
                fn(_y30_1, y79_2) => same(y79_2),
            ],
            depth - 1,
        );
        let _through_a_call: List<(5, T)> = through_a_call;
        return nil;
    }

    nil
}

test fn only_renamed_generics_given_a_type_count() -> List<Int> {
    only_inferred_renamed_generics::<Int, Int, Int>([fn(_a: Int, b: Int) => b], 1)
}

fn make_value<M>() -> M {
    unchecked_cast::<M>(nil)
}

// Guard: the arguments after one whose lambda's parameter has the caller's own `U` are compiled
// against what the arguments before them infer as if it didn't, as without the fix, so when the
// call is then solved as if it didn't, it's what it is without the fix too (infer-fuzz generator 3
// review, reduced)
fn arguments_after_own_generics<T, U>(
    functions: List<fn(a: List<U>, b: T) -> List<U>>,
    value: T,
    after: List<U>,
    later: List<fn(a: List<U>, b: T) -> List<U>>,
    depth: Int,
) -> List<U> {
    if depth > 0 {
        let call_after = arguments_after_own_generics(
            [fn(x: List<(5, U)>, _x1: List<(6, U)>) => x, fn(y, [..._rest]) => same(y)],
            nil,
            make_value(),
            nil,
            depth - 1,
        );
        let _call_after: List<(5, U)> = call_after;
        let lambda_after = arguments_after_own_generics(
            [
                fn(x: List<(5, U)>, _x1: List<(6, U)>) => x,
                fn(y, y1) => {
                    let _guard = y1 is nil;
                    same(y)
                },
            ],
            nil,
            nil,
            [fn(w, _w1) => w],
            depth - 1,
        );
        let _lambda_after: List<(5, U)> = lambda_after;
        return nil;
    }

    nil
}

test fn arguments_after_own_generics_are_as_without_them() -> List<Int> {
    arguments_after_own_generics([fn(x: List<Int>, _y: Int) => x], 1, [2], nil, 1)
}

// An untyped lambda that's the first element of a pair after one whose typed lambda gives the
// renamed `T` a type: the result is `Int` rather than `Int | T` (#362, 13k6). The call's inference
// counted its `x7` as the renamed `T` it stands for, not the caller's own `T`; now `x7` is held and
// refined to `Int` (see `HeldLambda`), and that counting is what a lambda compiled where it is gets
fn pairs_of_a_lambda_and_a_value<T, U>(p: List<(fn(a: T) -> U, Int)>, value: T, depth: Int) -> U {
    if depth > 0 {
        let listed = pairs_of_a_lambda_and_a_value(
            [(fn(x6: Int) => x6, 1), (fn(x7) => x7, 1)],
            5,
            depth - 1,
        );
        let _listed: Int = listed;
        return unchecked_cast::<U>(nil);
    }

    if p is ((fn(a: T) -> U, Int), List<(fn(a: T) -> U, Int)>) {
        p.first.first(value)
    } else {
        unchecked_cast::<U>(nil)
    }
}

fn nested_pairs_of_a_lambda<T, U>(
    p: (fn(a: T) -> U, ((fn(a: T) -> U, Int), nil)),
    value: T,
    depth: Int,
) -> U {
    if depth > 0 {
        let nested = nested_pairs_of_a_lambda(
            (fn(x6: Int) => x6, ((fn(x7) => x7, 1), nil)),
            5,
            depth - 1,
        );
        let _nested: Int = nested;
        return unchecked_cast::<U>(nil);
    }

    p.first(value)
}

test fn first_element_lambdas_count_as_the_renamed_generics() -> (Int, Int) {
    (
        pairs_of_a_lambda_and_a_value([(fn(x: Int) => x + 1, 1)], 6, 1),
        nested_pairs_of_a_lambda((fn(x: Int) => x + 2, ((fn(x: Int) => x, 1), nil)), 6, 1),
    )
}

// Guard: a body that returns its parameter on both branches returns the renamed generic twice once
// the parameter counts as it, which would give that generic a candidate with itself in it, so the
// argument's candidates are what they are with the caller's generic it stands for, as without that
fn pick_one<T>(functions: List<fn(a: T, b: T) -> T>, x: T, y: T, depth: Int) -> T {
    if depth > 0 {
        let picked = pick_one(
            [
                fn(a, b) => if depth > 1 {
                    a
                } else {
                    b
                },
            ],
            x,
            y,
            depth - 1,
        );
        let same = pick_one(
            [
                fn(a, _b) => if depth > 1 {
                    a
                } else {
                    a
                },
            ],
            x,
            y,
            depth - 1,
        );
        let _same: T = same;
        return picked;
    }

    if functions is (fn(a: T, b: T) -> T, List<fn(a: T, b: T) -> T>) {
        functions.first(x, y)
    } else {
        x
    }
}

test fn parameters_returned_on_both_branches() -> Int {
    pick_one([fn(a: Int, b: Int) => a + b], 1, 2, 2)
}

// An untyped lambda that's the first element of a pair is held until every argument of the call is
// compiled (see `HeldLambda`), and refined then against what the call is solved with, as any other
// element is, so `x7` is the `Int` that `x6: Int` gives the renamed `T` (or, in
// `first_element_of_a_pair`, the `1` after it, or in `first_element_with_a_later_value`, the `5`
// in the next argument), and `x7 + 1` compiles, where it was the caller's `T` (#362, 13k7 and 13k8)
fn first_element_lambda_body<T, U>(p: List<(fn(a: T) -> U, Int)>, depth: Int) -> U {
    if depth > 0 {
        let listed = first_element_lambda_body(
            [(fn(x6: Int) => x6, 1), (fn(x7) => x7 + 1, 1)],
            depth - 1,
        );
        let _listed: Int = listed;
        return unchecked_cast::<U>(nil);
    }

    unchecked_cast::<U>(nil)
}

fn first_element_with_a_later_value<T, U>(
    p: List<(fn(a: T) -> U, Int)>,
    value: T,
    depth: Int,
) -> U {
    if depth > 0 {
        let listed = first_element_with_a_later_value(
            [(fn(x6: Int) => x6, 1), (fn(x7) => x7 + 1, 1)],
            5,
            depth - 1,
        );
        let _listed: Int = listed;
        return unchecked_cast::<U>(nil);
    }

    if p is ((fn(a: T) -> U, Int), List<(fn(a: T) -> U, Int)>) {
        p.first.first(value)
    } else {
        unchecked_cast::<U>(nil)
    }
}

fn first_element_of_a_pair<T, U>(p: (fn(a: T) -> U, T), depth: Int) -> U {
    if depth > 0 {
        let paired = first_element_of_a_pair((fn(x7) => x7 + 1, 1), depth - 1);
        let _paired: Int = paired;
        return unchecked_cast::<U>(nil);
    }

    p.first(p.rest)
}

// A lambda is refined against what an argument after its own adds to what it reads too, as `[5]`
// does to `T` here, so `x1` is `(5, (5, nil)) | (5, nil)` rather than the `(5, (5, nil))` that the
// rest of its pair alone gives, which the call's `T` wouldn't be assignable to (infer-fuzz
// generator 3, seed 3993, reduced, where `x1` was the caller's `T`), and `second_element_added_to_later`
// for a second element, which was refined from `[5, 5]` alone and rejected
fn added_to_by_a_later_argument<T, U>(pair: (fn(a: T) -> U, T), value: T, depth: Int) -> U {
    if depth > 0 {
        let _inner = added_to_by_a_later_argument((fn(x1) => x1.first, [5, 5]), [5], depth - 1);
        return unchecked_cast::<U>(nil);
    }

    pair.first(value)
}

fn second_element_added_to_later<T, U>(pair: (T, fn(a: T) -> U), value: T, depth: Int) -> U {
    if depth > 0 {
        let _inner = second_element_added_to_later(([5, 5], fn(x1) => x1.first), [5], depth - 1);
        return unchecked_cast::<U>(nil);
    }

    pair.rest(value)
}

// A lambda isn't narrower than what the elements after it add, since it's refined once all of them
// are compiled: `x6` is `(U, 3) | (U, 4)` here, so `x6.rest` compiles, where it was the caller's `U`
// as the first element of its pair, or `(U, 3) | (U, 5)` from the elements before it in
// `nested_after_the_lambda`'s `((u, 3), (((u, 5), fn(x6) => ...), (u, 4)))` (#362, 13k7). Where
// the call's expected type isn't final, as in an argument of `same` with an `Any` required of it,
// it's compiled as before, since the call can be solved again without the caller's generics that
// are its own (`expected_type_not_final`, a guard)
fn widened_after_the_lambda<U>(p: (U, (fn(a: U) -> Int, U)), depth: Int) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        return widened_after_the_lambda(((u, 3), (fn(x6) => x6.rest, (u, 4))), depth - 1);
    }

    p.rest.first(p.first)
}

fn nested_after_the_lambda<U>(p: (U, ((U, fn(a: U) -> Int), U)), depth: Int) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        return nested_after_the_lambda(((u, 3), (((u, 5), fn(x6) => x6.rest), (u, 4))), depth - 1);
    }

    p.rest.first.rest(p.first)
}

fn expected_type_not_final<U>(p: (U, (fn(a: U) -> Int, U)), depth: Int) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let r: Any = same(expected_type_not_final(((u, 3), (fn(_x6) => 1, (u, 3))), depth - 1));
        return unchecked_cast::<Int>(r);
    }

    p.rest.first(p.first)
}

fn widened_in_a_list<U>(p: List<(U, fn(a: U) -> Int)>, depth: Int) -> Int {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        return widened_in_a_list(
            [
                ((u, 3), fn(_x4: (U, Int)) => 1),
                ((u, 4), fn(_x6) => 2),
                ((u, 5), fn(_x7: (U, Int)) => 3),
            ],
            depth - 1,
        );
    }

    0
}

test fn held_lambdas_are_refined_against_the_call() -> (Int, (Int, Int)) {
    (
        first_element_of_a_pair((fn(x: Int) => x + 1, 1), 1),
        (
            widened_after_the_lambda((1, (fn(x: Int) => x, 2)), 1),
            widened_in_a_list([(1, fn(x: Int) => x)], 1),
        ),
    )
}

fn make_any<M>() -> M {
    unchecked_cast::<M>(nil)
}

// Guards on held lambdas (see `HeldLambda`), each compiled as on main:
// - the list a held lambda is in is recorded once the lambda is compiled, where the other element
//   makes it not assignable, so `fn(_c)` gets `U | 7`
// - a body with a call in it, `same(x)`, is compiled as it would have been where it is
// - so is one whose own return type can add to its parameter's, as `nil` does to `T` in
//   `fn(a: T) -> T`, where `x0` would be `Int` from the `1` and `2`, as a first or second element
// - and a first element that's compiled as it would have been where it is keeps its expected
//   type as it is, with the caller's `U` for `_x3`, where only a union member that didn't match
//   the value, `(U, Int)` for `(1, [v])`, gives `U` a type
fn records_held_lambdas<U>(pair: (List<fn(a: Int) -> U>, fn(b: U) -> Int), depth: Int) -> List<U> {
    if depth > 0 {
        let inner = records_held_lambdas(
            ([fn(_a) => make_any(), fn(_b) => 7], fn(_c) => 1),
            depth - 1,
        );
        let _inner: List<U | Int> = inner;
        return nil;
    }

    nil
}

fn widened_by_a_later_lambda<T, U>(p: (fn(a: T) -> U, ((T, U), fn(a: U) -> T)), depth: Int) -> (
    T,
    U,
) {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let r = widened_by_a_later_lambda((fn(x) => x, ((1, u), fn(x) => same(x))), depth - 1);
        let _r: (Int | U, Int | U) = r;
        return unchecked_cast::<(T, U)>(nil);
    }

    unchecked_cast::<(T, U)>(nil)
}

fn widened_by_its_own_return<T>(p: (fn(a: T) -> T, T), depth: Int) -> T {
    if depth > 0 {
        let r = widened_by_its_own_return((fn(_x0) => nil, 1), depth - 1);
        return unchecked_cast::<T>(r);
    }

    p.first(p.rest)
}

fn widened_by_its_own_return_second<T>(p: (T, (fn(a: T) -> T, T)), depth: Int) -> T {
    if depth > 0 {
        let r = widened_by_its_own_return_second((1, (fn(_x0) => nil, 2)), depth - 1);
        return unchecked_cast::<T>(r);
    }

    p.first
}

fn given_by_an_unmatched_member<T, U, V>(
    p: ((U, Int) | (Int, T), (fn(a: U) -> V, (U, T))),
    depth: Int,
) -> V {
    if depth > 0 {
        let v = unchecked_cast::<V>(nil);
        let _r = given_by_an_unmatched_member(
            ((1, [v]), (fn(_x3) => unchecked_cast::<T>(nil), make_any())),
            depth - 1,
        );
        return unchecked_cast::<V>(nil);
    }

    unchecked_cast::<V>(nil)
}

// Guards on held lambdas that are compiled as they would have been where they are, as on main: one
// whose body writes the caller's `V`, which its parameter is there, and one whose body has a call in
// it, which takes what a held lambda before it infers there, as `x1: Int` does for `x99`
fn writes_the_callers_generic<T, U, V>(p: List<List<fn(a0: V) -> U>>, depth: Int) -> U {
    if depth > 0 {
        let r = writes_the_callers_generic(
            [[
                fn(x69) => {
                    let _c: V = x69;
                    0
                },
                fn(_x45: (5, V)) => make_any(),
                fn(_x72) => unchecked_cast::<U>(nil),
            ]],
            depth - 1,
        );
        let _r: Int | U = r;
        return unchecked_cast::<U>(nil);
    }

    unchecked_cast::<U>(nil)
}

fn after_an_earlier_held_lambda<T, U>(p: List<fn(a0: T, a1: U) -> T>, depth: Int) -> (U, T) {
    if depth > 0 {
        let t = unchecked_cast::<T>(nil);
        let r = after_an_earlier_held_lambda(
            [fn(x0, _x1: Int) => same(x0), fn(_x31, _x99) => same(t)],
            depth - 1,
        );
        let _r: (Int, T) = r;
        return unchecked_cast::<(U, T)>(nil);
    }

    unchecked_cast::<(U, T)>(nil)
}

// Guard: the pair a held lambda is in is recorded once the lambda is compiled, as before, so the
// `u` before `fn(x4, y2) => y2` gives the renamed `U` a type even though the pair isn't assignable
// to what's expected, and `x0` is `U | T` (infer-fuzz generator 3 review, reduced)
fn with_the_pair_its_in<T, U>(p: List<(U, fn(a: U, b: T) -> U)>, depth: Int) -> List<U> {
    if depth > 0 {
        let u = unchecked_cast::<U>(nil);
        let r = with_the_pair_its_in(
            [(u, fn(_x4, y2) => y2), (same(u), fn(x0, _y2) => x0)],
            depth - 1,
        );
        let _r: List<U> = r;
        return nil;
    }

    nil
}

// Guards from 13k7's reviews, each compiled as on main (generated review sweeps, reduced):
// - an element that's the caller's `T` itself after the lambda (a regression check from 13k7's
//   first design, which nothing in the final one tells apart)
// - an argument after this one for a list item, as `1` adds to `T` after `nil`
// - a union member that a pair with a held lambda in it matches, as `'x'` makes the pair match
//   `(fn(a: T) -> Int, T)`, which is only recorded once the lambda is compiled, so the lambdas are
//   compiled as they would have been where they are
// - an argument after this one that reads the generic the lambda returns, as `fn(_z) => 1` reads
//   `V`, where `u` is the caller's `U` in `T`'s slot
// - a body with a call in it, which can bring in the caller's generics, as the recursive call
//   returns `(U, V)` here
// - a generic that only a union member that already holds the value gives a type, as `2` does `T`
//   in `T | Int`, which the call's expected type can replace, so `x` isn't refined to `Int`
// - and a call without arguments after the lambda, `make_any()`
fn caller_value_after_the_lambda<T>(p: [T, fn(a: T) -> Int, T], depth: Int) -> Int {
    if depth > 0 {
        let t = unchecked_cast::<T>(nil);
        return caller_value_after_the_lambda([t, fn(_x) => 0, 1], depth - 1);
    }

    0
}

fn later_argument_for_a_list_item<T>(p: [fn(a: T) -> Int, T], e: T, depth: Int) -> Int {
    if depth > 0 {
        return later_argument_for_a_list_item([fn(_x) => 0, nil], 1, depth - 1);
    }

    p.first(e)
}

fn matched_through_a_union<T>(
    p: (T, (fn(a: T) -> Int, T) | (fn(a: T) -> Bytes, Bytes)),
