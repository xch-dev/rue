// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

fn first_of<T>(pair: (T, T)) -> T {
    pair.first
}

fn map_limited<A, B>(function: fn(a: A) -> B, value: A, limit: fn(b: B) -> nil) -> B {
    function(value)
}

// `B` is inferred from its own upper bound, so it isn't narrowed by what `A` passes down
fn already_inferred_generic_keeps_its_type() -> nil {
    let value = map_limited(first_of, (1, 2), fn(b: Int | nil) => nil);
    let shown: nil = value;
    shown
}
