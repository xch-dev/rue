// What a union that inference builds prints as in errors, when its members are copies of each other
// and when they only look alike (#362). Each is shown once, however many copies inference keeps,
// which `inferred_union_keeps_at_most_two_copies_of_a_member` pins

fn pick<T>(_first: T, second: T) -> T {
    second
}

fn pick3<T>(_first: T, _second: T, third: T) -> T {
    third
}

fn main() -> Int {
    // `(Int, Int)` is reached twice, from each argument, and printed once
    let either: Int | (Int, Int) = 1;
    let pair: (Int, Int) = (1, 2);
    let _first: Bytes = pick(either, pair);

    // So are three copies of `(Int, Int)`
    let _second: Bytes = pick3(pair, either, pair);

    // Pairs whose inner unions differ in length aren't copies, but the longer one includes the
    // shorter ones
    let shorter: (Int, 1 | 2) = (1, 1);
    let same: (Int, 1 | 2) = (1, 2);
    let longer: (Int, 1 | 2 | 3) = (1, 3);
    let _third: Bytes = pick3(shorter, same, longer);

    // Pairs whose inner unions have the same members in another order include each other
    let forward: (Int, 1 | 2) = (1, 1);
    let again: (Int, 1 | 2) = (1, 2);
    let backward: (Int, 2 | 1) = (1, 1);
    let _fourth: Bytes = pick3(forward, again, backward);

    1
}
