// The callee's generics are only instantiated within the type of the lambda whose parameter has
// them (see `generic_inference_element_lambda_generics.rue`), not in the rest of the argument. In a
// call nested in a call to the same function, which shares its generics, a sibling that captures
// the outer call's value of the generic has the generic itself, and stays rejected

fn identity<Q>(value: Q) -> Q {
    value
}

fn pair2<T, U>(functions: (fn(x: T) -> U, fn(x: T) -> U), value: T) -> U {
    functions.rest(value)
}

fn sibling_lambda_captures_the_shared_generic() -> Int {
    pair2(
        (
            fn(_b) => 1,
            fn(a) => {
                let z: Int = pair2((fn(x) => identity(x), fn(_y) => a), 5);
                z + 1
            },
        ),
        "hi",
    )
}
