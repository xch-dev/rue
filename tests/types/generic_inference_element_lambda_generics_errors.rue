// The unions in these tests overlap on purpose, to test how the compiler handles them
#![allow(indistinguishable_union_member)]

// The callee's generics are only instantiated within the type of the lambda whose parameter has
// them (see `generic_inference_element_lambda_generics.rue`), not in the rest of the argument. In a
// call nested in a call to the same function, which shares its generics, a sibling that captures
// the outer call's value of the generic has the generic itself, and stays rejected

fn identity<Q>(value: Q) -> Q {
    value
}

fn pair2<T, U>(functions: (fn(x: T) -> U, fn(x: T) -> U), value: T) -> U {
    functions.rest(value)
}

fn sibling_lambda_captures_the_shared_generic() -> Int {
    pair2(
        (
            fn(_b) => 1,
            fn(a) => {
                let z: Int = pair2((fn(x) => identity(x), fn(_y) => a), 5);
                z + 1
            },
        ),
        "hi",
    )
}

fn map_list<T, U>(functions: List<fn(x: T) -> U>, value: T) -> List<U> {
    if functions is (fn(x: T) -> U, List<fn(x: T) -> U>) {
        [functions.first(value), ...map_list(functions.rest, value)]
    } else {
        nil
    }
}

fn map_and_call<T, U, V>(functions: List<fn(x: T) -> U>, function: fn(y: Int) -> V, value: T) -> (
    List<U>,
    V,
) {
    (map_list(functions, value), function(1))
}

// A call rejected for another reason only reports that, and doesn't name the callee's generic in
// the element lambda's type
fn rejected_for_another_reason() -> (List<Int>, 1) {
    map_and_call([fn(x) => identity(x)], fn(_y) => "x", 5)
}

fn recursive<T, U>(functions: List<fn(x: T) -> U>, value: T, depth: Int) -> List<U> {
    if depth > 0 {
        // A body that names the caller's `T` needs its parameter to be the caller's `T`, but `5`
        // makes the call's `T` `Int`, so the parameter is `Int`, as with `recursive::<Int, Int>`
        let _named_in_a_call: List<Int> = recursive([fn(x) => identity::<T>(x)], 5, 0);
        let _named_in_a_binding: List<Int> = recursive(
            [
                fn(x) => {
                    let y: T = x;
                    identity(y)
                },
            ],
            5,
            0,
        );
        return map_list(functions, value);
    }

    map_list(functions, value)
}

// Nothing gives `T` a type, so `U`, inferred as `T`, is unresolved too, rather than leaking
// `map_list`'s `T` out of the call
fn generic_inferred_as_an_uninferred_one() -> Bool {
    map_list(
        [fn(x) => x],
        {
            raise;
        },
    )
}

fn map_list_of<T, U>(functions: List<fn(x: T) -> U>, value: T) -> List<U> {
    map_list(functions, value)
}

// A lambda whose body has a call that its return type can be is compiled where it is when the
// call's expected type bounds that return type, against `T` itself, so a body that needs
// its parameter to be `A` is rejected here, although the same call without an expected type
// compiles (see `element_names_the_callers_generic` in `generic_inference_element_lambda_generics.rue`).
// Compiled where it is, the expected type's bound can narrow `T` through the call in its body,
// which `let r: 5 = apply_first((fn(x) => identity(x), 1), 5)` needs, and which it can't once its
// parameter is what the other arguments infer. Which of the two a lambda needs depends on what its
// body does with its parameter, which isn't known before it's compiled
fn element_with_a_call_and_an_expected_type<A>(value: A) -> List<A> {
    let result: List<A> = map_list_of([fn(x) => identity::<A>(x)], value);
    result
}

fn apply_first_of<T, U>(functions: (fn(a: T) -> U, Int), value: T) -> U {
    functions.first(value)
}

fn duplicate<T>(value: T) -> (T, T) {
    (value, value)
}

// A lambda whose body passes its parameter to a call that needs it to be `Int | Bytes` is
// compiled where it is under an expected type, against `T` itself, so it's rejected,
// although `apply_first_of::<Int | Bytes, _>` compiles. As for `identity(x)` in
// `let r: 5 = apply_first_of((fn(x) => identity(x), 1), 5)`, which compiles because it's compiled
// where it is, whether a call keeps the parameter's generic isn't known before the body is
// compiled. Reading a field of the parameter is known never to compile there, so that one waits
// (see `element_reads_a_field_of_its_parameter_under_an_expected_type`)
fn element_passes_its_parameter_to_a_call_under_an_expected_type() -> (Int | Bytes, Int | Bytes) {
    let result: (Int | Bytes, Int | Bytes) = apply_first_of(
        (fn(x) => duplicate::<Int | Bytes>(x), 1),
        5,
    );
    result
}

fn nothing_given<A>() -> A {
    unchecked_cast(nil)
}

fn first_of_a_pair<T, U>(pair: (fn(x: T) -> U, T)) -> U {
    pair.first(pair.rest)
}

fn first_beside_an_int<T, U>(pair: (fn(x: T) -> U, Int)) -> Int {
    pair.rest
}

// A lambda whose body can't use its parameter as a generic, where nothing gives the generic a
// type, is reported as a parameter whose type can't be inferred, rather than by what its body
// does with a generic of the callee's, which the call doesn't name: with a call that has nothing
// to give it after the lambda, and with nothing in the call that has the generic's type at all
fn first_element_with_nothing_to_infer_from() -> Int {
    first_of_a_pair((fn(x) => x + 1, nothing_given()))
}

fn first_element_of_a_generic_nothing_gives() -> Int {
    first_beside_an_int((fn(x) => x.first, 5))
}
