// The callee's generics are only instantiated within the type of the lambda whose parameter has
// them (see `generic_inference_element_lambda_generics.rue`), not in the rest of the argument. In a
// call nested in a call to the same function, which shares its generics, a sibling that captures
// the outer call's value of the generic has the generic itself, and stays rejected

fn identity<Q>(value: Q) -> Q {
    value
}

fn pair2<T, U>(functions: (fn(x: T) -> U, fn(x: T) -> U), value: T) -> U {
    functions.rest(value)
}

fn sibling_lambda_captures_the_shared_generic() -> Int {
    pair2(
        (
            fn(_b) => 1,
            fn(a) => {
                let z: Int = pair2((fn(x) => identity(x), fn(_y) => a), 5);
                z + 1
            },
        ),
        "hi",
    )
}

fn map_list<T, U>(functions: List<fn(x: T) -> U>, value: T) -> List<U> {
    if functions is (fn(x: T) -> U, List<fn(x: T) -> U>) {
        [functions.first(value), ...map_list(functions.rest, value)]
    } else {
        nil
    }
}

fn map_and_call<T, U, V>(functions: List<fn(x: T) -> U>, function: fn(y: Int) -> V, value: T) -> (
    List<U>,
    V,
) {
    (map_list(functions, value), function(1))
}

// A call rejected for another reason only reports that, and doesn't name the callee's generic in
// the element lambda's type
fn rejected_for_another_reason() -> (List<Int>, 1) {
    map_and_call([fn(x) => identity(x)], fn(_y) => "x", 5)
}

fn recursive<T, U>(functions: List<fn(x: T) -> U>, value: T, depth: Int) -> List<U> {
    if depth > 0 {
        // A body that names the caller's `T` needs its parameter to be the caller's `T`, but `5`
        // makes the call's `T` `Int`, so the parameter is `Int`, as with `recursive::<Int, Int>`
        let _named_in_a_call: List<Int> = recursive([fn(x) => identity::<T>(x)], 5, 0);
        let _named_in_a_binding: List<Int> = recursive(
            [
                fn(x) => {
                    let y: T = x;
                    identity(y)
                },
            ],
            5,
            0,
        );
        return map_list(functions, value);
    }

    map_list(functions, value)
}

// Nothing gives `T` a type, so `U`, inferred as `T`, is unresolved too, rather than leaking
// `map_list`'s `T` out of the call
fn generic_inferred_as_an_uninferred_one() -> Bool {
    map_list(
        [fn(x) => x],
        {
            raise;
        },
    )
}

fn self_feeding<T>(pair: (Int, fn(a: T) -> T), value: T) -> T {
    pair.rest(value)
}

// An element lambda whose return type adds to the generic its parameter reads is compiled where it
// is, against `T` itself, so `x + 1` is rejected, although `self_feeding::<Int>` compiles. Waiting
// for `5`, as a lambda that's the whole argument does, would make `x` what the other arguments
// infer, which is narrower than `T` whenever the lambda returns something else, so it would reject
// `self_feeding((1, fn(_x) => (5, nil)), nil)`, which compiles today (see
// `element_adds_to_what_it_reads`, and infer-fuzz generator 1, seeds 1461, 2955 and 6784), as
// `apply_self(fn(_x) => (5, nil), nil)` is rejected for a lambda that's the whole argument. Which
// of the two a lambda needs depends on what its body returns, which isn't known before it's
// compiled, and a body is only compiled once. With an expected type, such as `Int`, that's what
// `T` is, and it compiles
fn element_returns_what_its_parameter_reads() -> Bool {
    let result = self_feeding((1, fn(x) => x + 1), 5);
    result == 6
}

fn map_list_from<T, U>(functions: List<fn(x: T) -> U>, value: T) -> List<U> {
    map_list(functions, value)
}

// A lambda before a spread whose type has the generic its return type adds to is compiled where it
// is, against `T` itself, as before, since the spread is compiled before a lambda that waits, and
// whether it uses the type it's expected to have (as a generic function's name does, which is
// instantiated against it) isn't known before it's compiled
fn element_before_a_spread_that_reads_its_return_type() -> List<Int> {
    let rest = [fn(x: Int) => x * 2];
    map_list_from([fn(x) => x + 1, ...rest], 5)
}
