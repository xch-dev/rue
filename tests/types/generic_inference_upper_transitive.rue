// A generic inferred through another must satisfy what that one is bounded by from above, so a
// generic that's only bounded from above through another generic can be inferred (#285)

fn identity<U>(value: U) -> U {
    value
}

fn increment(value: Int) -> Int {
    value + 1
}

fn feed<A, B>(first: fn(a: A) -> B, second: fn(b: B) -> Int) -> fn(a: A) -> Int {
    fn(a: A) => second(first(a))
}

test fn feed_identity() -> Int {
    let function = feed(identity, increment);
    function(1)
}

fn feed3<A, B, C>(first: fn(a: A) -> B, second: fn(b: B) -> C, third: fn(c: C) -> Int) -> fn(
    a: A,
) -> Int {
    fn(a: A) => third(second(first(a)))
}

test fn chain_of_three() -> Int {
    let function = feed3(identity, identity, increment);
    function(1)
}

fn forward<A, B>(first: fn(a: A) -> B, second: fn(b: B) -> Int) -> fn(a: A) -> Int {
    feed(first, second)
}

test fn through_several_layers() -> Int {
    let function = forward(identity, increment);
    function(1)
}

fn optional(value: Int | nil) -> Int {
    if value is nil {
        0
    } else {
        value
    }
}

test fn union_upper_bound() -> Int {
    let function = feed(identity, optional);
    function(nil) + function(1)
}

fn wrap<T>(value: T) -> (T, nil) {
    (value, nil)
}

fn first(pair: (Int, nil)) -> Int {
    pair.first
}

test fn compound_lower_bound() -> Int {
    // `B` is inferred from `(A, nil)` and bounded by `(Int, nil)`, so `A` is bounded by `Int`
    let function = feed(wrap, first);
    function(1)
}

fn duplicate<T>(value: T) -> (T, T) {
    (value, value)
}

fn sum(pair: (Int, Int)) -> Int {
    pair.first + pair.rest
}

test fn instantiated_generic_function() -> Int {
    let function = feed(duplicate, sum);
    function(21)
}

test fn expected_type_still_used() -> Int {
    // `A` falls back to `5` from the expected type, as before
    let function: fn(a: 5) -> Int = feed(identity, increment);
    function(5)
}

test fn nested_calls() -> Int {
    let inner = feed(identity, feed(identity, increment));
    let outer = feed(feed(identity, increment), identity);
    inner(1) + outer(1)
}

test fn nested_call_with_expected_type() -> Int {
    // The inner call has no expected type of its own to fall back to
    let function: fn(a: 5) -> Int = feed(identity, feed(identity, increment));
    function(5)
}

test fn typed_lambda() -> Int {
    let function = feed(identity, fn(b: Int) => b + 1);
    function(1)
}

fn one_or_two(value: 1 | 2) -> Int {
    value
}

test fn literal_union_upper_bound() -> Int {
    // Nothing bounds `A` from below, so it's inferred as the literal union
    let function = feed(identity, one_or_two);
    function(2)
}

fn five_only(value: 5) -> Int {
    value
}

test fn literal_upper_bound() -> Int {
    let function = feed(identity, five_only);
    function(5)
}

fn optional_input<L, G>(value: L | nil, first: fn(a: L) -> G, _second: fn(b: G) -> Int) -> G | nil {
    if value is nil {
        nil
    } else {
        first(value)
    }
}

test fn held_candidate_kept() -> (nil, Int) {
    // `L` is inferred as `nil`, held by the union, as before, rather than given `G`'s bound
    let result = optional_input(nil, identity, optional);
    let checked: nil = result;
    (checked, 1)
}

fn either<A, B>(
    first: fn(a: A) -> B,
    _second: (fn(b: B) -> nil) | (fn(b: 5) -> Int),
    _value: A,
) -> fn(a: A) -> B {
    first
}

test fn bound_from_unmatched_union_member_ignored() -> Int {
    // `five_only` leaves `B` bounded by `5` while it's compared to `fn(b: B) -> nil`, which it
    // doesn't match, so that isn't passed on to `A`, which is inferred as `Int` from `5` as before
    let function: fn(a: Int) -> Int = either(identity, five_only, 5);
    function(1)
}

fn run<A, B>(first: fn(a: A) -> B, second: fn(b: B) -> Int, value: A) -> Int {
    second(first(value))
}

test fn inferred_generic_narrowed_through_another() -> Int {
    // `A` has the lower bound `5`, and reaches `five_only`'s `B ≤ 5` through `A ≤ B`, so it's
    // inferred as `5` rather than widened to `Int` (#337)
    run(identity, five_only, 5)
}

test fn inferred_generic_narrowed_with_an_expected_type() -> Int {
    // The same when the expected type gives `A` a fallback
    let function: fn(a: 5) -> Int = feed(identity, five_only);
    function(5)
}

fn cycle3<A, B, C>(
    first: fn(a: A) -> B,
    second: fn(b: B) -> C,
    _third: fn(c: C) -> A,
    value: A,
) -> C {
    second(first(value))
}

test fn inferred_generic_narrowed_in_a_longer_cycle() -> Int {
    // `A` has `7` and `nil`, and reaches `B ≤ 7 | nil` through `identity`, so it's `7 | nil`
    // rather than `Int | nil` (#337, generator 2)
    let _result = cycle3(identity, fn(s0: 7 | nil) => "a", fn(s0: Bytes) => nil, 7);
    1
}

fn duplicate_both<T>(value: T) -> (T, T) {
    (value, value)
}

fn either_pair(_pair: (Int, Int) | (5, 5)) -> Int {
    1
}

fn run_later<A, B>(first: fn(a: A) -> B, second: fn(b: B) -> Int, _value: A) -> fn(a: A) -> Int {
    fn(a: A) => second(first(a))
}

test fn bound_from_one_of_several_matching_members_not_passed_on() -> Int {
    // `(A, A)` matches both `(Int, Int)` and `(5, 5)`, so `A` isn't bounded by `5`, and stays `Int`
    // for the later `6`
    run_later(duplicate_both, either_pair, 5)(6)
}
