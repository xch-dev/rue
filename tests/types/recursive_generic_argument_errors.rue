type Alt<A, B> = nil | (A, Alt<B, A>);

type Nested<T> = nil | (T, Nested<(T, T)>);

type Even<T> = nil | (T, Odd<T>);
type Odd<T> = (T, Even<(T, T)>);

type Grow<A, B> = nil | (A, Grow<B, (A, A)>);

struct Tree<T> {
    value: T,
    children: Tree<(T, T)> | nil = nil,
}

fn depth<T>(value: T, n: Int) -> T {
    if n == 0 {
        return value;
    }

    let nested: Bytes = depth((value, 1), n - 1);
    value
}

fn tree(value: (Int, Int)) -> Int {
    let tree = Tree::<(Int, Int)> { value: value };
    tree.value.first
}

fn main(nested: Nested<Int>, even: Even<Int>, grow: Grow<Int, Int>) -> Alt<Int, Bytes32> {
    let alt: Alt<Int, Bytes32> = (1, (2, nil));
    let _ = tree((1, 2));
    alt
}
