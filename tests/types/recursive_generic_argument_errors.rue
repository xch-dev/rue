type Alt<A, B> = nil | (A, Alt<B, A>);

type Nested<T> = nil | (T, Nested<(T, T)>);

type Even<T> = nil | (T, Odd<T>);
type Odd<T> = (T, Even<(T, T)>);

type Fixed<T> = nil | (T, Fixed<Int>);

fn depth<T>(value: T, n: Int) -> T {
    if n == 0 {
        return value;
    }

    let nested: Bytes = depth((value, 1), n - 1);
    value
}

fn main(nested: Nested<Int>, even: Even<Int>, fixed: Fixed<Int>) -> Alt<Int, Bytes32> {
    let alt: Alt<Int, Bytes32> = (1, (2, nil));
    alt
}
