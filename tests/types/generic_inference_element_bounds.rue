fn apply<T>(pair: (T, fn(value: T) -> Int)) -> Int {
    pair.rest(pair.first)
}

// The lambda is compiled with `T` inferred from the pair's first element (#350)
test fn lambda_after_a_value_in_a_pair() -> Int {
    apply((1, fn(x) => x))
}

fn apply_nested<T>(pair: (T, (Int, fn(value: T) -> Int))) -> Int {
    pair.rest.rest(pair.first)
}

// Through a nested pair
test fn lambda_in_a_nested_pair() -> Int {
    apply_nested((1, (2, fn(x) => x + 1)))
}

fn apply_all<T>(pairs: List<(T, fn(value: T) -> Int)>) -> Int {
    if pairs is nil {
        return 0;
    }

    pairs.first.rest(pairs.first.first) + apply_all(pairs.rest)
}

// In a list, each lambda is compiled with what the elements before it inferred
test fn lambdas_in_a_list() -> Int {
    apply_all([(1, fn(x) => x), (2, fn(y) => y * 2)])
}

fn apply_list<T>(items: (T, (fn(value: T) -> Int, nil))) -> Int {
    items.rest.first(items.first)
}

// A list item that's a lambda gets the generic's solution from the items before it
test fn lambda_item_after_a_value_in_a_list() -> Int {
    apply_list([1, fn(x) => x])
}

// A call inside the argument infers its own generics, with its own elements, and its lambda is
// compiled with what the outer pair's first element inferred
test fn call_inside_the_argument() -> Int {
    apply((1, fn(x) => apply((x, fn(y) => y))))
}

fn make<U>() -> U {
    unchecked_cast::<U>(nil)
}

fn first<T>(pair: (T, T)) -> T {
    pair.first
}

// A call with no arguments only its expected type can infer, so it needs `T` from the element
// before it
test fn call_without_arguments_after_a_value_in_a_pair() -> Int {
    first((5, make()))
}

fn count<T>(items: List<T>) -> Int {
    if items is nil {
        return 0;
    }

    1 + count(items.rest)
}

// The same in a list
test fn call_without_arguments_after_a_value_in_a_list() -> Int {
    count([5, make()])
}

fn optional<T>(value: T | nil) -> T {
    unchecked_cast::<T>(value)
}

// Guard: a call with arguments infers its own generics from them, so `optional(nil)` is `nil`
// rather than `(Int, Int)` from the element before it, and the guard can match
test fn call_with_arguments_after_a_value_keeps_its_own_inference() -> Int {
    let result = first(((1, 2), optional(nil)));
    if result is nil {
        return 0;
    }
    1
}

// A call with no arguments inside a pair element gets the element's refined type too
test fn call_without_arguments_nested_in_a_pair() -> Int {
    let result = first(((1, 2), (3, make())));
    result.first
}

// The same in a list inside a pair
test fn call_without_arguments_nested_in_a_list() -> Int {
    count([[5], [make()]])
}

// Guard: a call with arguments next to it still infers its own generics from them, using the
// refined type only for the generics they don't give a type, so `optional(nil)` is still `nil`
test fn call_with_arguments_next_to_a_nested_call_without_them() -> Int {
    let result = first(((1, 2), (optional(nil), make())));
    if result.first is nil {
        return 0;
    }
    1
}
