// Where an untyped lambda parameter's type isn't inferred along with the call's generics, so the
// errors are as they were (#362, step 13c)

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn wrap<T>(value: T) -> (T, Int) {
    (value, 1)
}

fn map_spread<A, B>(function: fn(...a: A) -> B, value: A) -> B {
    function(...value)
}

fn apply_to<T>(pair: (fn(value: T) -> T, T)) -> T {
    pair.first(pair.rest)
}

// A call nested in an argument of a call to the same function shares the enclosing call's `T`, so
// what it's inferred as here references that `T`, and the lambdas' `x` and `y` aren't checked as
// that, which would let it leak out of `apply_to`
#[expect(unused_function)]
fn nested_call_to_the_same_function() -> Any {
    apply_to((
        fn(x) => apply_to((
            fn(y) => if false {
                y
            } else {
                x
            },
            1,
        )),
        "hi",
    ))
}

fn call_back<T>(
    pair: (fn(value: T, callback: fn(v: T) -> Int) -> Int, (T, fn(v: T) -> Int)),
) -> Int {
    pair.first(pair.rest.first, pair.rest.rest)
}

fn five_only(value: 5) -> Int {
    value
}

// The inner call shares the outer call's `T`, and the outer lambda's `callback` takes it, so the inner
// lambda's `y` isn't checked as `Int`: that would pass `7` to `five_only`
#[expect(unused_function)]
fn callback_of_an_enclosing_call() -> Int {
    call_back((
        fn(_x, callback) => call_back((fn(y, _other) => callback(y), (7, fn(_z) => 0))),
        (5, five_only),
    ))
}

fn callback_map<A, B>(function: fn(callback: fn(x: A) -> Int, y: A) -> B, value: A) -> B {
    function(fn(_x) => 0, value)
}

// `A` is a parameter of `callback` too, which the lambda passes `5` to, so it isn't narrowed to the
// `7` that `B ≤ 7` would give it through `y`
#[expect(unused_function)]
fn generic_in_a_callback_parameter() -> Int {
    let result: 7 = callback_map(
        fn(callback, y) => {
            let _unused = callback(5);
            y
        },
        7,
    );
    result
}

fn main() -> Int {
    // The lambda returns `x + 0`, not `x`, so the expected bound doesn't reach `x`
    let computed: 5 = map(fn(x) => x + 0, 5);

    // A call that's an argument of an enclosing call is only expected to be what that call has
    // inferred so far, which it can still widen, so it isn't solved again for it
    let nested: (5, Int) = wrap(map(fn(x) => x, 5));

    // `x` would have to be `6`, which `5` isn't, so the call is left as it was and reports `Int`
    let unfitting: 6 = map(fn(x) => x, 5);

    // A spread parameter and a generic lambda's parameters aren't inferred
    let spread: 5 = map_spread(fn(...values) => values, 5);
    let generic: 5 = map(fn<T>(x) => x, 5);

    // The lambda's `1` doesn't fit the expected `2`, so the call is left as it was and reports
    // `(Int, 1)`
    let mismatched: (5, 2) = map(fn(x) => (x, 1), 5);

    // A cast's type is only a hint, so the call is solved as before and the cast still fails
    let cast = map(fn(x) => x, 5) as 5;

    // Without an expected type nothing bounds the return type, so `x` is `Int` as before
    let unbounded = map(fn(x) => x, 5);
    let five: 5 = unbounded;

    computed + nested.first + unfitting + spread + generic + mismatched.first + cast + five
}
