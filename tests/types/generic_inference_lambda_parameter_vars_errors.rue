// Where an untyped lambda parameter's type isn't inferred along with the call's generics, so the
// errors are as they were (#362, step 13c)

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn wrap_with<T>(_first: T, value: T) -> (T, Int) {
    (value, 1)
}

fn map_spread<A, B>(function: fn(...a: A) -> B, value: A) -> B {
    function(...value)
}

fn apply_to<T>(pair: (fn(value: T) -> T, T)) -> T {
    pair.first(pair.rest)
}

// A call nested in an argument of a call to the same function shares the enclosing call's `T`, and
// the inner lambda's body references `x`, which is that `T` too, so `y` isn't checked as what the
// inner call infers `T` as: `x` would leak out of `apply_to` as that
#[expect(unused_function)]
fn nested_call_to_the_same_function() -> Any {
    apply_to((
        fn(x) => apply_to((
            fn(y) => if false {
                y
            } else {
                x
            },
            1,
        )),
        "hi",
    ))
}

fn call_back<T>(
    pair: (fn(value: T, callback: fn(v: T) -> Int) -> Int, (T, fn(v: T) -> Int)),
) -> Int {
    pair.first(pair.rest.first, pair.rest.rest)
}

fn five_only(value: 5) -> Int {
    value
}

// The inner call shares the outer call's `T`, and the inner lambda's body references the outer
// lambda's `callback`, which takes it, so `y` isn't checked as `Int`: that would pass `7` to
// `five_only`
#[expect(unused_function)]
fn callback_of_an_enclosing_call() -> Int {
    call_back((
        fn(_x, callback) => call_back((fn(y, _other) => callback(y), (7, fn(_z) => 0))),
        (5, five_only),
    ))
}

fn callback_map<A, B>(function: fn(callback: fn(x: A) -> Int, y: A) -> B, value: A) -> B {
    function(fn(_x) => 0, value)
}

// `A` is a parameter of `callback` too, which the lambda passes `5` to, so it isn't narrowed to the
// `7` that `B ≤ 7` would give it through `y`
#[expect(unused_function)]
fn generic_in_a_callback_parameter() -> Int {
    let result: 7 = callback_map(
        fn(callback, y) => {
            let _unused = callback(5);
            y
        },
        7,
    );
    result
}

struct Wrapper<T> {
    value: T,
    other: Int,
}

fn struct_map<A, B>(function: fn(wrapper: Wrapper<A>) -> B, value: A) -> B {
    function(Wrapper::<A> { value, other: 1 })
}

fn optional_map<A, B>(function: fn(x: A | nil) -> B, value: A) -> B {
    function(value)
}

fn mixed_map<A, B>(function: fn(x: (A, Int) | ((Int, Int) | Int, Bytes)) -> B, value: A) -> B {
    function((value, 1))
}

fn main() -> Int {
    // Past `x.first is Int`, `x` is both members, which the `(A, Int)` member alone isn't all of,
    // so it's narrowed as before, and its `rest` can still be `Bytes`
    let mixed: Int = mixed_map(
        fn(x) => if x.first is Int {
            x.rest
        } else {
            0
        },
        5,
    );

    // Past `Bytes`, `x` is `nil | (Int, Int)`, where only `nil` is a member of `A | nil` on its own,
    // which has no reference, so it's narrowed as before and `Bytes` doesn't fit the `nil` expected
    let pair_or_bytes: (Int, Int) | Bytes = "hi";
    let narrowed: nil = optional_map(
        fn(x) => if x is Bytes {
            x
        } else {
            nil
        },
        pair_or_bytes,
    );

    // `other` is `Int` whatever `A` is, so it doesn't reference `A`, and isn't narrowed to `1`
    let other: 1 = struct_map(fn(wrapper) => wrapper.other, 5);

    // The lambda returns `x + 0`, not `x`, so the expected bound doesn't reach `x`
    let computed: 5 = map(fn(x) => x + 0, 5);

    // `wrap_with`'s `T` has to hold the `1` too, so no instantiation gives `(5, Int)`, and `map` is
    // solved as before
    let nested: (5, Int) = wrap_with(1, map(fn(x) => x, 5));

    // `x` would have to be `6`, which `5` isn't, so the call is left as it was and reports `Int`
    let unfitting: 6 = map(fn(x) => x, 5);

    // A spread parameter and a generic lambda's parameters aren't inferred
    let spread: 5 = map_spread(fn(...values) => values, 5);
    let generic: 5 = map(fn<T>(x) => x, 5);

    // The lambda's `1` doesn't fit the expected `2`, so the call is left as it was and reports
    // `(Int, 1)`
    let mismatched: (5, 2) = map(fn(x) => (x, 1), 5);

    // A cast's type is only a hint, so the call is solved as before and the cast still fails
    let cast = map(fn(x) => x, 5) as 5;

    // Without an expected type nothing bounds the return type, so `x` is `Int` as before
    let unbounded = map(fn(x) => x, 5);
    let five: 5 = unbounded;

    let _narrowed = (narrowed, mixed);
    other + computed + nested.first + unfitting + spread + generic + mismatched.first + cast + five
}
