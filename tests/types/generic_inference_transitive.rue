// Generics that are inferred from other generics are resolved through them (#146)

fn identity<T>(value: T) -> T {
    value
}

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn map_reversed<A, B>(value: A, function: fn(a: A) -> B) -> B {
    function(value)
}

fn chain<A, B, C>(first: fn(a: A) -> B, second: fn(b: B) -> C, value: A) -> C {
    second(first(value))
}

fn cycle<A, B>(forward: fn(a: A) -> B, _backward: fn(b: B) -> A, value: A) -> B {
    forward(value)
}

test fn map_identity() -> Int {
    let result = map(identity, 42);
    result + 1
}

test fn map_identity_reversed() -> Int {
    let result = map_reversed(42, identity);
    result + 1
}

test fn chain_of_three() -> Int {
    let result = chain(identity, identity, 42);
    result + 1
}

test fn cycle_between_generics() -> Int {
    let result = cycle(identity, identity, 42);
    result + 1
}

fn compose<A, B>(function: fn(a: A) -> B) -> fn(a: A) -> B {
    function
}

test fn through_generic_from_expected_type() -> Int {
    // Only the expected type gives `A` a type, and `B` is inferred through it
    let function: fn(a: Int) -> Int = compose(identity);
    function(42) + 1
}

fn swap<A, B>(depth: Int, first: A, second: B) -> (A, B) {
    if depth == 0 {
        (first, second)
    } else {
        // `A` and `B` are inferred as each other, which here are the caller's own generics
        let (b, a) = swap(depth - 1, second, first);
        (a, b)
    }
}

test fn recursive_call_with_swapped_generics() -> Int {
    let result = swap(3, 42, sha256("hello"));
    result.first + 1
}

fn shift<A, B>(depth: Int, first: A, second: B) -> (A, B) {
    if depth == 0 {
        (first, second)
    } else {
        // The function's own generics are in scope, so `A` is inferred as the caller's `B`,
        // rather than resolved through what `B` is inferred as here
        let (b, _) = shift(depth - 1, second, 1);
        (first, b)
    }
}

test fn recursive_call_with_generics_in_scope() -> Int {
    let result = shift(3, 42, sha256("hello"));
    result.first + 1
}
