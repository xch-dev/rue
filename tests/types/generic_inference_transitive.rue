// Generics that are inferred from other generics are resolved through them (#146)

fn identity<T>(value: T) -> T {
    value
}

fn map<A, B>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn map_reversed<A, B>(value: A, function: fn(a: A) -> B) -> B {
    function(value)
}

fn map_flipped<B, A>(function: fn(a: A) -> B, value: A) -> B {
    function(value)
}

fn chain<A, B, C>(first: fn(a: A) -> B, second: fn(b: B) -> C, value: A) -> C {
    second(first(value))
}

fn cycle<A, B>(forward: fn(a: A) -> B, _backward: fn(b: B) -> A, value: A) -> B {
    forward(value)
}

test fn map_identity() -> Int {
    let result = map(identity, 42);
    result + 1
}

test fn map_identity_reversed() -> Int {
    let result = map_reversed(42, identity);
    result + 1
}

test fn generics_declared_out_of_order() -> Int {
    let result = map_flipped(identity, 42);
    result + 1
}

test fn chain_of_three() -> Int {
    let result = chain(identity, identity, 42);
    result + 1
}

test fn cycle_between_generics() -> Int {
    let result = cycle(identity, identity, 42);
    result + 1
}

fn increment(value: Int) -> Int {
    value + 1
}

fn cycle_bounded<A, B>(
    forward: fn(a: A) -> B,
    _backward: fn(b: B) -> A,
    _bound: fn(b: B) -> Int,
) -> fn(a: A) -> B {
    forward
}

fn pure_cycle<A, B>(forward: fn(a: A) -> B, _backward: fn(b: B) -> A) -> fn(a: A) -> B {
    forward
}

test fn cycle_resolved_through_other_generic() -> Int {
    // Only `B` has a bound of its own, and `A` is resolved through it
    let function = cycle_bounded(identity, identity, increment);
    function(42) + 1
}

test fn cycle_resolved_from_expected_type() -> Int {
    let function: fn(a: Int) -> Int = pure_cycle(identity, identity);
    function(42) + 1
}

fn cycle3_bounded<A, B, C>(
    forward: fn(a: A) -> B,
    _middle: fn(b: B) -> C,
    _backward: fn(c: C) -> A,
    _bound: fn(b: B) -> Int,
) -> fn(a: A) -> B {
    forward
}

test fn cycle_resolved_through_other_generics_in_turn() -> Int {
    // Only `B` has a bound of its own, `C` is resolved through it, and then `A` through `C`
    let function = cycle3_bounded(identity, identity, identity, increment);
    function(42) + 1
}

fn cycle4<A, B, C, D>(
    first: fn(a: A) -> B,
    second: fn(b: B) -> C,
    third: fn(c: C) -> D,
    _fourth: fn(d: D) -> A,
    value: A,
) -> D {
    third(second(first(value)))
}

test fn cycle_of_four() -> Int {
    let result = cycle4(identity, identity, identity, identity, 42);
    result + 1
}

fn pure_cycle_returning_b<A, B>(_forward: fn(a: A) -> B, _backward: fn(b: B) -> A) -> B {
    unchecked_cast(42)
}

test fn cycle_resolved_from_expected_type_of_one_generic() -> Int {
    // Only `B` is given a type by the expected type, and `A` is resolved through it
    let result: Int = pure_cycle_returning_b(identity, identity);
    result + 1
}

fn compose<A, B>(function: fn(a: A) -> B) -> fn(a: A) -> B {
    function
}

test fn through_generic_from_expected_type() -> Int {
    // Only the expected type gives `A` a type, and `B` is inferred through it
    let function: fn(a: Int) -> Int = compose(identity);
    function(42) + 1
}

fn swap<A, B>(depth: Int, first: A, second: B) -> (A, B) {
    if depth == 0 {
        (first, second)
    } else {
        // `A` and `B` are inferred as each other, which here are the caller's own generics. Both
        // only being bounded by the other, they're left as they are either way, so the generics
        // in scope are covered by `shift` below
        let (b, a) = swap(depth - 1, second, first);
        (a, b)
    }
}

test fn recursive_call_with_swapped_generics() -> Int {
    let result = swap(3, 42, sha256("hello"));
    result.first + 1
}

fn shift<A, B>(depth: Int, first: A, second: B) -> (A, B) {
    if depth == 0 {
        (first, second)
    } else {
        // The function's own generics are in scope, so `A` is inferred as the caller's `B`,
        // rather than resolved through what `B` is inferred as here
        let (b, _) = shift(depth - 1, second, 1);
        (first, b)
    }
}

test fn recursive_call_with_generics_in_scope() -> Int {
    let result = shift(3, 42, sha256("hello"));
    result.first + 1
}
