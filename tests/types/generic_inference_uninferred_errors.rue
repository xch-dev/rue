fn get<T>() -> T {
    unchecked_cast(nil)
}

fn identity<T>(value: T) -> T {
    value
}

fn apply<T>(function: fn(value: T) -> T) -> T {
    function(unchecked_cast(5))
}

fn main() -> Int {
    let no_arguments = get();
    let lambda = apply(fn(value) => value);
    let unchecked = identity(unchecked_cast(5));
    no_arguments
        + lambda
        + unchecked
        + partial()
        + empty_generic_arguments()
        + nested_calls()
        + nested_union()
}

fn wrap<A, B>(value: A) -> (A, B) {
    (value, unchecked_cast(nil))
}

mod nested {
    export fn get<T>() -> T {
        unchecked_cast(nil)
    }
}

fn partial() -> Int {
    let pair = wrap::<Int>(1);
    let path = nested::get();
    pair.first + path
}

fn empty_generic_arguments() -> Int {
    let value = get::<>();
    value
}

fn both<A, B>(first: A, second: B) -> (A, B) {
    (first, second)
}

fn nested_calls() -> Int {
    let inner = identity(get());
    let pair = both(get(), identity(get()));
    let missing = identity(missing);
    let expected: Int = identity(identity(get()));
    inner + pair.first + pair.rest + missing + expected
}

fn make_function<T>() -> fn(value: T | nil) -> Int {
    fn(_value: T | nil) => 1
}

fn take_function<U>(_function: fn(value: U | nil) -> Int) -> Int {
    1
}

fn nested_union() -> Int {
    take_function(make_function())
}
