fn get<T>() -> T {
    unchecked_cast(nil)
}

fn identity<T>(value: T) -> T {
    value
}

fn apply<T>(function: fn(value: T) -> T) -> T {
    function(unchecked_cast(5))
}

fn main() -> Int {
    let no_arguments = get();
    let lambda = apply(fn(value) => value);
    let unchecked = identity(unchecked_cast(5));
    no_arguments + lambda + unchecked
}
