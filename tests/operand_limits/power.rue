// These tests are compiled with `operand_limits` (see `power.yaml`), and run with `LIMITS`, which
// makes `*` fail for an operand longer than 256 bytes. A power is compiled to the multiplications
// that the product of that many copies of the base is, so it fails exactly when that product
// does, in both debug and release builds. `tests/power/expansion.rue` has the powers compiled
// without it.

// The base is an operand of the product, so a base that's too long fails
test fn long_base(x: Int) -> Int {
    x ** 2
}

test fn long_base_by_hand(x: Int) -> Int {
    x * x
}

test fn short_base(x: Int) -> Int {
    x ** 2
}

// Each product is an operand of the next one, so they aren't flattened into one product, and the
// square of a 200 byte base is too long to be multiplied again, as it is when written by hand
test fn long_square(x: Int) -> Int {
    x ** 3
}

test fn long_square_by_hand(x: Int) -> Int {
    x * x * x
}

test fn short_square(x: Int) -> Int {
    x ** 3
}

// A power that isn't used is still evaluated, since it may fail
test fn unused_power(x: Int) -> Int {
    let _unused = x ** 2;
    1
}

// It isn't moved into the branch that uses it either
test fn conditional_power(x: Int, flag: Bool) -> Int {
    let square = x ** 2;
    if flag {
        square
    } else {
        0
    }
}

// A base that's bound is checked the same way
test fn long_bound_base(x: Int) -> Int {
    (x + 1) ** 2
}

// The first power isn't a product, so it doesn't limit the base, and neither does the zeroth
// power, which doesn't use the base
test fn first_power(x: Int) -> Int {
    x ** 1
}

test fn zeroth_power(x: Int) -> Int {
    x ** 0
}

// A power of short constants is still folded
test fn short_constants(flag: Bool) -> Int {
    if flag {
        2 ** 256
    } else {
        0
    }
}

// A power of a constant that's too long isn't folded, so it still fails at runtime
test fn long_constant(flag: Bool) -> Int {
    if flag {
        (
             as Int
        )
            ** 2
    } else {
        0
    }
}

// The square of a 200 byte constant is too long to be multiplied again, so its cube fails at
// runtime too
test fn long_constant_square(flag: Bool) -> Int {
    if flag {
        (
             as Int
        )
            ** 3
    } else {
        0
    }
}

// The square of a 200 byte constant is known to be too long to multiply, so a product with it
// that isn't used is kept, and fails
test fn unused_product_with_long_power() -> Int {
    let _unused = (
         as Int
    )
            ** 2
        * 3;
    1
}

// The first power of a constant is the atom it's written as, so one with leading zeros that
// make it longer than 256 bytes is still too long to multiply
test fn unused_product_with_first_power() -> Int {
    let _unused = (
         as Int
    )
            ** 1
        * 3;
    1
}

// A power of a short constant can't fail if every product before the last is short enough to be
// multiplied again, so a binding of one is moved into the branch that uses it, like a binding of
// the number is
test fn conditional_constant_power(x: Int, flag: Bool) -> Int {
    let scale = 10 ** 18;
    if flag {
        scale + x
    } else {
        x
    }
}

// The cube of a 200 byte constant multiplies its square, which is too long, so it may fail: one
// that isn't used is kept, and one that's used in a branch isn't moved into it
test fn unused_long_constant_cube() -> Int {
    let _unused = (
         as Int
    )
        ** 3;
    1
}

test fn conditional_long_constant_cube(flag: Bool) -> Int {
    let cube = (
         as Int
    )
        ** 3;
    if flag {
        cube
    } else {
        0
    }
}

// Its square only multiplies the constant, which is short enough, so it can't fail, and one
// that isn't used is removed
test fn unused_long_constant_square() -> Int {
    let _unused = (
         as Int
    )
        ** 2;
    1
}

// A constant's length counts its leading zeros, so the square of one that's 257 bytes long may
// fail, while the square of one that's 256 bytes long can't
test fn unused_square_of_long_zeros() -> Int {
    let _unused = (
         as Int
    )
        ** 2;
    1
}

test fn unused_square_of_short_zeros() -> Int {
    let _unused = (
         as Int
    )
        ** 2;
    1
}

// The eighth power of `2 ** 255` is 256 bytes long, so it can still be multiplied, and the ninth
// power can't fail, while the tenth power multiplies the ninth, which is too long
test fn unused_power_at_the_limit() -> Int {
    let _unused = (2 ** 255) ** 9;
    1
}

test fn unused_power_past_the_limit() -> Int {
    let _unused = (2 ** 255) ** 10;
    1
}

// A power that may fail is still evaluated as the base of another power, whatever the exponent
test fn zeroth_power_of_failing_power() -> Int {
    (
        (
             as Int
        )
            ** 3
    )
        ** 0
}

test fn first_power_of_failing_power() -> Int {
    (
        (
             as Int
        )
            ** 3
    )
            ** 1
        % 7
}

test fn square_of_failing_power() -> Int {
    (
        (
             as Int
        )
            ** 3
    )
            ** 2
        % 7
}

// Short powers of constants are known to be short, so operations on them that aren't used are
// removed
test fn unused_operations_on_short_powers(x: Int) -> Int {
    let _product = 2 ** 3 * 2 ** 4;
    let _quotient = 1000 / 10 ** 3;
    x
}

// Const expressions are evaluated without `LIMITS`, so a power in one can be of any length, and
// so can the exponent
test fn long_const_expression() -> Int {
    const {
        (
             as Int
        )
                ** 2
            % 7
    }
}

test fn long_exponent(x: Int) -> Int {
    x
        ** (
            (
                 as Int
            )
                % 3
        )
}

// A power can fail the way its product can, so as the right operand of `||` it's only evaluated
// when the left operand doesn't decide the result
fn any_large_square(items: List<Int>) -> Bool {
    if items is nil {
        return false;
    }

    items.first > 100 || items.first ** 2 > 100 || any_large_square(items.rest)
}

fn any_large_square_by_hand(items: List<Int>) -> Bool {
    if items is nil {
        return false;
    }

    items.first > 100 || items.first * items.first > 100 || any_large_square_by_hand(items.rest)
}

test fn square_is_skipped(items: List<Int>) -> Bool {
    any_large_square(items)
}

test fn square_is_skipped_by_hand(items: List<Int>) -> Bool {
    any_large_square_by_hand(items)
}
