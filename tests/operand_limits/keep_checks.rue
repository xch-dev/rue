// These tests are compiled with `operand_limits` (see `keep_checks.yaml`), and run with `LIMITS`,
// which mainnet enforces until hard fork 2. `tests/optimizer/keep_checks.rue` has most of the same
// tests compiled without it.

// `LIMITS` rejects a dividend longer than 256 bytes, so a division of a value that isn't known at
// compile time may fail, and can't be moved into a branch
test fn conditional_division(x: Int, flag: Bool) -> Int {
    let q = x / 2;
    if flag {
        q
    } else {
        0
    }
}

// The same applies to the remainder, and to `divmod` when it's unused
test fn unused_remainder(x: Int) -> Int {
    let _r = x % 7;
    1
}

test fn unused_divmod(x: Int) -> Int {
    let _qr = divmod(x, 7);
    1
}

// `LIMITS` also rejects an operand of a product that's longer than 256 bytes
test fn conditional_product(x: Int, flag: Bool) -> Int {
    let p = x * 3;
    if flag {
        p
    } else {
        0
    }
}

// The inner product is an operand of the outer one, so it's checked too, and the products can't
// be flattened into `x * 15`
test fn nested_product(x: Int) -> Int {
    x * 3 * 5
}

// A constant that's too long isn't folded, so it still fails at runtime
test fn long_constant_division(flag: Bool) -> Int {
    if flag {
         as Int
            / 3
    } else {
        0
    }
}

test fn long_constant_product(flag: Bool) -> Int {
    if flag {
         as Int
            * 3
    } else {
        0
    }
}

// `x % 2 == 1` isn't rewritten to `logand`, which doesn't limit `x`, so a long `x` fails as it does
// in a debug build
test fn odd_check(x: Int) -> Bool {
    x % 2 == 1
}

test fn short_odd_check(x: Int) -> Bool {
    x % 2 == 1
}

// Short constants are still folded
test fn short_constants(flag: Bool) -> Int {
    if flag {
        6 * 7 / 2 % 5
    } else {
        0
    }
}

// Const expressions are evaluated without `LIMITS`, so they can use operands of any length
test fn long_const_expression() -> Int {
    const {
         as Int
            * 3
            % 7
    }
}

// The `product` builtin is checked like `*`
test fn conditional_builtin_product(x: Int, flag: Bool) -> Int {
    let p = product([x, 3]);
    if flag {
        p
    } else {
        0
    }
}

// A short divisor is allowed whatever its encoding, but the dividend `x` isn't known at compile
// time, so both divisions are kept (see `tests/optimizer/keep_checks_shift.rue`)
test fn divide_long_zero_constant(x: Int, flag: Bool) -> Int {
    let quotient = x / (0x0000000000 as Int);
    if flag {
        quotient
    } else {
        0
    }
}

test fn divide_long_one_constant(x: Int, flag: Bool) -> Int {
    let quotient = x / (0x0000000001 as Int);
    if flag {
        quotient
    } else {
        0
    }
}

// A constant that's too long can fail too, so a binding of it isn't moved into the branch, where
// it would be skipped when `flag` is false
test fn long_constant_dividend_binding(flag: Bool) -> Int {
    let q =  as Int
        / 3;
    if flag {
        q
    } else {
        0
    }
}

test fn long_constant_divisor_binding(flag: Bool) -> Int {
    let r = 5
        / (
             as Int
        );
    if flag {
        r
    } else {
        0
    }
}

test fn long_constant_product_binding(flag: Bool) -> Int {
    let p =  as Int
        * 3;
    if flag {
        p
    } else {
        0
    }
}

// Short constants can't fail, so the division is folded into the branch
test fn short_constant_binding(flag: Bool) -> Int {
    let q = 7 / 3;
    if flag {
        q
    } else {
        0
    }
}
