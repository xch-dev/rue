// What a `for` expression rejects

fn main(xs: List<Int>, pair: (Int, Int), value: Int) -> Int {
    // The list must be a list
    let a = for x in value { x };
    let b = for x in pair { x };

    // The filter must be a condition
    let c = for x in xs if x { x };

    // The body can't return from the function
    let d = for x in xs {
        return x;
    };

    // A fold's body must give the fold's type, which is `Int` for a literal like `0`
    let e = for x in xs fold sum = 0 { "text" };

    // A fold from nil needs a type to build a list, or an expected type
    let f = for x in xs fold rest = nil { [x, ...rest] };

    // A body that isn't a list doesn't say what the type would be
    let p = for x in xs fold last = nil { x };

    // The fold's value must be its type
    let g = for x in xs fold sum: Int = "text" { sum + x };

    // The item is only in the body, and the result for the rest of the list too
    let h = for x in xs fold sum = 0 { sum + x } + x + sum;

    // The fold's value is the result without an item, so the item isn't in scope in it
    let j = for x in xs fold sum = x { sum + x };

    // A list with no items has nothing to destructure
    let k = for (a, b) in nil { a + b };

    // A fold from nil in a generic call's argument doesn't take the call's generic as its type
    let l = first_or(for x in xs fold rest = nil { [x, ...rest] }, 0);

    // Nor where the generic is only in the parameter that the fold is the argument for
    let o = count(for x in xs fold rest = nil { [x, ...rest] });

    // A fold from nil doesn't take its type from a type that's only a hint, such as a cast's
    let m = (for x in xs fold rest = nil { [x, ...rest] }) as List<Int>;

    // A body whose value is nil is a list of nils where a list is expected, not a loop
    let n: List<Int> = for x in xs { check(x) };

    // A list of the body's values isn't an `Int`
    let i: Int = for x in xs { x };

    length(a)
        + length(b)
        + length(c)
        + length(d)
        + e
        + length(f)
        + g
        + h
        + i
        + j
        + length(k)
        + l
        + length(m)
        + length(n)
        + o
}

fn check(x: Int) {
    assert x > 0;
}

fn count<T>(list: List<T>) -> Int {
    if list is (T, List<T>) {
        1 + count(list.rest)
    } else {
        0
    }
}

fn first_or<T>(list: List<T>, default: T) -> T {
    if list is (T, List<T>) {
        list.first
    } else {
        default
    }
}
