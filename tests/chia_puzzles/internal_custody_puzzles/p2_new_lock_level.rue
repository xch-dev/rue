// Regression test, not for production use. A port of `internal_custody_puzzles/p2_new_lock_level.clsp` from
// chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./p2_new_lock_level.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

fn main(
    public_key: PublicKey,
    rekey_mod_hash: Bytes32,
    new_puzzle_root: Bytes32,
    old_puzzle_root: Bytes32,
    // The singleton's inner puzzle hash and amount.
    singleton: (Bytes32, Int),
) -> List<Condition> {
    let rekey_puzzle_hash = curry_tree_hash(
        rekey_mod_hash,
        [tree_hash([new_puzzle_root as Any, old_puzzle_root, 0])],
    );

    [
        CreateCoin { puzzle_hash: rekey_puzzle_hash, amount: 0 },
        CreateCoin { puzzle_hash: singleton.first, amount: singleton.rest },
        AggSigMe { public_key, message: nil },
    ]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

test fn locks_to_a_new_level() -> Any {
    check([
        pubkey_for_exp(42),
        sha256("rekey_mod"),
        sha256("new_root"),
        sha256("old_root"),
        (sha256("singleton"), 1),
    ])
}
