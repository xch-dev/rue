// Regression test, not for production use. A port of `internal_custody_puzzles/p2_merkle_tree.clsp` from
// chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./p2_merkle_tree.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

fn main(
    inner_puzzle: fn(parameters: Any, solution: Any) -> Any,
    merkle_root: Bytes32,
    curried_args: Any,
    parameters: Any,
    merkle_proof: MerkleProof,
    inner_solution: Any,
) -> Any {
    assert merkle_root == simplify_merkle_proof(tree_hash(parameters), merkle_proof);

    // The curried arguments, if there are any, are prepended to the inner solution.
    let solution = if curried_args is nil {
        inner_solution
    } else {
        (curried_args, inner_solution) as Any
    };

    inner_puzzle(parameters, solution)
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

// A tree with two leaves, each the parameters for the inner puzzle.
inline const LEFT_PARAMETERS: (Int, Int) = (1, 2);
inline const RIGHT_PARAMETERS: String = "right";

fn left_leaf() -> Bytes32 {
    tree_hash_atom(tree_hash(LEFT_PARAMETERS))
}

fn right_leaf() -> Bytes32 {
    tree_hash_atom(tree_hash(RIGHT_PARAMETERS))
}

fn root() -> Bytes32 {
    tree_hash_pair(left_leaf(), right_leaf())
}

// The inner puzzle is `1`, so the output is its whole environment: the parameters and solution.
test fn runs_without_curried_args() -> Any {
    check([1, root(), nil, LEFT_PARAMETERS, (0, [right_leaf()]), [42, 43]])
}

test fn prepends_the_curried_args() -> Any {
    check([1, root(), ["curried"], RIGHT_PARAMETERS, (1, [left_leaf()]), [42]])
}

test fn rejects_the_wrong_proof() -> Any {
    run(main, [1, root(), nil, LEFT_PARAMETERS, (1, [right_leaf()]), nil])
}

test fn reference_rejects_the_wrong_proof() -> Any {
    run(reference, [1, root(), nil, LEFT_PARAMETERS, (1, [right_leaf()]), nil])
}
