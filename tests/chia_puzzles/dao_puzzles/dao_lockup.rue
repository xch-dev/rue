fn wrong_change_amount() -> Any {
    let vote_id = sha256("proposal");
    spend(
        nil,
        sha256("my_id"),
        [
            CreateCoin { puzzle_hash: sha256("my_inner_puzzle"), amount: 30 },
            CreateCoin { puzzle_hash: voted_puzzle_hash(vote_id, nil), amount: 60 },
        ],
        vote_id,
        60,
        nil,
    )
}

test fn rejects_the_wrong_change_amount() -> Any {
    run(main, wrong_change_amount())
}

test fn reference_rejects_the_wrong_change_amount() -> Any {
    run(reference, wrong_change_amount())
}

fn later_revote() -> Any {
    let vote_id = sha256("proposal");
    let active_votes = [sha256("other"), vote_id];
    spend(
        active_votes,
        sha256("my_id"),
        [
            CreateCoin { puzzle_hash: voted_puzzle_hash(vote_id, active_votes), amount: 100 },
            CreatePuzzleAnnouncement { message: vote_message(vote_id, 100) },
        ],
        vote_id,
        100,
        nil,
    )
}

test fn rejects_a_revote_on_a_later_vote() -> Any {
    run(main, later_revote())
}

test fn reference_rejects_a_revote_on_a_later_vote() -> Any {
    run(reference, later_revote())
}
