fn change_without_a_vote() -> Any {
    spend(
        nil,
        sha256("my_id"),
        [CreateCoin { puzzle_hash: sha256("my_inner_puzzle"), amount: 40 }],
        sha256("proposal"),
        60,
        nil,
    )
}

test fn rejects_change_without_a_vote() -> Any {
    run(main, change_without_a_vote())
}

test fn reference_rejects_change_without_a_vote() -> Any {
    run(reference, change_without_a_vote())
}

fn full_vote_after_change() -> Any {
    let vote_id = sha256("proposal");
    spend(
        nil,
        sha256("my_id"),
        [
            CreateCoin { puzzle_hash: sha256("my_inner_puzzle"), amount: 40 },
            CreateCoin { puzzle_hash: voted_puzzle_hash(vote_id, nil), amount: 100 },
        ],
        vote_id,
        60,
        nil,
    )
}

test fn rejects_a_full_vote_after_change() -> Any {
    run(main, full_vote_after_change())
}

test fn reference_rejects_a_full_vote_after_change() -> Any {
    run(reference, full_vote_after_change())
}

fn second_change_coin() -> Any {
    let vote_id = sha256("proposal");
    spend(
        nil,
        sha256("my_id"),
        [
            CreateCoin { puzzle_hash: voted_puzzle_hash(vote_id, nil), amount: 60 },
            CreateCoin { puzzle_hash: sha256("my_inner_puzzle"), amount: 40 },
            CreateCoin { puzzle_hash: sha256("my_inner_puzzle"), amount: 40 },
        ],
        vote_id,
        60,
        nil,
    )
}

test fn rejects_a_second_change_coin() -> Any {
    run(main, second_change_coin())
}

test fn reference_rejects_a_second_change_coin() -> Any {
