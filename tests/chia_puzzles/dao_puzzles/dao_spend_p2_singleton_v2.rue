// Regression test, not for production use. A port of `dao_puzzles/dao_spend_p2_singleton_v2.clsp`
// from chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

import std::singleton::SingletonStruct;

extern fn reference(...solution: Any) -> Any from "./dao_spend_p2_singleton_v2.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

// A coin held by the treasury's p2 singleton puzzle.
struct ParentAmount {
    parent: Bytes32,
    amount: Int,
}

// The conditions to create with one CAT.
struct TailConditions {
    tail_hash: Bytes32,
    conditions: List<Condition>,
}

// The coins of one CAT held by the treasury, in the same order as the conditions.
struct TailCoins {
    tail_hash: Bytes32,
    coins: List<ParentAmount>,
}

fn main(
    treasury_singleton_struct: SingletonStruct,
    cat_mod_hash: Bytes32,
    // XCH conditions, generated by the treasury.
    conditions: List<Condition>,
    list_of_tail_hash_conditions: List<TailConditions>,
    p2_singleton_via_delegated_puzzle_puzzle_hash: Bytes32,
    p2_singleton_parent_amount_list: List<ParentAmount>,
    p2_singleton_tail_hash_parent_amount_list: List<TailCoins>,
    treasury_inner_puzzle_hash: Bytes32,
) -> List<Condition> {
    let p2_puzzle_hash = p2_singleton_via_delegated_puzzle_puzzle_hash;

    // The XCH conditions come after the conditions for the CATs.
    let output = for_each_asset_type(
        cat_mod_hash,
        p2_puzzle_hash,
        list_of_tail_hash_conditions,
        p2_singleton_tail_hash_parent_amount_list,
        conditions,
    );

    [
        AssertMyPuzzleHash {
            puzzle_hash: curry_tree_hash(
                treasury_singleton_struct.mod_hash,
                [tree_hash(treasury_singleton_struct), treasury_inner_puzzle_hash],
            ),
        },
        CreateCoin {
            puzzle_hash: treasury_inner_puzzle_hash,
            amount: 1,
            memos: Memos { value: [treasury_singleton_struct.launcher_id] },
        },
        ...if conditions is nil {
            output
        } else if p2_singleton_parent_amount_list is nil {
            spend_xch_coins(sum_create_coins(conditions), p2_puzzle_hash, nil, nil, 0, output)
        } else {
            let first = p2_singleton_parent_amount_list.first;
            spend_xch_coins(
                sum_create_coins(conditions),
                p2_puzzle_hash,
                coinid(first.parent, p2_puzzle_hash, first.amount),
                p2_singleton_parent_amount_list.rest,
                first.amount,
                output,
            )
        },
    ]
}

// Spends each XCH coin, and returns the change to the p2 singleton puzzle.
fn spend_xch_coins(
    spend_amount: Int,
    p2_puzzle_hash: Bytes32,
    coin_id: Bytes,
    coins: List<ParentAmount>,
    total: Int,
    output: List<Condition>,
) -> List<Condition> {
    [
        CreatePuzzleAnnouncement { message: tree_hash([coin_id, tree_hash(nil)]) },
        AssertCoinAnnouncement { id: sha256(coin_id + "$") },
        ...if coins is nil {
            if total - spend_amount > 0 {
                [
                    CreateCoin {
                        puzzle_hash: p2_puzzle_hash,
                        amount: total - spend_amount,
                        memos: Memos { value: [p2_puzzle_hash] },
                    },
                    ...output,
                ]
            } else {
                output
            }
        } else {
            let coin = coins.first;
            spend_xch_coins(
                spend_amount,
                p2_puzzle_hash,
                coinid(coin.parent, p2_puzzle_hash, coin.amount),
                coins.rest,
                total + coin.amount,
                output,
            )
        },
    ]
}

// The total amount of the positive coins created, which excludes -113 and other magic amounts.
fn sum_create_coins(conditions: List<Condition>) -> Int {
    if conditions is nil {
        return 0;
    }

    let condition = conditions.first;
    let amount = if condition is CreateCoin && condition.amount > 0 {
        condition.amount
    } else {
        0
    };

    amount + sum_create_coins(conditions.rest)
}

fn for_each_asset_type(
    cat_mod_hash: Bytes32,
    p2_puzzle_hash: Bytes32,
    list_of_tail_hash_conditions: List<TailConditions>,
    tail_coins: List<TailCoins>,
    output: List<Condition>,
) -> List<Condition> {
    if list_of_tail_hash_conditions is nil {
        return output;
    }

    // There must be coins for each asset type.
    let all_tail_coins = unchecked_cast::<(TailCoins, List<TailCoins>)>(tail_coins);
    let tail_conditions = list_of_tail_hash_conditions.first;
    let coins = all_tail_coins.first;

    assert tail_conditions.tail_hash == coins.tail_hash;

    let cat_puzzle_hash = curry_tree_hash(
        cat_mod_hash,
        [tree_hash_atom(cat_mod_hash), tree_hash_atom(coins.tail_hash), p2_puzzle_hash],
    );

    for_each_asset_type(
        cat_mod_hash,
        p2_puzzle_hash,
        list_of_tail_hash_conditions.rest,
        all_tail_coins.rest,
        for_each_asset(
            tail_conditions.conditions,
            p2_puzzle_hash,
            cat_puzzle_hash,
            dedupe(coins.coins, nil),
            0,
            sum_create_coins(tail_conditions.conditions),
            output,
        ),
    )
}

// Spends each coin of a CAT. The last one creates the conditions and the change, and the rest
// destroy themselves.
fn for_each_asset(
    conditions: List<Condition>,
    p2_puzzle_hash: Bytes32,
    cat_puzzle_hash: Bytes32,
    coins: List<ParentAmount>,
    total: Int,
    create_coin_sum: Int,
    output: List<Condition>,
) -> List<Condition> {
    if coins is nil {
        return output;
    }

    let coin = coins.first;
    let coin_id = coinid(coin.parent, cat_puzzle_hash, coin.amount);

    let delegated_puzzle_hash = if coins.rest is nil {
        let change = total + coin.amount - create_coin_sum;
        let conditions = if change > 0 {
            [
                CreateCoin {
                    puzzle_hash: p2_puzzle_hash,
                    amount: change,
                    memos: Memos { value: [p2_puzzle_hash] },
                },
                ...conditions,
            ]
        } else {
            conditions
        };
        // The hash of `(q . conditions)`.
        tree_hash((1, conditions))
    } else {
        tree_hash(nil)
    };

    [
        CreatePuzzleAnnouncement { message: tree_hash([coin_id, delegated_puzzle_hash]) },
        AssertCoinAnnouncement { id: sha256(coin_id + "$") },
        ...for_each_asset(
            conditions,
            p2_puzzle_hash,
            cat_puzzle_hash,
            coins.rest,
            total + coin.amount,
            create_coin_sum,
            output,
        ),
    ]
}

// Removes the coins that appear more than once.
fn dedupe(coins: List<ParentAmount>, ids: List<Bytes32>) -> List<ParentAmount> {
    if coins is nil {
        return nil;
    }

    let coin = coins.first;
    let id = sha256(coin.parent + coin.amount as Bytes);

    if contains(id, ids) {
        dedupe(coins.rest, ids)
    } else {
        [coin, ...dedupe(coins.rest, [id, ...ids])]
    }
}

fn contains(item: Bytes32, items: List<Bytes32>) -> Bool {
    if items is nil {
        return false;
    }
    item == items.first || contains(item, items.rest)
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

fn treasury_singleton_struct() -> SingletonStruct {
    SingletonStruct {
        mod_hash: sha256("singleton_mod"),
        launcher_id: sha256("treasury_id"),
        launcher_puzzle_hash: sha256("launcher_puzzle"),
    }
}

fn spend(
    conditions: List<Condition>,
    list_of_tail_hash_conditions: List<TailConditions>,
    xch_coins: List<ParentAmount>,
    tail_coins: List<TailCoins>,
) -> Any {
    [
        treasury_singleton_struct(),
        sha256("cat_mod"),
        conditions,
        list_of_tail_hash_conditions,
        sha256("p2_singleton"),
        xch_coins,
        tail_coins,
        sha256("treasury_inner_puzzle"),
    ]
}

test fn spends_xch_with_change() -> Any {
    check(spend(
        [
            CreateCoin { puzzle_hash: sha256("payee"), amount: 70 },
            CreateCoin { puzzle_hash: sha256("melt"), amount: -113 },
            ReserveFee { amount: 5 },
        ],
        nil,
        [
            ParentAmount { parent: sha256("first"), amount: 50 },
            ParentAmount { parent: sha256("second"), amount: 40 },
        ],
        nil,
    ))
}

test fn spends_all_of_the_xch() -> Any {
    check(spend(
        [CreateCoin { puzzle_hash: sha256("payee"), amount: 50 }],
        nil,
        [ParentAmount { parent: sha256("first"), amount: 50 }],
        nil,
    ))
}

test fn spends_xch_without_coins() -> Any {
    check(spend([ReserveFee { amount: 1 }], nil, nil, nil))
}

test fn spends_cats() -> Any {
    check(
        spend(
            nil,
            [
                TailConditions {
                    tail_hash: sha256("first_tail"),
                    conditions: [CreateCoin { puzzle_hash: sha256("payee"), amount: 25 }],
                },
                TailConditions {
                    tail_hash: sha256("second_tail"),
                    conditions: [CreateCoin { puzzle_hash: sha256("payee"), amount: 10 }],
                },
            ],
            nil,
            [
                TailCoins {
                    tail_hash: sha256("first_tail"),
                    coins: [
                        ParentAmount { parent: sha256("first"), amount: 20 },
                        // A duplicate, which is skipped.
                        ParentAmount { parent: sha256("first"), amount: 20 },
                        ParentAmount { parent: sha256("second"), amount: 30 },
                    ],
                },
                TailCoins {
                    tail_hash: sha256("second_tail"),
                    coins: [ParentAmount { parent: sha256("third"), amount: 10 }],
                },
            ],
        ),
    )
}

test fn spends_xch_and_cats() -> Any {
    check(spend(
        [CreateCoin { puzzle_hash: sha256("payee"), amount: 1 }],
        [TailConditions {
            tail_hash: sha256("first_tail"),
            conditions: [CreateCoin { puzzle_hash: sha256("payee"), amount: 5 }],
        }],
        [ParentAmount { parent: sha256("first"), amount: 3 }],
        [TailCoins {
            tail_hash: sha256("first_tail"),
            coins: [ParentAmount { parent: sha256("second"), amount: 5 }],
        }],
    ))
}

test fn spends_nothing() -> Any {
    check(spend(nil, nil, nil, nil))
}

fn mismatched_tails() -> Any {
    spend(
        nil,
        [TailConditions {
            tail_hash: sha256("first_tail"),
            conditions: [CreateCoin { puzzle_hash: sha256("payee"), amount: 5 }],
        }],
        nil,
        [TailCoins {
            tail_hash: sha256("second_tail"),
            coins: [ParentAmount { parent: sha256("first"), amount: 5 }],
        }],
    )
}

test fn rejects_mismatched_tails() -> Any {
    run(main, mismatched_tails())
}

test fn reference_rejects_mismatched_tails() -> Any {
    run(reference, mismatched_tails())
}
