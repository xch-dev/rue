// Regression test, not for production use. A port of `dao_puzzles/dao_finished_state.clsp` from chia_puzzles, checked
// against the compiled original in the tests below (see tests/chia_puzzles/README.md).

import std::singleton::SingletonStruct;

extern fn reference(...solution: Any) -> Any from "./dao_finished_state.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

fn main(
    singleton_struct: SingletonStruct,
    dao_finished_state_mod_hash: Bytes32,
    my_amount: Int,
) -> List<Condition> {
    let my_inner_puzzle_hash = curry_tree_hash(
        dao_finished_state_mod_hash,
        [tree_hash(singleton_struct), tree_hash_atom(dao_finished_state_mod_hash)],
    );
    let my_puzzle_hash = curry_tree_hash(
        singleton_struct.mod_hash,
        [tree_hash(singleton_struct), my_inner_puzzle_hash],
    );

    [
        AssertMyPuzzleHash { puzzle_hash: my_puzzle_hash },
        AssertMyAmount { amount: my_amount },
        CreateCoin { puzzle_hash: my_inner_puzzle_hash, amount: my_amount },
        CreatePuzzleAnnouncement { message: nil },
    ]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

test fn recreates_itself() -> Any {
    check([
        SingletonStruct {
            mod_hash: sha256("singleton_mod"),
            launcher_id: sha256("proposal_id"),
            launcher_puzzle_hash: sha256("launcher_puzzle"),
        },
        sha256("finished_state_mod"),
        1,
    ])
}
