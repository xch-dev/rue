// Regression test, not for production use. A port of `p2_delegated_puzzle_or_hidden_puzzle.clsp` from chia_puzzles, checked
// against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./p2_delegated_puzzle_or_hidden_puzzle.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "./run.hex";

fn main(
    synthetic_public_key: PublicKey,
    original_public_key: PublicKey | nil,
    delegated_puzzle: fn(...solution: Any) -> List<Condition>,
    solution: Any,
) -> List<Condition> {
    let conditions = delegated_puzzle(...solution);

    if original_public_key is nil {
        return [
            AggSigMe { public_key: synthetic_public_key, message: tree_hash(delegated_puzzle) },
            ...conditions,
        ];
    }

    // The delegated puzzle is the hidden puzzle.
    assert synthetic_public_key == original_public_key
        + pubkey_for_exp(sha256(original_public_key as Bytes + tree_hash(delegated_puzzle)));

    conditions
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

inline const HIDDEN_PUZZLE: (1, List<ReserveFee>) = (1, [ReserveFee { amount: 1 }]);

fn synthetic_public_key() -> PublicKey {
    let original_public_key = pubkey_for_exp(42);
    original_public_key
        + pubkey_for_exp(sha256(original_public_key as Bytes + tree_hash(HIDDEN_PUZZLE)))
}

test fn signs_the_delegated_puzzle() -> Any {
    check([
        synthetic_public_key(),
        nil,
        1,
        [CreateCoin { puzzle_hash: sha256("destination"), amount: 1 }],
    ])
}

test fn reveals_the_hidden_puzzle() -> Any {
    check([synthetic_public_key(), pubkey_for_exp(42), HIDDEN_PUZZLE, nil])
}

test fn rejects_the_wrong_hidden_puzzle() -> Any {
    run(main, [synthetic_public_key(), pubkey_for_exp(42), 1, nil])
}

test fn reference_rejects_the_wrong_hidden_puzzle() -> Any {
    run(reference, [synthetic_public_key(), pubkey_for_exp(42), 1, nil])
}
