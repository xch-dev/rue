// Regression test, not for production use. A port of `consensus_puzzles/rom_bootstrap_generator.clsp`
// from chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./rom_bootstrap_generator.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

struct CoinSpend {
    parent_coin_info: Bytes32,
    puzzle: fn(...solution: Any) -> Any,
    amount: Int,
    solution: Any,
    ...extras: Any,
}

struct RunCoinSpend {
    parent_coin_info: Bytes32,
    puzzle_hash: Bytes32,
    amount: Int,
    conditions: Any,
    ...extras: Any,
}

struct HistoricalBlocks {
    tree: Any,
}

type Deserialize = fn(input: Bytes) -> Any;

fn main(
    // Decompresses the block into its coin spends, followed by extra block-level data.
    block_decompresser_program: fn(deserialize: Deserialize, historical_blocks_tree: Any) -> (
        List<CoinSpend>,
        Any,
    ),
    historical_blocks: HistoricalBlocks,
) -> (List<RunCoinSpend>, Any) {
    let block = block_decompresser_program(deserialize, historical_blocks.tree);
    (run_coin_spends(block.first), block.rest)
}

fn run_coin_spends(coin_spends: List<CoinSpend>) -> List<RunCoinSpend> {
    if coin_spends is nil {
        return nil;
    }

    let coin_spend = coin_spends.first;

    [
        RunCoinSpend {
            parent_coin_info: coin_spend.parent_coin_info,
            puzzle_hash: tree_hash(coin_spend.puzzle),
            amount: coin_spend.amount,
            conditions: coin_spend.puzzle(...coin_spend.solution),
            extras: coin_spend.extras,
        },
        ...run_coin_spends(coin_spends.rest),
    ]
}

// A port of `chialisp_deserialisation.clsp`, which the original includes as compiled CLVM. It
// rejects atoms with a length prefix longer than two bytes.
fn deserialize(input: Bytes) -> Any {
    deserialize_value(input).first
}

fn deserialize_value(input: Bytes) -> (Any, Bytes) {
    if substr(input, 0, 1) == 0xff {
        let first = deserialize_value(substr(input, 1));
        let rest = deserialize_value(first.rest);
        return ((first.first, rest.first), rest.rest);
    }

    deserialize_atom(substr(input, 1), substr(input, 0, 1))
}

fn deserialize_atom(input: Bytes, prefix: Bytes) -> (Any, Bytes) {
    if prefix == 0x80 {
        return (nil, input);
    }

    if !(prefix > 0x7f) {
        return (prefix, input);
    }

    let (size, input) = if prefix > 0xbf {
        assert !(prefix > 0xdf);
        (((31 & prefix as Int) as Bytes + substr(input, 0, 1)) as Int, substr(input, 1))
    } else {
        (63 & prefix as Int, input)
    };

    (substr(input, 0, size), substr(input, size))
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

// A decompresser that deserializes the historical blocks tree as the list of coin spends, followed
// by the block-level extras "extras": `(c (a 2 (c 5 ())) (q . "extras"))`.
fn decompresser() -> Any {
    [4 as Any, [2 as Any, 2, [4 as Any, 5, nil]], (1, "extras")]
}

// Two coin spends: one with the puzzle `1` that creates a coin, and one with a quoted puzzle that
// reserves a fee, followed by the spend-level extra "extra".
inline const COIN_SPENDS: Bytes = 0xffffa01111111111111111111111111111111111111111111111111111111111111111ff01ff01ffffff33ffa02222222222222222222222222222222222222222222222222222222222222222ff01808080ffffa03333333333333333333333333333333333333333333333333333333333333333ffff01ffff34ff058080ff02ff80ff8565787472618080;

test fn runs_the_coin_spends() -> Any {
    check([decompresser(), [COIN_SPENDS]])
}

test fn runs_no_coin_spends() -> Any {
    check([decompresser(), [0x80]])
}

test fn rejects_a_three_byte_length_prefix() -> Any {
    run(main, [decompresser(), [0xffe0000001ff80]])
}

test fn reference_rejects_a_three_byte_length_prefix() -> Any {
    run(reference, [decompresser(), [0xffe0000001ff80]])
}
