// Regression test, not for production use. A port of `nft_puzzles/nft_metadata_updater_updateable.clsp` from chia_puzzles, checked
// against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./nft_metadata_updater_updateable.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

// The metadata is a list of `(key . values)` pairs.
type Metadata = List<(Bytes, List<Bytes>)>;

// What the NFT state layer expects a metadata updater to return.
struct UpdaterOutput {
    state: MetadataState,
    conditions: List<Condition>,
}

struct MetadataState {
    metadata: Metadata,
    updater_puzzle_hash: Bytes32,
}

struct Solution {
    new_url: Bytes,
    // Replaces the updater if it's 32 bytes long.
    new_updater_puzzle_hash: Bytes,
}

fn main(
    current_metadata: Metadata,
    metadata_updater_puzzle_hash: Bytes32,
    solution: Solution,
) -> UpdaterOutput {
    let metadata = if solution.new_url != nil {
        add_url(current_metadata, solution.new_url)
    } else {
        current_metadata
    };

    let updater_puzzle_hash = if solution.new_updater_puzzle_hash is Bytes32 {
        solution.new_updater_puzzle_hash
    } else {
        metadata_updater_puzzle_hash
    };

    UpdaterOutput { state: MetadataState { metadata, updater_puzzle_hash }, conditions: nil }
}

// Prepends the url to the values of the first `u` entry, if there is one.
fn add_url(metadata: Metadata, new_url: Bytes) -> Metadata {
    if metadata is nil {
        return nil;
    }

    let entry = metadata.first;

    if entry.first == "u" {
        return [("u", [new_url, ...entry.rest]), ...metadata.rest];
    }

    [entry, ...add_url(metadata.rest, new_url)]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

fn metadata() -> Metadata {
    [("h", [sha256("data") as Bytes]), ("u", ["https://a"]), ("mu", nil)]
}

test fn adds_a_url() -> Any {
    check([
        metadata(),
        sha256("updater"),
        Solution { new_url: "https://b", new_updater_puzzle_hash: nil },
    ])
}

test fn replaces_the_updater() -> Any {
    check([
        metadata(),
        sha256("updater"),
        Solution { new_url: nil, new_updater_puzzle_hash: sha256("new_updater") },
    ])
}

test fn adds_a_url_and_replaces_the_updater() -> Any {
    check([
        metadata(),
        sha256("updater"),
        Solution { new_url: "https://b", new_updater_puzzle_hash: sha256("new_updater") },
    ])
}

test fn keeps_the_updater_for_a_short_hash() -> Any {
    check([
        metadata(),
        sha256("updater"),
        Solution { new_url: nil, new_updater_puzzle_hash: "short" },
    ])
}

test fn ignores_missing_url_entry() -> Any {
    check([
        [("h", [sha256("data") as Bytes])],
        sha256("updater"),
        Solution { new_url: "https://b", new_updater_puzzle_hash: nil },
    ])
}

test fn keeps_the_updater_for_a_long_hash() -> Any {
    check([
        metadata(),
        sha256("updater"),
        Solution { new_url: nil, new_updater_puzzle_hash: sha256("new_updater") + 0x00 },
    ])
}
