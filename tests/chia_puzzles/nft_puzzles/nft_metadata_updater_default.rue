// Regression test, not for production use. A port of `nft_puzzles/nft_metadata_updater_default.clsp` from chia_puzzles, checked
// against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./nft_metadata_updater_default.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

// The metadata is a list of `(key . values)` pairs.
type Metadata = List<(Bytes, List<Bytes>)>;

// What the NFT state layer expects a metadata updater to return.
struct UpdaterOutput {
    state: MetadataState,
    conditions: List<Condition>,
}

struct MetadataState {
    metadata: Metadata,
    updater_puzzle_hash: Bytes32,
}

fn main(
    current_metadata: Metadata,
    metadata_updater_puzzle_hash: Bytes32,
    solution: (Bytes, Bytes),
) -> UpdaterOutput {
    let (key, new_url) = solution;

    // Only the url lists can be added to, and only with a non-empty url.
    let is_url_key = (key == "mu") | (key == "lu") | (key == "u");
    let metadata = if (key != nil) & (new_url != nil) & is_url_key {
        add_url(current_metadata, key, new_url)
    } else {
        current_metadata
    };

    UpdaterOutput {
        state: MetadataState { metadata, updater_puzzle_hash: metadata_updater_puzzle_hash },
        conditions: nil,
    }
}

// Prepends the url to the values of the first entry with the key. An unknown key is ignored.
fn add_url(metadata: Metadata, key: Bytes, new_url: Bytes) -> Metadata {
    if metadata is nil {
        return nil;
    }

    let entry = metadata.first;

    if entry.first == key {
        return [(key, [new_url, ...entry.rest]), ...metadata.rest];
    }

    [entry, ...add_url(metadata.rest, key, new_url)]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

fn metadata() -> Metadata {
    [("u", ["https://a"]), ("h", [sha256("data") as Bytes]), ("mu", nil), ("lu", ["https://l"])]
}

test fn adds_a_data_url() -> Any {
    check([metadata(), sha256("updater"), ("u", "https://b")])
}

test fn adds_a_metadata_url() -> Any {
    check([metadata(), sha256("updater"), ("mu", "https://m")])
}

test fn adds_a_license_url() -> Any {
    check([metadata(), sha256("updater"), ("lu", "https://l2")])
}

test fn ignores_other_keys() -> Any {
    check([metadata(), sha256("updater"), ("h", sha256("other") as Bytes)])
}

test fn ignores_a_missing_key() -> Any {
    check([[("h", [sha256("data") as Bytes])], sha256("updater"), ("u", "https://b")])
}

test fn ignores_an_empty_url() -> Any {
    check([metadata(), sha256("updater"), ("u", nil)])
}

test fn ignores_an_empty_key() -> Any {
    check([metadata(), sha256("updater"), (nil, "https://b")])
}

test fn updates_only_the_first_duplicate_key() -> Any {
    check([[("u", ["https://a"]), ("u", ["https://b"])], sha256("updater"), ("u", "https://c")])
}
