// Regression test, not for production use. A port of `p2_delegated_conditions.clsp` from chia_puzzles, checked
// against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./p2_delegated_conditions.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "./run.hex";

fn main(public_key: PublicKey, conditions: List<Condition>) -> List<Condition> {
    [AggSigMe { public_key, message: tree_hash(conditions) }, ...conditions]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

test fn signs_the_conditions() -> Any {
    check([pubkey_for_exp(42), [CreateCoin { puzzle_hash: sha256("destination"), amount: 1 }]])
}

test fn signs_no_conditions() -> Any {
    check([pubkey_for_exp(42), nil])
}
