// Regression test, not for production use. A port of `full_node_puzzles/decompress_puzzle.clsp` from
// chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./decompress_puzzle.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";
extern fn deserialize(
    input: Bytes,
) -> Any from "../consensus_puzzles/chialisp_deserialisation.clsp.hex";

// Deserializes a puzzle that was compressed by removing everything but its public key.
fn main(
    deserialize: fn(input: Bytes) -> Any,
    puzzle_prefix: Bytes,
    public_key: Bytes,
    suffix: Bytes,
) -> Any {
    deserialize(puzzle_prefix + public_key + suffix)
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

// The serialization of `(a (q . 1) (c (q . <public key>) 1))` around the public key, which stands in
// for the standard transaction curried with a public key.
inline const PUZZLE_PREFIX: Bytes = 0xff02ffff0101ffff04ffff01b0;
inline const PUZZLE_SUFFIX: Bytes = 0xff018080;

test fn decompresses_a_puzzle() -> Any {
    check([deserialize, PUZZLE_PREFIX, pubkey_for_exp(42), PUZZLE_SUFFIX])
}
