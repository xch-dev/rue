// Regression test, not for production use. A port of `mips_puzzles/member_puzzles/secp256r1_member_puzzle_assert.clsp` from
// chia_puzzles, checked against the compiled original in the tests below (see
// tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./secp256r1_member_puzzle_assert.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../../run.hex";

fn main(
    public_key: R1PublicKey,
    #[trusted] delegated_puzzle_hash: Bytes32,
    my_puzzle_hash: Bytes32,
    signature: R1Signature,
) -> List<Condition> {
    secp256r1_verify(public_key, sha256(delegated_puzzle_hash + my_puzzle_hash), signature);
    [AssertMyPuzzleHash { puzzle_hash: my_puzzle_hash }]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

// Signed with the secret key 12345.
inline const PUBLIC_KEY: R1PublicKey = 0x0226efcebd0ee9e34a669187e18b3a9122b2f733945b649cc9f9f921e9f9dad812 as R1PublicKey;
inline const SIGNATURE: R1Signature = 0xae1a44594b2e9b58b16e2cff2fd90c43be7c866e13c3f5af9522f508cdd023c179c7a2fea6939ee9f5420c1969278c27adc3a39eea505c9515891c916ee8d196 as R1Signature;

// A valid signature, but of the delegated puzzle hash and a different my_puzzle_hash.
inline const OTHER_SIGNATURE: R1Signature = 0x9feb7bbf07c77895755abc78415507ee90a8654aebeea0408bdcaf8f0a6f80e22e32df361a74a0bd6f25cc89de2be2577e18980e811fc392bcad7ca813e0f441 as R1Signature;

test fn verifies_the_signature() -> Any {
    check([PUBLIC_KEY, sha256("delegated_puzzle"), sha256("my_puzzle"), SIGNATURE])
}

test fn rejects_the_wrong_signature() -> Any {
    run(main, [PUBLIC_KEY, sha256("delegated_puzzle"), sha256("my_puzzle"), OTHER_SIGNATURE])
}

test fn reference_rejects_the_wrong_signature() -> Any {
    run(reference, [PUBLIC_KEY, sha256("delegated_puzzle"), sha256("my_puzzle"), OTHER_SIGNATURE])
}

test fn rejects_another_delegated_puzzle() -> Any {
    run(main, [PUBLIC_KEY, sha256("other_puzzle"), sha256("my_puzzle"), SIGNATURE])
}

test fn reference_rejects_another_delegated_puzzle() -> Any {
    run(reference, [PUBLIC_KEY, sha256("other_puzzle"), sha256("my_puzzle"), SIGNATURE])
}
