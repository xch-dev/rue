// Regression test, not for production use. A port of `vc_puzzles/eml_covenant_morpher.clsp` from chia_puzzles,
// checked against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./eml_covenant_morpher.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../run.hex";

// Calculates the parent's puzzle hash, a singleton with an exigent metadata layer whose transfer
// program is a covenant adapter, for the covenant layer's lineage proof.
fn main(
    covenant_mod_hash: Bytes32,
    eml_mod_hash: Bytes32,
    adapter_mod_hash: Bytes32,
    singleton_mod_hash: Bytes32,
    singleton_launcher_hash_hash: Bytes32,
    transfer_program_hash: Bytes32,
    self_hash: Bytes32,
    covenant_initial_puzzle_hash: Bytes32,
    previous_inner_puzzle_hash: Bytes32,
    previous_metadata_hash: Bytes32,
    my_singleton_id: Bytes32,
) -> Bytes32 {
    let covenant_hash = curry_tree_hash(
        covenant_mod_hash,
        [
            tree_hash_atom(covenant_initial_puzzle_hash),
            curry_tree_hash(self_hash, [tree_hash_atom(self_hash)]),
            transfer_program_hash,
        ],
    );
    let adapter_hash = curry_tree_hash(adapter_mod_hash, [covenant_hash]);

    let singleton_struct_hash = tree_hash_pair(
        tree_hash_atom(singleton_mod_hash),
        tree_hash_pair(tree_hash_atom(my_singleton_id), singleton_launcher_hash_hash),
    );
    let eml_hash = curry_tree_hash(
        eml_mod_hash,
        [
            tree_hash_atom(eml_mod_hash),
            previous_metadata_hash,
            adapter_hash,
            tree_hash_atom(adapter_hash),
            previous_inner_puzzle_hash,
        ],
    );

    curry_tree_hash(singleton_mod_hash, [singleton_struct_hash, eml_hash])
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

test fn morphs_the_parent() -> Any {
    check([
        sha256("covenant_mod"),
        sha256("eml_mod"),
        sha256("adapter_mod"),
        sha256("singleton_mod"),
        tree_hash_atom(sha256("launcher")),
        sha256("transfer_program"),
        sha256("self"),
        sha256("initial_puzzle"),
        sha256("previous_inner_puzzle"),
        sha256("previous_metadata"),
        sha256("singleton_id"),
    ])
}
