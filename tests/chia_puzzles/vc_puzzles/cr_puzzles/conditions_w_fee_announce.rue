// Regression test, not for production use. A port of `vc_puzzles/cr_puzzles/conditions_w_fee_announce.clsp` from chia_puzzles,
// checked against the compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./conditions_w_fee_announce.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../../run.hex";

fn main(conditions: List<Condition>, nonce: Bytes) -> List<Condition> {
    [CreateCoinAnnouncement { message: nonce }, ...conditions]
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

test fn announces_the_nonce() -> Any {
    check([[CreateCoin { puzzle_hash: sha256("destination"), amount: 1 }], sha256("nonce")])
}

test fn announces_with_no_conditions() -> Any {
    check([nil, nil])
}
