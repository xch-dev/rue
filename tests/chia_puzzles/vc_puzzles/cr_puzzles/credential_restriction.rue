// Regression test, not for production use. A port of
// `vc_puzzles/cr_puzzles/credential_restriction.clsp` from chia_puzzles, checked against the
// compiled original in the tests below (see tests/chia_puzzles/README.md).

extern fn reference(...solution: Any) -> Any from "./credential_restriction.clsp.hex";
extern fn run(puzzle: Any, solution: Any) -> Any from "../../run.hex";

// The hashes needed to calculate the puzzle hash of a verifiable credential.
struct CredentialStruct {
    mod_hashes: ((Bytes32, Bytes32), (Bytes32, Bytes32)),
    initial_singleton_inner_puzzle_hash: Bytes32,
    // `(concat 2 COVENANT_MOD_HASH)`.
    two_and_covenant_mod_hash: Bytes,
    // The tree hash of `((c PARENT_MORPHER (c EML_DID_TP 1)) . ())`.
    ...rest_covenant_args_hash: Bytes32,
}

type ProofsChecker = fn(proofs: List<Any>, solution: Any) -> Any;

// The prefix of the coin announcements that pay to the credential restriction.
inline const ANNOUNCEMENT_NAMESPACE: Bytes = 0xcd;

fn main(
    credential_struct: CredentialStruct,
    authorized_providers: List<Bytes32>,
    proofs_checker: ProofsChecker,
    self_hash: Bytes32,
    inner_puzzle: fn(...solution: Any) -> List<Condition>,
    proof_of_inclusions: Any,
    proof_checker_solution: Any,
    provider_id: Bytes32,
    credential_id: Bytes32,
    credential_inner_puzzle_hash: Bytes32,
    my_coin_id: Bytes32,
    inner_solution: Any,
) -> List<Condition> {
    let conditions = inner_puzzle(...inner_solution);
    let collapsed = collapse_tree(proof_of_inclusions, nil);

    assert !(proofs_checker(collapsed.proofs, proof_checker_solution) is nil);
    assert contains(provider_id, authorized_providers);

    let singleton_mod_hash = credential_struct.mod_hashes.first.first;
    let singleton_launcher_hash = credential_struct.mod_hashes.first.rest;
    let credential_singleton_struct_hash = tree_hash_pair(
        tree_hash_atom(singleton_mod_hash),
        tree_hash_pair(tree_hash_atom(credential_id), tree_hash_atom(singleton_launcher_hash)),
    );
    let vc_puzzle_hash = vc_puzzle_hash(
        credential_struct,
        provider_id,
        credential_singleton_struct_hash,
        collapsed.tree_hash,
        credential_inner_puzzle_hash,
    );

    [
        AssertMyCoinId { coin_id: my_coin_id },
        // The credential must announce to this coin specifically.
        AssertPuzzleAnnouncement { id: sha256(vc_puzzle_hash + sha256(my_coin_id + 0xca)) },
        ...process_conditions(self_hash, conditions),
    ]
}

fn contains(value: Bytes32, list: List<Bytes32>) -> Bool {
    if list is nil {
        return false;
    }
    value == list.first || contains(value, list.rest)
}

// Wraps created coins in this puzzle, announcing each of them, and refuses announcements that could
// be mistaken for them.
fn process_conditions(self_hash: Bytes32, conditions: List<Condition>) -> List<Condition> {
    if conditions is nil {
        return nil;
    }

    let condition = conditions.first;

    if condition is CreateCoin {
        return [
            CreateCoinAnnouncement {
                message: ANNOUNCEMENT_NAMESPACE
                    + sha256(condition.puzzle_hash + condition.amount as Bytes),
            },
            CreateCoin {
                puzzle_hash: curry_tree_hash(
                    self_hash,
                    [tree_hash_atom(self_hash), condition.puzzle_hash],
                ),
                amount: condition.amount,
                memos: condition.memos,
            },
            ...process_conditions(self_hash, conditions.rest),
        ];
    }

    assert !(
        condition is CreateCoinAnnouncement
            && (condition.message.length == 33)
                & (substr(condition.message, 0, 1) == ANNOUNCEMENT_NAMESPACE)
    );

    [condition, ...process_conditions(self_hash, conditions.rest)]
}

fn vc_puzzle_hash(
    credential_struct: CredentialStruct,
    provider_id: Bytes32,
    credential_singleton_struct_hash: Bytes32,
    proof_hash: Bytes,
    credential_inner_puzzle_hash: Bytes32,
) -> Bytes32 {
    let singleton_mod_hash = credential_struct.mod_hashes.first.first;
    let ownership_layer_mod_hash = credential_struct.mod_hashes.rest.first;
    let adapter_mod_hash = credential_struct.mod_hashes.rest.rest;
    let initial_singleton_inner_puzzle_hash = credential_struct.initial_singleton_inner_puzzle_hash;
    let two_and_covenant_mod_hash = credential_struct.two_and_covenant_mod_hash;
    let rest_covenant_args_hash = credential_struct.rest_covenant_args_hash;

    // The covenant layer, curried with the initial singleton puzzle hash and the rest of its
    // arguments, which is wrapped in the transfer program adapter.
    let initial_puzzle_hash = curry_tree_hash(
        singleton_mod_hash,
        [credential_singleton_struct_hash, initial_singleton_inner_puzzle_hash],
    );
    let covenant_hash = tree_hash_pair(
        tree_hash_atom(2 as Bytes),
        sha256(
            two_and_covenant_mod_hash
                + tree_hash_pair(
                    tree_hash_pair(
                        tree_hash_atom(4 as Bytes),
                        tree_hash_pair(
                            tree_hash_pair(
                                tree_hash_atom(1 as Bytes),
                                tree_hash_atom(initial_puzzle_hash),
                            ),
                            rest_covenant_args_hash,
                        ),
                    ),
                    tree_hash_atom(nil),
                ),
        ),
    );
    let transfer_program_hash = curry_tree_hash(adapter_mod_hash, [covenant_hash]);

    let ownership_layer_hash = curry_tree_hash(
        ownership_layer_mod_hash,
        [
            tree_hash_atom(ownership_layer_mod_hash),
            tree_hash_pair(tree_hash_atom(provider_id), tree_hash_atom(proof_hash)),
            transfer_program_hash,
            tree_hash_atom(transfer_program_hash),
            credential_inner_puzzle_hash,
        ],
    );

    curry_tree_hash(singleton_mod_hash, [credential_singleton_struct_hash, ownership_layer_hash])
}

struct Collapsed {
    tree_hash: Bytes,
    proofs: List<Any>,
}

// Hashes a tree of proofs, where every pair of atoms is a key and value and every other atom is the
// hash of a subtree, and collects the key value pairs.
fn collapse_tree(tree: Any, proofs: List<Any>) -> Collapsed {
    if tree is Bytes {
        return Collapsed { tree_hash: tree, proofs };
    }

    if tree.first is Bytes && tree.rest is Bytes {
        return branch(
            Collapsed { tree_hash: tree_hash_atom(tree.first), proofs: nil },
            Collapsed { tree_hash: tree_hash_atom(tree.rest), proofs: [tree, ...proofs] },
        );
    }

    branch(collapse_tree(tree.first, nil), collapse_tree(tree.rest, proofs))
}

fn branch(left: Collapsed, right: Collapsed) -> Collapsed {
    Collapsed {
        tree_hash: sha256(2 as Bytes + left.tree_hash + right.tree_hash),
        proofs: merge_list(left.proofs, right.proofs),
    }
}

// Runs the port and the reference with the same solution, and checks that they agree.
fn check(solution: Any) -> Any {
    let output = run(main, solution);
    assert tree_hash(output) == tree_hash(run(reference, solution));
    output
}

fn credential_struct() -> CredentialStruct {
    CredentialStruct {
        mod_hashes: (
            (sha256("singleton_mod"), sha256("launcher")),
            (sha256("ownership_layer_mod"), sha256("adapter_mod")),
        ),
        initial_singleton_inner_puzzle_hash: sha256("initial_inner_puzzle"),
        two_and_covenant_mod_hash: 2 as Bytes + sha256("covenant_mod"),
        rest_covenant_args_hash: sha256("rest_covenant_args"),
    }
}

// A proofs checker that returns the proofs, so it accepts any non-empty list of them.
inline const RETURN_PROOFS: Any = 2;

// A tree of proofs with a pre-hashed subtree.
fn proof_of_inclusions() -> Any {
    [(("a", "1") as Any, sha256("subtree")), ("b", "2"), "c", "3"]
}

fn solution(
    proofs_checker: Any,
    proof_of_inclusions: Any,
    provider_id: Bytes32,
    conditions: List<Condition>,
) -> Any {
    [
        credential_struct() as Any,
        [sha256("provider"), sha256("other_provider")],
        proofs_checker,
        sha256("self"),
        1,
        proof_of_inclusions,
        "checker_solution",
        provider_id,
        sha256("credential"),
        sha256("credential_inner_puzzle"),
        sha256("my_coin"),
        conditions,
    ]
}

test fn wraps_created_coins() -> Any {
    check(solution(
        RETURN_PROOFS,
        proof_of_inclusions(),
        sha256("other_provider"),
        [
            CreateCoin {
                puzzle_hash: sha256("destination"),
                amount: 1,
                memos: Memos { value: [sha256("hint")] },
            },
            CreateCoinAnnouncement { message: "message" },
            CreateCoinAnnouncement { message: 0xca + sha256("not_the_namespace") },
            CreateCoinAnnouncement { message: 0xcd + sha256("too_long") + 0x00 },
            CreateCoin { puzzle_hash: sha256("change"), amount: 2 },
        ],
    ))
}

test fn hashes_a_single_proof() -> Any {
    check(solution(RETURN_PROOFS, ("key", "value"), sha256("provider"), nil))
}

test fn hashes_a_prehashed_tree() -> Any {
    // A checker that always accepts, since a pre-hashed tree has no proofs.
    check(solution((1, 1), sha256("tree"), sha256("provider"), nil))
}

fn unauthorized_provider() -> Any {
    solution(RETURN_PROOFS, proof_of_inclusions(), sha256("unknown_provider"), nil)
}

test fn rejects_an_unauthorized_provider() -> Any {
    run(main, unauthorized_provider())
}

test fn reference_rejects_an_unauthorized_provider() -> Any {
    run(reference, unauthorized_provider())
}

fn failed_check() -> Any {
    solution(RETURN_PROOFS, sha256("tree"), sha256("provider"), nil)
}

test fn rejects_a_failed_check() -> Any {
    run(main, failed_check())
}

test fn reference_rejects_a_failed_check() -> Any {
    run(reference, failed_check())
}

fn namespaced_announcement() -> Any {
    solution(
        RETURN_PROOFS,
        proof_of_inclusions(),
        sha256("provider"),
        [CreateCoinAnnouncement { message: 0xcd + sha256("payment") }],
    )
}

test fn rejects_a_namespaced_announcement() -> Any {
    run(main, namespaced_announcement())
}

test fn reference_rejects_a_namespaced_announcement() -> Any {
    run(reference, namespaced_announcement())
}

// A proofs checker that raises with the proofs, `(x 2)`, so the error shows the order they're
// collected in.
fn raised_proofs() -> Any {
    solution([8 as Any, 2], proof_of_inclusions(), sha256("provider"), nil)
}

test fn rejects_with_the_collected_proofs() -> Any {
    run(main, raised_proofs())
}

test fn reference_rejects_with_the_collected_proofs() -> Any {
    run(reference, raised_proofs())
}
