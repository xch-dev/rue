    } else {
        cycle1_f1(n - 1, x) + cycle1_f3(n - 1, x)
    }
}

fn cycle1_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle1_f0(n - 1, x)
    }
}

test fn cycle_1(x: Int, flag: Bool) -> Int {
    let y0 = cycle1_f0(2, x);
    let y1 = cycle1_f3(2, x);
    if flag {
        y0 + y1
    } else {
        0
    }
}

