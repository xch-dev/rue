// The same shape as the first, where nothing can fail, compiles as before

fn control_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f3(n - 1, x)
    }
}

fn control_f1(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f3(n - 1, x)
    }
}

fn control_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f0(n - 1, x)
    }
}

fn control_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f1(n - 1, x) + control_f2(n - 1, x)
    }
}

test fn cycle_that_cannot_fail(x: Int, flag: Bool) -> Int {
    let y0 = control_f2(2, x);
    let y1 = control_f3(2, x);
    let y2 = control_f1(2, x);
    if flag {
        y0 + y1 + y2
    } else {
        0
    }
}
