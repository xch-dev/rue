        cycle2_f3(n - 1, x)
    }
}

fn cycle2_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        0
    } else {
        assert x < 100;
        cycle2_f4(n - 1, x) + cycle2_f2(n - 1, x)
    }
}

fn cycle2_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle2_f0(n - 1, x) + cycle2_f0(n - 1, x)
    }
}

fn cycle2_f4(n: Int, x: Int) -> Int {
    if n < 1 {
        check(x)
    } else {
        cycle2_f1(n - 1, x)
    }
}

test fn cycle_of_5_2(x: Int, flag: Bool) -> Bool {
    let y = cycle2_f0(3, x);
    flag && y == 5
}

