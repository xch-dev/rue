// Functions that call each other in cycles, found by a fuzzer that compared release and debug
// builds. In each, exactly one function can fail, and `main` calls others that only reach it
// through their cycles, so whether each check is kept depends on how the cycles are resolved.
// These were picked because compilers with a bug planted in that (remembering a function's
// result before its strongly connected component is finished, or not noticing that it read an
// unfinished one) drop a check in each of them. Each test must fail for its solution in both builds, except the control at the end
// of the fuzzed cases.

fn check(x: Int) -> Int {
    if x > 10 {
        raise;
    }
    x
}

fn cycle0_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f3(n - 1, x)
    }
}

fn cycle0_f1(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f3(n - 1, x)
    }
}

fn cycle0_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        check(x)
    } else {
        cycle0_f0(n - 1, x)
    }
}

fn cycle0_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f1(n - 1, x) + cycle0_f2(n - 1, x)
    }
}

test fn cycle_0(x: Int, flag: Bool) -> Int {
    let y0 = cycle0_f2(2, x);
    let y1 = cycle0_f3(2, x);
    let y2 = cycle0_f1(2, x);
    if flag {
        y0 + y1 + y2
    } else {
        0
    }
}

fn cycle1_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle1_f1(n - 1, x) + cycle1_f2(n - 1, x)
    }
}

fn cycle1_f1(n: Int, x: Int) -> Int {
    if n < 1 {
