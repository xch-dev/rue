// The same shape as the first, where nothing can fail, compiles as before

fn control_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f3(n - 1, x)
    }
}

fn control_f1(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f3(n - 1, x)
    }
}

fn control_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f0(n - 1, x)
    }
}

fn control_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        control_f1(n - 1, x) + control_f2(n - 1, x)
    }
}

// The control: nothing in this cycle can fail, so it compiles as before and doesn't fail
test fn cycle_that_cannot_fail(x: Int, flag: Bool) -> Int {
    let y0 = control_f2(2, x);
    let y1 = control_f3(2, x);
    let y2 = control_f1(2, x);
    if flag {
        y0 + y1 + y2
    } else {
        0
    }
}

// The value of `x` calls `divides_through_value`, whose body references `x` again. Checking `x`
// first (to decide `y`) mustn't remember the function as unable to fail before `x` is known.
fn divides_through_value(n: Int) -> Int {
    if n == 0 {
        return 0;
    }
    inline let x = divides_through_value(n - 1) + 100 / (n - 1);
    let y = x;
    if n > 10 {
        y
    } else {
        1
    }
}

fn calls_divides_in_branch(n: Int) -> Int {
    let z = divides_through_value(n);
    if n > 100 {
        z
    } else {
        7
    }
}

test fn value_checked_before_its_recursive_function(n: Int) -> Int {
    if n == 5 {
        divides_through_value(n) * 0 + calls_divides_in_branch(n)
    } else {
        calls_divides_in_branch(n)
    }
}

fn unused_divides_through_value(n: Int) -> Int {
    if n == 0 {
        return 0;
    }
    inline let x = unused_divides_through_value(n - 1) + 100 / (n - 1);
    let _y = x;
    1
}

fn calls_unused_divides(n: Int) -> Int {
    let _z = unused_divides_through_value(n);
    7
}

test fn unused_value_checked_before_its_recursive_function(n: Int) -> Int {
    if n == 5 {
        unused_divides_through_value(n) * 0 + calls_unused_divides(n)
    } else {
        calls_unused_divides(n)
    }
}

// A pass over `late_x`'s component reaches `late_y`, which reads the unfinished `late_r`, so the
// component joins `late_r`'s instead of finishing without it
fn late_r(n: Int) -> Int {
    let v = late_x(fn(i: Int) => i, n);
    assert n < 100;
    v
}

fn late_y(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        late_r(n - 1)
    }
}

fn late_x(g: fn(n: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        g(n)
    } else {
        late_x(late_y, n - 1)
    }
}

test fn component_found_in_a_later_pass(n: Int, flag: Bool) -> Int {
    let w = late_r(5);
    let z = late_y(n);
    if flag {
        w + z
    } else {
        0
    }
}

// `finished_a` is finished before `swaps_values` reads it, and doesn't stop `swaps_values` from
// finding the second function value it calls
fn finished_a(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        finished_a(n - 1)
    }
}

fn swaps_values(g: fn(i: Int) -> Int, h: fn(i: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        g(1) + finished_a(1)
    } else {
        swaps_values(h, g, n - 1)
    }
}

test fn finished_component_before_swapped_values(x: Int) -> Int {
    let y = finished_a(1) + swaps_values(fn(i: Int) => i, fn(i: Int) => 100 / (i - 1), 1);
    if x > 0 {
        y
    } else {
        0
    }
}

// `grows_m2` grows after `grows_m1` read it, and then `grows_b` is resolved before the pass ends,
// which mustn't lose that something grew
fn grows_b(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        grows_r(n - 1)
    }
}

fn grows_r(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        grows_m2(fn(i: Int) => i, n - 1) + grows_b(n)
    }
}

fn grows_m2(p: fn(i: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        grows_m1(p, n - 1) + p(n)
    }
}

fn grows_m1(q: fn(i: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        grows_r(n)
    } else {
        grows_m2(q, n - 1)
    }
}

test fn growth_kept_across_nested_component(n: Int, flag: Bool) -> Int {
    let w = grows_r(n);
    let z = grows_m1(fn(i: Int) => 100 / (i - 2), 3);
    if flag {
        w + z
    } else {
        0
    }
}

// The same, where the nested component is finished on its own
fn own_b(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        own_b(n - 1)
    }
}

fn own_r(n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        own_m2(fn(i: Int) => i, n - 1) + own_b(n)
    }
}

fn own_m2(p: fn(i: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        0
    } else {
        own_m1(p, n - 1) + p(n)
    }
}

fn own_m1(q: fn(i: Int) -> Int, n: Int) -> Int {
    if n <= 0 {
        own_r(n)
    } else {
        own_m2(q, n - 1)
    }
}

test fn growth_kept_across_finished_component(n: Int, flag: Bool) -> Int {
    let w = own_r(n);
    let z = own_m1(fn(i: Int) => 100 / (i - 2), 3);
    if flag {
        w + z
    } else {
        0
    }
}
