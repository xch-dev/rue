// Functions that call each other in cycles, found by a fuzzer that compared release and debug
// builds. In each, a check is only reached through the cycle, and origin/main dropped it in
// release builds. Each test must fail for its solution in both builds.

fn check(x: Int) -> Int {
    if x > 10 {
        raise;
    }
    x
}

fn cycle0_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        0
    } else {
        cycle0_f5(n - 1, x) + cycle0_f1(n - 1, x)
    }
}

fn cycle0_f1(n: Int, x: Int) -> Int {
    if n < 1 {
        check(x)
    } else {
        cycle0_f2(n - 1, x)
    }
}

fn cycle0_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f0(n - 1, x)
    }
}

fn cycle0_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f4(n - 1, x) + cycle0_f1(n - 1, x)
    }
}

fn cycle0_f4(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        let c = check(x);
        (
            if n > 1 {
                c
            } else {
                0
            }
        )
            + cycle0_f2(n - 1, x)
    }
}

fn cycle0_f5(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        cycle0_f3(n - 1, x)
    }
}

test fn cycle_of_6_0(x: Int, flag: Bool) -> Int {
    let y = cycle0_f0(3, x);
    if flag {
        y
    } else {
        0
    }
}

fn cycle1_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        let c = check(x);
        (
            if n > 1 {
                c
            } else {
                0
            }
        )
            + cycle1_f1(n - 1, x)
    }
}

fn cycle1_f1(n: Int, x: Int) -> Int {
    if n < 1 {
        0
    } else {
        cycle1_f2(n - 1, x) + cycle1_f2(n - 1, x)
    }
}

fn cycle1_f2(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        let c = check(x);
        (
            if n > 1 {
                c
            } else {
                0
            }
        )
            + cycle1_f4(n - 1, x)
    }
}

fn cycle1_f3(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        assert x < 100;
        cycle1_f4(n - 1, x) + cycle1_f4(n - 1, x)
    }
}

fn cycle1_f4(n: Int, x: Int) -> Int {
    if n < 1 {
        x
    } else {
        assert x < 100;
        cycle1_f0(n - 1, x) + cycle1_f5(n - 1, x)
    }
}

fn cycle1_f5(n: Int, x: Int) -> Int {
    if n < 1 {
        check(x)
    } else {
        cycle1_f3(n - 1, x)
    }
}

test fn cycle_of_6_1(x: Int, flag: Bool) -> Int {
    let y = cycle1_f1(3, x);
    if flag {
        y
    } else {
        0
    }
}

fn cycle2_f0(n: Int, x: Int) -> Int {
    if n < 1 {
        check(x)
    } else {
        cycle2_f1(n - 1, x) + cycle2_f2(n - 1, x)
    }
}

fn cycle2_f1(n: Int, x: Int) -> Int {
