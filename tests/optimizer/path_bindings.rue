// A binding whose value is only a path into the environment, such as a field of a parameter, is
// read where it's referenced rather than bound, if that isn't larger.

struct Point {
    x: Int,
    y: Int,
    z: Int,
}

struct Line {
    _start: Point,
    end: Point,
}

test fn field_used_twice(a: Point, b: Int) -> Int {
    let v = a.z;
    v * v + b
}

// Through another binding that's a path
test fn nested_fields(line: Line) -> Int {
    let end = line.end;
    let z = end.z;
    let x = end.x;
    z * z + x * x + end.y
}

// Both parts of a pair, which isn't the pair itself unless it's put back together in order
test fn both_parts(value: (Int, Int)) -> (Int, (Int, (Int, Int))) {
    let first = value.first;
    let rest = value.rest;
    (first, (rest, (rest, first)))
}

// The value is called, so it's only evaluated once
test fn call_is_bound(f: fn() -> Point) -> Int {
    let point = f();
    let z = point.z;
    z * z + point.x
}

fn check_password(password: Bytes) -> (Bytes, Int) {
    assert sha256(password) == sha256("hunter2");
    (password, password.length)
}

// A field of a value that may fail is still checked at the let statement, whether or not the
// branch that reads it is taken
test fn check_is_kept_when_the_branch_is_not_taken(password: Bytes, unlock: Bool) -> Int {
    let checked = check_password(password);
    let length = checked.rest;

    if unlock {
        length + length
    } else {
        42
    }
}

test fn check_is_kept_when_the_branch_is_taken(password: Bytes, unlock: Bool) -> Int {
    let checked = check_password(password);
    let length = checked.rest;

    if unlock {
        length + length
    } else {
        42
    }
}

inline fn squared_length(pair: (Bytes, Int)) -> Int {
    let length = pair.rest;
    length * length
}

// The argument of an `inline fn` is substituted, so the binding is only a path if the argument is
test fn inline_argument_that_is_a_path(pair: (Bytes, Int)) -> Int {
    squared_length(pair)
}

test fn inline_argument_that_may_fail(password: Bytes) -> Int {
    squared_length(check_password(password))
}

// A closure that reads the binding captures what it's read from instead
test fn captured_by_a_closure(a: Point, flag: Bool) -> Int {
    let z = a.z;
    let f = fn(x: Int) => x + z;
    let g: fn(x: Int) -> Int = if flag {
        f
    } else {
        fn(x: Int) => x - z
    };
    g(z)
}

// A division by a field can fail, so it's not a path
test fn division_is_bound(a: Point) -> Int {
    let quotient = a.x / a.y;
    quotient + quotient
}

struct Wide {
    _a: Int,
    _b: Int,
    _c: Int,
    _d: Int,
    _e: Int,
    _f: Int,
    _g: Int,
    _h: Int,
    i: Int,
}

// A path that's deep enough takes two bytes at each reference, so it's bound once it's referenced
// often enough
test fn deep_path_used_often(wide: Wide) -> Int {
    let i = wide.i;
    i * i + i * i + i * i + i * i + i * i + i * i
}

test fn deep_path_used_twice(wide: Wide) -> Int {
    let i = wide.i;
    i * i
}

struct Deep {
    _a: Int,
    _b: Int,
    _c: Int,
    _d: Int,
    _e: Int,
    _f: Int,
    g: Int,
    h: Int,
}

// Neither of these is smaller bound on its own, since the first value that's bound takes more
// bytes than the next one, but both are smaller bound together
test fn deep_paths_bound_together(deep: Deep) -> Int {
    let g = deep.g;
    let h = deep.h;
    g * g + g * g + g * g + g + h * h + h * h + h * h + h
}

inline fn length_if(pair: (Bytes, Int), flag: Bool) -> Int {
    let length = pair.rest;

    if flag {
        length * length
    } else {
        0
    }
}

// The binding is a path in one call and not in the other, whichever comes first, and the check
// in the argument is kept although the branch that reads the binding isn't taken
test fn path_then_call(pair: (Bytes, Int), password: Bytes, flag: Bool) -> Int {
    length_if(pair, flag) + length_if(check_password(password), flag)
}

test fn path_then_call_that_fails(pair: (Bytes, Int), password: Bytes, flag: Bool) -> Int {
    length_if(pair, flag) + length_if(check_password(password), flag)
}

test fn call_then_path(pair: (Bytes, Int), password: Bytes, flag: Bool) -> Int {
    length_if(check_password(password), flag) + length_if(pair, flag)
}

test fn call_then_path_that_fails(pair: (Bytes, Int), password: Bytes, flag: Bool) -> Int {
    length_if(check_password(password), flag) + length_if(pair, flag)
}

// The length of a value isn't a path, since it fails for a pair
test fn length_is_bound(value: Bytes, flag: Bool) -> Int {
    let length = value.length;

    if flag {
        length + length
    } else {
        0
    }
}

fn add_one(value: Int) -> Int {
    value + 1
}

// A function that's referenced as a value is a closure, which isn't built twice
test fn function_value_is_bound(flag: Bool, value: Int) -> Int {
    let f = add_one;

    if flag {
        f(f(value))
    } else {
        f(value)
    }
}

// The call fails, whether or not its result is read
test fn call_that_fails_is_bound(f: fn() -> Point) -> Int {
    let point = f();
    let z = point.z;
    z * z + point.x
}
