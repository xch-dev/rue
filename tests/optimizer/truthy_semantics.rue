fn times_ten(x: Int) -> Int {
    x * 10
}

fn check(x: Int) -> Int {
    if x > 10 {
        raise "too big";
    }
    x
}

fn validate(x: Int) -> (Int, Int) {
    (check(x), 0)
}

fn noop(x: Int) -> Int {
    x
}

fn double_not_eq_true(b: Bool) -> Bool {
    !!b == true
}

// `x != 0` used as a value must be a boolean, not `x` itself
test fn ne_zero_value(amount: Int) -> Bool {
    amount != 0
}

test fn ne_zero_compare(a: Int, b: Int) -> Bool {
    (a != 0) == (b != 0)
}

test fn ne_nil_tree_hash(memo: Bytes) -> Bytes32 {
    tree_hash(memo != nil)
}

test fn ne_zero_const() -> Bool {
    const { (times_ten(5) != 0) == (times_ten(6) != 0) }
}

// `!!b` is only `b` if `b` is exactly `()` or `1`, which isn't checked at runtime
test fn double_not_atom(b: Bool) -> Bool {
    double_not_eq_true(b)
}

test fn double_not_pair(b: Bool) -> Bool {
    double_not_eq_true(b)
}

// A pair is truthy, but it can't be discarded if evaluating it fails
test fn pair_condition_raises(x: Int) -> Int {
    let v: List<Int> = [check(x)];
    if v is nil {
        1
    } else {
        2
    }
}

test fn pair_statement_raises(x: Int) -> Int {
    validate(x);
    noop(x);
    1
}

// This assumes that values match their static types, which isn't checked at runtime
// For ill-typed solutions like this, the optimized program intentionally differs from debug
test fn assert_ne_nil_pair(x: Bytes) -> Int {
    assert x != nil;
    2
}

// A list that ends in an atom other than nil has the right shape, so debug and release must agree
// on it. Like Chialisp, `is nil` only checks whether the value is nil, so the atom is treated as
// a pair, and reading from it fails
test fn list_is_nil_atom(l: List<Int>) -> Int {
    if l is nil {
        1
    } else {
        2
    }
}

test fn list_atom_terminator(l: List<Int>) -> Int {
    if l is nil {
        0
    } else {
        l.first
    }
}

test fn list_atom_terminator_raise(l: List<Int>) -> Int {
    if l is nil {
        raise;
    }
    1
}

test fn list_atom_terminator_value(l: List<Int>) -> Bool {
    l is nil
}

fn sum(l: List<Int>) -> Int {
    if l is nil {
        0
    } else {
        l.first + sum(l.rest)
    }
}

test fn list_atom_terminator_walk(l: List<Int>) -> Int {
    sum(l)
}
