fn times_ten(x: Int) -> Int {
    x * 10
}

fn check(x: Int) -> Int {
    if x > 10 {
        raise "too big";
    }
    x
}

fn validate(x: Int) -> (Int, Int) {
    (check(x), 0)
}

fn noop(x: Int) -> Int {
    x
}

fn double_not_eq_true(b: Bool) -> Bool {
    !!b == true
}

// `x != 0` used as a value must be a boolean, not `x` itself
test fn ne_zero_value(amount: Int) -> Bool {
    amount != 0
}

test fn ne_zero_compare(a: Int, b: Int) -> Bool {
    (a != 0) == (b != 0)
}

test fn ne_nil_tree_hash(memo: Bytes) -> Bytes32 {
    tree_hash(memo != nil)
}

test fn ne_zero_const() -> Bool {
    const { (times_ten(5) != 0) == (times_ten(6) != 0) }
}

// `!!b` is only `b` if `b` is exactly `()` or `1`, which isn't checked at runtime
test fn double_not_atom(b: Bool) -> Bool {
    double_not_eq_true(b)
}

test fn double_not_pair(b: Bool) -> Bool {
    double_not_eq_true(b)
}

// A pair is truthy, but it can't be discarded if evaluating it fails
test fn pair_condition_raises(x: Int) -> Int {
    let v: List<Int> = [check(x)];
    if v is nil {
        1
    } else {
        2
    }
}

test fn pair_statement_raises(x: Int) -> Int {
    validate(x);
    noop(x);
    1
}

// The static type of a value isn't checked at runtime, so it can't be relied on
test fn assert_ne_nil_pair(x: Bytes) -> Int {
    assert x != nil;
    2
}

test fn list_is_nil_atom(l: List<Int>) -> Int {
    if l is nil {
        1
    } else {
        2
    }
}
