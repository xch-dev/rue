// A call to a lambda that's known where it's called is inlined, rather than building the closure
// and running it.

inline fn apply(f: fn(value: Int) -> Int, value: Int) -> Int {
    f(value)
}

inline fn apply_rest(
    f: fn(first: Int, ...rest: List<Int>) -> List<Int>,
    list: List<Int>,
) -> List<Int> {
    f(1, ...list)
}

inline fn apply_nested(f: fn(g: fn(value: Int) -> Int) -> Int, x: Int) -> Int {
    f(fn(y: Int) => x + y)
}

inline fn twice(f: fn(value: Int) -> Int) -> fn(value: Int) -> Int {
    fn(value: Int) => f(f(value))
}

fn positive(value: Int) -> Int {
    assert value > 0;
    value
}

// Inlined, and then folded to 21
test fn bound() -> Int {
    let f = fn(value: Int) => value * 3;
    f(7)
}

// Inlined, with the capture read from the environment
test fn captured() -> Int {
    let k = positive(5);
    apply(fn(value: Int) => value * k, 7)
}

// Inlined, with the spread argument as the spread parameter
test fn spread_argument() -> List<Int> {
    let list = [positive(2), 3];
    let f = fn(first: Int, ...rest: List<Int>) => [first, ...rest];
    f(1, ...list)
}

// The argument is still evaluated, so the assertion still fails
test fn unused_argument_is_evaluated() -> Int {
    let f = fn(value: Int) => 42;
    f(positive(-1))
}

// The closure that `twice` returns is built, since it's called outside of `twice`, but the call to
// the lambda that's passed to it can't be inlined there, since its capture isn't static
test fn returned_closure() -> Int {
    let k = positive(2);
    twice(fn(value: Int) => value * k)(3)
}

// Not inlined, since the binding is used twice, so the lambda is built once
test fn used_twice() -> Int {
    let k = positive(2);
    let f = fn(value: Int) => value * k;
    f(1) + f(2)
}

// Inlined through a cast to another function type
test fn cast() -> Any {
    let f = fn(value: Int) => value * 3;
    let g = f as fn(value: Int) -> Any;
    g(7)
}

// Inlined through an inline function's parameter, with the spread argument as the spread parameter
test fn spread_through_inline_call() -> List<Int> {
    apply_rest(fn(first: Int, ...rest: List<Int>) => [first, ...rest], [positive(2), 3])
}

// The outer lambda isn't inlined into the call of `apply` it's passed to, since it calls `apply`
// itself, and the inner call's parameters would hide the outer call's from it. Lowering it against
// the inner call's arguments would never finish. It's run as a closure instead, with the inner
// lambda inlined in it.
test fn nested_calls_of_the_same_function() -> Int {
    let n = positive(3);
    apply(fn(a: Int) => apply(fn(b: Int) => a + b, a), n)
}

// The `x` that the outer call's lambda adds is the outer call's (the 10), not the inner one's (1)
test fn nested_lambda_sees_where_it_was_written() -> Int {
    let n = positive(10);
    apply_nested(
        fn(h: fn(value: Int) -> Int) => apply_nested(fn(h2: fn(value: Int) -> Int) => h(1000), 1),
        n,
    )
}

// An argument whose parameter is referenced more than once is bound, so it's evaluated once
test fn repeated_parameter() -> Int {
    let n = positive(2);
    let f = fn(value: Int) => value * value * value;
    f(n + 1)
}

// An argument that's a value in the environment is substituted for each reference
test fn repeated_trivial_parameter() -> Int {
    let n = positive(2);
    let f = fn(value: Int) => value * value * value;
    f(n) + n
}

// So is a static argument, which is folded
test fn repeated_static_parameter() -> Int {
    let f = fn(value: (Int, Int)) => value.first + value.rest;
    let make = fn() => (1, 2);
    f(make())
}
