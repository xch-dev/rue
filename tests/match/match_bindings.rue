// An arm's type can be followed by a binding, which destructures the value once it's been narrowed
// to the type. It's the same as a `let` with the binding at the start of the arm, so the arm still
// matches by its type alone.

struct Circle {
    kind = 1,
    radius: Int,
}

struct Square {
    kind = 2,
    side: Int,
}

struct Point {
    kind = 3,
}

struct Line {
    start: (Int, Int),
    end: (Int, Int),
}

struct Holder {
    shape: Shape,
    scale: Int,
}

type Rounded = Circle;
type Shape = Rounded | Square | Point;

enum Option<T> {
    None,
    Some { value: T },
}

enum Dir {
    Up = 1,
    Down,
}

// These three compile to the same program
test fn area_bindings(shape: Shape) -> Int {
    match shape {
        Circle { radius } => 3 * radius * radius,
        Square { side } => side * side,
        Point => 0,
    }
}

test fn area_fields(shape: Shape) -> Int {
    match shape {
        Circle => 3 * shape.radius * shape.radius,
        Square => shape.side * shape.side,
        Point => 0,
    }
}

test fn area_lets(shape: Shape) -> Int {
    match shape {
        Circle => {
            let { radius } = shape;
            3 * radius * radius
        }
        Square => {
            let { side } = shape;
            side * side
        }
        Point => 0,
    }
}

test fn structs() -> List<Int> {
    [
        area_bindings(Circle { radius: 2 }),
        area_bindings(Square { side: 3 }),
        area_bindings(Point {}),
    ]
}

// A field can be renamed, destructured further, or left out, and the rest of the value can be
// bound as a whole
fn length(value: Line | Point) -> Int {
    match value {
        Line { start: (x1, y1), end: { first: x2, rest: y2 } } => x2 - x1 + y2 - y1,
        Point {} => 0,
    }
}

fn start(value: Line | nil) -> Int {
    match value {
        Line { start: origin, ...line } => origin.first + line.end.first,
        nil => 0,
    }
}

test fn struct_bindings() -> List<Int> {
    let line = Line { start: (1, 2), end: (4, 6) };
    [length(line), length(Point {}), start(line), start(nil)]
}

// The type can be an alias, which is destructured as the type it stands for
test fn alias_binding(shape: Shape) -> Int {
    match shape {
        Rounded { radius } => radius,
        _ => 0,
    }
}

// A pair or a list is destructured by a binding after its type
fn sum(value: (Int, Int) | Int) -> Int {
    match value {
        (Int, Int) (first, rest) => first + rest,
        Int => value,
    }
}

fn total(values: List<Int>) -> Int {
    match values {
        nil => 0,
        (Int, List<Int>) [first, ...rest] => first + total(rest),
    }
}

fn first_two(values: List<Int>) -> Int {
    match values {
        (Int, (Int, List<Int>)) [first, second, ..._rest] => first + second,
        _ => 0,
    }
}

fn nested(value: ((Int, Int), [Int, Int]) | nil) -> Int {
    match value {
        ((Int, Int), [Int, Int]) ((a, b), [c, d]) => a + b + c + d,
        nil => 0,
    }
}

// An atom's length is a field, so it can be destructured too
fn size(value: Bytes | (Bytes, Bytes)) -> Int {
    match value {
        Bytes { length } => length,
        (Bytes, Bytes) ({ length: first }, { length: rest }) => first + rest,
    }
}

test fn pair_and_list_bindings() -> List<Int> {
    [
        sum((1, 2)),
        sum(5),
        total([1, 2, 3]),
        first_two([1, 2, 3]),
        first_two([1]),
        nested(((1, 2), [3, 4])),
        nested(nil),
        size(0x010203),
        size((0x01, 0x0203)),
    ]
}

// A variant of an enum is destructured like a struct, with its generic arguments if it has any
fn unwrap_or(option: Option<Int>, default: Int) -> Int {
    match option {
        Option::None<Int> => default,
        Option::Some<Int> { value } => value,
    }
}

// The binding sees the fields as the arm's type narrows them
fn down(option: Option<Dir>) -> Int {
    match option {
        Option::None<Dir> => 0,
        Option::Some<Dir::Up> => 1,
        Option::Some<Dir::Down> { value } => {
            let down: Dir::Down = value;
            down as Int
        }
    }
}

test fn variant_bindings() -> List<Int> {
    [
        unwrap_or(Option::None, 1),
        unwrap_or(Option::Some::<Int> { value: 2 }, 1),
        down(Option::None),
        down(Option::Some::<Dir> { value: Dir::Up }),
        down(Option::Some::<Dir> { value: Dir::Down }),
    ]
}

// An arm for a union destructures the union, which works if a `let` could do the same: every
// member is a pair here, and a copy of the same struct below
fn union_arm(value: (Int, Int) | (Int, nil) | nil) -> Int {
    match value {
        (Int, Int) | (Int, nil) (first, _) => first,
        nil => 0,
    }
}

fn union_of_copies(option: Option<Dir>) -> Int {
    match option {
        Option::Some<Dir::Up> | Option::Some<Dir::Down> { value } => value as Int,
        Option::None<Dir> => 0,
    }
}

// The wildcard arm destructures what's left
fn wildcard(shape: Shape) -> Int {
    match shape {
        Circle | Point => 0,
        _ { side } => side,
    }
}

test fn union_and_wildcard_bindings() -> List<Int> {
    [
        union_arm((1, 2)),
        union_arm((3, nil)),
        union_arm(nil),
        union_of_copies(Option::Some::<Dir> { value: Dir::Down }),
        union_of_copies(Option::None),
        wildcard(Square { side: 4 }),
        wildcard(Point {}),
    ]
}

fn make(radius: Int) -> Shape {
    if radius > 0 {
        Circle { radius }
    } else {
        Point {}
    }
}

// A value that isn't a reference is evaluated once, and destructured in the arms
fn computed(radius: Int) -> Int {
    match make(radius) {
        Circle { radius: made } => made + 1,
        Square { side } => side,
        Point => 0,
    }
}

// A field of a value is narrowed in the arms, and the rest of the value is still in scope
fn field(holder: Holder) -> Int {
    match holder.shape {
        Circle { radius } => radius * holder.scale,
        Square { side } => side * holder.scale,
        Point => holder.scale,
    }
}

test fn computed_and_field_values() -> List<Int> {
    [
        computed(2),
        computed(0),
        field(Holder { shape: Circle { radius: 2 }, scale: 3 }),
        field(Holder { shape: Point {}, scale: 3 }),
    ]
}

// A binding can shadow the value being matched on, like a `let` can, and is only in scope in its
// own arm
fn shadow(shape: Shape) -> Int {
    match shape {
        Circle { radius: shape } => shape,
        Square => shape.side,
        Point => 0,
    }
}

// The bindings can be captured by a lambda
fn capture(shape: Shape) -> fn(by: Int) -> Int {
    match shape {
        Circle { radius } => fn(by: Int) => radius * by,
        Square { side } => fn(by: Int) => side * by,
        Point => fn(by: Int) => by,
    }
}

test fn shadowing_and_captures() -> List<Int> {
    [shadow(Circle { radius: 7 }), shadow(Square { side: 8 }), capture(Square { side: 2 })(5)]
}

// The arms of a statement are blocks, which see the bindings too, and the value is still narrowed
// after the statement by the arms that fall through
fn statement(shape: Shape) -> Int {
    match shape {
        Circle { radius } => {
            return radius;
        }
        Square { side } => {
            assert side > 0;
        }
        Point => {
            raise "a point has no side";
        }
    }

    shape.side * 4
}

// The arms of a function body's value can return from it
fn body(shape: Shape) -> Int {
    match shape {
        Circle { radius } => {
            if radius > 10 {
                return 10;
            }

            radius
        }
        Square { side } => if side > 10 {
            10
        } else {
            side
        }
        Point => match shape {
            Point {} => 0,
        }
    }
}

test fn statements() -> List<Int> {
    [
        statement(Circle { radius: 2 }),
        statement(Square { side: 3 }),
        body(Circle { radius: 20 }),
        body(Circle { radius: 5 }),
        body(Square { side: 20 }),
        body(Point {}),
    ]
}

// The arms of an `inline match` are all evaluated, so they don't narrow the value, and a binding
// destructures the value as it is outside of the match
fn inline_pair(pair: (Int, Int)) -> Int {
    inline match pair {
        (0, Int) (_, rest) => rest,
        _ (first, rest) => first + rest,
    }
}

test fn inline_bindings() -> List<Int> {
    [inline_pair((0, 5)), inline_pair((1, 5))]
}

// A binding doesn't check anything, so the arm that handles everything that's left is still the
// `else` branch, and this is only a field access
test fn no_check(circle: Circle) -> Int {
    match circle {
        Circle { radius } => radius,
    }
}
