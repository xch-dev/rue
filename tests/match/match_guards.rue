// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

// An arm's type and binding can be followed by a condition. The arm is taken by the values of its
// type that the condition is true for, so the arms after it still see every value that it does.

enum Shape {
    Empty,
    Circle { radius: Int },
    Rect { width: Int, height: Int },
}

struct Tagged {
    kind = 1,
    value: Int | (Int, Int),
}

struct Plain {
    kind = 2,
    value: Int,
}

// An `inline match` can have conditions as well, which see the value narrowed to the arm's type,
// although the arm's value doesn't
fn inline_condition(value: Int, limit: Int) -> Int {
    inline match value {
        0 if limit > 0 => 1,
        0 => 2,
        _ if value > limit => 3,
        _ => 4,
    }
}

fn inline_narrowed(value: Tagged | Plain) -> Int {
    inline match value {
        Tagged if value.value is Int => 1,
        Plain if value.value > 10 => 2,
        _ => 3,
    }
}

test fn inline_conditions() -> List<Int> {
    [
        inline_condition(0, 1),
        inline_condition(0, 0),
        inline_condition(5, 1),
        inline_condition(5, 9),
        inline_narrowed(Tagged { value: 1 }),
        inline_narrowed(Tagged { value: (1, 2) }),
        inline_narrowed(Plain { value: 11 }),
        inline_narrowed(Plain { value: 1 }),
    ]
}

// These two compile to the same program
test fn size_match(shape: Shape) -> Int {
    match shape {
        Shape::Circle { radius } if radius > 10 => radius * 2,
        Shape::Circle { radius } => radius,
        Shape::Rect { width, height } => width * height,
        Shape::Empty => 0,
    }
}

test fn size_chain(shape: Shape) -> Int {
    if shape is Shape::Circle && shape.radius > 10 {
        shape.radius * 2
    } else if shape is Shape::Circle {
        shape.radius
    } else if shape is Shape::Rect {
        shape.width * shape.height
    } else {
        0
    }
}

test fn sizes() -> List<Int> {
    [
        size_match(Shape::Circle { radius: 11 }),
        size_match(Shape::Circle { radius: 10 }),
        size_match(Shape::Rect { width: 2, height: 3 }),
        size_match(Shape::Empty),
    ]
}

// The condition sees the value narrowed to the arm's type, with or without a binding, and so do
// these two, which compile to the same program
test fn atoms_match(value: Int | (Int, Int)) -> Int {
    match value {
        Int if value > 10 => 1,
        (Int, Int) as (first, rest) if first > rest => 2,
        Int => value,
        _ => 3,
    }
}

test fn atoms_chain(value: Int | (Int, Int)) -> Int {
    if value is Int && value > 10 {
        1
    } else if value is (Int, Int) && value.first > value.rest {
        2
    } else if value is Int {
        value
    } else {
        3
    }
}

test fn atoms() -> List<Int> {
    [atoms_match(11), atoms_match((2, 1)), atoms_match(5), atoms_match((1, 2))]
}

// A condition that's a type guard narrows the arm's value further, like it would in an `if`
fn narrowed(value: Tagged | Plain) -> Int {
    match value {
        Tagged if value.value is Int => value.value,
        Tagged { value: inner } if inner is (Int, Int) => inner.first + inner.rest,
        Tagged => 0,
        Plain => value.value,
    }
}

test fn narrowing() -> List<Int> {
    [
        narrowed(Tagged { value: 5 }),
        narrowed(Tagged { value: (1, 2) }),
        narrowed(Plain { value: 7 }),
    ]
}

// Every arm can have a condition, including `_`, as long as an arm without one handles what's
// left. The conditions are checked in order, and only for the values of the arm's type.
fn classify(value: Int | Bytes32 | (Int, Int)) -> Int {
    match value {
        (Int, Int) if value.first == 0 => 1,
        _ if value is (Int, Int) && value.rest == 0 => 2,
        (Int, Int) => 3,
        Int | Bytes32 as atom if atom as Bytes == nil => 4,
        _ => 5,
    }
}

test fn conditions() -> List<Int> {
    [classify((0, 0)), classify((1, 0)), classify((1, 1)), classify(0), classify(1)]
}

// The arms after an arm with a condition aren't narrowed by it, and neither is what's left for an
// arm that handles everything
fn rest(value: Int | (Int, Int) | Plain) -> Int {
    match value {
        Plain => 0,
        Int if value > 10 => value,
        _ as other if other is (Int, Int) && other.first > 5 => other.first,
        Int => value + 100,
        (Int, Int) => value.rest,
    }
}

test fn remaining() -> List<Int> {
    [rest(Plain { value: 1 }), rest(11), rest(5), rest((7, 8)), rest((1, 2))]
}

// A condition on an arm whose type doesn't need to be checked is the whole check
fn only_condition(value: Int) -> Int {
    match value {
        Int if value > 10 => 1,
        Int as small if small > 5 => 2,
        _ if value > 0 => 3,
        _ => 4,
    }
}

test fn unchecked() -> List<Int> {
    [only_condition(11), only_condition(6), only_condition(1), only_condition(0)]
}

// The value of an arm with a condition can be a block, an `if` or a `match`
fn values(value: Int | (Int, Int)) -> Int {
    match value {
        Int if value > 10 => if value > 20 {
            1
        } else {
            2
        }
        Int if value > 5 => {
            let double = value * 2;
            double + 1
        }
        Int if value > 0 => match value {
            1 => 3,
            _ => 4,
        }
        Int => 5,
        (Int, Int) => 6,
    }
}

test fn arm_values() -> List<Int> {
    [values(21), values(11), values(6), values(1), values(2), values(0), values((1, 2))]
}

// A value that isn't a reference is only evaluated once, however many conditions there are
fn double(value: Int) -> Int | (Int, Int) {
    if value > 100 {
        (value, value)
    } else {
        value * 2
    }
}

fn computed(value: Int) -> Int {
    match double(value) {
        Int as doubled if doubled > 10 => doubled,
        Int as doubled if doubled > 5 => doubled + 1,
        Int => 0,
        (Int, Int) => 1,
    }
}

test fn computed_values() -> List<Int> {
    [computed(6), computed(3), computed(1), computed(101)]
}

// The rest of the block after a statement sees the values of the arms that fall through to it,
// which are all of an arm's type if it has a condition
fn statement(value: Tagged | Plain | nil) -> Int {
    match value {
        Tagged if value.value is Int => {}
        Tagged => {
            return 1;
        }
        Plain if value.value > 10 => {
            return 2;
        }
        Plain => {}
        nil => {
            return 3;
        }
    }

    let rest: Tagged | Plain = value;

    match rest {
        Tagged => 4,
        Plain => 5,
    }
}

test fn statements() -> List<Int> {
    [
        statement(Tagged { value: 1 }),
        statement(Tagged { value: (1, 2) }),
        statement(Plain { value: 11 }),
        statement(Plain { value: 1 }),
        statement(nil),
    ]
}

// An arm with a condition whose type doesn't need to be checked takes any value that's left, so
// that's what the rest of the block sees if it falls through, rather than the arm's type
fn statement_unchecked(value: Tagged | Plain | nil, keep: Bool) -> Int {
    match value {
        nil => {
            return 0;
        }
        Tagged | Plain | nil if keep => {}
        _ if !keep => {
            return 1;
        }
        _ => {}
    }

    let rest: Tagged | Plain = value;

    match rest {
        Tagged => 2,
        Plain => 3,
    }
}

test fn unchecked_statements() -> List<Int> {
    [
        statement_unchecked(nil, true),
        statement_unchecked(Tagged { value: 1 }, true),
        statement_unchecked(Plain { value: 1 }, true),
        statement_unchecked(Plain { value: 1 }, false),
    ]
}

// A condition can use the generic type of the value
fn generic<T>(value: T | nil, fallback: T, use_fallback: Bool) -> T {
    match value {
        nil => fallback,
        _ if use_fallback => fallback,
        _ => value,
    }
}

test fn generics() -> List<Int> {
    [generic(1, 2, false), generic(1, 2, true), generic::<Int>(nil, 2, false)]
}
