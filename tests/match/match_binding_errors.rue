// A binding is checked against the type the arm narrows the value to, like a `let` would be

struct Circle {
    kind = 1,
    radius: Int,
}

struct Square {
    kind = 2,
    side: Int,
}

struct Point {
    kind = 3,
}

type Shape = Circle | Square | Point;

fn unknown_field(shape: Shape) -> Int {
    match shape {
        Circle { side } => side,
        Square { side, radius } => side + radius,
        Point => 0,
    }
}

fn not_a_pair(shape: Shape) -> Int {
    match shape {
        Circle (first, rest) => first + rest,
        Square [first, second] => first + second,
        Point => 0,
    }
}

fn not_a_struct(value: (Int, Int) | Int) -> Int {
    match value {
        (Int, Int) { side } => side,
        Int (first, rest) => first + rest,
    }
}

// A name can only be bound once in an arm, but each arm has its own bindings
fn duplicate(value: (Int, Int) | Square) -> Int {
    match value {
        (Int, Int) (part, part) => part,
        Square { side: part } => part,
    }
}

// The bindings aren't in scope in the other arms, or after the match
fn out_of_scope(shape: Shape) -> Int {
    let value = match shape {
        Circle { radius } => radius,
        Square => radius,
        Point => 0,
    };

    value + radius
}

// The arm's type is what's destructured, so a field can only be read from a union if its members
// are copies of one struct, as for a `let`, even if they all have the field
fn union_arm(shape: Shape) -> Int {
    match shape {
        Circle | Square { kind } => kind,
        Point => 0,
    }
}

// A list that might be empty has no first item, so its type can't be destructured before `nil`
// has been handled
fn list_before_nil(values: List<Int>) -> Int {
    match values {
        List<Int> [first, ...rest] => first + list_before_nil(rest),
    }
}

// The wildcard arm destructures what's left, which is two structs here
fn wildcard(shape: Shape) -> Int {
    match shape {
        Point => 0,
        _ { side } => side,
    }
}

// The arms of an `inline match` don't narrow the value, so neither do their bindings
fn inline_arm(shape: Shape) -> Int {
    inline match shape {
        Circle { radius } => radius,
        Square { side: (first, rest) } => first + rest,
        _ { side } => side,
    }
}

fn inline_pair(value: (Int, Int) | Int) -> Int {
    inline match value {
        (Int, Int) (first, rest) => first + rest,
        Int => 0,
    }
}

struct Renamed {
    width: Int,
    height: Int,
}

// Nor do the arms narrow the type that a value was cast to, so an arm after the first one
// destructures all of it too
fn inline_cast(pair: (Int, (Int, nil)) | nil) -> Int {
    let wildcard = inline match pair as Renamed | nil {
        nil => 0,
        _ { width } => width,
    };

    wildcard
        + inline match pair as Renamed | nil {
            nil => 0,
            Renamed { width } => width,
        }
}

// The note isn't added if the value is already of the arm's type, since narrowing it wouldn't help
fn inline_same_type(circle: Circle) -> Int {
    inline match circle {
        Circle { side } => side,
    }
}

// The note is only for what can't be destructured, and an arm that's never taken has it too
fn inline_arm_other_errors(value: (Int, Int), shape: Shape) -> Int {
    let duplicate = inline match value {
        (0, Int) (part, part) => part,
        _ => 0,
    };

    duplicate
        + inline match shape {
            Circle | Square | Point => 0,
            Circle { radius } => radius,
        }
}

// A binding doesn't make an arm match anything else, so it has no effect on which arms are
// reachable, or on whether the match is exhaustive. An arm that's never taken sees a value that
// doesn't exist, so its binding is an error like a field access is there.
fn unreachable(shape: Shape) -> Int {
    match shape {
        Circle { radius } => radius,
        Circle { radius: again } => again,
        Square | Point => 0,
        _ { kind } => kind,
    }
}

fn not_exhaustive(shape: Shape) -> Int {
    match shape {
        Circle { radius } => radius,
        Square { side } => side,
    }
}

fn incompatible(shape: Shape) -> Int {
    match shape {
        Int { length } => length,
        _ => 0,
    }
}

// A name is the value as the arm sees it, so in an `inline match` it isn't narrowed, and in each
// arm it's only that arm's type
fn named(shape: Shape) -> Int {
    let inlined = inline match shape {
        Circle circle => circle.radius,
        _ => 0,
    };

    inlined
        + match shape {
            Circle circle => circle.side,
            Square square => circle.radius + square.side,
            Point unused => 0,
        }
}

// A binding that isn't used is reported, unless its name starts with an underscore
fn unused(shape: Shape) -> Int {
    match shape {
        Circle { radius } => 1,
        Square { side: _side } => 2,
        Point => 0,
    }
}

// The arms of a statement don't have values, with or without a binding
fn statement_value(shape: Shape) -> Int {
    match shape {
        Circle { radius } => radius,
        _ => {}
    }

    0
}

// The type of a binding's field is the narrowed one
fn narrowed_type(shape: Shape) -> Int {
    match shape {
        Circle { kind } => {
            let two: 2 = kind;
            two + 1
        }
        _ => 0,
    }
}

fn main(shape: Shape, value: (Int, Int) | Int, other: (Int, Int) | Square) -> Int {
    unknown_field(shape)
        + not_a_pair(shape)
        + not_a_struct(value)
        + duplicate(other)
        + out_of_scope(shape)
        + union_arm(shape)
        + wildcard(shape)
        + inline_arm(shape)
        + inline_pair(value)
        + inline_cast(nil)
        + inline_same_type(Circle { radius: 1 })
        + inline_arm_other_errors((0, 1), shape)
        + list_before_nil(nil)
        + unreachable(shape)
        + not_exhaustive(shape)
        + incompatible(shape)
        + unused(shape)
        + named(shape)
        + statement_value(shape)
        + narrowed_type(shape)
}
