struct Point {
    x: Int,
    y: Int,
}

// The guard checks the cast value's length, but `x` is still an `Int`, so `+` adds
test fn int_length(x: Int) -> Int {
    if (x as Bytes) is Bytes32 {
        return x + x;
    }
    0
}

// Once the length is known, `x` can be cast to `Bytes32` without another guard
test fn int_length_cast(x: Int) -> Bytes32 {
    if (x as Bytes) is Bytes32 {
        return x as Bytes32;
    }
    sha256(x as Bytes)
}

// Guarding the value directly keeps its semantic as well
test fn int_length_direct(x: Int) -> Int {
    if x is Bytes32 {
        return x + 1;
    }
    0
}

// A pair checked against a struct takes on its structure, but isn't an instance of it
test fn pair_struct(p: (Int, (Int, nil)) | nil) -> Int {
    if (p as Point | nil) is Point {
        return p.first + (p as Point).y;
    }
    0
}
