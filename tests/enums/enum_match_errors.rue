// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

enum Shape {
    Empty,
    Circle { radius: Int },
    Rect = 10 { width: Int, height: Int },
}

enum Mode {
    Off,
    On,
}

// Each variant that isn't handled is listed
fn missing_one(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        Shape::Circle => shape.radius,
    }
}

fn missing_many(mode: Mode) -> Int {
    match mode {}
}

// An arm for a variant that's already handled is never taken
fn unreachable(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        _ => 1,
        Shape::Circle => 2,
    }
}

// The first variant of an enum without fields is the same value as `nil`, so a match can't tell
// them apart
fn indistinguishable(mode: Mode | nil) -> Int {
    match mode {
        nil => 0,
        Mode::On => 1,
        Mode::Off => 2,
    }
}

// A variant of another enum isn't a member of the value's type
fn other_enum(mode: Mode) -> Int {
    match mode {
        Shape::Empty => 0,
        _ => 1,
    }
}

enum Dir {
    Up = 1,
    Down,
}

enum Both<X, Y> {
    Neither,
    Two { x: X, y: Y },
}

// The combinations of a variant's fields that aren't handled are listed
fn missing_combinations(value: Both<Dir, Dir>) -> Int {
    match value {
        Both::Neither<Dir, Dir> => 0,
        Both::Two<Dir::Up, Dir::Up> => 1,
        Both::Two<Dir::Down, Dir::Up> => 3,
    }
}

// An arm's binding destructures the variant the arm names, so it can only read that variant's
// fields, and a variant of an enum without fields is only its discriminant
fn binding_fields(shape: Shape, mode: Mode) -> Int {
    let area = match shape {
        Shape::Empty { radius } => radius,
        Shape::Circle { width } => width,
        Shape::Rect { width, height } => width * height,
    };

    area
        + match mode {
            Mode::Off { value } => value,
            _ => 0,
        }
}

// A variant whose only arm has a condition isn't handled
fn conditional_variant(shape: Shape, mode: Mode) -> Int {
    let area = match shape {
        Shape::Empty => 0,
        Shape::Circle { radius } if radius > 10 => radius,
        Shape::Rect { width, height } => width * height,
    };

    area
        + match mode {
            Mode::Off => 0,
            Mode::On if area > 0 => 1,
            _ if area > 1 => 2,
        }
}

fn main(shape: Shape, mode: Mode, both: Both<Dir, Dir>) -> Int {
    missing_one(shape)
        + missing_many(mode)
        + unreachable(shape)
        + indistinguishable(mode)
        + other_enum(mode)
        + missing_combinations(both)
        + binding_fields(shape, mode)
        + conditional_variant(shape, mode)
}
