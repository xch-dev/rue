// A match on an enum handles each of its variants, since each is a member of the union it is

import shapes::Kind::*;

enum Shape {
    Empty,
    Circle { radius: Int },
    Rect = 10 { width: Int, height: Int },
}

enum Mode {
    Off,
    On,
    Auto = 5,
}

enum Option<T> {
    None,
    Some { value: T },
}

fn area(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        Shape::Circle => 3 * shape.radius * shape.radius,
        Shape::Rect => shape.width * shape.height,
    }
}

// The same as the `if` chain, which a match compiles to
fn area_if(shape: Shape) -> Int {
    if shape is Shape::Empty {
        0
    } else if shape is Shape::Circle {
        3 * shape.radius * shape.radius
    } else {
        shape.width * shape.height
    }
}

test fn match_variants() {
    assert area(Shape::Empty) == 0;
    assert area(Shape::Circle { radius: 2 }) == 12;
    assert area(Shape::Rect { width: 2, height: 3 }) == 6;
    assert area_if(Shape::Rect { width: 2, height: 3 }) == 6;
}

fn is_running(mode: Mode) -> Bool {
    match mode {
        Mode::Off => false,
        Mode::On | Mode::Auto => true,
    }
}

test fn match_unit_variants() {
    assert !is_running(Mode::Off);
    assert is_running(Mode::On);
    assert is_running(Mode::Auto);
}

// The arm that handles the rest is the `else` branch
fn has_corners(shape: Shape) -> Bool {
    match shape {
        Shape::Rect => true,
        _ => false,
    }
}

test fn match_rest() {
    assert has_corners(Shape::Rect { width: 1, height: 1 });
    assert !has_corners(Shape::Circle { radius: 1 });
    assert !has_corners(Shape::Empty);
}

// A variant of a generic enum is matched with its generic arguments, as with `is`
fn unwrap_or(option: Option<Int>, default: Int) -> Int {
    match option {
        Option::None<Int> => default,
        Option::Some<Int> => option.value,
    }
}

test fn match_generic() {
    assert unwrap_or(Option::None, 1) == 1;
    assert unwrap_or(Option::Some::<Int> { value: 2 }, 1) == 2;
}

fn code(mode: Mode) -> Int {
    inline match mode {
        Mode::Off => 1,
        Mode::On => 2,
        Mode::Auto => 3,
    }
}

test fn inline_match() {
    assert code(Mode::Off) == 1;
    assert code(Mode::On) == 2;
    assert code(Mode::Auto) == 3;
}

enum Dir {
    Up = 1,
    Down,
}

enum Both<X, Y> {
    Neither,
    Two { x: X, y: Y },
}

// A variant's fields are narrowed by its generic arguments, so an arm for each of them handles
// the variant, and what's left can still be read by field
fn direction(option: Option<Dir>) -> Int {
    match option {
        Option::None<Dir> => 0,
        Option::Some<Dir::Up> => 1,
        Option::Some<Dir::Down> => option.value as Int,
    }
}

fn direction_guard(option: Option<Dir>) -> Int {
    if option is Option::None<Dir> | Option::Some<Dir::Up> {
        return 1;
    }

    let down: Dir::Down = option.value;
    down as Int
}

test fn match_variant_fields() {
    assert direction(Option::None) == 0;
    assert direction(Option::Some::<Dir> { value: Dir::Up }) == 1;
    assert direction(Option::Some::<Dir> { value: Dir::Down }) == 2;
    assert direction_guard(Option::Some::<Dir> { value: Dir::Up }) == 1;
    assert direction_guard(Option::Some::<Dir> { value: Dir::Down }) == 2;
}

// An arm for every combination of two fields handles the variant too
fn directions(value: Both<Dir, Dir>) -> Int {
    match value {
        Both::Neither<Dir, Dir> => 0,
        Both::Two<Dir::Up, Dir::Up> => 1,
        Both::Two<Dir::Up, Dir::Down> => 2,
        Both::Two<Dir::Down, Dir::Up> => 3,
        Both::Two<Dir::Down, Dir::Down> => value.x as Int + value.y as Int,
    }
}

// The fields of what's left after some of the combinations can still be read
fn first_direction(value: Both<Dir, Dir>) -> Int {
    match value {
        Both::Neither<Dir, Dir> => 0,
        Both::Two<Dir::Up, Dir::Up> => 10,
        _ => value.x as Int * 10 + value.y as Int,
    }
}

test fn match_every_combination_of_fields() {
    assert directions(Both::Neither) == 0;
    assert directions(Both::Two::<Dir, Dir> { x: Dir::Up, y: Dir::Up }) == 1;
    assert first_direction(Both::Two::<Dir, Dir> { x: Dir::Up, y: Dir::Up }) == 10;
    assert first_direction(Both::Two::<Dir, Dir> { x: Dir::Down, y: Dir::Up }) == 21;
    assert directions(Both::Two::<Dir, Dir> { x: Dir::Up, y: Dir::Down }) == 2;
    assert directions(Both::Two::<Dir, Dir> { x: Dir::Down, y: Dir::Up }) == 3;
    assert directions(Both::Two::<Dir, Dir> { x: Dir::Down, y: Dir::Down }) == 4;
}

// The variants can be imported, and matched on by their own names
mod shapes {
    export enum Kind {
        Square { side: Int },
        Line { length: Int },
    }
}

fn size(kind: shapes::Kind) -> Int {
    match kind {
        Square => kind.side * kind.side,
        Line => kind.length,
    }
}

test fn match_imported_variants() {
    assert size(Square { side: 3 }) == 9;
    assert size(Line { length: 4 }) == 4;
}

// An arm's binding destructures the variant it narrows the value to. These three compile to the
// same program, since the binding is only another way to read the fields.
test fn variant_bindings(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        Shape::Circle { radius } => 3 * radius * radius,
        Shape::Rect { width, height } => width * height,
    }
}

test fn variant_fields(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        Shape::Circle => 3 * shape.radius * shape.radius,
        Shape::Rect => shape.width * shape.height,
    }
}

test fn variant_lets(shape: Shape) -> Int {
    match shape {
        Shape::Empty => 0,
        Shape::Circle => {
            let { radius } = shape;
            3 * radius * radius
        }
        Shape::Rect => {
            inline let { width, height } = shape;
            width * height
        }
    }
}

test fn match_variant_bindings() {
    assert variant_bindings(Shape::Empty) == 0;
    assert variant_bindings(Shape::Circle { radius: 2 }) == 12;
    assert variant_bindings(Shape::Rect { width: 2, height: 3 }) == 6;
    assert variant_lets(Shape::Rect { width: 2, height: 3 }) == 6;
}

// A variant of a generic enum is destructured after its generic arguments, and an imported
// variant by its own name
fn unwrap_binding(option: Option<Int>, default: Int) -> Int {
    match option {
        Option::None<Int> => default,
        Option::Some<Int> { value } => value,
    }
}

fn size_binding(kind: shapes::Kind) -> Int {
    match kind {
        Square { side } => side * side,
        Line { length } => length,
    }
}

// The rest of a variant's fields can be bound as a whole, which is the variant itself
fn perimeter(shape: Shape) -> Int {
    match shape {
        Shape::Rect { width, ...rect } => 2 * width + 2 * rect.height,
        _ => 0,
    }
}

test fn match_generic_and_imported_bindings() {
    assert unwrap_binding(Option::None, 1) == 1;
    assert unwrap_binding(Option::Some::<Int> { value: 2 }, 1) == 2;
    assert size_binding(Square { side: 3 }) == 9;
    assert size_binding(Line { length: 4 }) == 4;
    assert perimeter(Shape::Rect { width: 2, height: 3 }) == 10;
    assert perimeter(Shape::Empty) == 0;
}
