// A cycle of recursive functions where each calls the next twice. Checking whether a call may
// fail walks each function's body once, rather than once for each path through the cycle.

fn level_0(n: Int) -> Int {
    if n < 1 {
        0
    } else {
        level_40(n - 1)
    }
}

fn level_1(n: Int) -> Int {
    if n < 1 {
        0
    } else {
        level_0(n - 1) + level_0(n - 2)
    }
}

fn level_2(n: Int) -> Int {
    if n < 1 {
        0
    } else {
        level_1(n - 1) + level_1(n - 2)
    }
}

