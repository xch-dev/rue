// Twenty generics, each with the pair `(5, 5)` and inferred through every earlier one by
// `identity`, with `five_pair` bounding the last. Each one's union of lower bounds is built from
// those of the earlier ones, and copies of a member are left out, so it stays one member rather
// than doubling in size for each generic

fn identity<U>(value: U) -> U {
    value
}

fn five_pair(value: (5, 5)) -> Int {
    value.first
}

