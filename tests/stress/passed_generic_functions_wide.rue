// Sixty arguments that each pass the generic function `swap`, whose instances are solved with the
// call's generics. Each solve passes the bounds on to the instances once per inference, rather than
// again for the same inference before each argument

fn swap<T, U>(pair: (T, U)) -> (U, T) {
    (pair.rest, pair.first)
}

