fn main() -> Int {
    factorial(5) + A + B + D + E
}

inline fn factorial(num: Int) -> Int {
    if num > 1 {
        num * factorial(num - 1)
    } else {
        1
    }
}

const A: Int = A;
const B: Int = C;
const C: Int = B;

// References a cycle without being part of it, so it isn't reported
const E: Int = C;
inline const D: Int = D;
