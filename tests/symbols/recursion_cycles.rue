fn main() -> Int {
    A + B + C + D + E + F + G + p(1) + Y + X
}

// A cycle of three constants reports each of them
const A: Int = B;
const B: Int = C;
const C: Int = A;

// Two cycles, where one references the other
const D: Int = E;
const E: Int = D + F;
const F: Int = G;
const G: Int = F;

// Inline functions that call each other
inline fn p(x: Int) -> Int {
    q(x)
}

inline fn q(x: Int) -> Int {
    p(x)
}

// A constant that references itself through a function
const Y: Int = f();

fn f() -> Int {
    Y
}

// A constant reached from a cycle more than once is reported once
const X: Int = W + Z;
const W: Int = X;
const Z: Int = X;

// A binding whose value may fail is evaluated even if it's never referenced, so a cycle through
// one is a cycle
const V: Int = checked_with(1);

fn checked_with(x: Int) -> Int {
    let _v = V;
    assert x > 0;
    x
}

inline fn checks_itself(x: Int) -> Int {
    let _u = checks_itself(x - 1);
    assert x > 0;
    x
}

// A binding that can't fail isn't evaluated if it's never referenced, so this isn't a cycle
const U: Int = unchecked_with(1);

fn unchecked_with(x: Int) -> Int {
    let _u = U + 1;
    x
}
