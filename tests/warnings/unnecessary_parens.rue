fn main(value: Int, flag: Bool) -> Int {
    let grouped = (value + 1);
    let atomic = (value) * 2;
    let nested = ((value + 1)) * 2;
    assert (value > 0);
    let call = add((value * 2), 1);
    let list = [(value + 1), 2];

    if (flag) {
        return (grouped);
    }

    let power = (value) ** (2);

    // Parentheses that change how the expression is evaluated are needed
    let needed = (value + 1) * 2;
    let negated = -(value + 1);
    let power_of_negation = (-value) ** 2;
    let power_of_power = (value ** 2) ** 3;
    let power_of_sum = value ** (1 + 1);

    // A struct initializer can't be written without parentheses in a condition
    if (Point { x: value, y: 1 }).x > 100 {
        return 0;
    }

    if (Point { x: value, y: 1 }.x > 200) {
        return 0;
    }

    if (Wrapper { f: fn(v: Int) => v + 1 }).f(value) > 300 {
        return 0;
    }

    atomic
        + nested
        + call
        + list.first
        + power
        + needed
        + negated
        + power_of_negation
        + power_of_power
        + power_of_sum
}

struct Point {
    x: Int,
    y: Int,
}

struct Wrapper {
    f: fn(value: Int) -> Int,
}

fn add(a: Int, b: Int) -> Int {
    a + b
}
