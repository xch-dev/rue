// What's left is merged, so the else branch is any `Eight`
fn guard(value: Eight) -> Int {
    if value is EvenEight {
        return 1;
    }
    2
}

fn match_arm(value: Eight) -> Int {
    match value {
        EvenEight => 1,
        _ => 2,
    }
}

// Up to 64 combinations can be left, so this isn't reported
fn at_limit(value: Seven) -> Int {
    if value is EvenSeven {
        return 1;
    }
    2
}

#[allow(imprecise_narrowing)]
fn allowed(value: Eight) -> Int {
    if value is EvenEight {
        return 1;
    }
    2
}

fn main() -> Int {
    let a = A { kind: 1 };
    let b = B { kind: 2 };
    let even = Eight { f0: a, f1: a, f2: a, f3: a, f4: a, f5: a, f6: b, f7: b };
    let odd = Seven { f0: a, f1: a, f2: a, f3: a, f4: a, f5: a, f6: b };
    guard(even) + match_arm(even) + at_limit(odd) + allowed(even)
}
