struct A {
    kind: 1,
}

struct B {
    kind: 2,
}

struct Eight {
    f0: A | B,
    f1: A | B,
    f2: A | B,
    f3: A | B,
    f4: A | B,
    f5: A | B,
    f6: A | B,
    f7: A | B,
}

struct Seven {
    f0: A | B,
    f1: A | B,
    f2: A | B,
    f3: A | B,
    f4: A | B,
    f5: A | B,
    f6: A | B,
}

