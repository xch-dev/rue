// What a `for` does at the end of its list is always evaluated when the `for` is: the items after
// one that's spread in a list, and the value of a fold. Its body isn't, since the list can be
// empty, and neither is the value of a fold that can stop before the end

fn check(x: Int) -> Int {
    assert x > 0;
    x
}

fn inline_values(xs: List<Int>, k: Int) -> List<Any> {
    // Always evaluated, so nothing is reported
    inline let after = check(k);
    inline let after_before_a_list = check(k + 1);
    inline let after_a_filter = check(k + 2);
    inline let fold_value = check(k + 3);
    inline let after_two = check(k + 4);

    // Not always evaluated
    inline let stopped_fold_value = check(k + 5);
    inline let in_the_body = check(k + 6);
    inline let in_the_filter = check(k + 7);
    inline let after_a_stopped_fold = check(k + 8);

    [
        [...for x in xs { x }, after],
        [0, ...for x in xs { x }, ...[after_before_a_list]],
        [...for x in xs if x > 1 { x }, after_a_filter],
        for x in xs fold sum = fold_value { sum + x },
        [...for x in xs { x }, ...for x in xs { x + 1 }, after_two],
        for x in xs fold found = stopped_fold_value > 5 { x == 1 || found },
        [...for x in xs { x + in_the_body }, 0],
        [...for x in xs if x > in_the_filter { x }, 0],
        for x in xs fold found = false {
            x == 1 || [...for y in xs { y }, after_a_stopped_fold] is nil || found
        },
    ]
}

// A function that calls itself in the items after a `for`, or in the value of a fold, calls
// itself on every path
fn after_a_for(xs: List<Int>) -> List<Int> {
    [...for x in xs { x }, ...after_a_for(xs)]
}

fn after_a_filtered_for(xs: List<Int>, k: Int) -> List<Int> {
    [k, ...for x in xs if x > k { x }, ...after_a_filtered_for(xs, k - 1)]
}

fn in_a_fold_value(xs: List<Int>) -> Int {
    for x in xs fold sum = in_a_fold_value(xs) { sum + x }
}

// It doesn't if the fold can stop before the end of its list, if the call is in the body, or if
// another path doesn't get to the `for`
fn in_a_stopped_fold_value(xs: List<Int>) -> Bool {
    for x in xs fold found = in_a_stopped_fold_value(xs) { x == 1 || found }
}

fn in_the_body(xs: List<Int>) -> List<Int> {
    [...for x in xs { x + in_a_fold_value(in_the_body(xs)) }, 1]
}

fn after_a_for_in_a_branch(xs: List<Int>) -> List<Int> {
    if xs is nil {
        nil
    } else {
        [...for x in xs { x }, ...after_a_for_in_a_branch(xs.rest)]
    }
}

fn main(xs: List<Int>, k: Int) -> List<Any> {
    [
        inline_values(xs, k),
        after_a_for(xs),
        after_a_filtered_for(xs, k),
        in_a_fold_value(xs),
        in_a_stopped_fold_value(xs),
        in_the_body(xs),
        after_a_for_in_a_branch(xs),
    ]
}
