#![warn(negated_condition)]

fn main(value: Int, flag: Bool) -> Int {
    let negated = if !flag {
        1
    } else {
        2
    };
    let not_equal = if value != 5 {
        1
    } else {
        2
    };
    let grouped = if !(flag && value > 1) {
        1
    } else {
        2
    };

    // The negation is found inside of parentheses, even around a comment
    let commented = if (
        !flag // note
    ) {
        1
    } else {
        2
    };

    // An `else if` chain would be reordered by swapping the branches
    let chain = if !flag {
        1
    } else if value > 5 {
        2
    } else {
        3
    };

    negated + not_equal + grouped + commented + chain
}
