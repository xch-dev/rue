fn main(value: Bytes, flag: Bool) -> Bytes32 {
    let first = sha256(value);
    let second = sha256(value);

    // Calls in different branches are only evaluated once
    let branches = if flag {
        tree_hash(value)
    } else {
        tree_hash(value) + first
    };

    // A call before a branch is evaluated whenever the one inside of it is
    let hashed = coinid(first, second, 1);
    let inside = if flag {
        coinid(first, second, 1)
    } else {
        first
    };

    // The calls inside of a repeated call aren't reported again
    let nested = sha256(sha256(value) + value);
    let nested_again = sha256(sha256(value) + value);

    // A short call costs less to evaluate again than a new binding would add to the program
    let short = sha256(first + second) + sha256(first + second);

    // A function that calls itself is expensive to call again
    let recursive = tree_hash(nested) + tree_hash(nested);

    sha256(first + second + branches + hashed + inside + nested + nested_again + short + recursive)
}
