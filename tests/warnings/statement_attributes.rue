// Attributes apply to `if` and `match` statements, like any other statement

enum Mode {
    Open,
    Closed,
}

test fn attributes() -> Int {
    allowed_if(2) + expected_match(Mode::Open) + allowed_inline_match(1) + allowed_value(true)
}

fn allowed_if(value: Int) -> Int {
    #[allow(unused_binding)]
    if value > 1 {
        let unused = 1;
        return 1;
    } else {
        let unused_too = 2;
    }

    value
}

fn expected_match(mode: Mode) -> Int {
    #[expect(unreachable_match_arm)]
    match mode {
        _ => {
            debug mode;
        }
        Mode::Closed => {
            return 1;
        }
    }

    2
}

fn allowed_inline_match(value: Int) -> Int {
    #[allow(inline_match_may_raise)]
    inline match value {
        0 => {
            assert value == 0;
        }
        _ => {}
    }

    value
}

fn allowed_value(flag: Bool) -> Int {
    #[allow(unused_binding)]
    if flag {
        let unused = 1;
        1
    } else {
        2
    }
}

// An expectation that isn't fulfilled is still reported
fn unfulfilled(value: Int) -> Int {
    #[expect(unused_binding)]
    match value {
        0 => {
            return 0;
        }
        _ => {}
    }

    value
}

test fn unfulfilled_called() -> Int {
    unfulfilled(1)
}

// A statement's attributes aren't part of its code, so what's reported about it is reported at
// the statement itself
fn reported_at_statement(value: Int) -> Int {
    #[warn(inline_match_may_raise)]
    inline match value {
        0 => {
            assert value == 0;
        }
        _ => {}
    }

    value
}

test fn reported_at_statement_called() -> Int {
    reported_at_statement(1)
}
