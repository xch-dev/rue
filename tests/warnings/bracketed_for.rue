// A `for` is a list already, so brackets around it make a list with one list in it

fn check(x: Int) {
    assert x > 0;
}

fn length(xs: List<Any>) -> Int {
    for _x in xs fold count = 0 { count + 1 }
}

fn pairs(xs: List<Int>) -> List<(Int, Int)> {
    for x in xs { (x, x) }
}

fn same<T>(xs: List<T>) -> List<T> {
    xs
}

fn either<T>(xs: List<T | List<Int>>) -> List<T | List<Int>> {
    xs
}

fn flatten<T>(lists: List<List<T>>) -> List<T> {
    for list in lists fold rest: List<T> = nil { [...list, ...rest] }
}

type Tree = Int | List<Tree>;

fn groups(xs: List<Int>) -> List<List<Int>> {
    // A list of lists is expected here
    [for x in xs { x }]
}

fn main(xs: List<Int>) -> Int {
    let a = [for x in xs { x * 2 }];
    let b = [for x in xs if x > 0 { x }];

    // Over several lines
    let c = [
        for x in xs {
            assert x > 0;
            x
        },
    ];
    let d = [for (x, y) in pairs(xs) { x + y }];

    // Where the list is an operand, the `for` needs parentheses in its place
    let e = length([for x in xs { x }]) + length([for x in xs { x }].first);
    let f = [for x in xs { x }] as Any;

    // A comment in the brackets would be removed with them
    let g = [/* doubled */ for x in xs { x * 2 }];

    // The type the list is given isn't a list of lists
    let h: Any = [for x in xs { x }];

    // A list of lists is expected, or it's cast to one
    let i: List<List<Int>> = [for x in xs { x }];
    let j = [for x in xs { x }] as List<List<Int>>;
    let k = groups(xs);

    // So is one whose items are each a list or something else, or a pair that starts with a list
    let r: List<Tree> = [for x in xs { x }];
    let s: List<List<Int> | Int> = [for x in xs { x }];
    let t: List<List<Int>> | nil = [for x in xs { x }];
    let u: (List<Int>, nil) = [for x in xs { x }];

    // A generic type doesn't say that the items are lists, alone or with a list, though a list
    // of a generic type does
    let v = same([for x in xs { x }]);
    let y = either([for x in xs { x }]);
    let z = flatten([for x in xs { x }]);

    // Parentheses around the `for` aren't needed, and it's reported without them
    let w = [(for x in xs { x })];

    // A fold is a single value, and a loop's value is nil
    let l = [for x in xs fold sum = 0 { sum + x }];
    let x = [for x in xs fold rest: List<Int> = nil { [x, ...rest] }];
    let m = [for x in xs { check(x) }];

    // A `for` that's spread, or that isn't the only item
    let n = [...for x in xs { x }];
    let o = [for x in xs { x }, 1];
    let p = [0, ...for x in xs { x }];

    // The lint can be allowed
    #[allow(bracketed_for)]
    let q = [for x in xs { x }];

    length(a)
        + length(b)
        + length(c)
        + length(d)
        + e
        + length([f])
        + length(g)
        + length([h])
        + length(i)
        + length(j)
        + length(k)
        + length(l)
        + length(m)
        + length(n)
        + length(o)
        + length(p)
        + length(q)
        + length(r)
        + length(s)
        + length(t)
        + length(u)
        + length(v)
        + length(w)
        + length(x)
        + length(y)
        + length(z)
}
