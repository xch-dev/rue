struct Point {
    x: Int,
    y: Int,
}

struct Wrapper {
    ...inner: Int,
}

struct Empty {}

fn make(n: Int) -> Point {
    assert n > 0;
    Point { x: n, y: n }
}

// Every field is written, so nothing is copied from the value
test fn every_field(point: Point) -> Point {
    Point { ...point, x: 1, y: 2 }
}

test fn every_field_out_of_order(point: Point) -> Point {
    Point { ...point, y: 2, x: 1 }
}

test fn only_field(wrapper: Wrapper) -> Wrapper {
    Wrapper { ...wrapper, inner: 1 }
}

// A struct with no fields has nothing to copy
test fn no_fields(empty: Empty) -> Empty {
    Empty { ...empty }
}

// The value is still evaluated if it isn't a path, so removing it isn't always the same
test fn every_field_of_call(n: Int) -> Point {
    Point { ...make(n), x: 1, y: 2 }
}

test fn every_field_on_lines(point: Point) -> Point {
    Point {
        ...point,
        x: point.x + point.x + point.x + point.x + point.x + point.x + point.x + point.x,
        y: point.y + point.y + point.y + point.y + point.y + point.y + point.y + point.y,
    }
}

struct Spend {
    opcode = 51,
    amount: Int,
}

struct Tagged {
    tag: 7,
    amount: Int,
}

enum Shape {
    Square { side: Int },
    Rect { width: Int, height: Int },
}

// The fields that aren't written are all constants, so nothing is read from the value
test fn other_fields_are_constants(spend: Spend, n: Int) -> Spend {
    Spend { ...spend, amount: n }
}

test fn only_the_discriminant_is_left(square: Shape::Square, n: Int) -> Shape::Square {
    Shape::Square { ...square, side: n }
}

struct Marker {
    opcode = 51,
    version = 2,
}

// Every field is a constant, so the value isn't read though no field is written
test fn only_constants(marker: Marker) -> Marker {
    Marker { ...marker }
}

// A constant without a default value would be missing without the spread, so it isn't removed
test fn constant_without_a_default(tagged: Tagged, n: Int) -> Tagged {
    Tagged { ...tagged, amount: n }
}

// A field that isn't a constant is left, so the value is used
test fn variant_field_is_left(rect: Shape::Rect, n: Int) -> Shape::Rect {
    Shape::Rect { ...rect, width: n }
}

// A field is left to copy, so the value is used
test fn one_field(point: Point) -> Point {
    Point { ...point, x: 1 }
}

test fn no_fields_written(point: Point) -> Point {
    Point { ...point }
}

// The lint can be allowed or expected
#[allow(unused_struct_spread)]
test fn allowed(point: Point) -> Point {
    Point { ...point, x: 1, y: 2 }
}

test fn expected(point: Point) -> Int {
    #[expect(unused_struct_spread)]
    let updated = Point { ...point, x: 1, y: 2 };
    updated.x + updated.y
}
