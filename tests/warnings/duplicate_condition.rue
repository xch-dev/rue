fn main(value: Int, flag: Bool, other: Bool) -> Int {
    let chain = if value > 10 {
        1
    } else if value > 5 {
        2
    } else if value > 10 {
        3
    } else {
        4
    };

    let and = flag && other && flag;
    let or = flag || flag;
    let all = flag & other & flag;

    // Different conditions aren't reported
    let distinct = flag && other;

    if and || or || all || distinct {
        chain
    } else {
        0
    }
}
