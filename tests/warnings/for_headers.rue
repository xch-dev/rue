#![warn(shadowed_binding)]
#![warn(naming_convention)]
#![warn(unnecessary_parens)]
#![warn(inline_value_may_fail)]

// The lints see every list in the header of a `for`, and each of its bindings

struct Wrapper {
    list: List<Int>,
}

fn positive(x: Int) -> Int {
    assert x > 0;
    x
}

fn main(xs: List<Int>, ys: List<Int>, rest: Int, y: Int, flag: Bool) -> List<Int> {
    // An item, and what's left of a list, that the filter and the body don't use
    let a = for x, others in xs { x };
    let b = for x in xs, other in ys { x };
    let c = for x, others in xs, other, more in ys fold sum = 0 { sum + x + other };

    // They're used if only the filter refers to them
    let d = for x, others in xs, other in ys if other > length(others) { x };

    // A name that starts with `_` isn't reported, and `_` doesn't bind anything
    let e = for x, _others in xs, _ in ys { x };
    let f = for x, _ in xs { x };

    // The names of what's left of a list and of another list's item
    let g = for x, restOfList in xs, otherItem in ys { x + otherItem + length(restOfList) };

    // They shadow the names around the `for`, but not in the lists, which are outside of them
    let h = for x, rest in xs, y in [y, rest] { x + y + length(rest) };

    // Parentheses around a list, which a struct initializer needs
    let i = for x in (xs), other in (ys) { x + other };
    let j = for x in xs, other in (Wrapper { list: ys }).list { x + other };

    // The result of a fold over several lists that's evaluated where the body refers to it isn't
    // an `inline let`, though it may fail and isn't always evaluated
    let k = for x in xs, other in ys fold found = false { x == 1 || positive(other) == 5 || found };

    // An `inline let` whose value is a `for` over several lists can fail, since a list can run
    // out, whatever its body does
    inline let l = for x in xs, other in ys { x + other };
    inline let m = for x in xs, other in ys fold sum = 0 { sum + x + other };

    // An `inline let` in the body that reads the item of a list that can run out is only
    // skipped with its failure in a fold. Without one, the loop fails for that item anyway
    let o = for x in xs, other in ys {
        inline let next = other + 1;
        if x == 1 {
            0
        } else {
            next
        }
    };
    let p = for x in xs, other in ys fold sum = 0 {
        inline let next = other + 1;
        if x == 1 {
            100
        } else {
            sum + next
        }
    };

    // Over one list, it can't, unless its body can
    inline let n = for x, others in xs { x + length(others) };

    [
        ...a,
        ...b,
        c,
        ...d,
        ...e,
        ...f,
        ...g,
        ...h,
        ...i,
        ...j,
        ...o,
        p,
        if k {
            1
        } else {
            0
        },
        ...if flag {
            l
        } else {
            n
        },
        if flag {
            m
        } else {
            0
        },
    ]
}
