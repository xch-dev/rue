fn check(x: Int) -> Int {
    assert x < 100;
    x
}

// Inline bindings

// Warns: only evaluated in one branch
fn conditional_inline_binding(x: Int, flag: Bool) -> Int {
    inline let checked = check(x);
    if flag {
        checked
    } else {
        0
    }
}

// Warns: never evaluated
fn unused_inline_binding(x: Int) -> Int {
    inline let _checked = check(x);
    x
}

// Warns: not evaluated if the function returns early
fn inline_binding_after_early_return(x: Int, flag: Bool) -> Int {
    inline let checked = check(x);
    if flag {
        return 0;
    }
    checked
}

// Warns: a lambda's body might not be called
fn inline_binding_in_lambda(x: Int) -> fn() -> Int {
    inline let checked = check(x);
    fn() => checked
}

// Doesn't warn: always evaluated
fn unconditional_inline_binding(x: Int) -> Int {
    inline let checked = check(x);
    checked + 1
}

// Doesn't warn: always evaluated through another binding
fn inline_binding_through_binding(x: Int, flag: Bool) -> Int {
    inline let checked = check(x);
    let doubled = checked * 2;
    if flag {
        doubled
    } else {
        0
    }
}

// Doesn't warn: can't fail
fn safe_inline_binding(x: Int, flag: Bool) -> Int {
    inline let doubled = x * 2;
    if flag {
        doubled
    } else {
        0
    }
}

// Doesn't warn: the program fails before it would matter
fn inline_binding_before_raise(x: Int) -> Int {
    inline let _checked = check(x);
    raise "failed";
}

// Inline constants

// Warns: may fail
inline const CHECKED: Int = check(5);

// Doesn't warn: can't fail
inline const DOUBLED: Int = 5 * 2;

// Doesn't warn: isn't inline
const NOT_INLINE: Int = check(5);

// Arguments of inline functions

inline fn pick(value: Int, flag: Bool) -> Int {
    if flag {
        value
    } else {
        0
    }
}

inline fn ignore(_value: Int, other: Int) -> Int {
    other
}

inline fn double(value: Int) -> Int {
    value * 2
}

inline fn capture(value: Int) -> fn() -> Int {
    fn() => value
}

inline fn forward(value: Int, flag: Bool) -> Int {
    pick(value, flag)
}

inline fn sum(...values: List<Int>) -> Int {
    if values is (Int, Any) {
        values.first
    } else {
        0
    }
}

inline fn count(..._values: List<Int>) -> Int {
    0
}

fn inline_arguments(x: Int, flag: Bool) -> Int {
    // Warns: only evaluated in one branch
    let a = pick(check(x), flag);

    // Warns: never evaluated
    let b = ignore(check(x), 1);

    // Warns: never evaluated by the function it's forwarded to
    let c = forward(check(x), flag);

    // Warns: a rest parameter that's never evaluated
    let d = count(...[check(x), 1]);

    // Doesn't warn: always evaluated
    let e = double(check(x));

    // Doesn't warn: captured by value, so evaluated when the closure is created
    let f = capture(check(x));

    // Doesn't warn: a rest parameter that's always evaluated
    let g = sum(...[check(x), 1]);

    // Doesn't warn: can't fail
    let h = pick(x * 2, flag);

    // Doesn't warn: bound with `let`, so it's evaluated before the call
    let checked = check(x);
    let i = pick(checked, flag);

    a + b + c + d + e + f() + g + h + i + CHECKED + DOUBLED + NOT_INLINE
}

test fn tests() -> Int {
    conditional_inline_binding(1, true)
        + unused_inline_binding(1)
        + inline_binding_after_early_return(1, false)
        + inline_binding_in_lambda(1)()
        + unconditional_inline_binding(1)
        + inline_binding_through_binding(1, true)
        + safe_inline_binding(1, true)
        + inline_arguments(1, true)
}

test fn raises() -> Int {
    inline_binding_before_raise(1)
}
