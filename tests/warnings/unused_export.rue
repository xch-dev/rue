export reexported::item;

import enums::ByImportedVariant::A;

// The glob's path names the enum, even though none of its variants are used
#[allow(unused_import)]
import enums::ByUnusedGlob::*;

mod helpers {
    export fn used_outside() -> Int {
        only_inside() + 1
    }

    export fn only_inside() -> Int {
        CONSTANT
    }

    export const CONSTANT: Int = 42;

    fn private() -> Int {
        2
    }

    export fn calls_private() -> Int {
        private()
    }
}

// Items of an exported module can be used by anything that imports the file
export mod public {
    export fn only_inside() -> Int {
        1
    }

    export fn exported() -> Int {
        only_inside()
    }
}

// A nested module can use the items of the modules it's in through `super`, even private ones, so
// an item that's only used there doesn't need to be exported
mod outer {
    export fn used_by_nested() -> Int {
        1
    }

    export mod nested {
        export fn uses_outer() -> Int {
            super::used_by_nested()
        }
    }
}

// A nested module can use the items of the module it's in through `super`, which doesn't need
// them to be exported, but referencing an item through its module (even from inside of it) does
mod lexical {
    export fn by_name() -> Int {
        1
    }

    export fn by_path() -> Int {
        super::lexical::by_name() + 1
    }

    export fn only_by_name() -> Int {
        2
    }

    export mod nested {
        export fn uses_parent() -> Int {
            super::by_name() + super::only_by_name()
        }
    }
}

// An item that's imported or re-exported elsewhere must be exported
mod reexported {
    export fn item() -> Int {
        1
    }

    export fn uses_item() -> Int {
        item()
    }
}

// A type in the signature of another export is part of what the module exports, but one that's
// only used in the body of an export isn't
mod signature {
    export struct Coin {
        amount: Int,
    }

    export fn make() -> Coin {
        Coin { amount: 1 }
    }

    export struct Temporary {
        value: Int,
    }

    export fn body() -> Int {
        Temporary { value: 1 }.value
    }
}

// A struct that refers to itself isn't kept exported by its own fields
mod recursive {
    export struct Node {
        value: Int,
        next: Node | nil,
    }

    export fn total() -> Int {
        Node { value: 1, next: nil }.value
    }
}

// A type in the signature of an export of an exported module is exported by both of them
mod parent {
    export struct Item {
        value: Int,
    }

    export mod child {
        export fn make() -> super::Item {
            super::Item { value: 1 }
        }
    }
}

// Only the signatures of exports that are used outside of the module keep types exported, so
// both of these are reported at once
mod chain {
    export struct Result {
        value: Int,
    }

    export fn make() -> Result {
        Result { value: 1 }
    }

    export fn used() -> Int {
        make().value
    }
}

// A type in the signature of a nested module's export is only kept exported if that export is
// used outside of this module
mod internal {
    export struct Value {
        value: Int,
    }

    export mod inner {
        export fn make() -> super::Value {
            super::Value { value: 1 }
        }
    }

    export fn total() -> Int {
        inner::make().value
    }
}

// A type in the signature of an item that's re-exported is part of what the module exports
mod reexporting {
    export struct Item {
        value: Int,
    }

    mod inner {
        export fn make() -> super::Item {
            super::Item { value: 1 }
        }
    }

    export inner::make;
}

// A module is only public if every module it's in is exported, up to the file, so `helper` is
// reported: `hidden` isn't exported
mod hidden {
    export mod inner {
        export fn helper() -> Int {
            1
        }

        export fn used() -> Int {
            helper()
        }
    }
}

// An enum only needs to be exported if it's used from outside of the module, through its name or
// through one of its variants
mod enums {
    export enum OnlyInside {
        A,
        B { value: Int },
    }

    export enum ByVariant {
        A,
    }

    export enum ByImportedVariant {
        A { value: Int },
    }

    export enum ByName {
        A,
        B,
    }

    export enum ByUnusedGlob {
        A,
    }

    // Only one of its variants is in the signature of an export used from outside
    export enum InSignature {
        A { value: Int },
        B,
    }

    export fn in_signature() -> InSignature::A {
        InSignature::A { value: 3 }
    }

    export fn inside() -> Int {
        let a: OnlyInside = OnlyInside::A;
        assert a is OnlyInside::A;
        OnlyInside::B { value: 1 }.value + ByUnusedGlob::A as Int
    }
}

fn by_name(value: enums::ByName) -> Bool {
    value is enums::ByName::A
}

// Each module is exported from the one it's in, up to the file, so none of these are reported
export mod deep {
    export mod b {
        export mod c {
            export fn value() -> Int {
                2
            }

            export fn calls() -> Int {
                value()
            }
        }
    }
}

fn main() -> Int {
    helpers::used_outside()
        + helpers::calls_private()
        + public::exported()
        + outer::nested::uses_outer()
        + reexported::uses_item()
        + signature::make().amount
        + signature::body()
        + lexical::by_path()
        + lexical::nested::uses_parent()
        + recursive::total()
        + parent::child::make().value
        + chain::used()
        + internal::total()
        + reexporting::make().value
        + hidden::inner::used()
        + deep::b::c::calls()
        + enums::inside()
        + enums::ByVariant::A as Int
        + A { value: 1 }.value
        + by_name(enums::ByName::A) as Int
        + enums::in_signature().value
}
