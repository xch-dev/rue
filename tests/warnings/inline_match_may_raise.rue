// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

// Arms which can raise are evaluated whichever arm matches

test fn raise_arm() -> Int | nil {
    raise_arm_branch(1)
}

fn raise_arm_branch(x: Int | nil) -> Int | nil {
    inline match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

test fn assert_arm() -> Int {
    assert_arm_branch(1)
}

fn assert_arm_branch(x: Int) -> Int {
    inline match x {
        0 => 1,
        _ => {
            assert x > 5;
            x
        }
    }
}

// A normal `match` only evaluates the arm that matches

test fn normal_match() -> Int {
    normal_match_branch(1)
}

fn normal_match_branch(x: Int | nil) -> Int {
    match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

// An arm that can't raise isn't reported

test fn no_raise() -> Int {
    no_raise_branch(1)
}

fn no_raise_branch(x: Int | nil) -> Int {
    inline match x {
        nil => 0,
        Int => 1,
    }
}

// The only arm is the one that's evaluated

test fn single_arm() -> Int {
    single_arm_branch(1)
}

fn single_arm_branch(x: Int) -> Int {
    inline match x {
        _ => {
            assert x > 5;
            x
        }
    }
}

// The condition of an arm after the first is evaluated for the values that an earlier arm takes

test fn condition_raises() -> Int {
    condition_raises_branch(0)
}

fn positive(x: Int) -> Bool {
    assert x > 0;
    true
}

fn condition_raises_branch(x: Int) -> Int {
    inline match x {
        0 => 1,
        _ if positive(x) => 2,
        _ => 3,
    }
}

// A condition is only evaluated for the values of its arm's type, so it's reported when an
// earlier arm takes some of them

test fn overlapping_condition_raises() -> Int {
    overlapping_condition_raises_branch(1, 0)
}

fn overlapping_condition_raises_branch(x: Int, y: Int) -> Int {
    inline match x {
        1 if y > 5 => 1,
        1 if positive(y) => 2,
        _ => 3,
    }
}

// The earlier arms take none of the values that these conditions are evaluated for

test fn disjoint_condition() -> Int {
    disjoint_condition_branch(0) + disjoint_pair_condition_branch(5)
}

fn disjoint_condition_branch(x: Int) -> Int {
    inline match x {
        0 => 1,
        1 if positive(x - 2) => 2,
        _ => 3,
    }
}

fn disjoint_pair_condition_branch(x: Int | (Int, Int)) -> Int {
    inline match x {
        Int => 1,
        (Int, Int) if positive(x.first) => 2,
        _ => 3,
    }
}

// The condition of the first arm is evaluated either way, like the condition of an `if`

test fn first_condition_raises() -> Int {
    first_condition_raises_branch(1)
}

fn first_condition_raises_branch(x: Int) -> Int {
    inline match x {
        _ if positive(x) => 2,
        _ => 3,
    }
}

// The lint can be allowed

test fn allowed() -> Int | nil {
    allowed_branch(1)
}

#[allow(inline_match_may_raise)]
fn allowed_branch(x: Int | nil) -> Int | nil {
    inline match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

// When an arm of an `inline match` statement returns, the arm that falls through still evaluates
// the rest of the block
test fn statement_rest_raises() -> Int {
    statement_rest_raises_branch(nil, 1)
}

fn statement_rest_raises_branch(x: Int | nil, y: Int) -> Int {
    inline match x {
        nil => {
            return 0;
        }
        Int => {}
    }

    assert y != 1;
    y
}

// No arm returns, so the rest of the block is evaluated whichever arm is taken
test fn statement_without_return() -> Int {
    statement_without_return_branch(nil, 4)
}

fn statement_without_return_branch(x: Int | nil, y: Int) -> Int {
    inline match x {
        nil => {
            debug 0;
        }
        Int => {}
    }

    assert y != 1;
    y
}

// An `inline match` statement in a branch of another statement evaluates the rest of the block
// after that statement too
test fn nested_statement_rest_raises() -> Int {
    nested_statement_rest_raises_branch(nil, 1, true)
}

fn nested_statement_rest_raises_branch(x: Int | nil, y: Int, flag: Bool) -> Int {
    if flag {
        inline match x {
            nil => {
                return 0;
            }
            Int => {}
        }
    } else {
        debug y;
    }

    assert y != 1;
    y
}

// An `inline match` that's an arm of a `match` statement evaluates the rest of the block after it
test fn arm_rest_raises() -> Int {
    arm_rest_raises_branch(nil, nil, 1)
}

fn arm_rest_raises_branch(x: Int | nil, z: Int | nil, y: Int) -> Int {
    match x {
        nil => inline match z {
            nil => {
                return 1;
            }
            Int => {}
        }
        Int => {
            debug y;
        }
    }

    assert y != 1;
    2
}

// Reported once when both the statement's own rest and the rest after the statement it's in can
// raise
test fn nested_reported_once() -> Int {
    nested_reported_once_branch(nil, 1, true)
}

fn nested_reported_once_branch(x: Int | nil, y: Int, flag: Bool) -> Int {
    if flag {
        inline match x {
            nil => {
                return 0;
            }
            Int => {}
        }

        assert y > 1;
    } else {
        debug y;
    }

    assert y > 2;
    y
}
