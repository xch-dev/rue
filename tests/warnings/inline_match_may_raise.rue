// Arms which can raise are evaluated whichever arm matches

test fn raise_arm() -> Int | nil {
    raise_arm_branch(1)
}

fn raise_arm_branch(x: Int | nil) -> Int | nil {
    inline match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

test fn assert_arm() -> Int {
    assert_arm_branch(1)
}

fn assert_arm_branch(x: Int) -> Int {
    inline match x {
        0 => 1,
        _ => {
            assert x > 5;
            x
        }
    }
}

// A normal `match` only evaluates the arm that matches

test fn normal_match() -> Int {
    normal_match_branch(1)
}

fn normal_match_branch(x: Int | nil) -> Int {
    match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

// An arm that can't raise isn't reported

test fn no_raise() -> Int {
    no_raise_branch(1)
}

fn no_raise_branch(x: Int | nil) -> Int {
    inline match x {
        nil => 0,
        Int => 1,
    }
}

// The only arm is the one that's evaluated

test fn single_arm() -> Int {
    single_arm_branch(1)
}

fn single_arm_branch(x: Int) -> Int {
    inline match x {
        _ => {
            assert x > 5;
            x
        }
    }
}

// The lint can be allowed

test fn allowed() -> Int | nil {
    allowed_branch(1)
}

#[allow(inline_match_may_raise)]
fn allowed_branch(x: Int | nil) -> Int | nil {
    inline match x {
        nil => {
            raise "missing";
        }
        Int => x,
    }
}

// When an arm of an `inline match` statement returns, the arm that falls through still evaluates
// the rest of the block
test fn statement_rest_raises() -> Int {
    statement_rest_raises_branch(nil, 1)
}

fn statement_rest_raises_branch(x: Int | nil, y: Int) -> Int {
    inline match x {
        nil => {
            return 0;
        }
        Int => {}
    }

    assert y != 1;
    y
}

// No arm returns, so the rest of the block is evaluated whichever arm is taken
test fn statement_without_return() -> Int {
    statement_without_return_branch(nil, 4)
}

fn statement_without_return_branch(x: Int | nil, y: Int) -> Int {
    inline match x {
        nil => {
            debug 0;
        }
        Int => {}
    }

    assert y != 1;
    y
}

// An `inline match` statement in a branch of another statement evaluates the rest of the block
// after that statement too
test fn nested_statement_rest_raises() -> Int {
    nested_statement_rest_raises_branch(nil, 1, true)
}

fn nested_statement_rest_raises_branch(x: Int | nil, y: Int, flag: Bool) -> Int {
    if flag {
        inline match x {
            nil => {
                return 0;
            }
            Int => {}
        }
    } else {
        debug y;
    }

    assert y != 1;
    y
}

// An `inline match` that's an arm of a `match` statement evaluates the rest of the block after it
test fn arm_rest_raises() -> Int {
    arm_rest_raises_branch(nil, nil, 1)
}

fn arm_rest_raises_branch(x: Int | nil, z: Int | nil, y: Int) -> Int {
    match x {
        nil => inline match z {
            nil => {
                return 1;
            }
            Int => {}
        }
        Int => {
            debug y;
        }
    }

    assert y != 1;
    2
}
