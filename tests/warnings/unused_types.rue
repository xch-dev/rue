type Recursive = Int | (Recursive, Recursive);
type A = Int | (B, B);
type B = A;
type Used = 42;
type Unused = "Hello, world!";

const USED_VALUE: 42 = 42;
const UNUSED_VALUE: 34 = 34;

struct UsedStruct {
    value = USED_VALUE,
}

struct UnusedStruct {
    value = UNUSED_VALUE,
}

type UsedAlias = UsedStruct;
type UnusedAlias = UnusedStruct;
type Thing1 = 42;
type Thing2 = 42;

const INNER: Thing1 = 42;
const OUTER: Thing2 = 42;

struct Inner {
    value = INNER,
}

struct Outer {
    inner = Inner {},
    value = OUTER,
}

enum UnusedEnum {
    Variant,
}

// Using a variant uses its enum, even if the enum isn't named
enum UsedThroughVariant {
    First,
    Second { value: Int },
}

enum UsedThroughConstant {
    Only,
}

// Variants that are never used aren't reported, only enums
enum UsedByName {
    Never,
    Ever,
}

type RecursiveWithBaseCase<T> = nil | (T, RecursiveWithBaseCase<T>);

fn main() -> (A, Used) {
    (34, 42)
}

test fn alias() -> Int {
    UsedAlias {}.value
}

test fn nested() -> Outer {
    Outer {}
}

test fn variants() -> Int {
    let second = UsedThroughVariant::Second { value: 1 };
    assert UsedThroughConstant::Only as Int == 0;
    second.value
}

fn is_ever(value: UsedByName) -> Bool {
    value is UsedByName::Ever
}

test fn enum_name() -> Bool {
    is_ever(UsedByName::Ever)
}

test fn recursive() -> RecursiveWithBaseCase<Int> {
    nil
}
