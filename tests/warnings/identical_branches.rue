fn main(condition: Bool, value: Int, first: Point, second: Point) -> Int {
    let same = if condition {
        value + 1
    } else {
        value + 1
    };

    // Bindings with the same value in each branch are the same
    let blocks = if condition {
        let doubled = value * 2;
        doubled + 1
    } else {
        let doubled = value * 2;
        doubled + 1
    };

    let different = if condition {
        value
    } else {
        value + 1
    };

    // Structs updated from the same value are the same, but not ones updated from different
    // values, though the fields that are written are the same
    let same_update = if condition {
        Point { ...first, x: 1 }
    } else {
        Point { ...first, x: 1 }
    };

    let different_update = if condition {
        Point { ...first, x: 1 }
    } else {
        Point { ...second, x: 1 }
    };

    same + blocks + different + same_update.y + different_update.y
}

struct Point {
    x: Int,
    y: Int,
}
