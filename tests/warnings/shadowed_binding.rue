#![warn(shadowed_binding)]

fn main(value: Int) -> Int {
    let value = value + 1;
    let (first, rest) = (value, value);
    let first = first * 2;

    let closure = fn(rest: Int) => rest + 1;

    let scoped = {
        let inner = 1;
        inner
    };

    // Bindings in separate blocks don't shadow each other
    let separate = {
        let inner = 2;
        inner
    };

    // Names starting with `_` aren't reported
    let _ignored = 1;
    let _ignored = 2;

    first + rest + closure(value) + scoped + separate
}

// An arm's bindings shadow what's in scope where the match is, including the value being matched
// on, but not the bindings of the other arms
export fn arms(value: (Int, Int) | Int, first: Int) -> Int {
    let rest = first;

    rest
        + match value {
            (Int, Int) (first, rest) => first + rest,
            Int => {
                let rest = value;
                rest + 1
            }
        }
}

export fn scrutinee(value: (Int, Int) | Int) -> Int {
    match value {
        (Int, Int) (value, _rest) => value,
        Int => value,
    }
}

// The bindings of each arm are separate, and a name starting with `_` isn't reported
export fn separate_arms(value: (Int, Int) | [Int, Int, Int]) -> Int {
    match value {
        (Int, Int) (a, _value) => a,
        [Int, Int, Int] [a, _value, _] => a,
    }
}
