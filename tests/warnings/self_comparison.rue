fn main(a: Int, b: Int, bytes: Bytes) -> Bool {
    let same = a == a;
    let different = a != a;
    let ordered = a < a;
    let bytes_ordered = bytes >= bytes;
    let difference = a - a;
    let xor = a ^ a;
    let and = a & a;

    // Casts don't change the value, and bindings with the same value are the same
    let copy = a;
    let cast = (a as Int) > a;
    let through_binding = copy == a;

    // Powers are the same if their bases and exponents are
    let powers = a ** 2 == a ** 2;

    // Different operands aren't reported
    let unrelated = a == b;
    let sum = a + a;
    let different_exponents = a ** 2 == a ** 3;
    let different_bases = a ** 2 == b ** 2;

    same
        && different
        && ordered
        && bytes_ordered
        && difference == xor
        && and == 0
        && cast
        && through_binding
        && powers
        && unrelated
        && sum > 0
        && different_exponents
        && different_bases
}
