fn main(value: Int | nil, flag: Bool) -> Int {
    if value is nil {
        raise;
    }

    if !flag {
        raise;
    }

    if value != 5 {
        raise;
    }

    // The value of a `raise` is the message of the `assert`
    if value > 100 {
        raise "Too large";
    }

    // A comment would be dropped, so there's no suggestion
    if value > 90 {
        // Too large
        raise ["Too large", value];
    }

    // Both branches of an `inline if` are evaluated
    inline if value > 50 {
        raise;
    }

    value
}
