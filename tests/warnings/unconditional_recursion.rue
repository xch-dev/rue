fn main(value: Int) -> Int {
    forever(value)
        + through_branches(value)
        + terminates(value)
        + guarded(value)
        + through_statement(value)
        + after_statement(value)
}

fn forever(value: Int) -> Int {
    forever(value + 1)
}

fn through_branches(value: Int) -> Int {
    if value > 5 {
        through_branches(value - 1)
    } else {
        through_branches(value + 1) * 2
    }
}

// There's a path that returns without calling itself
fn terminates(value: Int) -> Int {
    if value > 0 {
        terminates(value - 1)
    } else {
        0
    }
}

// The assertion raises on some path before the call
fn guarded(value: Int) -> Int {
    assert value > 0;
    guarded(value - 1)
}

// Every branch of the statement calls itself
fn through_statement(value: Int) -> Int {
    if value > 0 {
        debug through_statement(value);
    } else {
        debug through_statement(value - 1);
    }

    0
}

// A branch of the statement could return before the call after it, so it isn't looked past
fn after_statement(value: Int) -> Int {
    if value > 0 {
        return 0;
    } else {
        debug value;
    }

    after_statement(value - 1)
}
