fn main(value: Int) -> Int {
    forever(value)
        + through_branches(value)
        + terminates(value)
        + guarded(value)
        + unused_binding(value)
        + unused_inline_binding(value)
}

fn forever(value: Int) -> Int {
    forever(value + 1)
}

fn through_branches(value: Int) -> Int {
    if value > 5 {
        through_branches(value - 1)
    } else {
        through_branches(value + 1) * 2
    }
}

// There's a path that returns without calling itself
fn terminates(value: Int) -> Int {
    if value > 0 {
        terminates(value - 1)
    } else {
        0
    }
}

// The assertion raises on some path before the call
fn guarded(value: Int) -> Int {
    assert value > 0;
    guarded(value - 1)
}

// A binding that isn't inline is evaluated at its let statement, even if it's unused
fn unused_binding(value: Int) -> Int {
    let result = unused_binding(value);
    1
}

// An inline binding is only evaluated where it's referenced
fn unused_inline_binding(value: Int) -> Int {
    inline let result = unused_inline_binding(value);
    1
}
