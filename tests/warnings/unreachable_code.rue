// These tests use unions that overlap at runtime, such as `Int | nil` for an optional `Int`,
// since how they overlap isn't what's being tested
#![allow(indistinguishable_union_member)]

fn main() -> Int {
    let value = first(1) + after_if(2) + after_lambda(3);
    return value;
    let unused = 0;
    unused
}

fn first(value: Int) -> Int {
    return value;
    0
}

fn after_if(value: Int) -> Int {
    if value > 100 {
        raise "too large";
        debug value;
    }

    value
}

fn after_lambda(value: Int) -> Int {
    let add = fn(left: Int, right: Int): Int => {
        return left + right;
        0
    };

    add(value, 1)
}

// A binding whose value may fail is evaluated at its let statement, so one that never finishes
// makes the code after it unreachable
fn after_never_binding(value: Int) -> Int {
    if value > 100 {
        let never = {
            raise "failed";
        };
        return never;
    }

    value
}

// An inline binding is only evaluated where it's referenced, so the code after it is reachable
fn after_never_inline_binding(value: Int) -> Int {
    if value > 100 {
        inline let never = {
            raise "failed";
        };
        return 0;
    }

    value
}

// The binding is only referenced after the `return`, but its value may fail, so it's still
// evaluated at its let statement
fn dead_reference() -> Int {
    let value = fails();
    return 1;
    value
}

// A binding that can't fail isn't evaluated if it's never referenced
fn dead_safe_reference() -> Int {
    let value = 5;
    return 1;
    value
}

fn fails() -> Int {
    raise "failed";
}

test fn reachable() {
    assert dead_safe_reference() == 1;
    assert main() == 7;
    assert after_never_binding(1) == 1;
    assert after_never_inline_binding(1) == 1;
}

test fn dead_reference_fails() -> Int {
    dead_reference()
}

// A statement whose branches all return or raise never finishes
fn after_exiting_match(value: Int | nil) -> Int {
    match value {
        nil => {
            return 0;
        }
        Int => {
            raise "value";
        }
    }

    1
}

fn after_exiting_if(flag: Bool) -> Int {
    if flag {
        return 0;
    } else {
        raise "flag";
    }

    1
}

// A statement with a branch that falls through finishes
fn after_falling_through(flag: Bool) -> Int {
    if flag {
        return 0;
    } else {
        debug flag;
    }

    1
}

test fn exiting_statements() {
    assert after_exiting_match(nil) == 0;
    assert after_exiting_if(true) == 0;
    assert after_falling_through(false) == 1;
}
