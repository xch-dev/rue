fn main(puzzle_hash: Bytes32, amount: Int, flag: Bool) -> List<Condition> {
    // The condition is only read from, so it's never output
    let coin = CreateCoin { puzzle_hash, amount, memos: nil };
    assert coin.amount > 0;

    // A condition that's output is fine, even if it's also read from
    let fee = ReserveFee { amount: 1 };
    assert fee.amount < amount;

    // A condition that's output in one branch and dropped in the other is fine
    let announcement = CreateCoinAnnouncement { message: puzzle_hash };
    let rest = if flag {
        [announcement, fee]
    } else {
        [fee]
    };

    // A condition in a list that's only read from isn't output either
    let pair = [AssertMyAmount { amount }];
    assert pair.first.amount == amount;

    // Conditions passed to a function could be output by it
    let child = AssertMyPuzzleHash { puzzle_hash };
    let checked = check(child);

    // The body of a lambda is what it returns when it's called
    let make = fn() => CreateCoinAnnouncement { message: puzzle_hash };
    let made = make();

    // A condition that's destructured from a pair and output is fine
    let both = (CreateCoin { puzzle_hash, amount: 1, memos: nil }, amount);
    let (destructured, _) = both;
    assert both.rest > 0;

    // A condition that's only kept by a branch that's read from is never output either, and neither
    // is the one in the other branch
    let dropped = CreateCoin { puzzle_hash, amount: 2, memos: nil };
    let picked = if flag {
        dropped
    } else {
        CreateCoin { puzzle_hash, amount: 3, memos: nil }
    };
    assert picked.amount > 0;

    // Values taken out of a list with `first` and `rest` are followed, but which part of the list
    // they are isn't, so the conditions in a list that's partly output all count as output
    let conditions = [ReserveFee { amount: 2 }, AssertMyAmount { amount }];
    assert conditions.first.amount > 0;

    [checked, made, destructured, conditions.rest.first, ...rest]
}

// Tests don't output anything, and often build conditions only to check them
test fn checks_a_condition() {
    let condition = ReserveFee { amount: 1 };
    assert condition.amount == 1;
}

fn check(condition: AssertMyPuzzleHash) -> AssertMyPuzzleHash {
    condition
}
