inline fn large(a: Int, b: Int) -> Int {
    let c = a * b + a - b;
    let d = c * c + a * 3 - b * 7;
    let e = d * c + d - c + a * b;
    let f = e * e - d * d + c * c - a;
    let g = f * e + d - c * b + a * 11;
    let h = g * g - f * e + d * c - b * a;
    if h > 1000 {
        h - g + f - e
    } else {
        h + g - f + e
    }
}

inline fn small(a: Int) -> Int {
    a + 1
}

fn main(a: Int, b: Int) -> Int {
    large(a, b) + large(b, a) + large(a, a) + large(b, b) + small(a) + small(b) + small(a + b)
}
