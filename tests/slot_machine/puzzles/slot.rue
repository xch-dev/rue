// slot.clsp by yakuhito
// Utility functions to use for slots

export inline fn spend_slot(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
) -> Condition {
    SendMessage {
        mode: 18, // puzzle-puzzle
        message: nil, // ()
        receiver: [
            get_slot_puzzle_hash(SLOT_1ST_CURRY_HASH, slot_value_hash)
        ]
    }
}

export fn create_slot(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
) -> Condition {
    CreateCoin {
        puzzle_hash: get_slot_puzzle_hash(SLOT_1ST_CURRY_HASH, slot_value_hash),
        amount: 0,
        memos: Memos {
            value: [SLOT_1ST_CURRY_HASH],
        }
    }
}

export fn create_slot_with_hint(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
    hint: Bytes32,
) -> Condition {
    CreateCoin {
        puzzle_hash: get_slot_puzzle_hash(SLOT_1ST_CURRY_HASH, slot_value_hash),
        amount: 0,
        memos: Memos {
            value: [hint],
        }
    }
}

inline fn get_slot_puzzle_hash(SLOT_1ST_CURRY_HASH: Bytes32, slot_value_hash: Bytes32) -> Bytes32 {
    curry_tree_hash(SLOT_1ST_CURRY_HASH, [
        tree_hash_atom(slot_value_hash)
    ])
}
