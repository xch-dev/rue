// extend.rue by yakuhito
// Used to extend the registration of a handle

// Warning: Pricing puzzle is responsible for ensuring registered_time > 0

import xchandles::*;
import super::super::common_types::*;
import super::super::slot::*;

fn main(
    OFFER_MOD_HASH: Bytes32,
    PAYOUT_PUZZLE_HASH: Bytes32,
    HANDLE_SLOT_1ST_CURRY_HASH: Bytes32, // after 1st curry
    Truth: XchandlesStateTruth,
    handle_pricing: HandlePricing,
    counter: Int,
    neighbors: HandleSlotNeighbors,
    rest_data: HandleSlotData,
    ...cat_maker: CatMaker,
) -> (XchandlesStateTruth, List<Condition>) {
    let { total_price, registered_time } = handle_pricing.puzzle(...handle_pricing.solution);
    inline let handle_hash = tree_hash_atom(handle_pricing.solution.handle);

    let full_offer_puzzle_hash = cat_maker.puzzle(OFFER_MOD_HASH, ...cat_maker.solution);

    assert (
        (tree_hash(cat_maker.puzzle) == Truth.State.Cat_Maker_Puzzle_Hash) &
        (tree_hash(handle_pricing.puzzle) == Truth.State.Pricing_Puzzle_Hash)
    );

    (Truth, [
        // spend slot
        spend_slot(
            HANDLE_SLOT_1ST_CURRY_HASH,
            tree_hash(XchandlesHandleSlotValue {
                counter,
                a: HandleSlotValueA {
                    handle_hash,
                    neighbors,
                },
                b: HandleSlotValueB {
                    expiration: handle_pricing.solution.current_expiration,
                    data: rest_data,
                }
            })
        ),

        // announcement
        CreatePuzzleAnnouncement {
            message: "e" + tree_hash((total_price, handle_pricing.solution.handle))
        },

        // can't extend if expired
        AssertBeforeSecondsAbsolute {
            seconds: handle_pricing.solution.current_expiration,
        },

        // assert buy time
        AssertSecondsAbsolute {
            seconds: handle_pricing.solution.buy_time,
        },

        // create new slot
        create_slot(
            HANDLE_SLOT_1ST_CURRY_HASH,
            tree_hash(XchandlesHandleSlotValue {
                counter: counter + 1,
                a: HandleSlotValueA {
                    handle_hash,
                    neighbors,
                },
                b: HandleSlotValueB {
                    expiration: handle_pricing.solution.current_expiration + registered_time,
                    data: rest_data,
                }
            })
        ),

        // assert payment
        AssertPuzzleAnnouncement {
            id: sha256(
                full_offer_puzzle_hash +
                tree_hash((
                    tree_hash((handle_pricing.solution.handle, handle_pricing.solution.current_expiration)),
                    (
                        (PAYOUT_PUZZLE_HASH, (total_price, ([PAYOUT_PUZZLE_HASH], nil))),
                        nil
                    )
                ))
            ),
        }
    ])
}
