// solution: ((1 2 3) 0)
// solution: ((1 2 (4 . 5)) 0)

// The loop in `add_scaled` captures what `add_scaled` does, and its own `xs` and `n`. The
// captures they share are laid out as `add_scaled`'s tree inside of the loop's, so the loop calls
// `add_scaled` with them as one path, `4`, and the loop's tree has the shape of `add_scaled`'s
// whole environment, so `add_scaled` calls the loop with it as it is, as `(c 1 7)`.

fn main(xs: List<Int>, n: Int) -> Int {
    add_scaled(xs, n)
}

fn scale(n: Int) -> Int {
    if n > 100 {
        n
    } else {
        scale(n * 3)
    }
}

const SCALE: Int = scale(5);

fn add_scaled(xs: List<Int>, n: Int) -> Int {
    if n > 3 {
        n
    } else {
        for x in xs fold sum = 0 { sum + x + add_scaled(xs, n + SCALE) }
    }
}

test fn adds_scaled_values() -> Int {
    add_scaled([1, 2, 3], 0)
}
