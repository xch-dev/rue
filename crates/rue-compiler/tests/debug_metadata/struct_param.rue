// solution: ((0x859facc5a4c9b80ac2eef78916c1953bcccaab6014bb11b9de8337430ea34f0c 100) (3 . 5))
// solution: ((0x859facc5a4c9b80ac2eef78916c1953bcccaab6014bb11b9de8337430ea34f0c 100) (5 . 3))

struct Payment {
    puzzle_hash: Bytes32,
    amount: Int,
}

fn main(payment: Payment, pair: (Int, Int)) -> Int {
    by_struct(payment) + by_destructure(payment) + by_tuple(pair)
}

fn by_struct(payment: Payment) -> Int {
    payment.amount
}

// A pattern over several lines is named on one line (this file is left unformatted, since the
// formatter would put the pattern on one line)
fn by_destructure(
    {
        puzzle_hash,
        amount,
    }: Payment,
) -> Int {
    assert puzzle_hash != sha256("burn");
    amount
}

fn by_tuple((low, high): (Int, Int)) -> Int {
    assert low < high;
    high - low
}
